# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Every variable here is read by bank-api/src/main/resources/application.yml,
# where the defaults and the full explanation of each one live.

# ---- Profile -----------------------------------------------------------
# "mock" serves fixtures and needs no database — use it for the first run to
# prove the container works. Switch to "denodo" for the real connections.
SPRING_PROFILES_ACTIVE=mock

# Container clock. Banking data is date-keyed, so this must match the PC the
# app is replacing.
TZ=Asia/Riyadh

# ---- DB #1: BM archival schema (Denodo Hive views) ---------------------
# Required when SPRING_PROFILES_ACTIVE=denodo.
ARCHIVAL_DB_URL=jdbc:vdb://DENODO-HOST:9999/VDB_NAME
ARCHIVAL_DB_USER=
ARCHIVAL_DB_PASSWORD=
# Environment-specific view prefix, e.g. stcusttab -> bv_impala_stg_bankmaster_stcusttab.
# Change this (not the SQL) when moving staging -> prod.
ARCHIVAL_DB_TABLE_PREFIX=bv_impala_stg_bankmaster_
# Optional fixed restore snapshot, YYYYMMDD. Empty = MAX(BankingDate).
ARCHIVAL_BANKING_DATE=

# ---- DB #2: none ---------------------------------------------------------
# The cbcmssrv/Finacle online source has no connection of its own: it was the
# same Denodo server as DB #1, so the two are merged. Nothing to configure.
# When that source turns up on its own engine, add ONLINE_DB_* back here, the
# datasource beans in DenodoDataSourceConfig, and that engine's JDBC driver in
# deploy/drivers/ alongside the Denodo one.

# ---- Authentication -----------------------------------------------------
# >= 32 characters. Blank falls back to the dev key compiled into SecurityConfig
# — acceptable for a mock run, not for anything real.
BANK_JWT_SECRET=

# AES passphrase shared with the SPA (frontend PASSWORD_KEY_PASSPHRASE).
# Both sides must match.
BANK_AUTH_PASSPHRASE=BANK-CSD-Login-Key-2026

# Active Directory bind. Off by default; local users still work.
BANK_LDAP_ENABLED=false
BANK_LDAP_URL=
BANK_LDAP_DOMAIN=

# Comma-separated user IDs allowed in. EMPTY = allow all (dev only).
BANK_ALLOWED_USERS=

# ---- Diagnostics --------------------------------------------------------
# Swagger UI at /swagger-ui.html. Off by default; turn on temporarily to
# explore endpoints.
SPRINGDOC_ENABLED=false
