# ---- Dependencies ----
node_modules/

# ---- Build output ----
target/
dist/
dist-ssr/
*.class
.vite/

# ---- Build artifacts (regenerate: `mvn package` / `npm run build`) ----
deploy/*.jar
deploy/drivers/*.jar

# ---- Logs ----
logs/

# Runtime configuration. The app creates one next to itself on first start, so
# a dev run drops bank-api/bank-runtime.properties into the source tree; that
# copy holds one machine's allow-list and is not the repo's business. The
# SHIPPED template under deploy/ is tracked on purpose.
bank-runtime.properties
!deploy/bank-runtime.properties
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---- Local / environment overrides (never commit real secrets) ----
*.local
.env
.env.*
!.env.example

# ---- Editor / IDE ----
.idea/
.project
.classpath
.settings/
*.iml
.vscode/*
!.vscode/extensions.json

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Claude: personal local settings (skills are kept) ----
.claude/settings.local.json
