openStopChqLogFile(int mode)
{
	char tmpStr[100];
	
	if ( stopChqLogFileOpen == YES )
		return SUCCESS;

	if ( (stopChqLogFile  = isopen(stopChqLogFilePath, mode )) < 0)
	{
		fprintf(logFp, "%s|%5d|[openStopChqLogFile] ISOPEN error %d for %s File\n", getDateTime(), PID, iserrno, stopChqLogFilePath);
		sprintf(tmpStr,"Error  %d occured while opening ststchqlog.dat", iserrno);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}
	isindexinfo(stopChqLogFile, &stopChqLogKey, 1);

	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| ststchqlog file (%d) successfully opened...\n", getDateTime(), PID, stopChqLogFile);
		fflush(logFp);
	}

	stopChqLogFileOpen = YES;
	return SUCCESS;
}

