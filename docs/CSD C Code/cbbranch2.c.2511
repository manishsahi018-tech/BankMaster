	responseMsg.fetchAccDetails.nullPad = '\0';
	sprintf(tmpStr, "%06d", strlen(responseMsg.fetchAccDetails.msgLen));
	strncpy(responseMsg.fetchAccDetails.msgLen, tmpStr, 6);
	if ( responseCode == COMMSERR )
	{
		iscleanup();
		fclose(logFp);
	}
	return SUCCESS;
}
