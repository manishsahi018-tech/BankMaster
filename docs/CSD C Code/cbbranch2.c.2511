extern int debug, extraDebug, loginAuthorised, custLogFileOpen, custTabFileOpen,jointLogFileOpen, acctLogFileOpen, staticFileOpen, ctlFileOpen, acctTabFileOpen, jointTabFileOpen,abcFileOpen, cardLogFileOpen, cardTabFileOpen, gldFileOpen, o3dFileOpen, acctBmFileOpen, userFileOpen, userLogFileOpen, chqTabFileOpen, reqFileOpen, crdFileOpen, pensFileOpen, pennotFileOpen, sodFileOpen, pydFileOpen, sodLogFileOpen, stopChqLogFileOpen, ridFileOpen , chqDelFileOpen, penInhFileOpen , idLogFileOpen, idTabFileOpen, signLogFileOpen, signTabFileOpen, cndFileOpen, samaAccFileOpen, accOpenCardFileOpen, fndTabFileOpen, calendarFileOpen, refreshFileOpen, sadadCtlFileOpen, cbCtlTabFileOpen, cbFinCityFileOpen;
extern int PID;
extern char  *userFilePath, *userLogFilePath, *custLogFilePath, *jointLogFilePath, *acctLogFilePath, *ctlFilePath, *custTabFilePath, *jointTabFilePath, *crdFilePath, *abcFilePath, *cardTabFilePath, *cardLogFilePath, *gldFilePath, *o3dFilePath, *acctBmFilePath, *chqTabFilePath, *reqFilePath, *pensFilePath, *pennotFilePath, *sodFilePath, *pydFilePath, *sodLogFilePath, *stopChqLogFilePath, *gldMemoFilePath, *cndFilePath, *thdFilePath, *thd1FilePath, *brFilePath, *refFilePath, *brsFilePath, *ridFilePath, *secLogFilePath, *chqDelFilePath, *refreshFilePath, *penInhFilePath, *tpinHistFilePath, *idLogFilePath, *addrLogFilePath, *calendarFilePath, *idTabFilePath, *addrTabFilePath, *cRefLogFilePath, *cRefTabFilePath , *signLogFilePath, *signTabFilePath, *ownerLogFilePath, *ownerTabFilePath, *samaAccFilePath, *accOpenCardFilePath, *fndTabFilePath, *sadadCtlFilePath, *cbCtlTabFilePath, *cbFinCityFilePath;

int stBranchInterface2(headerBuf)
char *headerBuf;
{ 
	int c, msgLen;
	char tmpStr[60];
	char sendMsg[50];


	if ( extraDebug )
	{

		fprintf(logFp, "%s|%5d|[stBranchInterface2]\n", getDateTime(), PID);
		fflush(logFp);
	}

	systime = time(NULL);                  /* get the system time */
	systemDate = localtime( &systime );

	sprintf(tmpStr, "%.6s", headerBuf);
	msgLen = atoi(tmpStr);

	/* receive the main details */

	memset(receivedMsg.customer.msgLen, NULL, sizeof receivedMsg.customer);
	memset(responseMsg.customer.msgLen,  ' ', sizeof responseMsg.customer);
	strncpy(receivedMsg.customer.msgLen, headerBuf, 12);
	if ( getMessage(receivedMsg.customer.userId, msgLen - 12) < 0 )
	{
		formatBranchResponse(COMMSERR, "Comms Error:Check your connnection or call Support ","Comms Error:Check your connnection or call Support ");
		sendResponse(responseMsg.customer.msgLen);
		return COMMSFAILURE;
	}
	     
	if ( loginAuthorised == NO && strncmp(&headerBuf[6], "63",2) && strncmp(&headerBuf[8], "TUX", 3) ) 
	{
		formatBranchResponse(NOT_LOGIN, "Not yet logged in", "Not yet logged in");
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( strncmp(&headerBuf[6],"20",2) == 0 ) /* Card Info Addition request */
	{
		logCardDetails();
		if ( openCardLogFile(ISMANULOCK + ISINOUT)  < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openCardTabFile(ISMANULOCK + ISINOUT)  < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openGldFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openCtlFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if( processCardRequest() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6],"21",2) == 0) /* Account Search request */
	{
		logAccSearchDetails();	
		if ( openGldFile(ISMANULOCK + ISINOUT)  < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
		if ( openCustTabFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}
		if ( openCrdFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		if ( openCtlFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openABCFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openUserFiles(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openUsrBrnFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if( processAccSearchRequest() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6],"22",2) == 0 ) /* Account PendingList request */
	{
	}
	else if ( strncmp(&headerBuf[6],"23",2) == 0 ) /* Card PendingList request */
	{
			logCardPendingListDetails();
			if ( openCardLogFile(ISMANULOCK + ISINOUT)  < 0 )
			{
				sendResponse(responseMsg.customer.msgLen);
				return FAILURE;
			}
			if ( readCardPendingList() == FAILURE )
				return FAILURE;
	}
	else if ( strncmp(&headerBuf[6],"24",2) == 0) /* Card Search request */
	{
			logCardSearchDetails();	

			if ( openCardLogFile(ISMANULOCK + ISINOUT) < 0 )
			{
				sendResponse(responseMsg.cardSearch.msgLen);
				return FAILURE;
			}

			if ( openCardTabFile(ISMANULOCK + ISINOUT) < 0 )
			{
				sendResponse(responseMsg.cardSearch.msgLen);
				return FAILURE;
			}

			if ( openCtlFile(ISMANULOCK + ISINOUT) < 0 )
			{
				sendResponse(responseMsg.cardSearch.msgLen);
				return FAILURE;
			}

			if ( processCardSearchRequest() == FAILURE )
				return FAILURE;
	}
	else if ( strncmp(&headerBuf[6],"25",2) == 0 ) /* Card Detail request */
	{
		logCardPendingDetails();

		if ( openCrdFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		if ( strncmp(receivedMsg.cardPendingDetail.requestType, "01", 2) == 0 )
									/* Read from cbcardlog */
		{
			if ( openCardLogFile(ISMANULOCK + ISINOUT) < 0 )
			{
				sendResponse(responseMsg.cardSearch.msgLen);
				return FAILURE;
			}
			if ( processCardPendingDetail() == FAILURE )
				return FAILURE;
		}
		else if ( strncmp(receivedMsg.cardPendingDetail.requestType, "02", 2) == 0 ) /* Read from cbcardtab */
		{
			if ( openCardLogFile(ISMANULOCK + ISINOUT) < 0 )
			{
				sendResponse(responseMsg.cardSearch.msgLen);
				return FAILURE;
			}

			if ( openCardTabFile(ISMANULOCK + ISINOUT) < 0 )
			{
				sendResponse(responseMsg.cardSearch.msgLen);
				return FAILURE;
			}

			if ( processCardDetailRequest() == FAILURE )
				return FAILURE;
		}
	}
	else if ( strncmp(&headerBuf[6],"26",2) == 0 )/*Card/Pin Status List Request*/
	{
		logStatusListDetails();

		if ( openCardTabFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		if ( processStatusList() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6],"27",2) == 0 ) /* Card / Pin Status Update Request */
	{
		logStatusUpdateDetails();

		if ( openCardLogFile(ISMANULOCK+ISINOUT) < 0 )
		{
			fprintf(logFp, "%s: Open error %d on cbcardlog for writing the history record ignored \n", getDateTime(), iserrno);
			fflush(logFp);
			fprintf(errLogFp, "%s: stBranchInterface2(): Open error %d on cbcardlog for writing the history record ignored \n", getDateTime(), iserrno);
			fflush(errLogFp);
		}

		if ( openCardTabFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		if ( processStatusUpdate() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6],"28",2) == 0 ) /* Card Activation/Deactivation Request */
	{
		logDeactivationDetails();

		if (openCardLogFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		if ( openCardTabFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		if ( receivedMsg.cardActivate.activateOrDeactivate == 'D' )
		{
			if ( processCardDeactivate() == FAILURE )
				return FAILURE;
		}
		else if ( receivedMsg.cardActivate.activateOrDeactivate == 'A' )
		{
			if ( processCardActivate() == FAILURE )
				return FAILURE;
		}
	}
	else if ( strncmp(&headerBuf[6],"29",2) == 0 ) /* 29 is for Force Card/Pin Generation Request */
	{
		logForceCardGenerationDetails();

		if ( openCardLogFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		if ( openCardTabFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		if ( openGldFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		if ( openCtlFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		if ( processForceCardGeneration() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6],"30",2) == 0) /* 30 is for General customer status enquiry */ /* previously 30 is Renewal Process
				                                                                          Renewal Process is included in statmext ;*/
	{
	}
	else if ( strncmp(&headerBuf[6],"31",2) == 0) /* 31 is for Update Status from DC9000 */
	{
		logSyncDC9000Details();

		if ( openCardLogFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		if ( openCardTabFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		if ( processDC9000Status() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6],"32",2) == 0) /* 32 is for Supervisor approval request for the cards */
	{
		logCardApprovalDetails();

		if ( openUserFile(ISMANULOCK+ISINOUT) < 0 )
		{
			fprintf(logFp, "%s : ISOPEN error %d on stuser is ignored \n", getDateTime(), iserrno);
			fflush(logFp);
			fprintf(errLogFp, "%s: processCardApproval(): Open error %d on stuser ignored \n", getDateTime(), iserrno);
			fflush(errLogFp);
		}

		if ( processCardApproval(receivedMsg.cardApproval.appRejectFlag) == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6],"33",2) == 0) /* Account PendingDetail request */
	{
		logAccPendingDetails();	

		if ( openCrdFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
		if ( openCustTabFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		if ( strncmp(receivedMsg.accPendingDetail.requestType,"01",2) == 0 )
												/*	read from stacclog */
		{
			if ( openAcctLogFile(ISMANULOCK + ISINOUT) < 0 )
			{
				sendResponse(responseMsg.customer.msgLen);
				return FAILURE;
			}

			if ( openSignLogFile(ISMANULOCK + ISINOUT) < 0 )
			{
				sendResponse(responseMsg.customer.msgLen);
				return FAILURE;
			}

			if ( processAccPendingDetail() == FAILURE )
				return FAILURE;
		}
		else if ( strncmp(receivedMsg.accPendingDetail.requestType, "02", 2) == 0 ) 
																/* read from gld0data */
		{
			if ( openGldFile(ISMANULOCK + ISINOUT)  < 0 )
			{
				sendResponse(responseMsg.customer.msgLen);
				return FAILURE;
			}

			if ( openCtlFile(ISMANULOCK + ISINOUT) < 0 )
			{
				sendResponse(responseMsg.customer.msgLen);
				return FAILURE;
			}

			if ( processAccDetail() == FAILURE )
				return FAILURE;
		}
	}
	else if ( strncmp(&headerBuf[6],"34",2) == 0 ) /*Account Approval request*/
	{
	}
	else if ( strncmp(&headerBuf[6],"35",2) == 0 ) /* Password reset Request */
	{
		logResetPasswordDetails();

		if ( openUserFiles(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( processResetPassword() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6],"36",2) == 0 ) /* Card/Pin History Request*/
	{
		logCardHistoryDetails();

		if ( openCardLogFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}	

		if ( getCardHistoryDetails() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6], "37",2) == 0 ) /* Cheque Book Request */
	{
	}
	else if ( strncmp(&headerBuf[6], "38",2) == 0 ) /* Cheque Book Status List Request */
	{
	}
	else if ( strncmp(&headerBuf[6], "39",2) == 0 ) /* Cheque Book Status Update Request */
	{
	}
	else if ( strncmp(&headerBuf[6], "42",2) == 0 ) /* Standing Order Search Request */
	{
		logStdOrdSearchDetails();

		if ( openSodFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( processStdOrdSearch() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6], "43",2) == 0 ) /* Standing Order Detail Request */
	{
		logStdOrdDetailRequest();
		if ( openCustTabFile(ISMANULOCK+ISINOUT) < 0 )
		{
			fprintf(logFp, "%s|%5d|[stbranchInterface2()] Open Error on stcusttab ignored as it is just for taking customer name ..\n", getDateTime(), PID);
			fflush(logFp);
			fprintf(errLogFp, "%s|%5d|[stBranchInterface2()]: Open Error %d on stcusttab ignored as it is just for taking customer name ..\n", getDateTime(), PID, iserrno);
			fflush(errLogFp);
		}

		if ( openCrdFile(ISMANULOCK+ISINOUT) < 0 )
		{
			fprintf(logFp, "%s|%5d|[stBranchInterface2()] Open Error on crd0data ignored as it is just for taking customer name ..\n", getDateTime(),PID);
			fflush(logFp);
			fprintf(errLogFp, "%s : stBranchInterface2(): Open Error %d on crd0data ignored as it is just for taking customer name ..\n", getDateTime(), iserrno);
			fflush(errLogFp);
		}

		if ( openGldFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( strncmp(receivedMsg.stdOrdDetail.requestType, "02",2) == 0 )
		{
			if ( openSodFile(ISMANULOCK+ISINOUT) < 0 )
			{
				sendResponse(responseMsg.customer.msgLen);
				return FAILURE;
			}

			if ( processStdOrdDetail() == FAILURE )
				return FAILURE;
		}
		else if ( strncmp(receivedMsg.stdOrdDetail.requestType, "01",2) == 0 )
		{
			if ( openSodLogFile(ISMANULOCK+ISINOUT) < 0 )
			{
				sendResponse(responseMsg.customer.msgLen);
				return FAILURE;
			}

			if ( processStdOrdPendingDetail() == FAILURE )
				return FAILURE;
		}
	}
	else if ( strncmp(&headerBuf[6], "45",2) == 0 ) /*Stop Cheque Search*/
	{
		logStopChqSearch();

		if (openPydFile(ISMANULOCK+ISINOUT)  < 0)
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( processStopChqSearch() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6], "46",2) == 0 ) /*Stop Cheque Detail*/
	{
		logStopChqDetail();

		if (openPydFile(ISMANULOCK+ISINOUT)  < 0)
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openStopChqLogFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( strncmp(receivedMsg.stopChqDetail.requestType, "02",2) == 0 )
		{
			if ( processStopChqDetail() == FAILURE )
				return FAILURE;
		}
		else
		{
			if ( processStopChqPendingDetail() == FAILURE )
				return FAILURE;
		}
	}
	else if ( strncmp(&headerBuf[6], "49",2) == 0 ) /*Change delivery address */
	{
		logChangeAddressDetails();

		if ( openCardLogFile(ISMANULOCK + ISINOUT)  < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openCardTabFile(ISMANULOCK + ISINOUT)  < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( processChangeAddress() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6], "55",2) == 0 ) /*Cheque Book Search */
	{
		logChequeBookSearchDetails();

		if ( openChqTabFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openCrdFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( processChequeBookSearch() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6], "56",2) == 0 ) /*Cheque Book History */
	{
		logChequeBookHistoryDetails();

		if ( openChqTabFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( getChequeBookHistoryDetails() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6], "57",2) == 0 ) /*Account Status change History */
	{
		logAcctStatusChangeHistoryDetails();

		if ( openAcctLogFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( getAcctStatusHistory() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6], "59",2) == 0 ) /*Update printing of Plastic card to Base24 through stb24int*/
	{
		logPrintCardDetails();

		if ( openCardTabFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openCardLogFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( processCardPrint() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6], "60",2) == 0 ) /*Process Pin request with interface to HSM */
	{
		logPinProcessDetails();

		if ( openCardTabFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openCardLogFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( processPinRequest() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6], "62",2) == 0 ) /* Restrict Card / remove restrcition */
	{
		logCardRestrictDetails();

		if ( openCardTabFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openCardLogFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( processCardRestrict() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6], "63",2) == 0 ) /* User Logout */
	{
		logLogoutDetails();

		if ( openUserFiles(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openSecLogFile(ISMANULOCK+ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( processLogoutUser() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6], "65",2) == 0 ) /* get Unix date & time */
	{
		fprintf(logFp, "%s|%5d|[stBranchInterface2] Unix Date & Time requested from branch [%.4s] by user [%.10s]\n", getDateTime(), PID, &headerBuf[8], receivedMsg.customer.userId);
		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d000", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
		sprintf(sendMsg, "%06d%s", strlen(tmpStr),tmpStr);
		sendResponse(sendMsg);
		return SUCCESS;
	}
	else if ( strncmp(&headerBuf[6], "67", 2) == 0 ) /* Customer Update History Request */ 
	{
		logCustomerHistoryDetails(); 
		if( openCustLogFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openCustTabFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openCrdFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( receivedMsg.custHistory.msgType == '0' )
		{
			if ( processCustomerHistory() == FAILURE )
				return FAILURE;
		}
	}
	else if ( strncmp(&headerBuf[6], "AZ", 2) == 0 ) /* Fetch details for Account opening card print */
	{
		logAccOpeningCardDetails();

		if ( openCustTabFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openCrdFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( openGldFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( processAccOpeningCard() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6], "BA", 2) == 0 ) /* Confirm printing of Account opening card */
	{
		logConfirmAccOpeningCardPrint();

		if ( openAccOpenCardFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( processConfirmAccOpeningCard() == FAILURE )
			return FAILURE;
	}
	else if ( strncmp(&headerBuf[6], "BB", 2) == 0 ) /* get IBAN for the given account number */
	{
		logGetIBANDetails();

		if ( openGldFile(ISMANULOCK + ISINOUT) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( processFetchIBAN() == FAILURE )
			return FAILURE;
	}
	else
	{
		sprintf(tmpStr, "Invalid Service Code %.2s received", &headerBuf[6]);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	return SUCCESS;
}

processCustomerHistory()
{
	int lastRecRcvd, recCount=0, recsInThisMsg = 0, i, j ;
	int len, currentYear=0;
	char tmpStr[100];
	char *pathName;
	int  tmpCustLogFile;
	struct keydesc  tmpCustLogKey;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processCustomerHistory]\n", getDateTime(), PID);

	memset(responseMsg.custHistory.msgLen, ' ', sizeof responseMsg.custHistory);
	responseMsg.custHistory.nullPad = '\0';

	sprintf(tmpStr, "%.5s", receivedMsg.custHistory.lastRecCount);
	lastRecRcvd = atoi(tmpStr);

	sprintf(tmpStr, "%.7s", receivedMsg.custHistory.custNo);
	if ( getCustName(tmpStr) == SUCCESS )
	{
		if ( strncmp(custTabRec.aShortName, "                                 ", 30) == 0 )
			strncpy(responseMsg.custHistory.shortName, custTabRec.eShortName, 30);
		else
			strncpy(responseMsg.custHistory.shortName, custTabRec.aShortName, 30);

		strncpy(responseMsg.custHistory.custBranchCode, custTabRec.branchCode, 4);
	}
	strncpy(responseMsg.custHistory.custNo, receivedMsg.custHistory.custNo, 7);

	getDateTime();
	currentYear = systemDate->tm_year+1900;
	for ( i=2000; i < currentYear; i++ )
	{
		sprintf(tmpStr, "custlog%04d", i);
		pathName = getpath(tmpStr, "static");

		if ( (tmpCustLogFile  = isopen(pathName, ISMANULOCK+ISINPUT)) < 0)
		{
			if ( extraDebug > 8 )
			{
				fprintf(logFp, "%s|%5d|[processCustomerHistory] ISOPEN error %d for %s File IGNORED\n",getDateTime(), PID, iserrno, pathName);
				fflush(logFp);
			}
			free(pathName);
			continue;
		}
		free(pathName);
		isindexinfo(tmpCustLogFile, &tmpCustLogKey, 3); /* Key on customer number */

		memset(&custLogRec.liveChar, ' ', sizeof custLogRec);
		strncpy(custLogRec.custNo, receivedMsg.custHistory.custNo, 7);
		isstart(tmpCustLogFile,&tmpCustLogKey, 0, &custLogRec.liveChar,ISGTEQ);
		while ( isread(tmpCustLogFile, &custLogRec.liveChar, ISNEXT) == 0 )
		{
			/* Remove NULL char from the record */
			len = sizeof custLogRec;
			for (j = 0 ; j < len; j++)
				if ( custLogRec.branchCode[j] == NULL )
					custLogRec.branchCode[j] = ' ';

			if ( strncmp(custLogRec.custNo, receivedMsg.custHistory.custNo, 7) )
				break;

			if ( recCount++ < lastRecRcvd )
				continue; /* read all records already sent */

			strncpy(responseMsg.custHistory.details[recsInThisMsg].branchCode, custLogRec.branchCode, 4);
			strncpy(responseMsg.custHistory.details[recsInThisMsg].userId, custLogRec.userId, 20);
			strncpy(responseMsg.custHistory.details[recsInThisMsg].dateTime, custLogRec.dateTime, 14);
			responseMsg.custHistory.details[recsInThisMsg].pendingStatus = custLogRec.bmUpdateStatus;
			if ( custLogRec.bmUpdateStatus != '1' && custLogRec.bmUpdateStatus != '2' )
			{
				strncpy(responseMsg.custHistory.details[recsInThisMsg].supervisorId, custLogRec.supervisorId, 20);
				strncpy(responseMsg.custHistory.details[recsInThisMsg].lastUpdateDateTime, custLogRec.lastUpdateDateTime, 14);
			}
			strncpy(responseMsg.custHistory.details[recsInThisMsg].mainCategoryCode, custLogRec.samaMainCategory, 2);
			strncpy(responseMsg.custHistory.details[recsInThisMsg].subCategoryCode, custLogRec.samaSubCategory, 2);
			
			if ( ++recsInThisMsg >=  20 )
				break;
		}
		isclose(tmpCustLogFile);
		if ( recsInThisMsg >= 20 )
		{
			sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
			strncpy(responseMsg.custHistory.lastRecCount, tmpStr, 5);
			sprintf(tmpStr, "%02d", recsInThisMsg);
			strncpy(responseMsg.custHistory.noOfRecs, tmpStr, 2);
			responseMsg.custHistory.details[recsInThisMsg+1].branchCode[0] = '\0';
			formatSearchResponse(DONE, "Successful", "Successful");
			fflush(logFp);
			sendResponse(responseMsg.custHistory.msgLen);
			return SUCCESS;
		}
	}

	memset(&custLogRec.liveChar, ' ', sizeof custLogRec);
	isindexinfo(custLogFile, &custLogKey, 3);
	strncpy(custLogRec.custNo, receivedMsg.custHistory.custNo, 7);
	memset(custLogRec.lastUpdateDateTime, ' ', 14);

	isstart(custLogFile,&custLogKey, 0, &custLogRec.liveChar,ISGTEQ);

	while ( isread(custLogFile, &custLogRec.liveChar, ISNEXT) == 0 )
	{
		/* Remove NULL char from the record */
		len = sizeof custLogRec;
		for (i = 0 ; i < len; i++)
			if ( custLogRec.branchCode[i] == NULL )
				custLogRec.branchCode[i] = ' ';

		if ( strncmp(custLogRec.custNo, receivedMsg.custHistory.custNo, 7) )
			break;

		if ( recCount++ < lastRecRcvd )
			continue; /* read all records already sent */

		if ( strncmp(responseMsg.custHistory.shortName, "                                ", 30 ) == 0 )
		{
			if ( strncmp(custLogRec.aShortName, "                                 ", 30) == 0 )
				strncpy(responseMsg.custHistory.shortName, custLogRec.eShortName, 30);
			else
				strncpy(responseMsg.custHistory.shortName, custLogRec.aShortName, 30);

			strncpy(responseMsg.custHistory.custBranchCode, custLogRec.custBranchCode, 4);
		}

		strncpy(responseMsg.custHistory.details[recsInThisMsg].branchCode, custLogRec.branchCode, 4);
		strncpy(responseMsg.custHistory.details[recsInThisMsg].userId, custLogRec.userId, 20);
		strncpy(responseMsg.custHistory.details[recsInThisMsg].dateTime, custLogRec.dateTime, 14);
		responseMsg.custHistory.details[recsInThisMsg].pendingStatus = custLogRec.bmUpdateStatus;
		if ( custLogRec.bmUpdateStatus != '1' && custLogRec.bmUpdateStatus != '2' )
		{
			strncpy(responseMsg.custHistory.details[recsInThisMsg].supervisorId, custLogRec.supervisorId, 20);
			strncpy(responseMsg.custHistory.details[recsInThisMsg].lastUpdateDateTime, custLogRec.lastUpdateDateTime, 14);
		}
		strncpy(responseMsg.custHistory.details[recsInThisMsg].mainCategoryCode, custLogRec.samaMainCategory, 2);
		strncpy(responseMsg.custHistory.details[recsInThisMsg].subCategoryCode, custLogRec.samaSubCategory, 2);
		
		if ( ++recsInThisMsg >=  20 )
			break;
	}
	sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
	strncpy(responseMsg.custHistory.lastRecCount, tmpStr, 5);
	sprintf(tmpStr, "%02d", recsInThisMsg);
	strncpy(responseMsg.custHistory.noOfRecs, tmpStr, 2);
	responseMsg.custHistory.details[recsInThisMsg+1].branchCode[0] = '\0';
	formatSearchResponse(DONE, "Successful", "Successful");
	fflush(logFp);
	sendResponse(responseMsg.custHistory.msgLen);
	return SUCCESS;
}

processRefreshRequest()
{
	int lastRecRcvd, recCount=0, recsInThisMsg = 0;
	char tmpStr[250], lastRefreshDateTime[15];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processRefreshRequest]\n", getDateTime(), PID);

	/* format the response message */

	memset(responseMsg.refresh.msgLen, ' ', sizeof responseMsg.refresh);
	responseMsg.refresh.nullPad = '\0';

	memset(lastRefreshDateTime, ' ', sizeof lastRefreshDateTime);
	sprintf(tmpStr, "%.5s", receivedMsg.refresh.lastRecCount);
	lastRecRcvd = atoi(tmpStr);

	receivedMsg.refresh.refreshType = '0'; /* Always a partial refresh is carried out; as the full refresh takes a lot of time from the branches; changed during the Phase-II roll-out */
	if ( receivedMsg.refresh.refreshType == '0' )  /* PARTIAL REFRESH */
	{ /* Read the refresh file for the client ip address  to get last refresh date & time */

		memset(&refreshRec.liveChar, ' ', sizeof refreshRec);
		strncpy(refreshRec.recType, "IP", 2);
		strncpy(refreshRec.clientIpAddress, clientIpAddress, 20);
		if ( isRead(refreshFile, &refreshRec.liveChar, ISEQUAL) < 0 )
		{
			if ( lastRecRcvd == 0 ) /* Log "IP not found" only during the first lot */
				fprintf(logFp, "%s|%5d| [processRefreshRequest] IP Address %.20s does not Exist; Error %d  \n", getDateTime(), PID, refreshRec.clientIpAddress, iserrno );
			getDateTime();
			sprintf(tmpStr, "20020101%02d%02d%02d", systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
			strncpy(lastRefreshDateTime, tmpStr, 14);
		}
		else
		{
			if ( receivedMsg.refresh.reqType != '1' ) /* 1 is for refreshing records from SADAD control file (stsadctl) */ 
				sprintf(lastRefreshDateTime, "%.14s", refreshRec.lastRefreshDateTime1); 
			else
				sprintf(lastRefreshDateTime, "%.14s", refreshRec.lastRefreshDateTime2); 
		}
	}

	if ( receivedMsg.refresh.reqType != '1' ) /* 1 is for refreshing records from SADAD control file (stsadctl) */ 
	{
		/* start searching for records(in stctltab) to be refreshed */
		isindexinfo(ctlFile, &ctlKey, 2);
		
		memset(&ctlRec.liveChar, ' ', sizeof ctlRec);
		strncpy(ctlRec.lastUpdateDateTime, lastRefreshDateTime, 14);
		if ( isstart(ctlFile, &ctlKey, 14, &ctlRec.liveChar, ISGTEQ) < 0 )
		{
			if ( iserrno != 110 && iserrno != 112 && iserrno != 111 )
			{
				sprintf(tmpStr, "CISAM Error %d occured on stctltab", iserrno);
				formatRefreshResponse(INTERNALERR,tmpStr, tmpStr);
				sendResponse(responseMsg.refresh.msgLen);
				return FAILURE;
			}
		}

		while ( isRead(ctlFile, &ctlRec.liveChar, ISNEXT) == 0 )
		{
			if ( strncmp(ctlRec.recType, "RN", 2) == 0 )
				continue;	/* RANGE record need no refresh */
			if ( recCount++ < lastRecRcvd )
				continue; /* read all records already sent */
			sprintf(tmpStr, "%-200.200s", ctlRec.recType);
			strncpy(&responseMsg.refresh.ctlRecInfo[recsInThisMsg*200], tmpStr, 200);
			if ( ++recsInThisMsg >=  10 )
				break;
		}
		sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
		strncpy(responseMsg.refresh.lastRecCount, tmpStr, 5);
		sprintf(tmpStr, "%02d", recsInThisMsg);
		strncpy(responseMsg.refresh.noOfRecs, tmpStr, 2);
		formatRefreshResponse(DONE, "Successful", "Successful");
		sendResponse(responseMsg.refresh.msgLen);
	}
	else /* Refresh records from SADAD control file ( stsadctl ) */
	{
		/* start searching for records to be refreshed  from SADAD control file */
		isindexinfo(sadadCtlFile, &sadadCtlKey, 2);
		
		memset(&sadadCtlRec.liveChar, ' ', sizeof sadadCtlRec);
		strncpy(sadadCtlRec.lastUpdateDateTime, lastRefreshDateTime, 14);
		if ( isstart(sadadCtlFile, &sadadCtlKey, 14, &sadadCtlRec.liveChar, ISGTEQ) < 0 )
		{
			if ( iserrno != 110 && iserrno != 112 && iserrno != 111 )
			{
				sprintf(tmpStr, "CISAM Error %d occured on stsadctl", iserrno);
				formatRefreshResponse(INTERNALERR,tmpStr, tmpStr);
				sendResponse(responseMsg.refresh.msgLen);
				return FAILURE;
			}
		}

		while ( isRead(sadadCtlFile, &sadadCtlRec.liveChar, ISNEXT) == 0 )
		{
			if ( recCount++ < lastRecRcvd )
				continue; /* read all records already sent */
			sprintf(tmpStr, "%-200.200s", sadadCtlRec.recType);
			strncpy(&responseMsg.refresh.ctlRecInfo[recsInThisMsg*200], tmpStr, 200);
			if ( ++recsInThisMsg >=  10 )
				break;
		}
		sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
		strncpy(responseMsg.refresh.lastRecCount, tmpStr, 5);
		sprintf(tmpStr, "%02d", recsInThisMsg);
		strncpy(responseMsg.refresh.noOfRecs, tmpStr, 2);
		formatRefreshResponse(DONE, "Successful", "Successful");
		sendResponse(responseMsg.refresh.msgLen);
	}

	/* when the last record received; branch refreshDateTime should be updated with current dateTime*/
	if ( recsInThisMsg < 10 ) /* means it is the last lot */
	{
		memset(&refreshRec.liveChar, ' ', sizeof refreshRec);
		strncpy(refreshRec.recType, "IP", 2);
		strncpy(refreshRec.clientIpAddress, clientIpAddress, 20);
		if ( isRead(refreshFile, &refreshRec.liveChar, ISEQUAL) < 0 )
		{
			fprintf(logFp, "%s|%5d| [processRefreshRequest] IP Address %.20s does not exist ; Error %d; so adding a record in refresh control table\n", getDateTime(), PID, refreshRec.clientIpAddress, iserrno);
			fflush(logFp);

			refreshRec.liveChar = '@';
			strncpy(refreshRec.recType, "IP", 2);
			strncpy(refreshRec.clientIpAddress, clientIpAddress, 20);
			getDateTime();
			sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
			if ( receivedMsg.refresh.reqType != '1' ) /* 1 is for refreshing records from SADAD control file (stsadctl) */ 
				strncpy(refreshRec.lastRefreshDateTime1, tmpStr, 14);
			else
				strncpy(refreshRec.lastRefreshDateTime2, tmpStr, 14);
				

			if ( extraDebug > 4 )
			{
				fprintf(logFp, "%s|%5d| [processRefreshRequest] Before writing to streftab file (%d)...\n", getDateTime(), PID, refreshFile);
				fflush(logFp);
			}
			if ( isWrite(refreshFile, &refreshRec.liveChar) < 0 )
			{
				fprintf(logFp, "%s|%5d| [processRereshRequest]  ISWRITE error %d on streftab while adding ip address %.20s and record type %.2s, IGNORED\n", getDateTime(), PID, iserrno, refreshRec.clientIpAddress, refreshRec.recType);
				fflush(logFp);
				fprintf(errLogFp, "%s : processRefreshRequest() : ISWRITE error %d on streftab while adding ip address %.20s and record type %.2s\n", getDateTime(), iserrno, refreshRec.clientIpAddress, refreshRec.recType);
				fflush(errLogFp);
			}
			else
				fprintf(logFp, "%s|%5d| [processRefreshRequest] Refresh(%c) completes for the ip address [%.20s]\n", getDateTime(), PID, receivedMsg.refresh.refreshType, refreshRec.clientIpAddress);
		}
		else
		{
			getDateTime();
			sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
			if ( receivedMsg.refresh.reqType != '1' ) /* 1 is for refreshing records from SADAD control file (stsadctl) */ 
				strncpy(refreshRec.lastRefreshDateTime1, tmpStr, 14);
			else
				strncpy(refreshRec.lastRefreshDateTime2, tmpStr, 14);
			if ( isRewcurr(refreshFile, &refreshRec.liveChar) < 0 )
			{
				fprintf(logFp, "%s|%5d| [processRefreshRequest] ISREWCURR error %d while writing Branch record for %.4s during LocalRefresh\n", getDateTime(), PID, iserrno, receivedMsg.refresh.branchCode);
				fflush(logFp);
				fprintf(errLogFp, "%s :processRefreshRequest() : ISREWCURR error %d while writing Branch record for %.4s during LocalRefresh\n", getDateTime(), iserrno, receivedMsg.refresh.branchCode);
				fflush(errLogFp);
			}
			else
				fprintf(logFp, "%s|%5d| [processRefreshRequest] Refresh(%c) completes for the ip address [%.20s]\n", getDateTime(), PID, receivedMsg.refresh.refreshType, refreshRec.clientIpAddress);
		}
	}
	fflush(logFp);
	return SUCCESS;
}

processChangeAddress()
{
	char tmpStr[100];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processChangeAddress]\n", getDateTime(), PID);

	memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);

	isindexinfo(cardTabFile, &cardTabKey, 1);
	strncpy(cardTabRec.cardNo, receivedMsg.changeAddress.cardNo, 19);

	if( isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar,ISGTEQ) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processChangeAddress]  ISSTART/ISGTEQ error %d occured on cbcardtab file for card # [%.19s] \n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
		fflush(logFp);
		if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
			 formatBranchResponse(END_OF_FILE, "No Record found for this card...", "No Record found for this card ..");
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on cbcardtab", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( readCardTabFile(ISEQUAL+ISLOCK) < 0 )
	{
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	cardTabRec.deliveryToBranchOrPO = receivedMsg.changeAddress.deliveryToBranchOrPO;
	strncpy(cardTabRec.address1, receivedMsg.changeAddress.address1, 30);
	strncpy(cardTabRec.address2, receivedMsg.changeAddress.address2, 30);
	strncpy(cardTabRec.poBox , receivedMsg.changeAddress.poBox, 10);
	strncpy(cardTabRec.cityName , receivedMsg.changeAddress.cityName, 20);
	strncpy(cardTabRec.zipCode, receivedMsg.changeAddress.zipCode, 10);
	strncpy(cardTabRec.lastUpdateUser, receivedMsg.changeAddress.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardTabRec.lastUpdateDateTime, tmpStr, 14);
			
	if ( updateCardTabFile() < 0 )
	{
		isrelease(cardTabFile);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}
	isrelease(cardTabFile);

	/* Now, add a record in cbcardlog for history purpose */

	memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);
	cardLogRec.liveChar = '@';
	strncpy(cardLogRec.branchCode, receivedMsg.changeAddress.homeBranch, 4);
	strncpy(cardLogRec.userId, receivedMsg.changeAddress.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardLogRec.dateTime, tmpStr, 14);
	cardLogRec.newOrUpdate = 'U'; 
	cardLogRec.bmUpdateStatus = '9'; /* completed */
	strncpy(cardLogRec.supervisorId, receivedMsg.changeAddress.userId , 10); 
	strncpy(cardLogRec.cardNo, cardTabRec.cardNo, 19);
	cardLogRec.requestStatus = cardTabRec.requestStatus;

	strncpy(&cardLogRec.cardType, &cardTabRec.cardType, 374);
	cardLogRec.requestType = '6'; /* Change address */
	strncpy(cardLogRec.processDateTime, cardTabRec.processDateTime, 14);
	memset(cardLogRec.cardGeneratedDate, ' ', 54);
	memset(cardLogRec.pinGeneratedDate, ' ', 54);
	strncpy(cardLogRec.lastUpdateUser, receivedMsg.changeAddress.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardLogRec.lastUpdateDateTime, tmpStr, 14);

	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| [processChangeAddress] Before writing to cardLogFile (%d) ..\n", getDateTime(), PID, cardLogFile);
		fflush(logFp);
	}
	if ( isWrite(cardLogFile, &cardLogRec.liveChar) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processChangeAddress] ISWRITE error %d occured on cbcardlog while inserting a record for history purposes ignored and the key is [%.28s] [%.19s]\n", getDateTime(), PID, iserrno, cardLogRec.branchCode, cardLogRec.cardNo);
		fflush(logFp);
		fprintf(errLogFp, "%s: processChangeAddress(): ISWRITE error %d occured on cbcardlog while inserting a record for history purposes ignored and the key is [%.28s] [%.19s]\n", getDateTime(), iserrno, cardLogRec.branchCode, cardLogRec.cardNo);
		fflush(errLogFp);
	}

	formatBranchResponse(DONE, "Successful...","Successful...");  
	sendResponse(responseMsg.customer.msgLen);
	return SUCCESS;
}

formatCardRequestResponse(responseCode, aRemarks, eRemarks)
char *responseCode, *aRemarks, *eRemarks;
{
	char tmpStr[120];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[formatCardRequestResponse] formating the response\n", getDateTime(), PID);

	strncpy(responseMsg.cardInfo.status, responseCode, 3);
	sprintf(tmpStr, "%-50.50s", aRemarks);
	strncpy(responseMsg.cardInfo.aRemarks,tmpStr,50);
	sprintf(tmpStr, "%-50.50s", eRemarks);
	strncpy(responseMsg.cardInfo.eRemarks,tmpStr,50);
	strncpy(responseMsg.cardInfo.service, receivedMsg.cardInfo.service, 2);
	responseMsg.cardInfo.nullPad = '\0';
	sprintf(tmpStr, "%06d", strlen(responseMsg.cardInfo.msgLen));
	strncpy(responseMsg.cardInfo.msgLen, tmpStr, 6);
	if ( responseCode == COMMSERR )
	{
		iscleanup();
		fclose(logFp);
	}
	return SUCCESS;
}

formatPrintCardResponse(responseCode, aRemarks, eRemarks)
char *responseCode, *aRemarks, *eRemarks;
{
	char tmpStr[120];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[formatPrintCardResponse] formating the response\n", getDateTime(), PID);

	strncpy(responseMsg.printCard.status, responseCode, 3);
	sprintf(tmpStr, "%-50.50s", aRemarks);
	strncpy(responseMsg.printCard.aRemarks,tmpStr,50);
	sprintf(tmpStr, "%-50.50s", eRemarks);
	strncpy(responseMsg.printCard.eRemarks,tmpStr,50);
	strncpy(responseMsg.printCard.service, receivedMsg.printCard.service, 2);
	responseMsg.printCard.nullPad = '\0';
	sprintf(tmpStr, "%06d", strlen(responseMsg.printCard.msgLen));
	strncpy(responseMsg.printCard.msgLen, tmpStr, 6);
	if ( responseCode == COMMSERR )
	{
		iscleanup();
		fclose(logFp);
	}
	return SUCCESS;
}

checkPrevStatus(char *accNo)
{
	int intlSuppCount = 0;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[checkPrevStatus]\n", getDateTime(), PID);


	primaryElectronCardExist = '0';
	primaryDepositCardExist = '0';
	primaryIntlCardExist = '0';
	primaryChipCardExist = '0';
	primaryLocalChipCardExist = '0';
	primaryCpsCardExist = '0';
	intlSuppCardAllowed = '0';
	memset(custAddress1, ' ', sizeof custAddress1);
	memset(custAddress2, ' ', sizeof custAddress2);
	memset(custPoBox, ' ', sizeof custPoBox);
	memset(custCity, ' ', sizeof custCity);
	memset(custZipCode, ' ', sizeof custZipCode);

	if ( openCardTabFile(ISMANULOCK+ISINOUT) < 0 )
	{
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}
	isindexinfo(cardTabFile, &cardTabKey, 9);
	strncpy(cardTabRec.coreAccNo, accNo, 16);
	isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar, ISGTEQ);
	while ( isRead(cardTabFile, &cardTabRec.liveChar, ISNEXT) == 0 )
	{
		if ( strncmp(cardTabRec.coreAccNo, accNo,16) )
			break;

		if ( cardTabRec.cardType == 'I' || cardTabRec.cardType == 'V' || cardTabRec.cardType == 'S' )
			intlSuppCount++;

		if ( cardTabRec.requestStatus == '9' || cardTabRec.requestStatus == '8' )
			continue;

		if ( cardTabRec.cardType == 'R' && cardTabRec.primaryOrSupplementary == 'P' && (cardTabRec.cardStatus == '1' || cardTabRec.cardStatus == '4' )  )
		{
			primaryElectronCardExist = '1';
			strncpy(custAddress1, cardTabRec.address1,30);
			strncpy(custAddress2, cardTabRec.address2,30);
			strncpy(custPoBox, cardTabRec.poBox,10);
			strncpy(custCity, cardTabRec.cityName, 20);
			strncpy(custZipCode, cardTabRec.zipCode, 10);
		}

		if ( cardTabRec.cardType == 'D' && cardTabRec.primaryOrSupplementary == 'P' && cardTabRec.cardStatus == '1' )
		{
			primaryDepositCardExist = '1';
			strncpy(custAddress1, cardTabRec.address1,30);
			strncpy(custAddress2, cardTabRec.address2,30);
			strncpy(custPoBox, cardTabRec.poBox,10);
			strncpy(custCity, cardTabRec.cityName, 20);
			strncpy(custZipCode, cardTabRec.zipCode, 10);
		}
			
		if ( (cardTabRec.cardType == 'I' || cardTabRec.cardType == 'V' ) && cardTabRec.primaryOrSupplementary == 'P' && (cardTabRec.cardStatus == '1' || cardTabRec.cardStatus == '4' ) ) 
		{
			primaryIntlCardExist = '1';
			strncpy(custAddress1, cardTabRec.address1,30);
			strncpy(custAddress2, cardTabRec.address2,30);
			strncpy(custPoBox, cardTabRec.poBox,10);
			strncpy(custCity, cardTabRec.cityName, 20);
			strncpy(custZipCode, cardTabRec.zipCode, 10);
		}

		if ( ( cardTabRec.cardType == 'S' ) && cardTabRec.primaryOrSupplementary == 'P' && (cardTabRec.cardStatus == '1' || cardTabRec.cardStatus == '4' ) ) 
		{
			primaryChipCardExist = '1';
			strncpy(custAddress1, cardTabRec.address1,30);
			strncpy(custAddress2, cardTabRec.address2,30);
			strncpy(custPoBox, cardTabRec.poBox,10);
			strncpy(custCity, cardTabRec.cityName, 20);
			strncpy(custZipCode, cardTabRec.zipCode, 10);
		}

		if ( cardTabRec.cardType == 'L' && cardTabRec.primaryOrSupplementary == 'P' && (cardTabRec.cardStatus == '1' || cardTabRec.cardStatus == '4' )  )
		{
			primaryLocalChipCardExist = '1';
			strncpy(custAddress1, cardTabRec.address1,30);
			strncpy(custAddress2, cardTabRec.address2,30);
			strncpy(custPoBox, cardTabRec.poBox,10);
			strncpy(custCity, cardTabRec.cityName, 20);
			strncpy(custZipCode, cardTabRec.zipCode, 10);
		}
		if ( cardTabRec.cardType == 'C' && cardTabRec.primaryOrSupplementary == 'P' && (cardTabRec.cardStatus == '1' || cardTabRec.cardStatus == '4' )  )
		{
			primaryCpsCardExist = '1';
			strncpy(custAddress1, cardTabRec.address1,30);
			strncpy(custAddress2, cardTabRec.address2,30);
			strncpy(custPoBox, cardTabRec.poBox,10);
			strncpy(custCity, cardTabRec.cityName, 20);
			strncpy(custZipCode, cardTabRec.zipCode, 10);
		}
	}

	if ( intlSuppCount >= 99 )
		intlSuppCardAllowed = '1';
}

processCardRequest()
{
	char tmpStr[100] , tCustNo[15], coreAccNo[20]; 
	char cardRequestStatus, pinRequestStatus;
	char tCardNo[30], saveExpiryDate[10];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processCardRequest]\n", getDateTime(), PID);

	memset(saveExpiryDate, ' ', sizeof saveExpiryDate);
	memset(responseMsg.cardInfo.msgLen, ' ', sizeof responseMsg.cardInfo);
	memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);

	strncpy(tCustNo, receivedMsg.cardInfo.custNo, 8);

	if ( receivedMsg.cardInfo.newOrUpdate == 'N' )
	{
		if ( strncmp(receivedMsg.cardInfo.coreAccNo, "              ", 10) == 0 || receivedMsg.cardInfo.coreAccNo[0] == NULL )
			sprintf(coreAccNo, "0108%.8s%.4s", receivedMsg.cardInfo.custNo, receivedMsg.cardInfo.subAcc);
		else
			sprintf(coreAccNo, "%.16s", receivedMsg.cardInfo.coreAccNo);
		checkPrevStatus(coreAccNo);
	}

	if ( receivedMsg.cardInfo.primaryOrSupplementary == 'P' )
	{
		if ( receivedMsg.cardInfo.cardType == 'R' )
		{
			if ( primaryElectronCardExist == '1' )
			{
				formatCardRequestResponse(INCORRECTMSG, "Primary Electron Card already Exists..", "Primary Electron Card already Exists..");  
				sendResponse(responseMsg.cardInfo.msgLen);
				return FAILURE;
			}
		}
		if ( receivedMsg.cardInfo.cardType == 'L' )
		{
			if ( primaryLocalChipCardExist == '1' )
			{
				formatCardRequestResponse(INCORRECTMSG, "Primary Local chip Card already Exists..", "Primary Local chip Card already Exists..");  
				sendResponse(responseMsg.cardInfo.msgLen);
				return FAILURE;
			}
		}
		else if ( receivedMsg.cardInfo.cardType == 'D' )
		{
			if ( primaryDepositCardExist == '1' )
			{
				formatCardRequestResponse(INCORRECTMSG, "Primary Deposit Card already Exists..", "Primary Deposit Card already Exists..");  
				sendResponse(responseMsg.cardInfo.msgLen);
				return FAILURE;
			}
		}
		else if ( receivedMsg.cardInfo.cardType == 'I' )
		{
			if ( primaryIntlCardExist == '1' )
			{
				formatCardRequestResponse(INCORRECTMSG, "Primary International Card already Exists..", "Primary International Card already Exists..");  
				sendResponse(responseMsg.cardInfo.msgLen);
				return FAILURE;
			}

			if ( intlSuppCardAllowed == '1' )
			{
				formatCardRequestResponse(INCORRECTMSG, "Supplementary International Card Limit Exceeded..", "Supplementary International Card Limit exceeded..");  
				sendResponse(responseMsg.cardInfo.msgLen);
				return FAILURE;
			}
		}
		else if ( receivedMsg.cardInfo.cardType == 'S' )
		{
			if ( primaryChipCardExist == '1' )
			{
				formatCardRequestResponse(INCORRECTMSG, "Primary Chip Card already Exists..", "Primary Chip Card already Exists..");  
				sendResponse(responseMsg.cardInfo.msgLen);
				return FAILURE;
			}

			if ( intlSuppCardAllowed == '1' )
			{
				formatCardRequestResponse(INCORRECTMSG, "Supplementary Chip Card Limit Exceeded..", "Supplementary Chip Card Limit exceeded..");  
				sendResponse(responseMsg.cardInfo.msgLen);
				return FAILURE;
			}
		}
		else if ( receivedMsg.cardInfo.cardType == 'C' )
		{
			if ( primaryCpsCardExist == '1' )
			{
				formatCardRequestResponse(INCORRECTMSG, "Primary CPS Card already Exists..", "Primary CPS Card already Exists..");  
				sendResponse(responseMsg.cardInfo.msgLen);
				return FAILURE;
			}

			if ( intlSuppCardAllowed == '1' )
			{
				formatCardRequestResponse(INCORRECTMSG, "Supplementary CPS Card Limit Exceeded..", "Supplementary CPS Card Limit exceeded..");  
				sendResponse(responseMsg.cardInfo.msgLen);
				return FAILURE;
			}
		}
	}
	else /* Requested card is a Supplementary Card */
	{
		if ( receivedMsg.cardInfo.cardType == 'I' || receivedMsg.cardInfo.cardType == 'S' || receivedMsg.cardInfo.cardType == 'C' )
		{
			if ( intlSuppCardAllowed == '1' )
			{
				formatCardRequestResponse(INCORRECTMSG, "Supplementary International Card Limit Exceeded..", "Supplementary International Card Limit exceeded..");  
				sendResponse(responseMsg.cardInfo.msgLen);
				return FAILURE;
			}
		}
	}

	if (receivedMsg.cardInfo.creationOrUpdate == 'C' && receivedMsg.cardInfo.cardType != 'A' ) /* No Need to check for current account existance for Admin card */
	{
		if ( strncmp(receivedMsg.cardInfo.coreAccNo, "              ", 10) == 0 || receivedMsg.cardInfo.coreAccNo[0] == NULL )
			sprintf(coreAccNo, "0108%.8s%.4s", receivedMsg.cardInfo.custNo, receivedMsg.cardInfo.subAcc);
		else
			sprintf(coreAccNo, "%.16s", receivedMsg.cardInfo.coreAccNo);

		fprintf(logFp, "%s|%5d|[processCardRequest] : Account Formed : %s\n", getDateTime(), PID, coreAccNo);
		fflush(logFp);


		if ( validateAccNo(coreAccNo) == FAILURE )
		{
			if ( strncmp(acctInfoResponseMsg.responseStatus, "00005", 5) == 0  )
				sprintf(tmpStr, "Attached Account not exist for this customer");
			else
				sprintf(tmpStr, "Error %.5s while reading account ", acctInfoResponseMsg.responseStatus);

			formatCardRequestResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.cardInfo.msgLen);
			return FAILURE;
		}

		if ( acctInfoResponseMsg.accStatus == '2' || acctInfoResponseMsg.accStatus == '3' )
		{
			fprintf(logFp, "%s|%5d|[processCardRequest] : Card issue is rejected since account status is closed (%c) ) \n", getDateTime(), PID, acctInfoResponseMsg.accStatus);
			fflush(logFp);
			sprintf(tmpStr,"Account Status is closed , Card cannot be issued");
			formatCardRequestResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.cardInfo.msgLen);
			return FAILURE;
		}

		if ( acctInfoResponseMsg.dormantFlag == '1' )
		{
			fprintf(logFp, "%s|%5d|[processCardRequest] Card issue is rejected since account status is dormant ) \n", getDateTime(), PID);
			fflush(logFp);
			sprintf(tmpStr,"Account Status is dormant , Card cannot be issued");
			formatCardRequestResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.cardInfo.msgLen);
			return FAILURE;
		}

		memset(&ctlRec.liveChar, ' ', sizeof ctlRec);

		strncpy(ctlRec.recType, "BD", 2);
		strncpy(ctlRec.branchCode, acctInfoResponseMsg.branchCode, 4);

		isindexinfo(ctlFile, &ctlKey, 1);
		isstart(ctlFile, &ctlKey, 0, &ctlRec.liveChar, ISGTEQ);

		if ( isRead(ctlFile, &ctlRec.liveChar, ISEQUAL) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processCardRequest] ISREAD/ISEQUAL error %d occured while reading Control File for Code No [%.6s]\n", getDateTime(), PID, iserrno,ctlRec.recType);
			fflush(logFp);
			sprintf(tmpStr, "Branch record missing for branch code [%.4s]", gldRec.branchCode);
			formatCardRequestResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.cardInfo.msgLen);
			return FAILURE;
		}

		if ( ctlRec.cardRequestFromBranch != '1' ) /* card Request rejected for the branch */
		{
			fprintf(logFp, "%s|%5d|[processCardRequest] Card Request is set as rejected (%c) in the control table for the branch [%.4s] \n", getDateTime(), PID, ctlRec.cardRequestFromBranch, ctlRec.branchCode);
			fflush(logFp);
			sprintf(tmpStr, "Card request is rejected for this branch customer");
			formatCardRequestResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.cardInfo.msgLen);
			return FAILURE;
		}
	}

	if ( receivedMsg.cardInfo.cardType == 'A' ) /* Admin card */
		sprintf(coreAccNo, "0100%.8s0001", receivedMsg.cardInfo.custNo);

	if ( receivedMsg.cardInfo.creationOrUpdate == 'U' || receivedMsg.cardInfo.creationOrUpdate == 'F' )
	{
		strncpy(cardLogRec.branchCode, receivedMsg.cardInfo.homeBranch,4);
		strncpy(cardLogRec.userId, receivedMsg.cardInfo.userId,10);
		strncpy(cardLogRec.dateTime, receivedMsg.cardInfo.dateTime,14);
		strncpy(cardLogRec.cardNo, receivedMsg.cardInfo.cardNo, 19);

		isindexinfo(cardLogFile, &cardLogKey, 1);
		if ( isstart(cardLogFile,&cardLogKey,0,&cardLogRec.liveChar,ISEQUAL) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processCardRequest] No card Record found for the key [%.28s] Error  %d \n", getDateTime(), PID, cardLogRec.branchCode, iserrno);
			fflush(logFp);
			if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
				 formatCardRequestResponse(END_OF_FILE,"No card Record(s) found for this key ....", "No card Record(s) found for this key ....");
			else
			{
				sprintf(tmpStr, "CISAM Error %d occured on cbcardlog file", iserrno);
				formatCardRequestResponse(INTERNALERR, tmpStr, tmpStr);
			}
			sendResponse(responseMsg.cardInfo.msgLen);
			return FAILURE;
		}

		if ( readCardLogFile(ISEQUAL+ISLOCK) < 0 )
		{
			isrelease(cardLogFile);
			sendResponse(responseMsg.cardInfo.msgLen);
			return FAILURE;
		}
	}

	cardLogRec.liveChar = '@';
	if ( receivedMsg.cardInfo.creationOrUpdate == 'F' )
		strncpy(cardLogRec.userId, authorisedUser, 10);
	else
		strncpy(cardLogRec.userId, receivedMsg.cardInfo.userId,10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	if ( receivedMsg.cardInfo.creationOrUpdate == 'U' || receivedMsg.cardInfo.creationOrUpdate == 'F' )
		strncpy(cardLogRec.dateTime, receivedMsg.cardInfo.dateTime,14);
	else
		strncpy(cardLogRec.dateTime, tmpStr, 14);
	strncpy(cardLogRec.branchCode, receivedMsg.cardInfo.branchCode,4);
	cardLogRec.newOrUpdate = receivedMsg.cardInfo.newOrUpdate;
	cardLogRec.bmUpdateStatus = '1'; /* Pending with Supervisor,*/
	strncpy(cardLogRec.supervisorId, receivedMsg.cardInfo.supervisorId,10);
	strncpy(cardLogRec.cardNo, receivedMsg.cardInfo.cardNo, 19);
	cardLogRec.cardType = receivedMsg.cardInfo.cardType;
	cardLogRec.newOrReplacement = receivedMsg.cardInfo.newOrReplacement; 
	cardLogRec.primaryOrSupplementary = receivedMsg.cardInfo.primaryOrSupplementary;
	cardLogRec.cardStatus = receivedMsg.cardInfo.cardStatus;
	cardLogRec.regionCode = receivedMsg.cardInfo.regionCode;
	strncpy(cardLogRec.coreCustNo, receivedMsg.cardInfo.custNo, 8);

	/*
	if ( readBranchFile("BD", receivedMsg.cardInfo.customerBranch) == FAILURE )
		cardLogRec.regionCode = receivedMsg.cardInfo.regionCode;
	else
	{
		if ( branchRec.regionCode == NULL || branchRec.regionCode == ' ' )
			cardLogRec.regionCode = receivedMsg.cardInfo.regionCode;
		else
			cardLogRec.regionCode = branchRec.regionCode;
	}
	*/

	cardLogRec.languageCode = receivedMsg.cardInfo.languageCode;
	strncpy(cardLogRec.nameOnTheCard, receivedMsg.cardInfo.nameOnTheCard, 26);
	cardLogRec.deliveryToBranchOrPO = receivedMsg.cardInfo.deliveryToBranchOrPO;
	strncpy(cardLogRec.address1, receivedMsg.cardInfo.address1, 30);
	strncpy(cardLogRec.address2, receivedMsg.cardInfo.address2, 30);
	strncpy(cardLogRec.poBox, receivedMsg.cardInfo.poBox, 10);
	strncpy(cardLogRec.cityName, receivedMsg.cardInfo.cityName, 20);
	strncpy(cardLogRec.zipCode, receivedMsg.cardInfo.zipCode, 10);
	strncpy(cardLogRec.firstIssueDate, receivedMsg.cardInfo.firstIssueDate, 8);
	strncpy(cardLogRec.expireDate, receivedMsg.cardInfo.expiryDate,8);
	/*if ( receivedMsg.cardInfo.creationOrUpdate == 'C' )*/
	if ( receivedMsg.cardInfo.creationOrUpdate != 'U' )
	{
		strncpy(cardLogRec.customerBranch, receivedMsg.cardInfo.customerBranch, 4);
		strncpy(cardLogRec.renewalDate, receivedMsg.cardInfo.firstIssueDate, 8);
		strncpy(cardLogRec.coreAccNo, coreAccNo, 16);
		cardLogRec.requestType = '0'; /* Initial Card */
		cardLogRec.requestStatus = '0'; /* Requested */ 
		cardLogRec.pinRequestStatus = '0'; /* Requested */
	}
	strncpy(cardLogRec.lastUpdateUser, receivedMsg.cardInfo.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardLogRec.lastUpdateDateTime, tmpStr, 14);
	memset(cardLogRec.filler1,' ', sizeof cardLogRec.filler1);

	if ( receivedMsg.cardInfo.newOrUpdate == 'N' && receivedMsg.cardInfo.creationOrUpdate == 'C' )
	{
		if ( formatCardRecord(cardLogRec.cardType, cardLogRec.newOrReplacement, cardLogRec.primaryOrSupplementary, cardLogRec.nameOnTheCard, receivedMsg.cardInfo.idNo ) == FAILURE )
		{
			sendResponse(responseMsg.cardInfo.msgLen);
			return FAILURE;
		}
		strncpy(cardLogRec.address2, cardTabRec.address2,30);

		sprintf(tCardNo, "%.19s", cardTabRec.cardNo);
		do
		{
			if ( checkExistance(tCardNo) == FAILURE )
				break;

			if ( cardLogRec.cardType == cardTabRec.cardType && cardLogRec.primaryOrSupplementary == 'P' && cardLogRec.cardType != 'A') /* check whether primary electron/intl/deposit card already exist */
			{
				if ( cardTabRec1.cardStatus != '1' && cardTabRec1.cardStatus != '4' && cardTabRec1.primaryOrSupplementary == 'P' )
				{
					if ( cardTabRec.primaryOrSupplementary == 'P' && strncmp(cardTabRec.coreAccNo, cardTabRec1.coreAccNo,16) == 0 )
					{
						cardTabRec.newOrReplacement = 'R';

						/* Stamp the latest of the previous cards and stamp it as OLD card number & expiry date */
						if ( strncmp(saveExpiryDate, "           ", 8) )
						{
							if ( strncmp(cardTabRec1.expireDate, saveExpiryDate, 8) > 0 )
							{
								strncpy(cardTabRec.oldCardNo, cardTabRec1.cardNo, 19);
								strncpy(cardLogRec.oldCardNo, cardTabRec.oldCardNo, 19);
								strncpy(cardTabRec.oldExpiryDate, &cardTabRec1.expireDate[2], 4);
								strncpy(cardLogRec.oldExpiryDate, cardTabRec.oldExpiryDate, 4);
								sprintf(saveExpiryDate, "%.8s", cardTabRec1.expireDate);
							}
						}
						else
						{
							strncpy(cardTabRec.oldCardNo, cardTabRec1.cardNo, 19);
							strncpy(cardLogRec.oldCardNo, cardTabRec.oldCardNo, 19);
							strncpy(cardTabRec.oldExpiryDate, &cardTabRec1.expireDate[2], 4);
							strncpy(cardLogRec.oldExpiryDate, cardTabRec.oldExpiryDate, 4);
							sprintf(saveExpiryDate, "%.8s", cardTabRec1.expireDate);
						}
					}
				}
			}

			if ( incCard(cardTabRec.cardType, tCardNo) == FAILURE )
			{
				formatCardRequestResponse(INTERNALERR, "Card Range have been exhausted..", "Card Range have been exhausted..");
				isrelease(cardLogFile);
				sendResponse(responseMsg.cardInfo.msgLen);
				return FAILURE;
			}
		} while(1);

		strncpy(cardTabRec.cardNo, tCardNo, 19);
		if ( receivedMsg.cardInfo.newOrReplacement == 'R' )
		{
			if ( receivedMsg.cardInfo.deactivationType != NULL )
			{
				cardTabRec.deactivationType = receivedMsg.cardInfo.deactivationType;
				cardLogRec.deactivationType = receivedMsg.cardInfo.deactivationType;
			}
			memset(tmpStr, ' ', sizeof tmpStr);
			sprintf(tmpStr, "%-19.19s", receivedMsg.cardInfo.oldCardNo);
			strncpy(cardLogRec.oldCardNo, tmpStr, 19);
			strncpy(cardTabRec.oldCardNo, tmpStr, 19);
			if ( receivedMsg.cardInfo.oldExpiryDate[0] != NULL )
			{
				strncpy(cardLogRec.oldExpiryDate, receivedMsg.cardInfo.oldExpiryDate, 4);
				strncpy(cardTabRec.oldExpiryDate, receivedMsg.cardInfo.oldExpiryDate, 4);
			}

			/* If the Old Expiry date is coming as SPACES during REPLACEMENT card request.. 
			   find out the old card number & its expiry date and stamp it in cardTab & cardLog
			   as it is required for servicefee program ;  10th Jan 2009 
			*/
			if ( strncmp(receivedMsg.cardInfo.oldExpiryDate, "      ", 4) == 0 )
			{
				if ( extraDebug > 4 )
				{
					fprintf(logFp, "%s|%5d| Old expiry date is coming as SPACES.. hence getting the old expiry date by reading stcardtab for this account [%.14s] \n", getDateTime(), PID, cardTabRec.bmAccNo);
					fflush(logFp);
				}
				memset(&cardTabRec1.liveChar, ' ', sizeof cardTabRec1);
				strncpy(cardTabRec1.coreAccNo, cardTabRec.coreAccNo, 14);
				isindexinfo(cardTabFile, &cardTabKey, 9);
				isstart(cardTabFile, &cardTabKey, 0, &cardTabRec1.liveChar, ISGTEQ);

				while ( isRead(cardTabFile, &cardTabRec1.liveChar, ISNEXT) == 0 )
				{
					if ( strncmp(cardTabRec1.coreAccNo, cardTabRec.coreAccNo, 16) )
						break;

					if ( cardTabRec1.cardStatus != '2' && cardTabRec1.cardStatus != '3' && cardTabRec1.cardStatus != '9' )
						continue;

					if ( strncmp(cardTabRec1.deactivationUserId, cardTabRec.requestUserId, 10) == 0 && 
						 strncmp(cardTabRec1.deactivationDate, cardTabRec.requestDateTime, 8) == 0 )
					{
						strncpy(cardTabRec.oldCardNo, cardTabRec1.cardNo, 19);
						strncpy(cardTabRec.oldExpiryDate, &cardTabRec1.expireDate[2], 4);
						strncpy(cardLogRec.oldCardNo, cardTabRec1.cardNo, 19);
						strncpy(cardLogRec.oldExpiryDate, &cardTabRec1.expireDate[2], 4);
						break;
					}
				}
			}
		}

		strncpy(cardLogRec.cardNo, cardTabRec.cardNo, 19);
		strncpy(cardLogRec.coreAccNo, cardTabRec.coreAccNo,16);
		strncpy(cardLogRec.idNo, cardTabRec.idNo, 15);
		/*strncpy(cardLogRec.titleCode, cardTabRec.titleCode,2);*/

		cardLogRec.bmUpdateStatus = '1'; /* Pending with Supervisor */
		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
		strncpy(cardLogRec.firstIssueDate, tmpStr, 8);
		strncpy(cardLogRec.renewalDate, tmpStr, 8);
		strncpy(cardLogRec.expireDate, cardTabRec.expireDate, 8);
		cardLogRec.newOrReplacement = cardTabRec.newOrReplacement;
		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
		strncpy(cardLogRec.lastUpdateDateTime, tmpStr, 14);
		cardLogRec.branchPinSelect = 'N';
		cardLogRec.branchCardPrdn  = 'N'; 

		if ( extraDebug > 4 )
		{
			fprintf(logFp, "%s|%5d| [processCardRequest] Before writing to cardTabFile (%d) ..\n", getDateTime(), PID, cardTabFile);
			fflush(logFp);
		}
		if ( isWrite(cardTabFile, &cardTabRec.liveChar) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processCardRequest] :ISWRITE error %d while writing card request into card file for card # %.19s\n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
			fflush(logFp);
			if  ( iserrno == 100 )
			{
				sprintf(tmpStr, "Duplicate record [%.19s] on cbcardtab", cardTabRec.cardNo);
				formatCardRequestResponse(DUPLICATE, tmpStr, tmpStr);
			}
			else if ( iserrno == 107 || iserrno == 113 )
			{
				sprintf(tmpStr, "Record/File locked on cbcardtab"); 
				formatCardRequestResponse(RECORD_LOCKED, tmpStr, tmpStr);
			}
			else
			{
				sprintf(tmpStr, "CISAM Error %d occured on cbcardtab", iserrno);
				formatCardRequestResponse(INTERNALERR, tmpStr, tmpStr);
			}
			isrelease(cardLogFile);
			sendResponse(responseMsg.cardInfo.msgLen);
			return FAILURE;
		}
	}

	if ( receivedMsg.cardInfo.creationOrUpdate == 'U' || receivedMsg.cardInfo.creationOrUpdate == 'F' )
	{
		if ( updateCardLogFile() < 0 )
		{
			isrelease(cardLogFile);
			sendResponse(responseMsg.cardInfo.msgLen);
			return FAILURE;
		}
		isrelease(cardLogFile);
	}
	else
	{
		if ( extraDebug > 4 )
		{
			fprintf(logFp, "%s|%5d| [processCardRequest] Before writing to cardLogFile (%d) ..\n", getDateTime(), PID, cardLogFile);
			fflush(logFp);
		}
		if ( isWrite(cardLogFile, &cardLogRec.liveChar) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processCardRequest] ISWRITE error %d on cbcardlog while creating a new card/update key is [%.28s] and the card #[%.19s] \n", getDateTime(), PID, iserrno, cardLogRec.branchCode, cardLogRec.cardNo );
			fflush(logFp);
			if  ( iserrno == 100 || iserrno == 108 )
			{
				sprintf(tmpStr, "Duplicate record [%.28s]",cardLogRec.branchCode);
				formatCardRequestResponse(DUPLICATE, tmpStr, tmpStr);
			}
			else if ( iserrno == 107 || iserrno == 113 )
			{
				sprintf(tmpStr, "Record/File locked on cbcardlog");
				formatCardRequestResponse( RECORD_LOCKED, tmpStr, tmpStr);
			}
			else
			{
				sprintf(tmpStr, "CISAM Error %d occured on cbcardlog", iserrno);
				formatCardRequestResponse(INTERNALERR, tmpStr, tmpStr);
			}
			sendResponse(responseMsg.cardInfo.msgLen);
			return FAILURE;
		}
	}

	strncpy(responseMsg.cardInfo.cardNo, cardLogRec.cardNo, 19);
	strncpy(responseMsg.cardInfo.dateTime, cardLogRec.dateTime, 14);
	closeAllFiles();

	formatCardRequestResponse(DONE, "Successfully Added...", "Successfully Added...");
    sendResponse(responseMsg.cardInfo.msgLen);
	return SUCCESS;
}

checkExistance( char *cardNo )
{
	memset(&cardTabRec1.liveChar, ' ', sizeof cardTabRec1);

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[checkExistance]\n", getDateTime(), PID);

	strncpy(cardTabRec1.cardNo, cardNo, 19);
	isindexinfo(cardTabFile, &cardTabKey, 1);
	if( isstart(cardTabFile, &cardTabKey, 0, &cardTabRec1.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[checkExistance] ISSTART/ISEQUAL error %d occured on cbcardtab file for card # [%.19s]\n", getDateTime(), PID, iserrno, cardTabRec1.cardNo);
		fflush(logFp);
		if ( iserrno != 111 )
			return FAILURE;
	}

	if ( isRead(cardTabFile, &cardTabRec1.liveChar, ISEQUAL) < 0 )
	{
		if ( iserrno != 111 )
		{
			fprintf(logFp, "%s|%5d|[checkExistance] ISREAD/ISEQUAL error %d while reading cbcardtab for card # [%.19s]\n", getDateTime(), PID, iserrno, cardTabRec1.cardNo);
			fflush(logFp);
		}
		return FAILURE;
	}
	return SUCCESS;
}

processCardRestrict()
{
	char tmpStr[100],tAccNo[20], tCardNo[19];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processCardRestrict]\n", getDateTime(), PID);

	if ( extraDebug )
	{
		fprintf(logFp, "processCardRestrict() entered....\n");
		fflush(logFp);
	}

	memset(responseMsg.customer.msgLen, ' ', sizeof responseMsg.customer);
	memset(&cardLogRec1.liveChar, ' ', sizeof cardLogRec1);

	strncpy(cardLogRec1.cardNo, receivedMsg.cardRestrict.cardNo, 19);

	isindexinfo(cardLogFile, &cardLogKey, 2);
	if( isstart(cardLogFile, &cardLogKey, 0, &cardLogRec1.liveChar,ISGTEQ) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardRestrict] ISSTART/ISGTEQ error %d on cbcardlog for card # [%.19s]ignored..\n", getDateTime(), PID, iserrno, cardLogRec1.cardNo);
		fflush(logFp);
		fprintf(errLogFp, "%s :processCardRestrict(): ISSTART/ISGTEQ error %d on cbcardlog for card # [%.19s]ignored..\n", getDateTime(), iserrno, cardLogRec1.cardNo);
		fflush(errLogFp);
	}

	while ( isRead(cardLogFile, &cardLogRec1.liveChar, ISNEXT) == 0 )
	{
		if ( strncmp(cardLogRec1.cardNo, receivedMsg.cardRestrict.cardNo,19) )
			break;

		if (cardLogRec1.bmUpdateStatus == '1' || cardLogRec1.bmUpdateStatus == '2')
		{
			fprintf(logFp, "%s|%5d|[processCardRestrict] Card # [%.19s] already in pending status [%c] in branch [%.4s] for the request [%c] ; Request User Id [%.10s]\n", getDateTime(), PID, cardLogRec1.cardNo, cardLogRec1.bmUpdateStatus, cardLogRec1.branchCode, cardLogRec1.requestType, cardLogRec1.userId);
			fflush(logFp);

			if ( cardLogRec1.bmUpdateStatus == '1' ) /* Pending with supervisor */
				sprintf(tmpStr, "Card is Pending with Supervisor of Br.Code [%.4s]", cardLogRec1.branchCode);
			else /* pending with CSO */
				sprintf(tmpStr, "Card is pending with User[%.10s];Br.[%.4s]", cardLogRec1.userId, cardLogRec1.branchCode);

			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
	}

	memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);

	strncpy(cardTabRec.cardNo, receivedMsg.cardRestrict.cardNo,19);

	isindexinfo(cardTabFile, &cardTabKey, 1);
	if( isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar,ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardRestrict] ISSTART/ISEQUAL error %d occured on cbcardtab file for card # [%.19s]\n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
		fflush(logFp);
		if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
			 formatBranchResponse(END_OF_FILE, "No Record found for this card...", "No Record found for this card ..");
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on cbcardtab", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( readCardTabFile(ISEQUAL) < 0 )
	{
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE ;
	}

	if ( strncmp(cardTabRec.processDateTime, "                  ", 14) == 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardRestrict] Action [%c:%s] is pending for the Card no. [%.19s] from Br.Code [%.4s]\n", getDateTime(), PID, cardTabRec.requestType, cardTabRec.requestType == '0' ? "New Card" : cardTabRec.requestType == '2' ? "Force Card" : cardTabRec.requestType == '3' ? "Force Pin":"Unknown", cardTabRec.cardNo, cardTabRec.requestBranch);
		fflush(logFp);
		sprintf(tmpStr, "Action pending ; may be tried on next working day");
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);

	cardLogRec.liveChar = '@';

	strncpy(cardLogRec.branchCode, receivedMsg.cardRestrict.homeBranch, 4);
	strncpy(cardLogRec.userId, receivedMsg.cardRestrict.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardLogRec.dateTime, tmpStr, 14);

	cardLogRec.newOrUpdate = 'U';
	cardLogRec.bmUpdateStatus = '1'; /* Pending with Supervisor */
	memset(cardLogRec.supervisorId, ' ', 10);

	strncpy(cardLogRec.cardNo, receivedMsg.cardRestrict.cardNo, 19);
	cardLogRec.requestStatus = '1';

	strncpy(&cardLogRec.cardType, &cardTabRec.cardType, 374);
	strncpy(cardLogRec.coreAccNo, cardTabRec.coreAccNo, 16);
	strncpy(cardLogRec.coreCustNo, cardTabRec.coreCustNo, 8);

	if ( receivedMsg.cardRestrict.restrictOrUnrestrict == 'R' )
		cardLogRec.requestType = '7'; /* Restriction Action */
	else
		cardLogRec.requestType = '8'; /* Unrestriction Action */

	strncpy(cardLogRec.lastUpdateUser, receivedMsg.cardRestrict.userId, 10);
	strncpy(cardLogRec.lastUpdateDateTime, tmpStr, 14);
	strncpy(cardLogRec.processDateTime, cardTabRec.processDateTime, 14);

	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| [processCardRestrict] Before writing to cardLogFile (%d) ..\n", getDateTime(), PID, cardLogFile);
		fflush(logFp);
	}
	if ( isWrite(cardLogFile, &cardLogRec.liveChar) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardRestrict] : ISWRITE error %d on cbcardlog while creating a new card/update key is [%.28s] and the card # is [%.19s]\n", getDateTime(), PID, iserrno, cardLogRec.branchCode, cardLogRec.cardNo );
		fflush(logFp);
		if  ( iserrno == 100 || iserrno == 108 )
		{
			sprintf(tmpStr, "Duplicate record [%.28s]",cardLogRec.branchCode);
			formatBranchResponse(DUPLICATE, tmpStr, tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked on cbcardlog");
			formatBranchResponse( RECORD_LOCKED, tmpStr, tmpStr);
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on cbcardlog", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}
	formatBranchResponse(DONE,"Successful..", "Successful");
	sendResponse(responseMsg.customer.msgLen);
	return SUCCESS;
}

processCardDeactivate()
{
	char tmpStr[100], tAccNo[20], tCardNo[25];
	char *isLogPathName;
	int  isappLogFp ;
	long oldSigMask;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processCardDeactivate]\n", getDateTime(), PID);


	memset(responseMsg.customer.msgLen, ' ', sizeof responseMsg.customer);
	memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);

	if ( cardTabFileOpen == YES )
	{
		isclose(cardTabFile); 
		cardTabFileOpen=NO;
	}
	if ( cardLogFileOpen == YES )
	{
		isclose(cardLogFile);
		cardLogFileOpen=NO;
	}

	oldSigMask = sigblock(sigmask(SIGINT)  |      /* Interrupt  */
						  sigmask(SIGHUP)  |      /* Hangup     */
						  sigmask(SIGQUIT) |      /* Quit       */
						  sigmask(SIGPIPE) |      /* child process terminated  */
						  sigmask(SIGUSR1) |      /* user defined signal-16*/
						  sigmask(SIGUSR2) |      /* user defined signal-17*/
						  sigmask(SIGTERM) |      /* Quit       */
						  sigmask(SIGALRM) );     /* Alarm      */

	sprintf(tmpStr, "isst%d.log", getpid());
	isLogPathName = getpath(tmpStr, "log");
	if ( (isappLogFp = creat(isLogPathName, 0660)) < 0 )
	{
		perror(isLogPathName);
		fprintf(logFp, "%s|%5d|[processCardDeactivate] : Error %d while creating CISAM log file %s\n", getDateTime(), PID, errno,  isLogPathName);
		fflush(logFp);
		sprintf(tmpStr, "Error %d while creating CISAM log file ", errno);
		formatBranchResponse( INTERNALERR, tmpStr, tmpStr );
		sigsetmask(oldSigMask);
		free(isLogPathName);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}
	close(isappLogFp);
	if ( islogopen(isLogPathName) < 0 )
	{
		perror(isLogPathName);
		fprintf(logFp, "%s|%5d|[processCardDeactivate] ISLOGOPEN error %d on %s\n", getDateTime(), PID, iserrno, isLogPathName);
		fflush(logFp);
		sprintf(tmpStr, "Error %d while opening CISAM log file ", iserrno);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}
	if ( isbegin() < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardDeactivate] ISBEGIN error %d;  while Deactivating the Card \n", getDateTime(), PID, iserrno);
		sprintf(tmpStr, "ISBEGIN error %d while Deactivating the Card ", iserrno);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( openCardTabFile(ISMANULOCK+ISINOUT+ISTRANS) < 0 ) 
	{
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( openCardLogFile(ISMANULOCK+ISINOUT+ISTRANS) < 0 ) 
	{
		isclose(cardTabFile); 
		cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.cardApproval.msgLen);
		return FAILURE;
	}

	memset(&cardLogRec1.liveChar, ' ', sizeof cardLogRec);

	strncpy(cardLogRec1.cardNo, receivedMsg.cardActivate.cardNo, 19);

	isindexinfo(cardLogFile, &cardLogKey, 2);
	if( isstart(cardLogFile, &cardLogKey, 0, &cardLogRec1.liveChar,ISGTEQ) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardDeactivate] ISSTART/ISGTEQ error %d on cbcardlog for card # [%.19s]ignored..\n", getDateTime(), PID, iserrno, cardLogRec1.cardNo);
		fflush(logFp);
		fprintf(errLogFp, "%s :processCardDeactivate(): ISSTART/ISGTEQ error %d on cbcardlog for card # [%.19s]ignored..\n", getDateTime(), iserrno, cardLogRec1.cardNo);
		fflush(errLogFp);
	}

	while ( isRead(cardLogFile, &cardLogRec1.liveChar, ISNEXT) == 0 )
	{
		if ( strncmp(cardLogRec1.cardNo, receivedMsg.cardActivate.cardNo, 19) )
			break;

		if (cardLogRec1.bmUpdateStatus == '1' || cardLogRec1.bmUpdateStatus == '2')
		{
			fprintf(logFp, "%s|%5d|[processCardDeactivate] : Card # [%.19s] already in pending status [%c] in branch [%.4s] for the request [%c] ; Request User Id [%.10s]\n", getDateTime(), PID, cardLogRec1.cardNo, cardLogRec1.bmUpdateStatus, cardLogRec1.branchCode, cardLogRec1.requestType, cardLogRec1.userId);
			fflush(logFp);

			if ( cardLogRec1.bmUpdateStatus == '1' ) /* Pending with supervisor */
				sprintf(tmpStr, "Card is Pending with Supervisor of Br.Code [%.4s]", cardLogRec1.branchCode);
			else /* pending with CSO */
				sprintf(tmpStr, "Card is pending with User[%.10s];Br.[%.4s]", cardLogRec1.userId, cardLogRec1.branchCode);

			isclose(cardTabFile); isclose(cardLogFile);
			cardLogFileOpen=cardTabFileOpen=NO;
			sigsetmask(oldSigMask);
			unlink(isLogPathName);
			free(isLogPathName);
			/*formatBranchResponse(INTERNALERR, tmpStr, tmpStr);*/
			formatBranchResponse(PENDING, tmpStr, tmpStr);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
	}

	strncpy(cardTabRec.cardNo, receivedMsg.cardActivate.cardNo,19);

	isindexinfo(cardTabFile, &cardTabKey, 1);
	if( isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar,ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardDeactivate] ISSTART/ISEQUAL error %d occured on cbcardtab file for card # [%.19s]\n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
		fflush(logFp);
		if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
			 formatBranchResponse(END_OF_FILE, "No Record found for this card...", "No Record found for this card ..");
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on cbcardtab", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		isclose(cardTabFile); isclose(cardLogFile);
		cardLogFileOpen=cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( readCardTabFile(ISEQUAL) < 0 )
	{
		isclose(cardTabFile); isclose(cardLogFile);
		cardLogFileOpen=cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( strncmp(cardTabRec.processDateTime, "               ", 14) == 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardDeactivate] : Action [%c:%s] is pending for the Card no. [%.19s] from Br.Code [%.4s]\n", getDateTime(), PID, cardTabRec.requestType, cardTabRec.requestType == '0' ? "New Card" : cardTabRec.requestType == '2' ? "Force Card" : cardTabRec.requestType == '3' ? "Force Pin" : "Unknown", cardTabRec.cardNo, cardTabRec.requestBranch);
		fflush(logFp);
		isclose(cardTabFile); isclose(cardLogFile);
		cardLogFileOpen=cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sprintf(tmpStr, "Action pending; may be tried on next working day" );
		formatBranchResponse(PENDING, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( receivedMsg.cardActivate.deactivationType == 'S' )
		cardTabRec.cardStatus = '3'; /* Stolen */
	else if ( receivedMsg.cardActivate.deactivationType == 'L' )
		cardTabRec.cardStatus = '2'; /* Lost */
	else
	{
		cardTabRec.cardStatus = '9'; /* 9 is for closed , we set 9 for damaged  cards */
		cardTabRec.requestStatus = '8'; /* 8 is "Cancelled by branch" */
	}
	
	cardTabRec.requestType = '4'; /* Deactivation Request */

	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday);
	strncpy(cardTabRec.deactivationDate,tmpStr,8);
	strncpy(cardTabRec.deactivationUserId, receivedMsg.cardActivate.userId,10);

	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	/*
	strncpy(cardTabRec.requestBranch, receivedMsg.cardActivate.homeBranch, 4);
	strncpy(cardTabRec.requestUserId, receivedMsg.cardActivate.userId, 10);
	strncpy(cardTabRec.requestDateTime, tmpStr, 14);
	*/
	strncpy(cardTabRec.processDateTime, tmpStr, 14);
	strncpy(cardTabRec.lastUpdateUser, receivedMsg.cardActivate.userId, 10);
	strncpy(cardTabRec.lastUpdateDateTime, tmpStr, 14);

	if ( updateCardTabFile() < 0 )
	{
		isclose(cardTabFile); isclose(cardLogFile);
		cardLogFileOpen=cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	strncpy(pinOffset, "      ", 4);

	if ( callB24Int() == FAILURE )
	{
		isrollback();
		isclose(cardTabFile); isclose(cardLogFile);
		cardLogFileOpen=cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( strncmp(b24ReplyMsg.retStatus, "000",3) )
	{
		fprintf(logFp, "%s|%5d|[processCardDeactivate]  Error %.3s received from Base 24 interface for the card # [%.19s]\n", getDateTime(), PID, b24ReplyMsg.retStatus, cardTabRec.cardNo);
		fflush(logFp);
		sprintf(tmpStr, "Error %.3s received from Base 24 server", b24ReplyMsg.retStatus);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		isrollback();
		isclose(cardTabFile); isclose(cardLogFile);
		cardLogFileOpen=cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	/* Now, write a record in cbcardlog for history purpose */
	memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);

	cardLogRec.liveChar = '@';

	strncpy(cardLogRec.branchCode, receivedMsg.cardActivate.homeBranch, 4);
	strncpy(cardLogRec.userId, receivedMsg.cardActivate.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardLogRec.dateTime, tmpStr, 14);
	/*strncpy(cardLogRec.dateTime, cardTabRec.requestDateTime, 14);*/

	cardLogRec.newOrUpdate = 'U'; 
	cardLogRec.bmUpdateStatus = '9'; /* Completed */
	memset(cardLogRec.supervisorId, ' ', 10);

	strncpy(cardLogRec.cardNo, receivedMsg.cardActivate.cardNo, 19);
	/*cardLogRec.requestStatus = '1'; /* Approved */
	cardLogRec.requestStatus = cardTabRec.requestStatus;

	strncpy(&cardLogRec.cardType, &cardTabRec.cardType, 374);
	strncpy(cardLogRec.coreAccNo, cardTabRec.coreAccNo, 16);
	strncpy(cardLogRec.coreCustNo, cardTabRec.coreCustNo, 8);
	cardLogRec.requestType = '4'; /* DeActivated */

	strncpy(cardLogRec.lastUpdateUser, receivedMsg.cardActivate.userId, 10);
	strncpy(cardLogRec.lastUpdateDateTime, tmpStr, 14);
	strncpy(cardLogRec.processDateTime, cardTabRec.processDateTime,14);

	if ( extraDebug )
	{
		fprintf(logFp, "Before Write cbcardlog history record for the card # [%.19s].\n",cardLogRec.cardNo);
		fflush(logFp);
	}
	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| [processCardDeactivate] Before writing to cardLogFile (%d) ..\n", getDateTime(), PID, cardLogFile);
		fflush(logFp);
	}
	if ( isWrite(cardLogFile, &cardLogRec.liveChar) < 0 )
	{
		fprintf(logFp,"%s|%d|[processCardDeactivate] ISWRITE error %d on cbcardlog while creating the history record during deactivation,  key is [%.28s] and the card # is [%.19s] ignored \n", getDateTime(), PID, iserrno, cardLogRec.branchCode, cardLogRec.cardNo );
		fflush(logFp);
		fprintf(errLogFp,"%s : processCardDeactivate(): ISWRITE error %d on cbcardlog while creating the history record during deactivation,  key is [%.28s] and the card # is [%.19s] ignored \n", getDateTime(), iserrno, cardLogRec.branchCode, cardLogRec.cardNo );
		fflush(errLogFp);
	}

	if ( iscommit() < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardDeactivate]:ISCOMMIT error %d; ignored\n", getDateTime(), PID, iserrno);
		fflush(logFp);
	/* when iscommit fails; isrollback does not work; but all the update have been taken place; so it is better to ignore it at this stage
		sprintf(tmpStr, "ISCOMMIT error %d occured ", iserrno);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.customer.msgLen);
		sigsetmask(oldSigMask);
		return FAILURE;
	*/
	}
	isclose(cardLogFile); isclose(cardTabFile); 
	cardLogFileOpen=cardTabFileOpen=NO;
	islogclose();
	unlink(isLogPathName);
	free(isLogPathName);
	sigsetmask(oldSigMask);
	
	formatBranchResponse(DONE, "Successfully Deactivated", "Successfully Deactivated");
	sendResponse(responseMsg.customer.msgLen);
	return SUCCESS;
}

processCardActivate()
{
	char tmpStr[100],tAccNo[20], tCardNo[25];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processCardActivate]\n", getDateTime(), PID);


	if ( extraDebug )
	{
		fprintf(logFp, "processCardActivate() entered....\n");
		fflush(logFp);
	}

	memset(responseMsg.customer.msgLen, ' ', sizeof responseMsg.customer);
	memset(&cardLogRec1.liveChar, ' ', sizeof cardLogRec);

	strncpy(cardLogRec1.cardNo, receivedMsg.cardActivate.cardNo,19);

	isindexinfo(cardLogFile, &cardLogKey, 2);
	if( isstart(cardLogFile, &cardLogKey, 0, &cardLogRec1.liveChar,ISGTEQ) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardActivate] :ISSTART/ISGTEQ error %d on cbcardlog for card # [%.19s]ignored..\n", getDateTime(), PID, iserrno, cardLogRec1.cardNo);
		fflush(logFp);
		fprintf(errLogFp, "%s :processCardActivate(): ISSTART/ISGTEQ error %d on cbcardlog for card # [%.19s]ignored..\n", getDateTime(), iserrno, cardLogRec1.cardNo);
		fflush(errLogFp);
	}

	while ( isRead(cardLogFile, &cardLogRec1.liveChar, ISNEXT) == 0 )
	{
		if ( strncmp(cardLogRec1.cardNo, receivedMsg.cardActivate.cardNo,19) )
			break;

		if (cardLogRec1.bmUpdateStatus == '1' || cardLogRec1.bmUpdateStatus == '2')
		{
			fprintf(logFp, "%s|%5d|[processCardActivate] : Card # [%.19s] already in pending status [%c] in branch [%.4s] for the request [%c] ; Request User Id [%.10s]\n", getDateTime(), PID, cardLogRec1.cardNo, cardLogRec1.bmUpdateStatus, cardLogRec1.branchCode, cardLogRec1.requestType, cardLogRec1.userId);
			fflush(logFp);

			if ( cardLogRec1.bmUpdateStatus == '1' ) /* Pending with supervisor */
				sprintf(tmpStr, "Card is Pending with Supervisor of Br.Code [%.4s]", cardLogRec1.branchCode);
			else /* pending with CSO */
				sprintf(tmpStr, "Card is pending with User[%.10s];Br.[%.4s]", cardLogRec1.userId, cardLogRec1.branchCode);

			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
	}

	memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);

	strncpy(cardTabRec.cardNo, receivedMsg.cardActivate.cardNo,19);

	isindexinfo(cardTabFile, &cardTabKey, 1);
	if( isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar,ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardActivate] ISSTART/ISEQUAL error %d occured on cbcardtab file for card # [%.19s]\n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
		fflush(logFp);
		if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
			 formatBranchResponse(END_OF_FILE, "No Record found for this card...", "No Record found for this card ..");
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on cbcardtab", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( readCardTabFile(ISEQUAL) < 0 )
	{
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE ;
	}

	if ( strncmp(cardTabRec.processDateTime, "               ", 14) == 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardActivate] : Action [%c:%s] is pending for the Card no. [%.19s] from Br.Code [%.4s]\n", getDateTime(), PID, cardTabRec.requestType, cardTabRec.requestType == '0' ? "New Card" : cardTabRec.requestType == '2' ? "Force Card" : cardTabRec.requestType == '3' ? "Force Pin":"Unknown", cardTabRec.cardNo, cardTabRec.requestBranch);
		fflush(logFp);
		sprintf(tmpStr, "Action pending ; may be tried on next working day");
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);

	cardLogRec.liveChar = '@';

	strncpy(cardLogRec.branchCode, receivedMsg.cardActivate.homeBranch, 4);
	strncpy(cardLogRec.userId, receivedMsg.cardActivate.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardLogRec.dateTime, tmpStr, 14);

	cardLogRec.newOrUpdate = 'U';
	cardLogRec.bmUpdateStatus = '1'; /* Pending with Supervisor */
	memset(cardLogRec.supervisorId, ' ', 10);

	strncpy(cardLogRec.cardNo, receivedMsg.cardActivate.cardNo, 19);
	cardLogRec.requestStatus = '1';

	strncpy(&cardLogRec.cardType, &cardTabRec.cardType, 374);

	cardLogRec.requestType = '5'; /* Activation Action */
	strncpy(cardLogRec.lastUpdateUser, receivedMsg.cardActivate.userId, 10);
	strncpy(cardLogRec.lastUpdateDateTime, tmpStr, 14);
	strncpy(cardLogRec.processDateTime, cardTabRec.processDateTime, 14);

	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| [processCardActivate] Before writing to cardLogFile (%d) ..\n", getDateTime(), PID, cardLogFile);
		fflush(logFp);
	}
	if ( isWrite(cardLogFile, &cardLogRec.liveChar) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardActivate] ISWRITE error %d on cbcardlog while creating a new card/update key is [%.28s] and the card # is [%.19s]\n", getDateTime(), PID, iserrno, cardLogRec.branchCode, cardLogRec.cardNo );
		fflush(logFp);
		if  ( iserrno == 100 || iserrno == 108 )
		{
			sprintf(tmpStr, "Duplicate record [%.28s]",cardLogRec.branchCode);
			formatBranchResponse(DUPLICATE, tmpStr, tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked on cbcardlog");
			formatBranchResponse( RECORD_LOCKED, tmpStr, tmpStr);
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on cbcardlog", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}
	formatBranchResponse(DONE,"Successful..", "Successful");
	sendResponse(responseMsg.customer.msgLen);
	return SUCCESS;
}

processStatusUpdate()
{
	char tmpStr[100];
	int noOfRecs, i, noOfRecsUpdated=0;
	int cardLogExists = YES;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processStatusUpdate]\n", getDateTime(), PID);


	memset(responseMsg.customer.msgLen, ' ', sizeof responseMsg.customer);

	sprintf(tmpStr, "%.2s", receivedMsg.statusUpdate.noOfRecs);
	noOfRecs = atoi(tmpStr);

	memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);
	isindexinfo(cardTabFile, &cardTabKey, 1);

	strncpy(cardTabRec.cardNo, receivedMsg.statusUpdate.cardNo[0], 19);

	isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar, ISEQUAL);

	isindexinfo(cardLogFile, &cardLogKey, 1);
	isstart(cardLogFile, &cardLogKey, 0, &cardLogRec.liveChar, ISEQUAL);

	for ( i = 0 ; i < noOfRecs; i++ )
	{
		strncpy(cardTabRec.cardNo, receivedMsg.statusUpdate.cardNo[i], 19);
		if ( readCardTabFile(ISEQUAL+ISLOCK) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE ;
		}

		if ( receivedMsg.statusUpdate.cardOrPin == 'C' )
		{
			if ( strncmp(receivedMsg.statusUpdate.homeBranch, cardTabRec.deliveryBranchCode, 4) )
				continue;
		}
		else
		{
			if ( strncmp(receivedMsg.statusUpdate.homeBranch, cardTabRec.customerBranch, 4) )
				continue;
		}

		cardLogExists = YES;
		memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);
		strncpy(cardLogRec.branchCode, cardTabRec.requestBranch, 4);
		strncpy(cardLogRec.userId, cardTabRec.requestUserId, 10);
		strncpy(cardLogRec.dateTime, cardTabRec.requestDateTime, 14);
		strncpy(cardLogRec.cardNo, cardTabRec.cardNo, 19);
		if ( readCardLogFile(ISEQUAL+ISLOCK) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processStatusUpdate] Error %d on cbcardlog for the card # [%.19s] ignored since it is for history purpose..\n", getDateTime(), PID, iserrno, cardLogRec.cardNo);
			fflush(logFp);
			fprintf(errLogFp, "%s : processStatusUpdate() : ISREAD/ISEQUAL error %d on cbcardlog for the card # [%.19s] ignored since it is for history purpose..\n", getDateTime(), iserrno, cardLogRec.cardNo);
			fflush(errLogFp);
			cardLogExists = NO;
		}

		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);

		if ( receivedMsg.statusUpdate.cardOrPin == 'C' )
		{
			cardTabRec.requestStatus = receivedMsg.statusUpdate.requestStatus;
			if ( receivedMsg.statusUpdate.requestStatus == '4' )/* Card Received by branch */
			{
				strncpy(cardTabRec.cBranchReceiptDate, tmpStr,8);
				strncpy(cardTabRec.cBranchReceiptUserId, receivedMsg.statusUpdate.userId, 10);
				strncpy(cardLogRec.cBranchReceiptDate, tmpStr, 8);
				strncpy(cardLogRec.cBranchReceiptUserId, receivedMsg.statusUpdate.userId, 10);
				strncpy(cardLogRec.cBranchReceiptTime, &tmpStr[8], 6);
			}
			else if ( receivedMsg.statusUpdate.requestStatus == '5' )/* Card Issued to customer */ 
			{
				strncpy(cardTabRec.cCustIssueDate, tmpStr, 8);
				strncpy(cardTabRec.cCustIssueUserId, receivedMsg.statusUpdate.userId, 10);
				strncpy(cardLogRec.cCustIssueDate, tmpStr, 8);
				strncpy(cardLogRec.cCustIssueUserId, receivedMsg.statusUpdate.userId, 10);
				strncpy(cardLogRec.cCustIssueTime, &tmpStr[8], 6);

			}
		}
		else /* cardOrPin flag is 'P' */
		{
			cardTabRec.pinRequestStatus = receivedMsg.statusUpdate.requestStatus;
			if ( receivedMsg.statusUpdate.requestStatus == '4' )/* Pin Received by branch */
			{
				strncpy(cardTabRec.pBranchReceiptDate, tmpStr,8);
				strncpy(cardTabRec.pBranchReceiptUserId, receivedMsg.statusUpdate.userId, 10);
				strncpy(cardLogRec.pBranchReceiptDate, tmpStr,8);
				strncpy(cardLogRec.pBranchReceiptUserId, receivedMsg.statusUpdate.userId, 10);
				strncpy(cardLogRec.pBranchReceiptTime, &tmpStr[8], 6);
			}
			else if ( receivedMsg.statusUpdate.requestStatus == '5' )/* Pin Issued to customer */ 
			{
				strncpy(cardTabRec.pCustIssueDate, tmpStr, 8);
				strncpy(cardTabRec.pCustIssueUserId, receivedMsg.statusUpdate.userId, 10);
				strncpy(cardLogRec.pCustIssueDate, tmpStr, 8);
				strncpy(cardLogRec.pCustIssueUserId, receivedMsg.statusUpdate.userId, 10);
				strncpy(cardLogRec.pCustIssueTime, &tmpStr[8], 6);
			}
		}

		strncpy(cardTabRec.lastUpdateUser, receivedMsg.statusUpdate.userId, 10);
		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
		strncpy(cardTabRec.lastUpdateDateTime, tmpStr,14);

		if ( updateCardTabFile() < 0 )
		{
			isrelease(cardTabFile);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
		isrelease(cardTabFile);
		noOfRecsUpdated++;

		/* Now modify a record in cbcardlog for history purpose */

		strncpy(cardLogRec.lastUpdateUser, receivedMsg.statusUpdate.userId, 10);
		/* Commented since in history,  we are showing last update date as APPROVED date , if it changed here, approved date will 
		not be displayed correctly 
		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
		strncpy(cardLogRec.lastUpdateDateTime, tmpStr, 14);
		*/
		if ( cardLogExists == YES )
		{
			if ( isRewcurr(cardLogFile, &cardLogRec.liveChar) < 0 )
			{
				fprintf(logFp, "%s|%5d|[processStatusUpdate] : ISREWCURR error %d occured on cbcardlog while inserting a record for history purposes ignored and the key is [%.28s] [%.19s]\n", getDateTime(), PID, iserrno, cardLogRec.branchCode, cardLogRec.cardNo);
				fflush(logFp);
				fprintf(errLogFp, "%s : processStatusUpdate() : ISREWCURR error %d occured on cbcardlog while inserting a record for history purposes ignored and the key is [%.28s] [%.19s]\n", getDateTime(), iserrno, cardLogRec.branchCode, cardLogRec.cardNo);
				fflush(errLogFp);
			}
		}
		isrelease(cardLogFile);
	}
	fprintf(logFp, "No. of Cards Successfully Updated : %d\n", noOfRecsUpdated);
	fflush(logFp);
	closeAllFiles();

	formatBranchResponse(DONE, "Successfully Updated", "Successfully Updated");
	sendResponse(responseMsg.customer.msgLen);
	return SUCCESS;
}

processStatusList()
{
	char tmpStr[100];
	int lastRecRcvd, recCount=0, recsInThisMsg = 0, searchType = 0, i, nameLen;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processStatusList]\n", getDateTime(), PID);


	memset(responseMsg.statusList.msgLen, ' ', sizeof responseMsg.statusList);
	responseMsg.statusList.nullPad = '\0';
	memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);

	sprintf(tmpStr, "%.5s", receivedMsg.statusList.lastRecCount);
	lastRecRcvd = atoi(tmpStr);
	if ( receivedMsg.statusList.cardOrPin == 'C' )
	{
		isindexinfo(cardTabFile, &cardTabKey, 6 );
		cardTabRec.requestStatus = receivedMsg.statusList.requestStatus;
		/*strncpy(cardTabRec.customerBranch, receivedMsg.statusList.homeBranch, 4);*/
		strncpy(cardTabRec.deliveryBranchCode, receivedMsg.statusList.homeBranch, 4);
	}
	else
	{
		isindexinfo(cardTabFile, &cardTabKey, 7);
		cardTabRec.pinRequestStatus = receivedMsg.statusList.requestStatus; 
		strncpy(cardTabRec.customerBranch, receivedMsg.statusList.homeBranch, 4);
	}

	isstart(cardTabFile,&cardTabKey, 0, &cardTabRec.liveChar,ISGTEQ);

	while (isread(cardTabFile, &cardTabRec.liveChar, ISNEXT) == 0)
	{
		if ( receivedMsg.statusList.cardOrPin == 'C' )
		{
			if ( strncmp(cardTabRec.deliveryBranchCode, receivedMsg.statusList.homeBranch, 4) )
				break;  /* delivery branch code changes */
		}
		else /* For Pin, pin-mailer always sent to customer branch only */
		{
			if ( strncmp(cardTabRec.customerBranch, receivedMsg.statusList.homeBranch, 4) )
				break;  /* customer branch code changes */
		}

		if ( recCount++ < lastRecRcvd )
			continue; /* read all records already sent */

		if ( receivedMsg.statusList.cardOrPin == 'C' )
		{
			if ( cardTabRec.requestStatus != receivedMsg.statusList.requestStatus )
				break;
		}
		else 
		{
			if ( cardTabRec.pinRequestStatus != receivedMsg.statusList.requestStatus )
				break;
		}
		strncpy(responseMsg.statusList.details[recsInThisMsg].cardNo, cardTabRec.cardNo, 19);
		strncpy(responseMsg.statusList.details[recsInThisMsg].nameOnTheCard, cardTabRec.nameOnTheCard, 26);
		strncpy(responseMsg.statusList.details[recsInThisMsg].cardGeneratedDate,cardTabRec.cardGeneratedDate,8);
		strncpy(responseMsg.statusList.details[recsInThisMsg].issueDate, cardTabRec.firstIssueDate, 8);
		strncpy(responseMsg.statusList.details[recsInThisMsg].expireDate, cardTabRec.expireDate, 8);

		if ( ++recsInThisMsg >=  20 )
			break;
	}
	sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
	strncpy(responseMsg.statusList.lastRecCount, tmpStr, 5);
	sprintf(tmpStr, "%02d", recsInThisMsg);
	strncpy(responseMsg.statusList.noOfRecs, tmpStr, 2);
	responseMsg.statusList.details[recsInThisMsg].cardNo[0] = '\0';
	formatStatusListResponse(DONE, "Successful", "Successful");
	fflush(logFp);
	sendResponse(responseMsg.statusList.msgLen);
	return SUCCESS;
}

processForceCardGeneration()
{
	char tmpStr[100];
	int expiryYear;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processForceCardGeneration]\n", getDateTime(), PID);


	memset(responseMsg.customer.msgLen, ' ', sizeof responseMsg.customer);
	memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);
	memset(&cardLogRec1.liveChar, ' ', sizeof cardLogRec);

	strncpy(cardLogRec1.cardNo, receivedMsg.forceCard.cardNo,19);

	isindexinfo(cardLogFile, &cardLogKey, 2);
	if( isstart(cardLogFile, &cardLogKey, 0, &cardLogRec1.liveChar,ISGTEQ) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processForceCardGeneration] ISSTART/ISGTEQ error %d on cbcardlog for card # [%.19s]ignored..\n", getDateTime(), PID, iserrno, cardLogRec1.cardNo);
		fflush(logFp);
		fprintf(errLogFp, "%s :processForceCardGeneration(): ISSTART/ISGTEQ error %d on cbcardlog for card # [%.19s]ignored..\n", getDateTime(), iserrno, cardLogRec1.cardNo);
		fflush(errLogFp);
	}

	while ( isRead(cardLogFile, &cardLogRec1.liveChar, ISNEXT) == 0 )
	{
		if ( strncmp(cardLogRec1.cardNo, receivedMsg.forceCard.cardNo,19) )
			break;

		if (cardLogRec1.bmUpdateStatus == '1' || cardLogRec1.bmUpdateStatus == '2')
		{
			fprintf(logFp, "%s|%5d|[processForceCardGeneration] : Card # [%.19s] already in pending status [%c] in branch [%.4s] for the request [%c] ; Request User Id [%.10s]\n", getDateTime(), PID, cardLogRec1.cardNo, cardLogRec1.bmUpdateStatus, cardLogRec1.branchCode, cardLogRec1.requestType, cardLogRec1.userId);
			fflush(logFp);

			if ( cardLogRec1.bmUpdateStatus == '1' ) /* Pending with supervisor */
				sprintf(tmpStr, "Card is Pending with Supervisor of Br.Code [%.4s]", cardLogRec1.branchCode);
			else /* pending with CSO */
				sprintf(tmpStr, "Card is pending with UserId [%.10s] ; Br.Code [%.4s]", cardLogRec1.userId, cardLogRec1.branchCode);

			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
	}

	strncpy(cardLogRec.cardNo, receivedMsg.forceCard.cardNo,19);

	strncpy(cardLogRec.branchCode, receivedMsg.forceCard.homeBranch,4);
	strncpy(cardLogRec.userId, receivedMsg.forceCard.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardLogRec.dateTime, tmpStr, 14);

	cardLogRec.bmUpdateStatus = '1';

	memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);

	strncpy(cardTabRec.cardNo, receivedMsg.forceCard.cardNo, 19);

	isindexinfo(cardTabFile, &cardTabKey, 1);
	if( isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar,ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processForceCardGeneration] ISSTART/ISEQUAL error %d occured on cbcardtab file for card # [%.19s] \n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
		fflush(logFp);
		if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
			 formatBranchResponse(END_OF_FILE, "No Record found for this card...", "No Record found for this card ..");
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on cbcardtab", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( readCardTabFile(ISEQUAL) < 0 )
	{
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE ;
	}

	if ( cardTabRec.cardStatus != '1' && cardTabRec.cardStatus != '4' ) /* Not Active */
	{
		sprintf(tmpStr, "Card is not Active...Force Card/Pin not allowed");
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( strncmp(cardTabRec.processDateTime, "                ", 14) == 0 )
	{
		fprintf(logFp, "%s|%5d|[processForceCardGeneration] : Action [%c:%s] is pending for the Card no. [%.19s] from Br.Code [%.4s]\n", getDateTime(), PID, cardTabRec.requestType, cardTabRec.requestType == '0' ? "New Card" : cardTabRec.requestType == '2' ? "Force Card" : cardTabRec.requestType == '3' ?  "Force Pin" : "Unknown", cardTabRec.cardNo, cardTabRec.requestBranch);
		if ( cardTabRec.requestType ==  '2' ) /* Force Card Request */
		{
		 	if ( receivedMsg.forceCard.cardOrPin == 'C' )
			{
				fprintf(logFp, "%s|%5d|[processForceCardGeneration] : Card no. [%.19s] already requested for force card \n", getDateTime(), PID, cardTabRec.cardNo);
				sprintf(tmpStr, "Force Card Already Requested for this card"); 
			}
			else /* Force Pin Request */
			{
				fprintf(logFp, "%s|%5d|[processForceCardGeneration] : Force Card request is pending for this card [%.19s]\n", getDateTime(), PID, cardTabRec.cardNo);
				sprintf(tmpStr, "Force card request is pending for this card");
			}
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
		else if ( cardTabRec.requestType ==  '3' ) /* Force Pin Request */
		{
		 	if ( receivedMsg.forceCard.cardOrPin == 'P' )
			{
				fprintf(logFp, "%s|%5d|[processForceCardGeneration] : Card no. [%.19s] already requested for force pin \n", getDateTime(), PID, cardTabRec.cardNo);
				sprintf(tmpStr, "Force Pin Already Requested for this card"); 
			}
			else
			{
				fprintf(logFp, "%s|%5d|[processForceCardGeneration] : Force Pin request is pending for this card [%.19s]\n", getDateTime(), PID, cardTabRec.cardNo);
				sprintf(tmpStr, "Force pin request is pending for this card");
			}
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
		else
		{
			sprintf(tmpStr, "Action(%c) pending ; may be tried on next working day", cardTabRec.requestType);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
		fflush(logFp);
	}

	if ( receivedMsg.forceCard.cardOrPin == 'C' && strncmp(receivedMsg.forceCard.cardNo, "588848",6) == 0 && cardTabRec.cardType != 'A' )
	{
		fprintf(logFp, "%s|%5d|[processForceCardGeneration] Force card rejected for local card [%.19s] from branch [%.4s]\n", getDateTime(), PID, receivedMsg.forceCard.cardNo, receivedMsg.forceCard.homeBranch);
		fflush(logFp);
		sprintf(tmpStr, "Force card not allowed for local cards");
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	cardLogRec.liveChar = '@';

	cardLogRec.requestStatus = cardTabRec.requestStatus;

	strncpy(&cardLogRec.cardType, &cardTabRec.cardType, 374);
	if ( receivedMsg.forceCard.cardOrPin == 'C' )
	{
		if ( receivedMsg.forceCard.cardType == 'S' && cardTabRec.cardType != 'C' ) /* this condition is required to handle request from old client also except for CPS cards */
			cardLogRec.cardType = 'S';
	}

	cardLogRec.newOrUpdate = 'U';
	if ( cardTabRec.cardType != 'A' ) /* No need to check GLD for admin cards */
	{
		sprintf(tmpStr, "%.16s", cardTabRec.coreAccNo);

		if ( validateAccNo(tmpStr) == FAILURE )
		{
			sprintf(tmpStr,"Error %.5s occured while reading acct info", acctInfoResponseMsg.responseStatus);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( acctInfoResponseMsg.dormantFlag == '1' ) /* If dormant , then reject the request ; even if for central Unit, they should 
													   remove the dormant flag and then try to do this request */
		{
			fprintf(logFp, "%s|%5d|[processForceCardGeneration] Force Card/Pin request is rejected since account status is dormant  \n", getDateTime(), PID );
			fflush(logFp);
			sprintf(tmpStr,"Account Status is dormant , Request is rejected ");
			formatCardRequestResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.cardInfo.msgLen);
			return FAILURE;
		}
	}

	if ( receivedMsg.forceCard.cardOrPin == 'C' ) /* Force card */
	{
		memset(&ctlRec.liveChar, ' ', sizeof ctlRec);

		strncpy(ctlRec.recType, "BD", 2);
		strncpy(ctlRec.branchCode, acctInfoResponseMsg.branchCode, 4);

		isindexinfo(ctlFile, &ctlKey, 1);
		isstart(ctlFile, &ctlKey, 0, &ctlRec.liveChar, ISGTEQ);

		if ( isRead(ctlFile, &ctlRec.liveChar, ISEQUAL) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processForceCardGeneration] ISREAD/ISEQUAL error %d occured while reading Control File for Code No [%.6s]\n", getDateTime(), PID, iserrno,ctlRec.recType);
			fflush(logFp);
			sprintf(tmpStr, "Branch record missing for branch code [%.4s]", acctInfoResponseMsg.branchCode);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		if ( ctlRec.cardRequestFromBranch == '0' ) /* card Request rejected for the branch */
		{
			fprintf(logFp, "%s|%5d|[processForceCardGeneration] : Card Request is set as rejected (%c) in the control table for the branch [%.4s] \n", getDateTime(), PID, ctlRec.cardRequestFromBranch, ctlRec.branchCode);
			fflush(logFp);
			sprintf(tmpStr, "Card request is rejected for this branch customer");
			formatCardRequestResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.cardInfo.msgLen);
			return FAILURE;
		}

		cardLogRec.requestStatus = '0'; /* Requested */
		cardLogRec.requestType = '2'; /* Force Card */
		cardLogRec.branchCardPrdn  = 'N';
	}
	else /* Force pin */
	{
		cardLogRec.requestType = '3'; /* Force Pin */
		cardLogRec.pinRequestStatus = '0'; /* Requested */
		cardLogRec.branchPinSelect = 'N';
	}

	strncpy(cardLogRec.coreAccNo, cardTabRec.coreAccNo, 16);
	strncpy(cardLogRec.coreCustNo, cardTabRec.coreCustNo, 8);

	strncpy(cardLogRec.lastUpdateUser, receivedMsg.cardInfo.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardLogRec.lastUpdateDateTime, tmpStr, 14);
	memset(cardLogRec.filler1,' ', sizeof cardLogRec.filler1);

	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| [processForceCardGeneration] Before writing to cardLogFile (%d) ..\n", getDateTime(), PID, cardLogFile);
		fflush(logFp);
	}
	if ( isWrite(cardLogFile, &cardLogRec.liveChar) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processForceCardGeneration] : ISWRITE error %d on cbcardlog while creating a new card/update key is [%.28s] and the card # is [%.19s]\n", getDateTime(), PID, iserrno, cardLogRec.branchCode, cardLogRec.cardNo );
		fflush(logFp);
		if  ( iserrno == 100 || iserrno == 108 )
		{
			sprintf(tmpStr, "Duplicate record [%.28s]", cardLogRec.branchCode);
			formatBranchResponse(DUPLICATE, tmpStr, tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked on cbcardlog");
			formatBranchResponse( RECORD_LOCKED, tmpStr, tmpStr);
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on cbcardlog", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	strncpy(responseMsg.cardInfo.cardNo, cardLogRec.cardNo, 19);
	strncpy(responseMsg.cardInfo.dateTime, cardLogRec.dateTime, 14);

	formatCardRequestResponse(DONE, "Successful.. ...", "Successful.. ...");
    sendResponse(responseMsg.cardInfo.msgLen);
	return SUCCESS;
}

checkGldFile(char *accNo)
{
	char tAccNo[20];

	memset(&gldRec.liveChar, ' ', sizeof gldRec);

	isindexinfo(gldFile, &gldKey, 1);
	strncpy(gldRec.accNo, actualToBmAcc(accNo, tAccNo), 13);
	isstart(gldFile, &gldKey, 13, &gldRec.liveChar, ISEQUAL);

	if ( isRead(gldFile, &gldRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[checkGldFile] :ISREAD/ISEQUAL error %d occured while reading gld0data for the account no [%.14s]  [%.13s] \n", getDateTime(), PID, iserrno, accNo, gldRec.accNo );
		fflush(logFp);
		return FAILURE;
	}

	return SUCCESS;
}

processDC9000Status()
{
	char inBuf[500], tmpCardNo[25], cardNo[25], status[20], tmpStr[100], *tmpPtr;
	char *pathName;
	char cardProductionDate[20];
	char cardProductionTime[15], tmpDeliveryFlag=' ';
	int i, j, totalCardsUpdated = 0, cardLogExists = YES;

	FILE *dc9000Log, *testFp;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processDC900Status]\n", getDateTime(), PID);

	fprintf(logFp, "%s|%5d|[processDC900Status] Card production log update is configured from %s\n", getDateTime(), PID, (dcOrMxFlag=='M'?"MX6000":"DC9000"));
	fflush(logFp);

	if ( dcOrMxFlag != 'M' )
		system("cbcards.ftp"); 
	else
		system("cbcards1.ftp"); 

	if ((testFp=fopen("status.file","r")) == NULL )
	{
		fprintf(logFp, "%s|%5d|[processDC9000Status] Error %d while opening the status file transferred from DC9000\n", getDateTime(), PID, errno);
		formatBranchResponse(INTERNALERR, "Error in transferring file(s) from DC9000","Error in transferring file(s) from DC9000");
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( dcOrMxFlag == 'M' )
		pathName = getpath("mx6_atm.log", "cbcards");
	else
		pathName = getpath("dc9_atm.log", "cbcards");

	if ( (dc9000Log = fopen(pathName, "r")) == NULL )
	{
		perror(pathName);
		fprintf(logFp, "%s|%5d|[processDC9000Status] Error %d while opening %s for read\n", getDateTime(), PID, errno, pathName);
		sprintf(tmpStr,"Error %d while opening DC9000 log file ", errno );
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}
	free(pathName);

	sprintf(cardProductionDate, "%04d%02d%02d", systemDate->tm_year+1900, systemDate -> tm_mon+1, systemDate -> tm_mday);
	while ( fgets(inBuf, 500, dc9000Log) )
	{
		/* get the production date */

		if ( strncmp( inBuf, "D_StrtDate", 10 ) == 0 )
		{
			if ( strncmp(&inBuf[18] , "90", 2) > 0 )
				sprintf(tmpStr, "19%.2s%.2s%.2s", &inBuf[18], &inBuf[12], &inBuf[15]);
			else
				sprintf(tmpStr, "20%.2s%.2s%.2s", &inBuf[18], &inBuf[12], &inBuf[15]);
			if ( validate(tmpStr) >= 0 )
				sprintf(cardProductionDate, "%s", tmpStr);
			else
			{
				fprintf(logFp, "[processDC9000Status] Invalide date %s; Ignored\n", tmpStr);
				fflush(logFp);
			}
			fprintf(logFp, "[processDC9000Status] Generation Date = %s\n", cardProductionDate);
			fflush(logFp);
			continue;
		}

		if ( strncmp( inBuf, "D_StrtTime", 10 ) == 0 )
		{
			sprintf(cardProductionTime, "%.2s%.2s%.2s", &inBuf[12], &inBuf[15], &inBuf[18]);
			fprintf(logFp, "[processDC9000Status] Generation Time = %s\n", cardProductionTime);
			fflush(logFp);
			continue;
		}

		/* get the card number & status */

		if ( !isdigit(inBuf[0]) )
			continue;
		/*
		if ( isdigit(inBuf[3]) )
		{
			sprintf(tmpCardNo, "%.22s", &inBuf[3]);
			sprintf(status, "%.10s", &inBuf[85]);
		}
		else
		{
			sprintf(tmpCardNo, "%.22s", &inBuf[7]);
			if ( strncmp(tmpCardNo, "588848", 6) == 0  || strncmp(tmpCardNo,"788848",6) == 0 )
				sprintf(status, "%.10s", &inBuf[67]);
			else 
			{
				sprintf(status, "%.10s", &inBuf[85]);
				sprintf(tmpCardNo, "%.22s", &inBuf[9]);
			}
		}
		*/
		if ( (tmpPtr = strstr(inBuf, " 588848")) == NULL )
		{
			if ( (tmpPtr = strstr(inBuf, " 788848")) == NULL )
			{
				if ( (tmpPtr = strstr(inBuf, " 200030")) == NULL )
				{
					if ( (tmpPtr = strstr(inBuf, " 4550 ")) == NULL )
					{
						fprintf(logFp, "[updateDC9000Log] Read record [%.50s] does not have any valid card #\n", inBuf);
						continue;
					}
				}
			}
		}
		sprintf(tmpCardNo, "%.22s", tmpPtr);
		for( i=0, j=0; i<22; i++ )
		{
			if ( isspace(tmpCardNo[i] ) )
				continue;
			cardNo[j++] = tmpCardNo[i];
		}
		for ( ; j < 19; j++)
			cardNo[j] = ' ';
		cardNo[j] = NULL;

		/* look in for Passed or Failed */
		if ( ( tmpPtr = strstr(inBuf, "Passed")) == NULL )
		{
			if ( ( tmpPtr = strstr(inBuf, "Failed")) == NULL )
			{
				fprintf(logFp, "[processDC9000Status] Read record [%.50s] does not have any valid status #\n", inBuf);
				continue;
			}
		}
		sprintf(status, "%.10s", tmpPtr);
		/* Update the card database with production status */

		memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);
		isindexinfo(cardTabFile, &cardTabKey, 1);
		strncpy(cardTabRec.cardNo, cardNo, 19);
		if( isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar,ISEQUAL) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processDC9000Status] :ISSTART/ISEQUAL error %d occured on stcardtab file for card # [%.19s]\n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
			fflush(logFp);
			continue;
		}

		if ( isRead(cardTabFile, &cardTabRec.liveChar, ISEQUAL) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processDC9000Status] :ISREAD/ISEQUAL error %d on stcardtab while reading for card # %.19s; skipped\n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
			fflush(logFp);
			continue;
		}

		if ( strncmp(cardTabRec.processDateTime, "                   ", 14) == 0 )
		{
			fprintf(logFp, "%s|%5d|[processDC9000Status]: Card No [%.19s] is skipped since it is in pending status requested from br. [%.4s] , and the userId requested is [%.10s] and approved userId is [%.10s] for the action [%c:%s]\n", getDateTime(), PID, cardTabRec.cardNo, cardTabRec.requestBranch, cardTabRec.requestUserId, cardTabRec.lastUpdateUser, cardTabRec.requestType, cardTabRec.requestType == '0' ? "New Card" : cardTabRec.requestType == '2' ? "Force Card" : cardTabRec.requestType == '3' ?  "Force Pin" : "Unknown"); 
			fflush(logFp);
			continue;
		}

		if ( cardTabRec.requestStatus >= '3' && cardTabRec.requestStatus < '8' )
		{
			fprintf(logFp, "%s|%5d|[processDC9000Status]:Process already performed for this card %.19s with issue date  %.8s; Ignored\n", getDateTime(), PID, cardTabRec.cardNo, cardTabRec.firstIssueDate);
			fflush(logFp);
			continue;
		}
		memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);

		strncpy(cardLogRec.branchCode, cardTabRec.requestBranch, 4);
		strncpy(cardLogRec.userId, cardTabRec.requestUserId, 10);
		strncpy(cardLogRec.dateTime, cardTabRec.requestDateTime, 14);
		strncpy(cardLogRec.cardNo, cardTabRec.cardNo, 19);

		isindexinfo(cardLogFile, &cardLogKey, 1);
		isstart(cardLogFile, &cardLogKey, 0, &cardLogRec.liveChar, ISEQUAL);

		cardLogExists = YES;

		if ( readCardLogFile(ISEQUAL+ISLOCK) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processDC9000Status]: This read failure %d is ignored as it is not so critical ..\n", getDateTime(), PID, iserrno);
			fflush(logFp);
			fprintf(errLogFp, "%s: processDC9000Status() : ISREAD/ISEQUAL error %d on stcardlog for the key [%.28s] and the card # [%.19s] ;ignored \n", getDateTime(), iserrno, cardLogRec.branchCode, cardLogRec.cardNo);
			fflush(errLogFp);
			cardLogExists = NO;
		}
		if ( strncmp(status, "Passed", 6) == 0 )
		{ /* card generated successfully; Update the record in stcardlog & stcardtab*/
			/* DC9000 can failed to produce in the first instance and will retry again to produce and get successfull; so clear if it is updated earlier */
			strncpy(cardTabRec.rejectedDate, "            ", 8);
			strncpy(cardTabRec.rejectedUserId, "           ", 10);
			strncpy(cardTabRec.rejectedReason, "                      ", 20);
			cardTabRec.requestStatus='3'; /* generated at DC9000 */

			/*cardTabRec.cardStatus = '1'; /* Open */ /* Commented by Rajesh on 16th Nov 05; as the card is getting deactivated before producing the card; */
			strncpy(cardTabRec.cardGeneratedDate, cardProductionDate, 8);
			strncpy(cardTabRec.cardGeneratedUserId, receivedMsg.dc9000Status.userId, 10);
			strncpy(cardTabRec.lastUpdateUser, receivedMsg.dc9000Status.userId, 10);
			getDateTime();
			sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
			strncpy(cardTabRec.lastUpdateDateTime, tmpStr,14);
			tmpDeliveryFlag = cardTabRec.deliveryFlag;
			if ( tmpDeliveryFlag == ' ' || tmpDeliveryFlag == NULL ) /* to handle the cards requested before this enhancement */
				tmpDeliveryFlag = cardTabRec.deliveryToBranchOrPO;

			/*if ( cardTabRec.deliveryToBranchOrPO == 'P' || cardTabRec.deliveryToBranchOrPO == 'G' )*/
			if ( tmpDeliveryFlag == 'P' || tmpDeliveryFlag == 'G' )
			{
				cardTabRec.requestStatus = '5'; /* Issued to Customer */
				strncpy(cardTabRec.cCustIssueDate, tmpStr, 8);
				strncpy(cardTabRec.cCustIssueUserId, "POSTAL       ", 10);
			}
			if ( isRewcurr(cardTabFile, &cardTabRec.liveChar) < 0 )
			{
				fprintf(logFp, "%s|%5d|[processDC9000Status] :ISREWCURR Error %d on stcardtab for card # %.19s; ignored\n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
				fflush(logFp);
				fprintf(errLogFp, "%s :processDC9000Status() :ISREWCURR Error %d on stcardtab for card # %.19s; ignored\n", getDateTime(), iserrno, cardTabRec.cardNo);
				fflush(logFp);
			}
			totalCardsUpdated++;
			
			cardLogRec.requestStatus = cardTabRec.requestStatus;
			strncpy(cardLogRec.cardGeneratedDate, cardProductionDate, 8);
			strncpy(cardLogRec.cardGeneratedUserId, receivedMsg.dc9000Status.userId, 10);
			strncpy(cardLogRec.cCustIssueUserId, cardTabRec.cCustIssueUserId, 10);
			strncpy(cardLogRec.cCustIssueDate, cardTabRec.cCustIssueDate, 8);
			strncpy(cardLogRec.rejectedDate, cardTabRec.rejectedDate, 8);
			strncpy(cardLogRec.rejectedTime, "             ", 6);
			strncpy(cardLogRec.rejectedUserId, cardTabRec.rejectedUserId,10);
			strncpy(cardLogRec.rejectedReason, cardTabRec.rejectedReason, 20);
			getDateTime();
			sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
			/*if ( cardTabRec.deliveryToBranchOrPO == 'P' || cardTabRec.deliveryToBranchOrPO == 'G' )*/
			if ( tmpDeliveryFlag == 'P' || tmpDeliveryFlag == 'G' )
				strncpy(cardLogRec.cCustIssueTime, &tmpStr[8], 6);

			strncpy(cardLogRec.cardGeneratedTime, cardProductionTime, 6); 
			strncpy(cardLogRec.lastUpdateUser, receivedMsg.statusUpdate.userId, 10);
		/* Commented since in history,  we are showing last update date as APPROVED date , if it changed here, approved date will not be displayed correctly 
			getDateTime();
			sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
			strncpy(cardLogRec.lastUpdateDateTime, tmpStr, 14);
		*/

			if ( cardLogExists == YES )
			{
				if ( isRewcurr(cardLogFile, &cardLogRec.liveChar ) < 0 )
				{
					isrelease(cardLogFile);
					fprintf(logFp, "%s|%5d|[processDC9000Status] :ISREWCURR error %d while adding history record in stcardlog for card # 19s; issueDate=%.8s; key [%.28s] ignored\n", getDateTime(), PID, iserrno, cardLogRec.cardNo, cardLogRec.firstIssueDate, cardLogRec.branchCode);
					fflush(logFp);
					fprintf(errLogFp, "%s :processDC9000Status(): ISREWCURR error %d while adding history record in stcardlog for card # 19s; issueDate=%.8s; key [%.28s] ignored\n", getDateTime(), iserrno, cardLogRec.cardNo, cardLogRec.firstIssueDate, cardLogRec.branchCode);
					fflush(errLogFp);
				}
			}
			isrelease(cardLogFile);
		}
		else /* update the details as rejected by DC9000 */
		{
			strncpy(cardTabRec.rejectedDate, cardProductionDate, 8);
			if ( dcOrMxFlag == 'M' )
			{
				strncpy(cardTabRec.rejectedUserId, "MX6000       ", 10);
				strncpy(cardTabRec.rejectedReason, "MX6 unable to produce ", 20);
			}
			else
			{
				strncpy(cardTabRec.rejectedUserId, "DC9000       ", 10);
				strncpy(cardTabRec.rejectedReason, "DC9 unable to produce ", 20);
			}
			cardTabRec.requestStatus='9';
			fprintf(logFp, "%s reported it as Failed for %.19s; %.100s\n", (dcOrMxFlag=='M'?"MX6000":"DC9000"), cardTabRec.cardNo, inBuf);
			if ( isRewcurr(cardTabFile, &cardTabRec.liveChar) < 0 )
			{
				fprintf(logFp, "%s|%5d|[processDC9000Status] :Error %d while rewriting card record file for card # %.19s; ignored\n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
				fflush(logFp);
				fprintf(errLogFp, "%s :processDC9000Status(): Error %d while rewriting card record file for card # %.19s; ignored\n", getDateTime(), iserrno, cardTabRec.cardNo);
				fflush(errLogFp);
			}
			totalCardsUpdated++;

			cardLogRec.requestStatus = cardTabRec.requestStatus;
			strncpy(cardLogRec.rejectedDate, cardTabRec.rejectedDate, 8);
			strncpy(cardLogRec.rejectedUserId, cardTabRec.rejectedUserId,10);
			strncpy(cardLogRec.rejectedReason, cardTabRec.rejectedReason, 20);
			strncpy(cardLogRec.rejectedTime, cardProductionTime, 6);

			strncpy(cardLogRec.lastUpdateUser, receivedMsg.statusUpdate.userId, 10);
			/* Commented since in history,  we are showing last update date as APPROVED date , if it changed here, approved date will not be displayed correctly 
			getDateTime();
			sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
			strncpy(cardLogRec.lastUpdateDateTime, tmpStr, 14);
			*/

			if ( cardLogExists == YES )
			{
				if ( isRewcurr(cardLogFile, &cardLogRec.liveChar ) < 0 )
				{
					isrelease(cardLogFile);
					fprintf(logFp, "%s [processDC9000Status]: ISREWCURR error %d while adding history record in stcardlog for card # 19s; issueDate=%.8s; key [%.28s] ignored\n", getDateTime(), iserrno, cardLogRec.cardNo, cardLogRec.firstIssueDate, cardLogRec.branchCode);
					fflush(logFp);
					fprintf(errLogFp, "%s : processDC9000Status() :ISREWCURR error %d while adding history record in stcardlog for card # 19s; issueDate=%.8s; key [%.28s] ignored\n", getDateTime(), iserrno, cardLogRec.cardNo, cardLogRec.firstIssueDate, cardLogRec.branchCode);
					fflush(errLogFp);
				}
			}
			isrelease(cardLogFile);
			continue;
		}
	}
	fclose(dc9000Log);

	pathName = getpath(".", "cbcards");
	if ( dcOrMxFlag == 'M' )
	{
		fprintf(logFp, "%s [processDC9000Status] :Total no. of cards updated from MX6000 : %d\n", getDateTime(), totalCardsUpdated);
		sprintf(tmpStr, "%s/mxlogs/mx6_atm.log.%.8s", pathName, cardProductionDate);
		free(pathName);
		pathName = getpath("mx6_atm.log", "cbcards");
		rename(pathName, tmpStr);
	}
	else
	{
		fprintf(logFp, "%s [processDC9000Status] :Total no. of cards updated from DC9000 : %d\n", getDateTime(), totalCardsUpdated);
		sprintf(tmpStr, "%s/dclogs/dc9_atm.log.%.8s", pathName, cardProductionDate);
		free(pathName);
		pathName = getpath("dc9_atm.log", "cbcards");
		rename(pathName, tmpStr);
	}
	fflush(logFp);
	free(pathName);


	formatBranchResponse(DONE, "Successfully Updated..", "Successfully Updated..");
	sendResponse(responseMsg.customer.msgLen);
	return SUCCESS;
}

calculateHashTotal(unsigned char *recdMsg)
{
    char tmpStr[100];
    int calculatedHashTotal=0;
    int i=0, messageLength;

    if ( extraDebug > 6 )
    {
        fprintf(logFp, "%s|%5d| CalculateHashTotal() :  strlen=%d\n", getDateTime(), PID , strlen(recdMsg));
        fflush(logFp);
    }
    messageLength = strlen(recdMsg);

    for (i=0;i<messageLength-4;i++)
    {
        calculatedHashTotal += recdMsg[i];
		
        if ( extraDebug > 8 )
        {
            fprintf(logFp, "%s|%5d| CalculateHashTotal() : Hash Total [%d] ; RecdMsg[%d;%c] = [%d] \n", getDateTime(), PID, calculatedHashTotal, i, recdMsg[i], recdMsg[i]);
            fflush(logFp);
        }
		

        if ( calculatedHashTotal > 9999 )
            calculatedHashTotal -= 9999;
    }

    return (calculatedHashTotal);
}

processLogoutUser()
{
	char tmpStr[100], tmpUserId[30];
	sprintf(tmpUserId, "%-10.10s", receivedMsg.logoutUser.userId);

	memset(&userRec.liveChar, ' ', sizeof userRec);
	strncpy(userRec.userId, tmpUserId, 10);
	isindexinfo(userFile, &userKey, 1);
	if ( isstart(userFile, &userKey, 0, &userRec.liveChar, ISGTEQ) < 0 )
		fprintf(logFp, "%s|%5d|[processLogoutUser] ISSTART/ISGTEQ error %d on stuser.dat for user [%.10s]\n", getDateTime(), PID, iserrno, userRec.userId);

	if ( isRead(userFile, &userRec.liveChar, ISEQUAL+ISLOCK) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processLogoutUser] : ISREAD/ISEQUAL error %d on stuser for key=%.20s\n", getDateTime(), PID, iserrno, userRec.userId);
		fflush(logFp);
		if  ( iserrno == 111 || iserrno == 112 )
		{
			sprintf(tmpStr, "UserId [%.20s] does not exist.", userRec.userId);
			formatBranchResponse(NOT_FOUND, tmpStr, tmpStr);
		}
		else if ( iserrno = 110 )
		{
			sprintf(tmpStr, "Begining/End of file reached");
			formatBranchResponse(END_OF_FILE, tmpStr, tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked");
			formatBranchResponse(RECORD_LOCKED, tmpStr, tmpStr);
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		isrelease(userFile);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	userRec.loginStatus = '0';  /* Logout from the system */
	strncpy(userRec.loginIpAddress, "                    ", 15);

	if ( isRewcurr(userFile, &userRec.liveChar) < 0 )
	{
		fprintf(logFp, "%s|%5d| [processLogoutUser] Error %d occurred while logging out user on stuser for the user [%.10s]\n", getDateTime(), PID, iserrno, userRec.userId);
		fflush(logFp);
	}
	isrelease(userFile);

	writeSecurityLog('1', tmpUserId, "                       ", receivedMsg.logoutUser.homeBranch); /* 1 is for logout user */
	formatBranchResponse(DONE, "Successful...", "Successful...");
	sendResponse(responseMsg.customer.msgLen);
	return SUCCESS;
}

processResetPassword()
{
	char tmpStr[100], tmpStr1[50], pass1[10], pass2[10];
	char lastPasswords[200];
	char tmpUserId[30];


	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processResetPassword]\n", getDateTime(), PID);

	/* MISYS */

	sprintf(tmpStr,"Please contact HELPDESK for resetting the passowrd "); /* MISYS */
	formatBranchResponse(INTERNALERR, tmpStr, tmpStr); /* MISYS */
	sendResponse(responseMsg.customer.msgLen); /* MISYS */
	return FAILURE; /* MISYS */

	/* MISYS */

	memset(responseMsg.customer.msgLen, ' ', sizeof responseMsg.customer);
	memset(&userRec.liveChar, ' ', sizeof userRec);
	sprintf(tmpStr, "%.10s", receivedMsg.resetPassword.resetUserId);
	sprintf(tmpUserId, "%-20.20s", tmpStr);

	strncpy(userRec.userId, tmpUserId, 20);

	if ( isRead(userFile, &userRec.liveChar, ISEQUAL+ISLOCK) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processResetPassword] : ISREAD/ISEQUAL error %d on stuser for key=%.20s\n", getDateTime(), PID, iserrno, userRec.userId);
		fflush(logFp);
		if  ( iserrno == 111 || iserrno == 112 )
		{
			sprintf(tmpStr, "UserId [%.20s] does not exist.", userRec.userId);
			formatBranchResponse(NOT_FOUND, tmpStr, tmpStr);
		}
		else if ( iserrno = 110 )
		{
			sprintf(tmpStr, "Begining/End of file reached");
			formatBranchResponse(END_OF_FILE, tmpStr, tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked");
			formatBranchResponse(RECORD_LOCKED, tmpStr, tmpStr);
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		isrelease(userFile);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( strncmp(userRec.branchCode, receivedMsg.resetPassword.homeBranch, 4) )
	{
		sprintf(tmpStr,"Reset prohibited for the users of different branch");
		formatBranchResponse(INCORRECTMSG, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	
	sprintf(lastPasswords,"%.200s",userRec.last10Password);
	sprintf(tmpStr,"%.20s", userRec.password);
	storeLast10Password(lastPasswords, tmpStr);
	strncpy(userRec.last10Password,lastPasswords,200);

	sprintf(tmpStr,"%-20.20s", userRec.userId);
	sprintf(pass1, "%.8s", tmpStr);
	sprintf(pass2, "%.8s", &tmpStr[8]);
	trim(pass1);
	trim(pass2);
	sprintf(tmpStr, "%-10.10s", crypt(pass1,"AR")+2);
	sprintf(tmpStr1, "%s%-10.10s", tmpStr, crypt(pass2, "AR")+2);
	strncpy(userRec.password,tmpStr1,20);
	userRec.liveStatus = '0';

	sprintf(tmpStr, "%-10.10s", receivedMsg.resetPassword.userId);
	strncpy(userRec.lastUpdateUser, tmpStr, 10);
	strncpy(&userRec.lastUpdateUser[10],"                 ", 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(userRec.lastUpdateDateTime, tmpStr, 14);
	if ( isRewcurr(userFile, &userRec.liveChar) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processResetPassword] : ISREWCURR error %d on stuser for key=%.20s\n", getDateTime(), PID, iserrno, userRec.userId);
		fflush(logFp);
		if  ( iserrno == 100 )
		{
			sprintf(tmpStr, "Duplicate record [%.20s] on stuser", userRec.userId);
			formatBranchResponse(DUPLICATE, tmpStr, tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked on stuser", userRec.userId);
			formatBranchResponse(RECORD_LOCKED, tmpStr, tmpStr);
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on stuser", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		sendResponse(responseMsg.customer.msgLen);
		isrelease(userFile);
		return FAILURE;
	}
	isrelease(userFile);
	writeSecurityLog('5', userRec.userId, receivedMsg.resetPassword.userId, userRec.branchCode); /* 5 is for reset password */
	memcpy(&userLogRec.liveChar, &userRec.liveChar, sizeof userLogRec);
	userLogRec.newOrUpdate = 'U';

	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| [processResetPassword] Before writing to userLogFile (%d) ..\n", getDateTime(), PID, userLogFile);
		fflush(logFp);
	}
	if ( isWrite(userLogFile, &userLogRec.liveChar) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processResetPassword] : ISWRITE error %d on stuserlog for the user %.20s\n", getDateTime(), PID, iserrno, userLogRec.userId);
		fflush(logFp);
		if  ( iserrno == 100 )
		{
			sprintf(tmpStr, "Duplicate record while on stuserlog");
			formatBranchResponse(DUPLICATE, tmpStr, tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked on stuserlog" );
			formatBranchResponse(RECORD_LOCKED, tmpStr, tmpStr);
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on stuserlog", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	formatBranchResponse(DONE, "Successful...", "Successful..");
	sendResponse(responseMsg.customer.msgLen);
	return SUCCESS;
}

processCardApproval(char reqAction)
{
	char tmpStr[200], *isLogPathName;
	char tCardNo[25];
	int  isappLogFp ;
	long oldSigMask;
	int i;
	char tmpAuthLevel[150];
	char *tmpPtr;


	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processCardApproval]\n", getDateTime(), PID);

	readBankingDate();

	memset(responseMsg.cardApproval.msgLen, ' ', sizeof responseMsg.cardApproval);
	responseMsg.cardApproval.appRejectFlag = receivedMsg.cardApproval.appRejectFlag;

	/* If ForwardedToTeller or Rejected the changes; just update the log file */

	if( reqAction != SUP_ACCEPTED ) 
	{
		if ( openCardLogFile(ISMANULOCK + ISINOUT)  < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}

		/*Update cbcardlog file to include supervisorId and his comments*/

		memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);

		strncpy(cardLogRec.branchCode, receivedMsg.cardApproval.homeBranch,4);
		strncpy(cardLogRec.userId, receivedMsg.cardApproval.userId, 10);
		strncpy(cardLogRec.dateTime, receivedMsg.cardApproval.dateTime,14);
		strncpy(cardLogRec.cardNo, receivedMsg.cardApproval.cardNo,19);
		isindexinfo(cardLogFile, &cardLogKey, 1);
		if ( isstart(cardLogFile,&cardLogKey,0,&cardLogRec.liveChar,ISEQUAL) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processCardApproval]: ISSTART error %d on cbcardlog for the key [%.38s]\n", getDateTime(), PID, iserrno, cardLogRec.branchCode);
			fflush(logFp);
			if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
				 formatCardApprovalResponse(END_OF_FILE,"No card Record(s) found for this key ....", "No card Record(s) found for this key ....");
			else
			{
				sprintf(tmpStr, "CISAM Error %d occured on cbcardlog file", iserrno);
				formatCardApprovalResponse(INTERNALERR, tmpStr, tmpStr);
			}
			sendResponse(responseMsg.cardApproval.msgLen);
			return FAILURE;
		}

		if ( extraDebug )
		{
			fprintf(logFp, "branch code  : %.4s\n", receivedMsg.cardApproval.homeBranch);
			fprintf(logFp, "user Id      : %.10s\n", receivedMsg.cardApproval.userId);
			fprintf(logFp, "date Time    : %.14s\n", receivedMsg.cardApproval.dateTime);
			fprintf(logFp, "action       : %c\n", receivedMsg.cardApproval.appRejectFlag);
			fflush(logFp);
		}

		if ( readCardLogFile(ISEQUAL+ISLOCK) < 0 )
		{
			sendResponse(responseMsg.cardApproval.msgLen);
			return FAILURE;
		}

		if ( cardLogRec.bmUpdateStatus == '9' || cardLogRec.bmUpdateStatus == '3') /* Completed or Rejected */
		{
			fprintf(logFp, "%s|%5d|[processCardApproval] This card record has already been approved by %.10s\n", getDateTime(), PID, cardLogRec.supervisorId);
			fflush(logFp);
			sprintf(tmpStr," This Record has been already approved by %.10s", cardLogRec.supervisorId);
			formatCardApprovalResponse(INCORRECTMSG,tmpStr,tmpStr); 
			sendResponse(responseMsg.cardApproval.msgLen);
			return FAILURE;
		}

		if ( reqAction == SUP_FORWARD )
			cardLogRec.bmUpdateStatus = '2';  /* 2 is for Pending with Teller */
		else
		{
			cardLogRec.bmUpdateStatus = '3';  /* 3 is for Rejecting the entry */
			if ( cardLogRec.newOrUpdate == 'N' && strncmp(receivedMsg.cardApproval.cardNo,"                       ", 19) )
			{
				if ( openCardTabFile(ISMANULOCK+ISINOUT) < 0 )
				{
					sendResponse(responseMsg.cardApproval.msgLen);
					return FAILURE;
				}

				isindexinfo(cardTabFile, &cardTabKey, 1);
				memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);
				strncpy(cardTabRec.cardNo, cardLogRec.cardNo, 19);
				isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar, ISGTEQ);

				if ( readCardTabFile(ISEQUAL+ISLOCK) < 0 )
				{
					sendResponse(responseMsg.cardApproval.msgLen);
					return FAILURE;
				}

				cardTabRec.requestStatus = '9';
				cardTabRec.cardStatus = '9';
				strncpy(cardTabRec.rejectedUserId, receivedMsg.cardApproval.supervisorId, 10);
				getDateTime();
				sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
				strncpy(cardTabRec.rejectedDate, tmpStr, 8); 
				strncpy(cardTabRec.rejectedReason, "Rejected by Branch    ", 20);
				strncpy(cardTabRec.lastUpdateUser, receivedMsg.cardApproval.supervisorId, 10);
				strncpy(cardTabRec.lastUpdateDateTime, tmpStr, 14);

				if ( updateCardTabFile() < 0 )
				{
					isrelease(cardTabFile);
					sendResponse(responseMsg.cardApproval.msgLen);
					return FAILURE;
				}
				isrelease(cardTabFile);

				cardLogRec.requestStatus = cardTabRec.requestStatus;
				cardLogRec.cardStatus = cardTabRec.cardStatus;
				strncpy(cardLogRec.rejectedUserId, cardTabRec.rejectedUserId, 10);
				strncpy(cardLogRec.rejectedDate, cardTabRec.rejectedDate, 8);
				strncpy(cardLogRec.rejectedReason, cardTabRec.rejectedReason, 20);
				strncpy(cardLogRec.rejectedTime, &tmpStr[8], 6);
			}
		}

		strncpy(cardLogRec.supervisorId,receivedMsg.cardApproval.supervisorId,10);
		strncpy(cardLogRec.supervisorComments, receivedMsg.cardApproval.supervisorComments, 200);
		strncpy(cardLogRec.lastUpdateUser, receivedMsg.cardApproval.supervisorId, 10);
		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
		strncpy(cardLogRec.lastUpdateDateTime, tmpStr, 14);

		if ( updateCardLogFile() < 0 )
		{
			sendResponse(responseMsg.cardApproval.msgLen);
			return FAILURE;
		}
		closeAllFiles();
		formatCardApprovalResponse(DONE, "Successful", "Successful");
		sendResponse(responseMsg.cardApproval.msgLen);
		return SUCCESS;
	}

	/* HENCEFORTH ONLY IF SUPERVISOR APPROVES */

	/* Portion introduced for atomic update */
	if ( cardTabFileOpen == YES )
	{
		isclose(cardTabFile); 
		cardTabFileOpen=NO;
	}
	if ( cardLogFileOpen == YES )
	{
		isclose(cardLogFile);
		cardLogFileOpen=NO;
	}

	oldSigMask = sigblock(sigmask(SIGINT)  |      /* Interrupt  */
						  sigmask(SIGHUP)  |      /* Hangup     */
						  sigmask(SIGQUIT) |      /* Quit       */
						  sigmask(SIGPIPE) |      /* child process terminated  */
						  sigmask(SIGUSR1) |      /* user defined signal-16*/
						  sigmask(SIGUSR2) |      /* user defined signal-17*/
						  sigmask(SIGTERM) |      /* Quit       */
						  sigmask(SIGALRM) );     /* Alarm      */

	sprintf(tmpStr, "isst%d.log", getpid());
	isLogPathName = getpath(tmpStr, "log");
	if ( (isappLogFp = creat(isLogPathName, 0660)) < 0 )
	{
		perror(isLogPathName);
		fprintf(logFp, "%s|%5d|[processCardApproval] Error %d while creating CISAM log file %s\n", getDateTime(), PID, errno,  isLogPathName);
		fflush(logFp);
		sprintf(tmpStr, "Error %d while creating CISAM log file ", errno);
		formatCardApprovalResponse( INTERNALERR, tmpStr, tmpStr );
		sigsetmask(oldSigMask);
		free(isLogPathName);
		sendResponse(responseMsg.cardApproval.msgLen);
		return FAILURE;
	}
	close(isappLogFp);
	if ( islogopen(isLogPathName) < 0 )
	{
		perror(isLogPathName);
		fprintf(logFp, "%s|%5d|[processCardApproval] ISLOGOPEN error %d on %s\n", getDateTime(), PID, iserrno, isLogPathName);
		fflush(logFp);
		sprintf(tmpStr, "Error %d while opening CISAM log file ", iserrno);
		formatCardApprovalResponse(INTERNALERR, tmpStr, tmpStr);
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.cardApproval.msgLen);
		return FAILURE;
	}
	if ( isbegin() < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardApproval] ISBEGIN error %d;  while Card supervisor approval\n", getDateTime(), PID, iserrno);
		sprintf(tmpStr, "ISBEGIN error %d while Card supervisor approval", iserrno);
		formatCardApprovalResponse(INTERNALERR, tmpStr, tmpStr);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.cardApproval.msgLen);
		return FAILURE;
	}

	if ( openCardTabFile(ISMANULOCK+ISINOUT+ISTRANS) < 0 ) 
	{
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.cardApproval.msgLen);
		return FAILURE;
	}

	if ( openCardLogFile(ISMANULOCK+ISINOUT+ISTRANS) < 0 ) 
	{
		isclose(cardTabFile); 
		cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.cardApproval.msgLen);
		return FAILURE;
	}

	if ( openCrdFile(ISMANULOCK+ISINOUT) < 0 )
	{
		isclose(cardTabFile); isclose(cardLogFile);
		cardLogFileOpen=cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( openGldFile(ISMANULOCK+ISINOUT) < 0 )
	{
		isclose(cardTabFile); isclose(cardLogFile);
		cardLogFileOpen=cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( openCtlFile(ISMANULOCK+ISINOUT) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardApproval] Open error %d on stctltab file IGNORED...\n", getDateTime(), PID, iserrno);
		fflush(logFp);	
	}

	memset(responseMsg.cardApproval.msgLen, ' ', sizeof responseMsg.cardApproval);
	responseMsg.cardApproval.appRejectFlag = receivedMsg.cardApproval.appRejectFlag;

	memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);

	strncpy(cardLogRec.branchCode, receivedMsg.cardApproval.homeBranch,4);
	strncpy(cardLogRec.userId, receivedMsg.cardApproval.userId,10);
	strncpy(cardLogRec.dateTime, receivedMsg.cardApproval.dateTime,14);
	strncpy(cardLogRec.cardNo, receivedMsg.cardApproval.cardNo, 19);
	isindexinfo(cardLogFile, &cardLogKey, 1);
	if ( isstart(cardLogFile,&cardLogKey,0,&cardLogRec.liveChar,ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardApproval] ISSTART error %d on cbcardlog for the key [%.28s]\n", getDateTime(), PID, iserrno, cardLogRec.branchCode);
		fflush(logFp);
		if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
			 formatCardApprovalResponse(END_OF_FILE,"No card Record(s) found for this key ....", "No card Record(s) found for this key ....");
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on cbcardlog file", iserrno);
			formatCardApprovalResponse(INTERNALERR, tmpStr, tmpStr);
		}
		isclose(cardTabFile); isclose(cardLogFile);
		cardLogFileOpen=cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.cardApproval.msgLen);
		return FAILURE;
	}

	if ( readCardLogFile(ISEQUAL+ISLOCK) < 0 )
	{
		isrelease(cardLogFile);
		isclose(cardTabFile); isclose(cardLogFile);
		cardLogFileOpen=cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.cardApproval.msgLen);
		return FAILURE;
	}

	if ( cardLogRec.bmUpdateStatus == '9'  || cardLogRec.bmUpdateStatus == '3' ) /* completed or Rejected */
	{
		fprintf(logFp, "%s|%5d|[processCardApproval] :This card record has already been approved[%c] by %.10s\n", getDateTime(), PID, cardLogRec.bmUpdateStatus, cardLogRec.supervisorId);
		fflush(logFp);
		isrelease(cardLogFile);
		isclose(cardTabFile); isclose(cardLogFile);
		cardLogFileOpen=cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sprintf(tmpStr," This Record has been already approved by %.10s", cardLogRec.supervisorId);
		formatCardApprovalResponse(INCORRECTMSG,tmpStr,tmpStr); 
		sendResponse(responseMsg.cardApproval.msgLen);
		return FAILURE;
	}

	cardLogRec.bmUpdateStatus = '9';/* Completed */

	if ( receivedMsg.cardApproval.newOrUpdate == 'N' && strncmp(receivedMsg.cardApproval.cardNo, "                     ", 19) == 0 )
	{
		if ( formatCardRecord(cardLogRec.cardType, cardLogRec.newOrReplacement, cardLogRec.primaryOrSupplementary, cardLogRec.nameOnTheCard, cardLogRec.idNo) == FAILURE )
		{
			isclose(cardTabFile); isclose(cardLogFile);
			cardLogFileOpen=cardTabFileOpen=NO;
			sigsetmask(oldSigMask);
			unlink(isLogPathName);
			free(isLogPathName);
			sendResponse(responseMsg.cardApproval.msgLen);
			return FAILURE;
		}

		if ( extraDebug )
		{
			fprintf(logFp,"formatCardRecord() success\n");
			fflush(logFp);
		}

		sprintf(tCardNo, "%.19s", cardTabRec.cardNo);
		do
		{
			if ( checkExistance(tCardNo) == FAILURE )
				break;

			if ( cardLogRec.cardType == cardTabRec.cardType && cardLogRec.primaryOrSupplementary == 'P' && cardLogRec.cardType != 'A') /* check whether primary electron/intl/deposit card already exist */
			{
				if ( cardTabRec1.cardStatus != '1' && cardTabRec1.cardStatus != '4' && cardTabRec1.primaryOrSupplementary == 'P' )
				{
					if ( cardTabRec.primaryOrSupplementary == 'P' )
						cardTabRec.newOrReplacement = 'R';
				}
			}

			if ( incCard(cardTabRec.cardType, tCardNo) == FAILURE )
			{
				isclose(cardTabFile); isclose(cardLogFile);
				cardLogFileOpen=cardTabFileOpen=NO;
				sigsetmask(oldSigMask);
				unlink(isLogPathName);
				formatCardApprovalResponse(INTERNALERR, "Card Range have been exhausted..", "Card Range have been exhausted..");
				sendResponse(responseMsg.cardApproval.msgLen);
				return FAILURE;
			}
		} while(1);

		strncpy(cardTabRec.cardNo, tCardNo, 19);
		strncpy(cardLogRec.cardNo, cardTabRec.cardNo, 19);
	}
	else
	{
		memset(&cardTabRec.liveChar, ' ',sizeof cardTabRec);

		strncpy(cardTabRec.cardNo, cardLogRec.cardNo, 19);

		isindexinfo(cardTabFile, &cardTabKey, 1);
		if( isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar,ISEQUAL ) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processCardApproval] :ISSTART/ISEQUAL error %d occured on cbcardtab file for card # [%.19s]\n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
			fflush(logFp);
			if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
				 formatCardApprovalResponse(END_OF_FILE, "No Record found for this card...", "No Record found for this card ..");
			else
			{
				sprintf(tmpStr, "CISAM Error %d occured on cbcardtab", iserrno);
				formatCardApprovalResponse(INTERNALERR, tmpStr, tmpStr);
			}
			isclose(cardTabFile); isclose(cardLogFile);
			cardLogFileOpen=cardTabFileOpen=NO;
			sigsetmask(oldSigMask);
			unlink(isLogPathName);
			free(isLogPathName);
			sendResponse(responseMsg.cardApproval.msgLen);
			return FAILURE;
		}

		if ( readCardTabFile(ISEQUAL) < 0 )
		{
			isclose(cardTabFile); isclose(cardLogFile);
			cardLogFileOpen=cardTabFileOpen=NO;
			sigsetmask(oldSigMask);
			unlink(isLogPathName);
			free(isLogPathName);
			sendResponse(responseMsg.cardApproval.msgLen);
			return FAILURE ;
		}
	}
	memset(&crdRec.liveChar, ' ', sizeof crdRec);
	sprintf(tmpStr, "%.8s", cardTabRec.coreCustNo);

	if ( validateCustNo(tmpStr) ==  FAILURE )
	{
		isclose(cardTabFile); isclose(cardLogFile);
		cardLogFileOpen=cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sprintf(tmpStr,"Error %.5s occured while reading customer info", custInfoResponseMsg.responseStatus);
		formatCardApprovalResponse(NOT_FOUND, tmpStr, tmpStr);
		sendResponse(responseMsg.cardApproval.msgLen);
		return FAILURE;
	}

	/* read the account number from GL */

	memset(&gldRec.liveChar, ' ', sizeof gldRec);
	sprintf(tmpStr, "%.16s", cardTabRec.coreAccNo);

	if ( validateAccNo(tmpStr) == FAILURE )
	{
		strncpy(gldRec.branchCode, crdRec.branchCode, 4);
		gldRec.on2CardHolder = '0';
	}

	memset(tmpAuthLevel, ' ', sizeof tmpAuthLevel);
	if ( custInfoResponseMsg.packageCustFlag > '0' )
	{
		isindexinfo(userFile, &userKey, 1);
		memset(&userRec.liveChar, ' ', sizeof userRec);
		if ( isstart(userFile, &userKey, 0, &userRec.liveChar, ISGTEQ) < 0 )
			fprintf(logFp, "%s|%5d|[processCardApproval] ISSTART/ISGTEQ error %d on stuser.dat \n", getDateTime(), PID, iserrno);

		strncpy(userRec.userId, receivedMsg.cardApproval.userId, 10);
		isRead(userFile, &userRec.liveChar, ISEQUAL);

		if ( iserrno || strncmp(userRec.userId, receivedMsg.cardApproval.userId, 10) )
		{
			fprintf(logFp, "%s|%5d|[processCardApproval] : ISREAD/ISEQUAL error %d occured while reading userId [%.10s] and obtained userId from stuser [%.10s]\n", getDateTime(), PID, iserrno, receivedMsg.cardApproval.userId, userRec.userId);
			fflush(logFp);
			sprintf(tmpStr, "UserID[%.10s:%.10s] could not be read", receivedMsg.cardApproval.userId, userRec.userId);
			formatCardApprovalResponse(INTERNALERR, tmpStr, tmpStr);
			isclose(cardTabFile); isclose(cardLogFile);
			cardLogFileOpen=cardTabFileOpen=NO;
			sigsetmask(oldSigMask);
			unlink(isLogPathName);
			free(isLogPathName);
			sendResponse(responseMsg.cardApproval.msgLen);
			return FAILURE;
		}

		sprintf(tmpStr, "%.20s", userRec.authorityLevel);
		sprintf(tmpAuthLevel, "~%.2s", tmpStr);
		for (i=2; i < strlen(tmpStr); i += 2 )
			sprintf(tmpAuthLevel, "%s~%.2s", tmpAuthLevel, &tmpStr[i]);

		sprintf(tmpStr, "%.60s", userRec.authorityLevel2);
		for (i=0; i < strlen(tmpStr); i += 2 )
			sprintf(tmpAuthLevel, "%s~%.2s", tmpAuthLevel, &tmpStr[i]);
	}
		

	if ( cardLogRec.requestType == '0' ) /* Initial Card */
	{
		strncpy(cardTabRec.nameOnTheCard, cardLogRec.nameOnTheCard, 26);
		cardTabRec.languageCode = cardLogRec.languageCode;
		cardTabRec.deliveryToBranchOrPO = cardLogRec.deliveryToBranchOrPO;
		strncpy(cardTabRec.address1, cardLogRec.address1, 30);
		strncpy(cardTabRec.address2, cardLogRec.address2, 30);
		strncpy(cardTabRec.poBox, cardLogRec.poBox, 10);
		strncpy(cardTabRec.cityName, cardLogRec.cityName, 20);
		strncpy(cardTabRec.zipCode, cardLogRec.zipCode, 10);
		cardTabRec.requestStatus = '1'; /* Approved */
		cardTabRec.pinRequestStatus = '1'; /* Approved */
		memset(cardTabRec.processDateTime, ' ', sizeof cardTabRec.processDateTime);
		cardTabRec.branchCardPrdn = 'N';
		cardTabRec.branchPinSelect = 'N';
		strncpy(cardTabRec.pinOffset, cardLogRec.pinOffset, 4);
		strncpy(cardTabRec.cvv, cardLogRec.cvv, 3);
		strncpy(cardTabRec.pvv, cardLogRec.pvv, 4);
		strncpy(cardTabRec.requestBranch, cardLogRec.branchCode, 4);
		strncpy(cardTabRec.requestUserId, cardLogRec.userId, 10);
		strncpy(cardTabRec.requestDateTime, cardLogRec.dateTime, 14);
		cardTabRec.requestType = '0'; /* Initial */
		if ( strncmp(cardTabRec.customerBranch, custInfoResponseMsg.branchCode, 4) ) 
		{
			strncpy(cardTabRec.customerBranch, custInfoResponseMsg.branchCode, 4); /* When there is a change in the card, branch code from CRD 
																	 	 will be moved to STCARDTAB 
																      */ 
			if ( cardTabRec.deliveryToBranchOrPO == 'C' ) 
			{
				isindexinfo(ctlFile, &ctlKey, 1);
				isstart(ctlFile, &ctlKey, 0, &ctlRec.liveChar, ISGTEQ);
				getCtlDesc("BD", custInfoResponseMsg.branchCode);

				strncpy(&branchRec.liveChar, &ctlRec.liveChar, sizeof ctlRec);
				sprintf(tmpStr, "Branch : %.30s                        ", branchRec.englishName);
				strncpy(cardTabRec.address1, tmpStr, 30);
				sprintf(tmpStr, "(*)( )( )BR.CODE:%.3s              ", &custInfoResponseMsg.branchCode[1]);
				if ( strncmp(custInfoResponseMsg.businessType, "029", 3) == 0 || strncmp(custInfoResponseMsg.businessType, "290", 3) == 0 )
					strncpy(&tmpStr[3], "(R)", 3 );
				strncpy(cardTabRec.address2, tmpStr, 30);
				strncpy(cardTabRec.poBox, branchRec.poBox, 10);
				strncpy(cardTabRec.zipCode, branchRec.zipCode, 10);
				getCtlDesc("CT", branchRec.cityCode);
				strncpy(cardTabRec.cityName, ctlRec.englishName, 20);
			} 
		} 
			
		if ( (tmpPtr=strstr(tmpAuthLevel, "~7")) != NULL  )
			cardTabRec.requestFromClo = '1'; /* Card Requested from CLO */
		else
			cardTabRec.requestFromClo = '0'; /* Card request from branches */

	}
	else if ( cardLogRec.requestType == '5' ) /* Activation */
	{
		strncpy(cardTabRec.requestBranch, cardLogRec.branchCode, 4);
		strncpy(cardTabRec.requestUserId, cardLogRec.userId, 10);
		strncpy(cardTabRec.requestDateTime, cardLogRec.dateTime, 14);
		cardTabRec.requestType = '5'; /* Activation */
		cardTabRec.cardStatus = '1'; /* Open */
		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
		if ( strncmp(cardTabRec.processDateTime, "                   ",14) )
			strncpy(cardTabRec.processDateTime, tmpStr, 14); 
		memset(cardTabRec.deactivationDate, ' ', sizeof cardTabRec.deactivationDate);
		memset(cardTabRec.deactivationUserId, ' ', sizeof cardTabRec.deactivationUserId);

		if ( strncmp(cardTabRec.customerBranch, custInfoResponseMsg.branchCode, 4) ) 
		{
			strncpy(cardTabRec.customerBranch, custInfoResponseMsg.branchCode, 4); /* When there is a change in the card, branch code from CRD 
																	 	 will be moved to STCARDTAB 
																      */ 
			if ( cardTabRec.deliveryToBranchOrPO == 'C' ) 
			{
				isindexinfo(ctlFile, &ctlKey, 1);
				isstart(ctlFile, &ctlKey, 0, &ctlRec.liveChar, ISGTEQ);
				getCtlDesc("BD", custInfoResponseMsg.branchCode);

				strncpy(&branchRec.liveChar, &ctlRec.liveChar, sizeof ctlRec);
				sprintf(tmpStr, "Branch : %.30s                        ", branchRec.englishName);
				strncpy(cardTabRec.address1, tmpStr, 30);
				sprintf(tmpStr, "(*)( )( )BR.CODE:%.3s              ", &custInfoResponseMsg.branchCode[1]);
				if ( strncmp(custInfoResponseMsg.businessType, "029", 3) == 0 || strncmp(custInfoResponseMsg.businessType, "290", 3) == 0 )
					strncpy(&tmpStr[3], "(R)", 3 );
				strncpy(cardTabRec.address2, tmpStr, 30);
				strncpy(cardTabRec.poBox, branchRec.poBox, 10);
				strncpy(cardTabRec.zipCode, branchRec.zipCode, 10);
				getCtlDesc("CT", branchRec.cityCode);
				strncpy(cardTabRec.cityName, ctlRec.englishName, 20);
			} 
		} 
	}
	else if ( cardLogRec.requestType == '7' ) /* Restriction */
	{
		strncpy(cardTabRec.requestBranch, cardLogRec.branchCode, 4);
		strncpy(cardTabRec.requestUserId, cardLogRec.userId, 10);
		strncpy(cardTabRec.requestDateTime, cardLogRec.dateTime, 14);
		cardTabRec.requestType = '7'; /* Restriction */
		cardTabRec.cardStatus = '4'; /* Restricted */

		if ( strncmp(cardTabRec.customerBranch, custInfoResponseMsg.branchCode, 4) ) 
		{
			strncpy(cardTabRec.customerBranch, custInfoResponseMsg.branchCode, 4); /* When there is a change in the card, branch code from CRD 
																	 	 will be moved to STCARDTAB 
																      */ 
			if ( cardTabRec.deliveryToBranchOrPO == 'C' ) 
			{
				isindexinfo(ctlFile, &ctlKey, 1);
				isstart(ctlFile, &ctlKey, 0, &ctlRec.liveChar, ISGTEQ);
				getCtlDesc("BD", custInfoResponseMsg.branchCode);

				strncpy(&branchRec.liveChar, &ctlRec.liveChar, sizeof ctlRec);
				sprintf(tmpStr, "Branch : %.30s                        ", branchRec.englishName);
				strncpy(cardTabRec.address1, tmpStr, 30);
				if ( strncmp(custInfoResponseMsg.businessType, "029", 3) == 0 || strncmp(custInfoResponseMsg.businessType, "290", 3) == 0 )
					strncpy(&tmpStr[3], "(R)", 3 );
				strncpy(cardTabRec.address2, tmpStr, 30);
				strncpy(cardTabRec.poBox, branchRec.poBox, 10);
				strncpy(cardTabRec.zipCode, branchRec.zipCode, 10);
				getCtlDesc("CT", branchRec.cityCode);
				strncpy(cardTabRec.cityName, ctlRec.englishName, 20);
			} 
		} 
		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
		if ( strncmp(cardTabRec.processDateTime, "                    ", 14) )
			strncpy(cardTabRec.processDateTime, tmpStr, 14); 
	}
	else if ( cardLogRec.requestType == '8' ) /* Remove restriction */
	{
		strncpy(cardTabRec.requestBranch, cardLogRec.branchCode, 4);
		strncpy(cardTabRec.requestUserId, cardLogRec.userId, 10);
		strncpy(cardTabRec.requestDateTime, cardLogRec.dateTime, 14);
		cardTabRec.requestType = '8'; /* removed restrction */
		cardTabRec.cardStatus = '1'; /* Open */
		cardTabRec.restrictedReason = '0'; /* Required for SAMA */
		if ( strncmp(cardTabRec.customerBranch, custInfoResponseMsg.branchCode, 4) ) 
		{
			strncpy(cardTabRec.customerBranch, custInfoResponseMsg.branchCode, 4); /* When there is a change in the card, branch code from CRD 
																	 	 will be moved to STCARDTAB 
																      */ 
			if ( cardTabRec.deliveryToBranchOrPO == 'C' ) 
			{
				isindexinfo(ctlFile, &ctlKey, 1);
				isstart(ctlFile, &ctlKey, 0, &ctlRec.liveChar, ISGTEQ);
				getCtlDesc("BD", custInfoResponseMsg.branchCode);

				strncpy(&branchRec.liveChar, &ctlRec.liveChar, sizeof ctlRec);
				sprintf(tmpStr, "Branch : %.30s                        ", branchRec.englishName);
				strncpy(cardTabRec.address1, tmpStr, 30);
				sprintf(tmpStr, "(*)( )( )BR.CODE:%.3s              ", &custInfoResponseMsg.branchCode[1]);
				if ( strncmp(custInfoResponseMsg.businessType, "029", 3) == 0 || strncmp(custInfoResponseMsg.businessType, "290", 3) == 0 )
					strncpy(&tmpStr[3], "(R)", 3 );
				strncpy(cardTabRec.address2, tmpStr, 30);
				strncpy(cardTabRec.poBox, branchRec.poBox, 10);
				strncpy(cardTabRec.zipCode, branchRec.zipCode, 10);
				getCtlDesc("CT", branchRec.cityCode);
				strncpy(cardTabRec.cityName, ctlRec.englishName, 20);
			} 
		} 
		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
		if ( strncmp(cardTabRec.processDateTime, "                  ", 14) )
			strncpy(cardTabRec.processDateTime, tmpStr, 14); 
	}
	else if ( cardLogRec.requestType == '2' ) /* Force Card */
	{
		memset(cardTabRec.processDateTime,' ', sizeof cardTabRec.processDateTime);
		strncpy(cardTabRec.requestBranch, cardLogRec.branchCode, 4);
		strncpy(cardTabRec.requestUserId, cardLogRec.userId, 10);
		strncpy(cardTabRec.requestDateTime, cardLogRec.dateTime, 14);
		cardTabRec.requestStatus = '1'; /* Approved */
		cardTabRec.requestType = '2'; /* Force Card */
		memset(cardTabRec.cardGeneratedDate, ' ', 54);
		strncpy(cardTabRec.expireDate, cardLogRec.expireDate, 8);
		strncpy(cardTabRec.renewalDate, cardLogRec.renewalDate, 8);
		if ( (tmpPtr=strstr(tmpAuthLevel, "~7")) != NULL )
			cardTabRec.requestFromClo = '1'; /* Card Requested from CLO */
		else
			cardTabRec.requestFromClo = '0'; /* Card request from branches */

		strncpy(cardTabRec.oldCardNo, cardTabRec.cardNo, 19);
		strncpy(cardTabRec.oldExpiryDate, &cardTabRec.expireDate[2], 4);

		strncpy(cardLogRec.oldCardNo, cardTabRec.oldCardNo, 19);
		strncpy(cardLogRec.oldExpiryDate, cardTabRec.oldExpiryDate, 4);

		cardTabRec.branchCardPrdn = 'N';
		if ( strncmp(cardLogRec.cvv, "     ", 3) )
			strncpy(cardTabRec.cvv, cardLogRec.cvv, 3);
		if ( strncmp(cardLogRec.pvv, "       ", 4) )
			strncpy(cardTabRec.pvv, cardLogRec.pvv, 4);

		if ( strncmp(cardTabRec.pvv, "        ", 4) == 0 || cardTabRec.pvv[0] == NULL )
			strncpy(cardTabRec.pvv, "4321", 4); /* to prevent the card rejection at DC9000 */

		cardTabRec.cardType = cardLogRec.cardType; /* If user requested smart card while force card, card type needs 
													  to be changed in cbcardtab */
		if ( cardTabRec.cardType == 'V' )
		{
			if ( crdRec.packageAcc > '0' )
				cardTabRec.cardType = 'I';
		}
		if ( strncmp(cardTabRec.customerBranch, custInfoResponseMsg.branchCode, 4) ) 
		{
			strncpy(cardTabRec.customerBranch, custInfoResponseMsg.branchCode, 4); /* When there is a change in the card, branch code from CRD 
																	 	 will be moved to STCARDTAB */ 
			if ( cardTabRec.deliveryToBranchOrPO == 'C' ) /* MISYS */
			{
				isindexinfo(ctlFile, &ctlKey, 1);
				isstart(ctlFile, &ctlKey, 0, &ctlRec.liveChar, ISGTEQ);
				getCtlDesc("BD", custInfoResponseMsg.branchCode);

				strncpy(&branchRec.liveChar, &ctlRec.liveChar, sizeof ctlRec);
				sprintf(tmpStr, "Branch : %.30s                        ", branchRec.englishName);
				strncpy(cardTabRec.address1, tmpStr, 30);
				sprintf(tmpStr, "(*)( )( )BR.CODE:%.3s              ", &custInfoResponseMsg.branchCode[1]);
				if ( strncmp(custInfoResponseMsg.businessType, "029", 3) == 0 || strncmp(custInfoResponseMsg.businessType, "290", 3) == 0 )
					strncpy(&tmpStr[3], "(R)", 3 );
				strncpy(cardTabRec.address2, tmpStr, 30);
				strncpy(cardTabRec.poBox, branchRec.poBox, 10);
				strncpy(cardTabRec.zipCode, branchRec.zipCode, 10);
				getCtlDesc("CT", branchRec.cityCode);
				strncpy(cardTabRec.cityName, ctlRec.englishName, 20);
			} 
		} 
	}
	else if( cardLogRec.requestType == '3' ) /* Force Pin */
	{
		memset(cardTabRec.processDateTime,' ', sizeof cardTabRec.processDateTime);
		strncpy(cardTabRec.requestBranch, cardLogRec.branchCode, 4);
		strncpy(cardTabRec.requestUserId, cardLogRec.userId, 10);
		strncpy(cardTabRec.requestDateTime, cardLogRec.dateTime, 14);
		cardTabRec.pinRequestStatus = '1'; /* Approved */
		cardTabRec.requestType = '3'; /* Force Pin */
		memset(cardTabRec.pinGeneratedDate, ' ', 54);
		if ( (tmpPtr=strstr(tmpAuthLevel, "~7")) != NULL )
			cardTabRec.requestFromClo = '1'; /* Card Requested from CLO */
		else
			cardTabRec.requestFromClo = '0'; /* Card request from branches */

		cardTabRec.branchPinSelect = 'N';
		strncpy(cardTabRec.pinOffset, cardLogRec.pinOffset, 4);
		if ( strncmp(cardLogRec.cvv, "      ", 3) )
			strncpy(cardTabRec.cvv, cardLogRec.cvv, 3);
		if ( strncmp(cardTabRec.pvv, "      ", 4) )
			strncpy(cardTabRec.pvv, cardLogRec.pvv, 4);
		if ( strncmp(cardTabRec.customerBranch, custInfoResponseMsg.branchCode, 4) ) /* MISYS */
		{
			strncpy(cardTabRec.customerBranch, custInfoResponseMsg.branchCode, 4); /* When there is a change in the card, branch code 																					  from CRD will be moved to STCARDTAB */ 
			if ( cardTabRec.deliveryToBranchOrPO == 'C' ) 
			{
				isindexinfo(ctlFile, &ctlKey, 1);
				isstart(ctlFile, &ctlKey, 0, &ctlRec.liveChar, ISGTEQ);
				getCtlDesc("BD", custInfoResponseMsg.branchCode);

				strncpy(&branchRec.liveChar, &ctlRec.liveChar, sizeof ctlRec);
				sprintf(tmpStr, "Branch : %.30s                        ", branchRec.englishName);
				strncpy(cardTabRec.address1, tmpStr, 30);
				sprintf(tmpStr, "(*)( )( )BR.CODE:%.3s              ", &custInfoResponseMsg.branchCode[1]);

				if ( strncmp(custInfoResponseMsg.businessType, "029", 3) == 0 || strncmp(custInfoResponseMsg.businessType, "290", 3) == 0 )
					strncpy(&tmpStr[3], "(R)", 3 );
				strncpy(cardTabRec.address2, tmpStr, 30);
				strncpy(cardTabRec.poBox, branchRec.poBox, 10);
				strncpy(cardTabRec.zipCode, branchRec.zipCode, 10);
				getCtlDesc("CT", branchRec.cityCode);
				strncpy(cardTabRec.cityName, ctlRec.englishName, 20);
			} 
		} 
	}

	strncpy(cardTabRec.lastUpdateUser, receivedMsg.cardApproval.supervisorId, 10);	
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardTabRec.lastUpdateDateTime, tmpStr, 14);

	if ( receivedMsg.cardApproval.newOrUpdate == 'N' && strncmp(receivedMsg.cardApproval.cardNo, "                     ", 19) == 0 )
	{
		if ( extraDebug > 4 )
		{
			fprintf(logFp, "%s|%5d| [processCardApproval] Before writing to cardTabFile (%d) ..\n", getDateTime(), PID, cardTabFile);
			fflush(logFp);
		}
		if ( isWrite(cardTabFile, &cardTabRec.liveChar) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processCardApproval] ISWRITE error %d while writing card request into card file for card # %.19s\n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
			fflush(logFp);
			if  ( iserrno == 100 )
			{
				sprintf(tmpStr, "Duplicate record [%.19s] on cbcardtab", cardTabRec.cardNo);
				formatCardApprovalResponse(DUPLICATE, tmpStr, tmpStr);
			}
			else if ( iserrno == 107 || iserrno == 113 )
			{
				sprintf(tmpStr, "Record/File locked on cbcardtab"); 
				formatCardApprovalResponse(RECORD_LOCKED, tmpStr, tmpStr);
			}
			else
			{
				sprintf(tmpStr, "CISAM Error %d occured on cbcardtab", iserrno);
				formatCardApprovalResponse(INTERNALERR, tmpStr, tmpStr);
			}
			isrollback();
			isclose(cardTabFile); isclose(cardLogFile);
			cardLogFileOpen=cardTabFileOpen=NO;
			sigsetmask(oldSigMask);
			unlink(isLogPathName);
			free(isLogPathName);
			sendResponse(responseMsg.cardApproval.msgLen);
			return FAILURE;
		}
	}
	else
	{
		if ( updateCardTabFile() < 0 )
		{
			isrollback();
			isclose(cardTabFile); isclose(cardLogFile);
			cardLogFileOpen=cardTabFileOpen=NO;
			sigsetmask(oldSigMask);
			unlink(isLogPathName);
			free(isLogPathName);
			sendResponse(responseMsg.cardApproval.msgLen);
			return FAILURE;
		}
	}

	if (extraDebug)
	{
		fprintf(logFp, "Update cardTabFile successful...\n");
		fflush(logFp);
	}

	cardLogRec.bmUpdateStatus = '9'; /* Completed */
	cardLogRec.requestStatus = cardTabRec.requestStatus;
	strncpy(&cardLogRec.cardType, &cardTabRec.cardType, 374);
	cardLogRec.pinRequestStatus = cardTabRec.pinRequestStatus;
	strncpy(cardLogRec.processDateTime, cardTabRec.processDateTime,14);
	strncpy(cardLogRec.supervisorId, receivedMsg.cardApproval.supervisorId,10);
	strncpy(cardLogRec.lastUpdateUser, receivedMsg.cardApproval.supervisorId, 10);	
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardLogRec.lastUpdateDateTime, tmpStr, 14);

	if ( updateCardLogFile() < 0)
	{
		isrollback();
		isclose(cardTabFile); isclose(cardLogFile);
		cardLogFileOpen=cardTabFileOpen=NO;
		sigsetmask(oldSigMask);
		unlink(isLogPathName);
		free(isLogPathName);
		sendResponse(responseMsg.cardApproval.msgLen);
		return FAILURE;
	}
	isrelease(cardLogFile);


	if ( cardLogRec.requestType == '5' || cardLogRec.requestType == '7' || cardLogRec.requestType == '8' ) /* Activation/Restrict/ 
																											  Unrestrict */
	{
		strncpy(pinOffset, "      ", 4);

		if ( callB24Int() == FAILURE )
		{
			isrollback();
			isclose(cardTabFile); isclose(cardLogFile);
			cardLogFileOpen=cardTabFileOpen=NO;
			sigsetmask(oldSigMask);
			unlink(isLogPathName);
			free(isLogPathName);
			sendResponse(responseMsg.cardApproval.msgLen);
			return FAILURE;
		}

		if ( strncmp(b24ReplyMsg.retStatus, "000", 3) )
		{
			fprintf(logFp, "%s|%5d|[processCardApproval] Error %.3s received from Base 24 interface for the card # [%.19s]\n", getDateTime(), PID, b24ReplyMsg.retStatus, cardTabRec.cardNo);
			fflush(logFp);
			sprintf(tmpStr, "Error %.3s received from Base 24 server", b24ReplyMsg.retStatus);
			isrollback();
			isclose(cardTabFile); isclose(cardLogFile);
			cardLogFileOpen=cardTabFileOpen=NO;
			sigsetmask(oldSigMask);
			unlink(isLogPathName);
			free(isLogPathName);
			formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.cardApproval.msgLen);
			return FAILURE;
		}
	}

	if ( extraDebug )
	{
		fprintf(logFp, "updateCardLogFile() successful\n");
		fflush(logFp);
	}

	if ( iscommit() < 0 )
	{
		fprintf(logFp, "ISCOMMIT error %d; ignored\n", iserrno);
		fflush(logFp);
	/* when iscommit fails; isrollback does not work; but all the update have been taken place; so it is better to ignore it at this stage
		sprintf(tmpStr, "ISCOMMIT error %d occured ", iserrno);
		formatCardApprovalResponse(INTERNALERR, tmpStr, tmpStr);
		unlink(isLogPathName);
		sendResponse(responseMsg.cardApproval.msgLen);
		sigsetmask(oldSigMask);
		return FAILURE;
	*/
	}

	if ( extraDebug )
	{
		fprintf(logFp, "After iscommit()...\n");
		fflush(logFp);
	}

	isclose(cardLogFile); isclose(cardTabFile); 
	cardLogFileOpen=cardTabFileOpen=NO;
	islogclose();
	sigsetmask(oldSigMask);

	if ( extraDebug )
	{
		fprintf(logFp, "Supervisor Approval action on card successful\n");
		fflush(logFp);
	}
	strncpy(responseMsg.cardApproval.custNo, cardLogRec.coreCustNo, 8);
	strncpy(responseMsg.cardApproval.cardNo, cardTabRec.cardNo,19);
	strncpy(responseMsg.cardApproval.nameOnTheCard, cardTabRec.nameOnTheCard, 26);
	strncpy(responseMsg.cardApproval.custBranchCode, cardTabRec.customerBranch, 4);
	strncpy(responseMsg.cardApproval.cardExpiryDate, cardTabRec.expireDate, 6);
	strncpy(responseMsg.cardApproval.pinOffset, cardTabRec.pinOffset, 6);
	responseMsg.cardApproval.branchPinSelect = cardLogRec.branchPinSelect;
	responseMsg.cardApproval.branchCardPrdn  = cardLogRec.branchCardPrdn;
	getTrackInfo(cardTabRec.cvv, cardTabRec.pvv);
	strncpy(responseMsg.cardApproval.trk1, trk1, 75);
	strncpy(responseMsg.cardApproval.trk2, trk2, 37);

	closeAllFiles();
	unlink(isLogPathName);
	free(isLogPathName);
	formatCardApprovalResponse(DONE, "Successful", "Successful");
	sendResponse(responseMsg.cardApproval.msgLen);
	return SUCCESS;
}

callB24Int()
{
	struct msqid_ds queueStatus;
	int msgid, msgid1, pid, noOfBytes;
	char tmpStr[100], idType=' ';
	char  GLStatus='1';

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[callB24Int]\n", getDateTime(), PID);

	if ( openCbCtlFile(ISMANULOCK+ISINOUT) < 0 )
	{
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( cardTabRec.cardType != 'A' )
	{
		/* Read the corresponding account from GL */

		sprintf(tmpStr, "%.16s", cardTabRec.coreAccNo);
		if ( validateAccNo(tmpStr) == FAILURE )
		{
			sprintf(tmpStr,"Error %.5s occured while reading acct info", acctInfoResponseMsg.responseStatus);
			formatPrintCardResponse(NOT_FOUND, tmpStr, tmpStr);
			return FAILURE;
		}
	}
	else
		strncpy(acctInfoResponseMsg.branchCode, cardTabRec.customerBranch, 4);

	if ( (msgid = msgget(b24Key1, 0777)) < 0 )
	{
		if ( errno == 2 )
		{
			fprintf(logFp, "%s|%5d|[callB24Int] : B24 Interface Server not available\n", getDateTime(), PID);
			sprintf(tmpStr, "B24 Interface server not available..");
			formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr); 
			return FAILURE;
		}
		fprintf(logFp, "%s|%5d|[callB24Int] : Error %d (%s) while getting message queue id\n", getDateTime(), PID, errno, strerror(errno));
		sprintf(tmpStr, "Error %d  while getting message queue id", errno);
		formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}

	if ( (msgid1 = msgget(b24Key2, 0777)) < 0 )
	{
		if ( errno == 2 )
		{
			fprintf(logFp, "%s|%5d|[callB24Int] B24 Interface Server not available \n", getDateTime(), PID);
			sprintf(tmpStr, "B24 Interface server not available..");
			formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr); 
			return FAILURE;
		}
		fprintf(logFp, "%s|%5d|[callB24Int] Error %d (%s) while getting message queue id\n", getDateTime(), PID, errno, strerror(errno));
		sprintf(tmpStr, "Error %d while getting message queue id", errno);
		formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}

	pid = getpid();
	sprintf(tmpStr, "%06d", pid);
	memset(&b24RequestMsg.mtype, ' ', sizeof b24RequestMsg);
	b24RequestMsg.mtype = pid;
	if ( cardTabRec.requestType == '0' ) /* Initial */
		b24RequestMsg.action = '0'; /* New card */
	else
		b24RequestMsg.action = '1'; /* Caf Update */

	strncpy(b24RequestMsg.cardNo, cardTabRec.cardNo, 19);
	if ( cardTabRec.requestType  == '0' || cardTabRec.requestType == '3' )
		strncpy(b24RequestMsg.pinOffset, pinOffset, 4);
	if ( cardTabRec.requestType == '0' )
		b24RequestMsg.cardStatus = '1'; /* Open */
	else
		b24RequestMsg.cardStatus = cardTabRec.cardStatus;
	strncpy(b24RequestMsg.branchCode, acctInfoResponseMsg.branchCode, 4);
	strncpy(b24RequestMsg.expiryDate, &cardTabRec.expireDate[2], 4);
	b24RequestMsg.restrictedReason = cardTabRec.restrictedReason;

	memset(&crdRec.liveChar, ' ', sizeof crdRec);
	sprintf(tmpStr, "%.8s", cardTabRec.coreCustNo);

	if ( validateCustNo(tmpStr) ==  FAILURE )
	{
		sprintf(tmpStr,"Error %.5s occured while reading customer info", custInfoResponseMsg.responseStatus);
		formatPrintCardResponse(NOT_FOUND, tmpStr, tmpStr);
		return FAILURE;
	}
	b24RequestMsg.packageAcc = custInfoResponseMsg.packageCustFlag;

	/* define the card type */
	if ( cardTabRec.cardType == 'A' )
		strncpy(b24RequestMsg.cardType, "AD", 2);  /* Administrative cards */
	else if ( cardTabRec.cardType == 'D' )
		strncpy(b24RequestMsg.cardType, "BD", 2);  /* Business deposit only card */
	else if ( cardTabRec.cardType == 'V' )
		strncpy(b24RequestMsg.cardType, "P4", 2); /* Electron Int'l VIP card */
	else if ( (cardTabRec.cardType == 'I' || cardTabRec.cardType == 'S') && custInfoResponseMsg.packageCustFlag >= '1' ) /* Electron Int'l */
	{
		if ( custInfoResponseMsg.packageCustFlag == '1' )
			strncpy(b24RequestMsg.cardType, "P7", 2); /* Munafa cards */
		else if ( custInfoResponseMsg.packageCustFlag == '2' )
			strncpy(b24RequestMsg.cardType, "P8", 2); /* Wahat(Gold) cards */
		else if ( custInfoResponseMsg.packageCustFlag == '3' )
			strncpy(b24RequestMsg.cardType, "P9", 2); /* Alsafwah(Platinium) cards */
		else if ( custInfoResponseMsg.packageCustFlag == '4' )
			strncpy(b24RequestMsg.cardType, "PA", 2); /* Hisab(Islamic) cards */
		else if ( custInfoResponseMsg.packageCustFlag == 'P' )
			strncpy(b24RequestMsg.cardType, "PB", 2); /* Private Banking cards */
		else if ( custInfoResponseMsg.packageCustFlag >= 'A' && custInfoResponseMsg.packageCustFlag <= 'Z' )
		{
			sprintf(tmpStr, "H%c", custInfoResponseMsg.packageCustFlag);
			strncpy(b24RequestMsg.cardType, tmpStr, 2);
		}
		else
			strncpy(b24RequestMsg.cardType, "P3", 2);  /* Unclassified international card*/
	}
	else if ( cardTabRec.cardType == 'C' )
		strncpy(b24RequestMsg.cardType, "P2", 2); /* CPS customer cards */
	else if ( strncmp(custInfoResponseMsg.businessType, "A0029", 5) == 0 || 
		      strncmp(custInfoResponseMsg.businessType, "A0290", 5) == 0 ) /*pensioners */
		strncpy(b24RequestMsg.cardType, "P1", 2); /* ANB pensioners card */
	else if ( strncmp(custInfoResponseMsg.businessType, "A0266", 5) == 0 ) /*ANB Staff */
		strncpy(b24RequestMsg.cardType, "P5", 2); /* ANB staff */
	else if ( cardTabRec.cardType == 'R' || cardTabRec.cardType == 'L' )
		strncpy(b24RequestMsg.cardType, "P ", 2);  /* unclassified local cards */
	else 
		strncpy(b24RequestMsg.cardType, "P3", 2);  /* Unclassified international card*/

	/* The following 4 lines were added for Opportunity Management project by Rajesh on 26th jan 2007 */

	b24RequestMsg.primaryOrSupplementary = cardTabRec.primaryOrSupplementary;

	strncpy(b24RequestMsg.custNo, cardTabRec.coreCustNo, 8);
	strncpy(b24RequestMsg.idNo, custInfoResponseMsg.idNo, 15);

	memset(&cbCtlTabRec.liveChar, ' ', sizeof cbCtlTabRec);
	strncpy(cbCtlTabRec.englishName, custInfoResponseMsg.idType, 30);
	isindexinfo(cbCtlTabFile, &cbCtlTabKey, 3);
	isstart(cbCtlTabFile, &cbCtlTabKey, 0, &cbCtlTabRec.liveChar, ISGTEQ);

	idType = custInfoResponseMsg.idType[0]; 

	while ( isRead(cbCtlTabFile, &cbCtlTabRec.liveChar, ISNEXT) ==  0 )
	{
		if ( strncmp(cbCtlTabRec.englishName, custInfoResponseMsg.idType, 30) )
			break;
		
		if ( strncmp(cbCtlTabRec.recType, "ID", 2) )
			continue;

		idType =  cbCtlTabRec.ctlCode[0];
	}

	/*
	fprintf(logFp, "%s|%5d|[callB24Int] ISREAD/ISEQUAL error %d on cbctltab for the english name [%.30s] IGNORED \n", getDateTime(), PID, iserrno, custInfoResponseMsg.idType);
	fflush(logfp);
	*/

	/*b24RequestMsg.idType =  custInfoResponseMsg.idType[0];*/
	b24RequestMsg.idType =  idType;

	/* The following portions were added for EMV(Chip card) enhancement */
	strncpy(b24RequestMsg.accLimit, "9999", 4);

	if ( cardTabRec.cardType == 'S' || cardTabRec.cardType == 'L' ) /* Smart card or local chip card */
	{
		if( cardTabRec.cardStatus == '2' || cardTabRec.cardStatus == '3' ||
			cardTabRec.cardStatus == '9' )
			b24RequestMsg.sendCardBlk = 'Y';
		else
			b24RequestMsg.sendCardBlk = 'N';

		if( cardTabRec.requestType ==  '0' &&  
		   (cardTabRec.cardStatus == '0' || cardTabRec.cardStatus == '1') ) 
		{
			b24RequestMsg.sendPutData = 'N';
			strncpy(b24RequestMsg.lowerConsLimit, "0000", 4);
		}

		if( strncmp(cardTabRec.pinOffset, "          ", 4) == 0 )
		{
			b24RequestMsg.sendPinUnBlock = '0';
			b24RequestMsg.sendPinChange = '0';
		}
		else 
		{
			if( cardTabRec.requestType == '0' && 
			   (cardTabRec.cardStatus == '0' || cardTabRec.cardStatus == '1'))
			{
				b24RequestMsg.sendPinUnBlock = emvValue1;
				b24RequestMsg.sendPinChange = emvValue3;
			}
			else
			{
				b24RequestMsg.sendPinUnBlock = emvValue2;
				b24RequestMsg.sendPinChange = emvValue4;
			}
		}
		b24RequestMsg.pinSyncAct = '1';
		if( cardTabRec.requestType == '0' && 
		  (cardTabRec.cardStatus == '0' || cardTabRec.cardStatus == '1'))
		{
			b24RequestMsg.accScriptMgt = emvValue5;
			b24RequestMsg.issApplDataFrmt = emvValue6;
			b24RequestMsg.actTblIndex = emvValue7;
		}
	}
	else /*other cards*/
	{
		b24RequestMsg.sendCardBlk = 'N';
		b24RequestMsg.sendPutData = 'N';
		strncpy(b24RequestMsg.lowerConsLimit, "0000", 4);
		b24RequestMsg.sendPinUnBlock = '0';
		b24RequestMsg.sendPinChange = '0';
		b24RequestMsg.pinSyncAct = '0';
	}
	/* EMV enhancement ends here */

	strncpy(b24RequestMsg.atmAccNo, cardTabRec.coreAccNo, 16);
	b24RequestMsg.atmAccStatus = '1'; 
	strncpy(b24RequestMsg.atmAccDesc, "CURRENT ACCOUNT", 10);

	if ( cardTabRec.cardType != 'A' )
	{
		GLStatus=((acctInfoResponseMsg.accStatus=='0')?'1':
			(acctInfoResponseMsg.accStatus <= '3')?'9':
			(acctInfoResponseMsg.accStatus <= '5')?'2':
			(acctInfoResponseMsg.accStatus <= '8')?'1':'9');
		
		/* Make dormant account deposit only in CAF; Mail from Kamel on 02/08/98*/
		if ( GLStatus == '1' )
			if ( acctInfoResponseMsg.dormantFlag == '1' )
				GLStatus = '2';
		/*
		GLStatus=((acctInfoResponseMsg.accStatus=='A')?'1':
			(acctInfoResponseMsg.accStatus == 'I')?'9':' ');
		
		/* Make dormant account deposit only in CAF; Mail from Kamel on 02/08/98*
		if ( GLStatus == '1' )
			if ( acctInfoResponseMsg.accStatus == 'D' )
				GLStatus = '2';
		*/
		b24RequestMsg.atmAccStatus =  GLStatus; 
		strncpy(b24RequestMsg.atmAccDesc, "CURRENT ACCOUNT", 10);
	}
	else /* For admin cards */
	{
		b24RequestMsg.atmAccStatus = '1'; 
		strncpy(b24RequestMsg.atmAccDesc, "CURRENT ACCOUNT", 10);
	}

	fprintf(logFp, "%s|%5d|[callB24Int] Send to B24 Interface Server : [%s]\n", getDateTime(), PID, &b24RequestMsg.action);
	fflush(logFp);
	if ( msgsnd(msgid, &b24RequestMsg, strlen(&b24RequestMsg.action), 0) < 0 )
	{
		fprintf(logFp, "%s|%5d|[callB24Int] Error %d (%s) while sending message to B24 queues\n", getDateTime(), PID, errno, strerror(errno));
		sprintf(tmpStr, "Error %d while sending message to B24 queues", errno);
		formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}
	msgctl(msgid, IPC_STAT, &queueStatus);
	fprintf(logFp, "B24 Queue size=%d\n", queueStatus.msg_qnum);
	fflush(logFp);
	if ( (noOfBytes = msgrcv(msgid1, &b24ReplyMsg, sizeof(b24ReplyMsg), pid, 0)) < 0 )
	{
		fprintf(logFp, "%s|%5d|[callB24Int] Error %d (%s) while receving message from B24 queues\n", getDateTime(), PID, errno, strerror(errno));
		fflush(logFp);
		sprintf(tmpStr, "Error %d while receving message from B24 queues", errno);
		formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}
	fprintf(logFp, "%s|%5d|[callB24Int] : Number of bytes received from B24 server = %d; error=%d\n", getDateTime(), PID, noOfBytes, errno);
	fprintf(logFp, "%s|%5d|[callB24Int] : Msg received from B24 server = %s\n", getDateTime(), PID, b24ReplyMsg.cardNo);
	fflush(logFp);

	return SUCCESS;
}

callHsmInt(char *clearPin, char requestType)
{
	struct msqid_ds queueStatus;
	int msgid, msgid1, pid, noOfBytes;
	char tmpStr[100];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[callHsmInt]\n", getDateTime(), PID);


	if ( (msgid = msgget(hsmKey1, 0777)) < 0 )
	{
		if ( errno == 2 )
		{
			fprintf(logFp, "%s|%5d|[callHsmInt] HSM Interface Server not available\n", getDateTime(), PID);
			sprintf(tmpStr, "HSM Interface server not available..");
			formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr); 
			return FAILURE;
		}
		fprintf(logFp, "%s|%5d|[callHsmInt] Error %d (%s) while getting HSM message queue id\n", getDateTime(), PID, errno, strerror(errno));
		sprintf(tmpStr, "Error %d  while getting HSM message queue id", errno);
		formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}

	if ( (msgid1 = msgget(hsmKey2, 0777)) < 0 )
	{
		if ( errno == 2 )
		{
			fprintf(logFp, "%s|%5d|[callHsmInt] HSM Interface Server not available \n", getDateTime(), PID);
			sprintf(tmpStr, "HSM Interface server not available..");
			formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr); 
			return FAILURE;
		}
		fprintf(logFp, "%s|%5d|[callHsmInt] Error %d (%s) while getting HSM message queue id\n", getDateTime(), PID, errno, strerror(errno));
		sprintf(tmpStr, "Error %d while getting HSM message queue id", errno);
		formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}

	pid = getpid();
	sprintf(tmpStr, "%06d", pid);
	memset(&hsmRequestMsg.mtype, ' ', sizeof hsmRequestMsg);
	hsmRequestMsg.mtype = pid;
	strncpy(hsmRequestMsg.cardNo, cardTabRec.cardNo, 19);
	strncpy(hsmRequestMsg.expiryDate, cardTabRec.expireDate, 8);
	memset(hsmRequestMsg.branchEncryptedPin, ' ', sizeof hsmRequestMsg.branchEncryptedPin);
	strncpy(hsmRequestMsg.branchEncryptedPin, clearPin, 4);
	hsmRequestMsg.requestType = requestType;
	hsmRequestMsg.nullPad = '\0';

	if ( msgsnd(msgid, &hsmRequestMsg, strlen(hsmRequestMsg.cardNo), 0) < 0 )
	{
		fprintf(logFp, "%s|%5d|[callHsmInt] Error %d (%s) while sending message to HSM queues\n", getDateTime(), PID, errno, strerror(errno));
		sprintf(tmpStr, "Error %d while sending message to HSM queues", errno);
		formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}

	msgctl(msgid, IPC_STAT, &queueStatus);
	fprintf(logFp, "HSM Queue size=%d\n", queueStatus.msg_qnum);
	fflush(logFp);
	if ( (noOfBytes = msgrcv(msgid1, &hsmReplyMsg, sizeof(hsmReplyMsg), pid, 0)) < 0 )
	{
		fprintf(logFp, "%s|%5d|[callHsmInt] Error %d (%s) while receving message from HSM queues\n", getDateTime(), PID, errno, strerror(errno));
		fflush(logFp);
		sprintf(tmpStr, "Error %d while receving message from HSM queues", errno);
		formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}
	fprintf(logFp, "%s|%5d|[callHsmInt]: Number of bytes received from HSM server = %d; error=%d\n", getDateTime(), PID, noOfBytes, errno);
	fprintf(logFp, "%s|%5d|[callHsmInt]: Client : Msg received from HSM server = %s\n", getDateTime(), PID, hsmReplyMsg.cardNo);
	fflush(logFp);

	strncpy(pinOffset, hsmReplyMsg.pinOffset, 4);
	if ( strncmp(hsmReplyMsg.retStatus, "00", 2) )
	{
		fprintf(logFp, " %s|%5d|[callHsmInt] Error %.2s received from HSM server for the card # [%.19s] \n", getDateTime(), PID, hsmReplyMsg.retStatus, hsmRequestMsg.cardNo);
		fflush(logFp);
		sprintf(tmpStr, "Error %.2s received from HSM server", hsmReplyMsg.retStatus);
		formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}

	return SUCCESS;
}

getTrackInfo(char *cvv, char *pvv)
{
	char tmpStr[200], ans[10];
	struct track1Info
	{
		char  trk1Pan[19];       	/*   pic x(19).*/
		char  trk1Fs1;         		/* pic x(01)   value "^".*/
		char  trk1City[3];        	/*  pic x(03)   value "001".*/
		char  trk1Name[26];         /* pic x(26).*/
		char  trk1Fs2;         		/* pic x(01)   value "^".*/
		char  trk1ExpYear[2];     	/*  pic 9(02).*/
		char  trk1ExpMonth[2];      /* pic 9(02).*/
		char  trk1Ide;         		/* pic 9(01)   value 1.*/
		char  trk1Scd[2];        	/*  pic 9(02)   value 26.*/
		char  trk1Pvki;        		/* pic 9(01)   value 6.*/
		char  trk1Pvv[4];        	/*  pic x(04)   value zeros.*/
		char  filler7[5];           /* pic x(05)   value zeros.*/
		char  trk1Cvv[3];         	/* pic x(03).*/
		char  filler8[5];          	/* pic x(05)   value zeros.*/
		char  trk1Es[2];          	/* pic x(02)   value "? ".      */
	}trk1Rec;

	struct visaTrk1Info
	{
		char  trk1Pan[16];      			/* pic x(16).           */
		char  trk1Fs1;         			/* pic x(01)   value "^".*/
		char  trk1Name[26];    			/* pic x(26).           */
		char  trk1Fs2;         			/* pic x(01)   value "^".*/
		char  trk1ExpiryYear[2];      	/* pic 9(02).         */
		char  trk1ExpiryMonth[2];      	/* pic 9(02).          */
		char  trk1Ide;         			/* pic 9(01)   value 1.*/
		char  trk1Scd[2];         		/* pic 9(02)   value 26.*/
		char  trk1Pvki;        			/* pic 9(01)   value 6.*/
		char  trk1Pvv[4];         		/* pic x(04)   value zeros.*/
		char  filler7[5];              	/* pic x(05)   value zeros.*/
		char  trk1Cvv[3];         		/*pic x(03).              */
		char  filler8[2];          		/*pic x(02)   value zeros.*/
		char  trk1Cvv2[3];        		/*pic x(03).             */
		char  filler9[6];               /*pic x(06)   value zeros.*/
		char  trk1Es[2];          		/*pic x(02)   value "? ".*/
	}visaTrk1Rec;

	struct track2Info
	{
		char  trk2Pan[19];     	  	/*   pic x(19).*/
		char  trk2Fs;          		/* pic x(01)   value "=".*/
		char  trk2ExpYear[2];     	/*  pic 9(02).*/
		char  trk2ExpMonth[2];      /* pic 9(02).*/
		char  trk2Ide;         		/* pic 9(01)   value 1.*/
		char  trk2Scd[2];        	/*  pic 9(02)   value 26.*/
		char  trk2Pvki;        		/* pic 9(01)   value 6.*/
		char  trk2Pvv[4];      		/*  pic x(04)   value zeros.*/
		char  trk2Cvv[3];         	/* pic x(03).*/
		char  filler9;           	/* pic x(01)   value "0".*/
		char  trk2Lan;         		/* pic 9(01).*/
	}trk2Rec;

	struct visaTrack2Info
	{
		char  trk2Ss;          			/*pic x(01)   value ";". */
		char  trk2Pan[16];         		/*pic x(16).            */
		char  trk2Fs;          			/*pic x(01)   value "=".*/
		char  trk2ExpiryYear[2];      	/*pic 9(02).           */
		char  trk2ExpiryMonth[2];      	/*pic 9(02).          */
		char  trk2Ide;         			/*pic 9(01)   value 1.*/
		char  trk2Scd[2];         		/*pic 9(02)   value 26.*/
		char  trk2Pvki;        			/*pic 9(01)   value 6.*/
		char  trk2Pvv[4];         		/*pic x(04)   value zeros.*/
		char  trk2Cvv[3];         		/*pic x(03).             */
		char  filler10[4];              /*pic x(04)   value zeros.*/
		char  trk2Lan;         			/*pic 9(01).*/
		char  trk2Es;          			/*pic x(01)   value "?".*/
	}visaTrk2Rec;


	if ( strncmp(pvv, "        ", 4) == 0 )
		strncpy(pvv, "1234", 4);

	if ( strncmp(cardTabRec.cardNo, "455036", 6) == 0 ) /* International card */
	{ /* can have the card type (I)nternational or (V)ip */
		strncpy(visaTrk1Rec.trk1Pan, cardTabRec.cardNo, 16);
		visaTrk1Rec.trk1Fs1='^';
		strncpy(visaTrk1Rec.trk1Name, cardTabRec.nameOnTheCard, 26);
		visaTrk1Rec.trk1Fs2='^';
		strncpy(visaTrk1Rec.trk1ExpiryYear, &cardTabRec.expireDate[2], 2);
		strncpy(visaTrk1Rec.trk1ExpiryMonth, &cardTabRec.expireDate[4], 2);
		visaTrk1Rec.trk1Ide='1';
		strncpy(visaTrk1Rec.trk1Scd, "26", 2);/* changed to 26 from 20 as per Mr.Hisham's mail to Mr.Arul dt.29/09/2001*/
		visaTrk1Rec.trk1Pvki='6';
		strncpy(visaTrk1Rec.trk1Pvv, pvv, 4);
		strncpy(visaTrk1Rec.filler7, "00000", 5);
		strncpy(visaTrk1Rec.trk1Cvv, cvv, 3);
		strncpy(visaTrk1Rec.filler8, "00", 2);
		strncpy(visaTrk1Rec.trk1Cvv2, cvv, 3);
		strncpy(visaTrk1Rec.filler9, "000000", 6);

		visaTrk2Rec.trk2Ss = ';';
		strncpy(visaTrk2Rec.trk2Pan, cardTabRec.cardNo, 16);
		visaTrk2Rec.trk2Fs = '=';
		strncpy(visaTrk2Rec.trk2ExpiryYear, &cardTabRec.expireDate[2], 2);
		strncpy(visaTrk2Rec.trk2ExpiryMonth, &cardTabRec.expireDate[4], 2);
		visaTrk2Rec.trk2Ide = '1';
		strncpy(visaTrk2Rec.trk2Scd, "26", 2);/* Changed to 26 from 20 as per Mr.Hisham's mail to Mr.Arul dt.29/09/2001*/
		visaTrk2Rec.trk2Pvki='6';
		strncpy(visaTrk2Rec.trk2Pvv, pvv, 4);
		strncpy(visaTrk2Rec.trk2Cvv, cvv, 3);
		strncpy(visaTrk2Rec.filler10, "0000", 4);
		if ( cardTabRec.languageCode == '1' )
			visaTrk2Rec.trk2Lan = '1'; /* ENGLISH for ATM*/ 
		else if ( cardTabRec.languageCode == '0' )
			visaTrk2Rec.trk2Lan = '2'; /* ARABIC  for ATM*/
		else if ( cardTabRec.languageCode == '2' )
			visaTrk2Rec.trk2Lan = '0'; /* BILINGUAL for ATM*/
		visaTrk2Rec.trk2Es = '?';

		strncpy(trk1, visaTrk1Rec.trk1Pan, 75);
		strncpy(trk2, visaTrk2Rec.trk2Pan, 37);
	}
	else /* local card, CPS cards, deposit cards */
	{
		strncpy(trk1Rec.trk1Pan, cardTabRec.cardNo, 19);
		trk1Rec.trk1Fs1='^';
		strncpy(trk1Rec.trk1City, "001", 3);
		strncpy(trk1Rec.trk1Name, cardTabRec.nameOnTheCard, 26);
		trk1Rec.trk1Fs2='^';
		strncpy(trk1Rec.trk1ExpYear, &cardTabRec.expireDate[2], 2);
		strncpy(trk1Rec.trk1ExpMonth, &cardTabRec.expireDate[4], 2);
		trk1Rec.trk1Ide='1';
		strncpy(trk1Rec.trk1Scd, "26", 2);/* changed to 26 from 20 as per Mr.Hisham's mail to Mr.Arul dt.29/09/2001*/
		trk1Rec.trk1Pvki='6';
		strncpy(trk1Rec.trk1Pvv, pvv, 4);
		strncpy(trk1Rec.filler7, "00000", 5);
		strncpy(trk1Rec.trk1Cvv, cvv, 3);
		strncpy(trk1Rec.filler8, "00000", 5);
		strncpy(trk1Rec.trk1Es, "? ", 2);

		strncpy(trk2Rec.trk2Pan, cardTabRec.cardNo, 19);
		trk2Rec.trk2Fs='=';
		strncpy(trk2Rec.trk2ExpYear, &cardTabRec.expireDate[2], 2);
		strncpy(trk2Rec.trk2ExpMonth, &cardTabRec.expireDate[4], 2);
		trk2Rec.trk2Ide='1';
		strncpy(trk2Rec.trk2Scd, "26", 2);/* changed to 26 from 20 as per Mr.Hisham's mail to Mr.Arul dt.29/09/2001*/
		trk2Rec.trk2Pvki='6';
		strncpy(trk2Rec.trk2Pvv, pvv, 4);
		strncpy(trk2Rec.trk2Cvv, cvv, 3);
		trk2Rec.filler9='0';
		if ( cardTabRec.languageCode == '1' )
			trk2Rec.trk2Lan = '1'; /* ENGLISH for ATM */
		else if ( cardTabRec.languageCode == '0' )
			trk2Rec.trk2Lan = '2'; /* ARABIC for ATM*/
		else
			trk2Rec.trk2Lan = '0'; /* BILINGUAL for ATM*/

		strncpy(trk1, trk1Rec.trk1Pan, 75);
		strncpy(trk2, trk2Rec.trk2Pan, 37);
	}
	return 0;
}

incCard(char cardType, char *cardNo)
{
	int seqNo;
	char tmpStr[10];

	fprintf(logFp, "%s|%5d|[incCard] : Entered incCard(); Card No  : %.19s and Type : %c\n", getDateTime(), PID, cardNo, cardType);

	if ( cardType == 'R' || cardType == 'D' || cardType == 'L' ) /* Regular or Deposit or Local chip */
	{
		sprintf(tmpStr, "%.3s", &cardNo[15]);
		seqNo = atoi(tmpStr);
		seqNo++;
		if ( seqNo > 999 )
		{
			fprintf(logFp, "%s|%5d|[incCard] : Exceed the maximum sequence number 999 for Electron Local card\n", getDateTime(), PID);
			return FAILURE;
		}

		sprintf(tmpStr,"%03d", seqNo);
		strncpy(&cardNo[15], tmpStr,3);
		sprintf(tmpStr, "%.18s", cardNo);
		cardNo[18] = luhnCheckDigit(tmpStr)+'0';
	}
	else if ( cardType == 'I' || cardType == 'V' || cardType == 'S' ) /* Electron International/Smart Card */
	{
		sprintf(tmpStr, "%.2s", &cardNo[6]);
		seqNo = atoi(tmpStr);
		seqNo++;

		if( seqNo > 99 )
		{
			fprintf(logFp, "%s|%5d|[incCard] : Exceed the maximum sequence number 99 for Electron Intl card\n", getDateTime(), PID);
			return FAILURE;
		}

		sprintf(tmpStr, "%02d", seqNo);
		strncpy(&cardNo[6], tmpStr, 2);
		sprintf(tmpStr, "%.15s", cardNo);
		cardNo[15] = luhnCheckDigit(tmpStr)+'0';
	}
	else if ( cardType == 'A' ) /* Admin Card */
	{
		sprintf(tmpStr, "%.3s", &cardNo[15]);
		seqNo = atoi(tmpStr);
		seqNo++;

		if ( seqNo > 999 )
		{
			fprintf(logFp, "%s|%5d|[incCard] : Exceed the maximum sequence number 999 for Admin card\n", getDateTime(), PID);
			return FAILURE;
		}

		sprintf(tmpStr,"%03d", seqNo);
		strncpy(&cardNo[15], tmpStr, 3);
		sprintf(tmpStr, "%.18s", cardNo);
		cardNo[18] = luhnCheckDigit(tmpStr)+'0';
	}
	else if ( cardType == 'C' ) /* CPS Card */
	{
		sprintf(tmpStr, "%.2s", &cardNo[16]);
		seqNo = atoi(tmpStr);
		seqNo++;

		if( seqNo > 99 )
		{
			fprintf(logFp, "%s|%5d|[incCard] : Exceed the maximum sequence number 99 for CPS card\n", getDateTime(), PID);
			return FAILURE;
		}

		sprintf(tmpStr, "%02d", seqNo);
		strncpy(&cardNo[16], tmpStr, 2);
		sprintf(tmpStr, "%.18s", cardNo);
		cardNo[18] = luhnCheckDigit(tmpStr)+'0';
	}
	else
	{
		fprintf(logFp, "%s|%5d|[incCard] : Invalid card type[%c] received\n", getDateTime(), PID, cardType);
		fflush(logFp);
		return FAILURE;
	}
	fprintf(logFp, "%s|%5d|[incCard] : Card Number after incCard() is %.19s\n", getDateTime(), PID, cardNo);
	fflush(logFp);
	return SUCCESS;
}

formatCardRecord(char cardType, char newOrReplacement, char primaryOrSupplementary, char *nameOnCard, char *idNo )
{
	char  tmpStr[100];
	int tYear=0;
	char monthDays[15][4] = {"31", "29", "31", "30", "31", "30", "31", "31", "30", "31", "30", "31"};

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[formatCardRecord]\n", getDateTime(), PID);

	memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);
	cardTabRec.liveChar = '@';
	if ( cardType == 'R' || cardType == 'L' ) /* Regular or Local chip card */
	{
		if ( primaryOrSupplementary == 'P' ) /* Primary */
			/*sprintf(tmpStr, "588848%c0%.7s001", cardLogRec.regionCode, &cardLogRec.bmAccNo[5]);*/
			sprintf(tmpStr, "588848%c0%.7s001", cardLogRec.customerBranch[1], &cardLogRec.coreCustNo[1]);
		else
			/*sprintf(tmpStr, "588848%c0%.7s002", cardLogRec.regionCode, &cardLogRec.coreAccNo[5]);*/
			sprintf(tmpStr, "588848%c0%.7s002", cardLogRec.customerBranch[1], &cardLogRec.coreCustNo[1]);
		strncpy(cardTabRec.cardNo, tmpStr, 18);
		cardTabRec.cardNo[18] = luhnCheckDigit(tmpStr)+'0';
	}
	else if ( cardType == 'D' ) /* Deposit */
	{
		if ( primaryOrSupplementary == 'P' ) /* Primary */
			/*sprintf(tmpStr, "788848%c0%.7s001", cardLogRec.regionCode, &cardLogRec.coreAccNo[5]);*/
			sprintf(tmpStr, "788848%c0%.7s001", cardLogRec.customerBranch[1], &cardLogRec.coreCustNo[1]);
		else
			/*sprintf(tmpStr, "788848%c0%.7s002", cardLogRec.regionCode, &cardLogRec.coreAccNo[5]);*/
			sprintf(tmpStr, "788848%c0%.7s002", cardLogRec.customerBranch[1], &cardLogRec.coreCustNo[1]);
		strncpy(cardTabRec.cardNo, tmpStr, 18);
		cardTabRec.cardNo[18] = luhnCheckDigit(tmpStr)+'0';
	}
	else if ( cardType == 'I' || cardType == 'S' )  /* Electron International/ Smart Card  */
	{
		if ( primaryOrSupplementary == 'P' )
			sprintf(tmpStr, "45503601%.7s", &cardLogRec.coreCustNo[1]);
		else
			sprintf(tmpStr, "45503602%.7s", &cardLogRec.coreCustNo[1]);
		strncpy(cardTabRec.cardNo, tmpStr, 15);
		cardTabRec.cardNo[15] = luhnCheckDigit(tmpStr)+'0';
	}
	else if ( cardType == 'A' ) /* Admin Card */
	{
		/*sprintf(tmpStr,"588848%c00000%.3s001", cardLogRec.regionCode, &cardLogRec.customerBranch[1]);*/ 
		sprintf(tmpStr,"588848%c00000%.3s001", cardLogRec.customerBranch[1], &cardLogRec.customerBranch[1]);
		strncpy(cardTabRec.cardNo, tmpStr, 18);
		cardTabRec.cardNo[18] = luhnCheckDigit(tmpStr)+'0';
	}
	else if ( cardType == 'C'  )  /* CPS Card  */
	{
		if ( primaryOrSupplementary == 'P' )
			sprintf(tmpStr, "200030%.10s01", idNo);
		else
			sprintf(tmpStr, "200030%.10s02", idNo);
		strncpy(cardTabRec.cardNo, tmpStr, 18);
		cardTabRec.cardNo[18] = luhnCheckDigit(tmpStr)+'0';
	}

	strncpy(cardTabRec.requestDateTime, cardLogRec.dateTime, 14);
	cardTabRec.requestStatus = '0'; /* Requested */
	strncpy(cardTabRec.requestBranch, cardLogRec.branchCode, 4);
	strncpy(cardTabRec.requestUserId, cardLogRec.userId, 10);
	cardTabRec.cardType = cardType; 
	cardTabRec.newOrReplacement=newOrReplacement;
	cardTabRec.primaryOrSupplementary=primaryOrSupplementary;
	cardTabRec.cardStatus = '0'; /* Requested */
	cardTabRec.regionCode = cardLogRec.regionCode;
	strncpy(cardTabRec.coreAccNo, cardLogRec.coreAccNo, 16);
	strncpy(cardTabRec.coreCustNo, cardLogRec.coreCustNo, 8);
	cardTabRec.languageCode = cardLogRec.languageCode; 
	strncpy(cardTabRec.customerBranch, cardLogRec.customerBranch, 4);
	strncpy(cardTabRec.nameOnTheCard, nameOnCard, 26);
	strncpy(cardTabRec.address1, cardLogRec.address1, 30);
	strncpy(cardTabRec.address2, cardLogRec.address2, 30);
	strncpy(cardTabRec.poBox, cardLogRec.poBox, 10);
	strncpy(cardTabRec.cityName, cardLogRec.cityName, 20);
	strncpy(cardTabRec.zipCode, cardLogRec.zipCode, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardTabRec.firstIssueDate, tmpStr, 8);
	strncpy(cardTabRec.renewalDate, tmpStr, 8);

	sprintf(tmpStr,"%04d", systemDate->tm_year+1900+2);
	tYear = atoi(tmpStr);

	if ( tYear % 400 == 0 || (tYear % 4 == 0 && tYear % 100 == 0) )
		strcpy(monthDays[1],"29");
	else
		strcpy(monthDays[1],"28");

	sprintf(tmpStr, "%04d%02d%.2s", systemDate->tm_year+1900+2, systemDate->tm_mon+1, monthDays[systemDate->tm_mon]);
	strncpy(cardTabRec.expireDate, tmpStr, 8);

	sprintf(tmpStr, "%.8s", cardTabRec.coreCustNo);

	if ( validateCustNo(tmpStr) ==  FAILURE )
	{
		sprintf(tmpStr,"Error %.5s occured while reading customer info", custInfoResponseMsg.responseStatus);
		formatCardApprovalResponse(NOT_FOUND, tmpStr, tmpStr);
		sendResponse(responseMsg.cardApproval.msgLen);
		return FAILURE;
	}

	strncpy(cardTabRec.titleCode, custInfoResponseMsg.titleCode, 2);
	strncpy(cardTabRec.idNo, custInfoResponseMsg.idNo, 15);

	cardTabRec.deliveryToBranchOrPO = cardLogRec.deliveryToBranchOrPO;

	if ( extraDebug )
	{
		fprintf(logFp, "Delivery to branch or Po flag : %c\n", cardTabRec.deliveryToBranchOrPO);
		fflush(logFp);
	}

	if ( cardTabRec.deliveryToBranchOrPO == 'R' || cardTabRec.deliveryToBranchOrPO == 'C' )
		strcpy(tmpStr,"(*)");
	else
		strcpy(tmpStr,"   ");

	sprintf(tmpStr,"%s   ",tmpStr);
	
	if ( strncmp(custInfoResponseMsg.businessType,"029",3) == 0 )
		sprintf(tmpStr,"%s(R)",tmpStr);
	else
		sprintf(tmpStr,"%s   ",tmpStr);

	sprintf(tmpStr,"%sBR.CODE:%.3s", tmpStr, cardTabRec.deliveryToBranchOrPO == 'R'? &receivedMsg.cardApproval.homeBranch[1] : &custInfoResponseMsg.branchCode[1]);

	sprintf(tmpStr,"%-30.30s", tmpStr);

	strncpy(cardTabRec.address2, tmpStr, 30);

	cardTabRec.requestType = '0';  /* Initial Card */
	cardTabRec.pinRequestStatus = '0'; /* Requested */
	cardTabRec.source = 'S' ; /* Requested from Static Data */

	strncpy(cardTabRec.lastUpdateUser, authorisedUser, 10);	
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardTabRec.lastUpdateDateTime, tmpStr, 14);

	return SUCCESS;
}

luhnCheckDigit(inString)
char *inString;
{
	int strLen = strlen(inString);
	int checkDigit, digit, multiplyFactor = 2, accumValue = 0;

	for ( strLen--; strLen >= 0; strLen-- )
	{
		digit = inString[strLen] - '0';
		digit *= multiplyFactor;
		if ( digit <= 9 )
			accumValue += digit;
		else
			accumValue += (digit % 10 + 1 );
		if ( multiplyFactor == 2 )
			multiplyFactor = 1;
		else
			multiplyFactor = 2;
	}
	return ( (accumValue % 10 ) == 0 ? 0 : (10 - accumValue % 10));
}

checkCustNo(char *custNo)
{
	char bmCustNo[10];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[checkCustNo] in stcusttab for the customer number [%.7s]\n", getDateTime(), PID, custNo);

	/* In the source code given to MISYS, this crd reading is placed only when there is a read error in stcusttab */

	/* Reading the Customer Info from STCUSTTAB */

	memset(&custTabRec.liveChar, ' ', sizeof custTabRec);

	strncpy(custTabRec.custNo, custNo, 7);

	isindexinfo(custTabFile, &custTabKey, 1);
	isstart(custTabFile, &custTabKey, 0, &custTabRec.liveChar, ISEQUAL);

	if ( isRead(custTabFile, &custTabRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[checkCustNo] :ISREAD error %d occured on stcusttab while validating customer # [%.7s]\n", getDateTime(), PID, iserrno, custTabRec.custNo);
		fflush(logFp);
		return FAILURE;
	}
	else
	{
		if ( custTabRec.custType != '0' )
		{
			strncpy(custTabRec.aShortName, custTabRec.aOrgShortName, 30);
			strncpy(custTabRec.eShortName, custTabRec.eOrgShortName, 30);
		}
		return SUCCESS;
	}
}

processAccSearchRequest()
{
	int lastRecRcvd, recCount=0, recsInThisMsg = 0, searchType = 0, i, nameLen;
	char tmpStr[100], tmpAuthLevel[150], *tmpPtr, tmpEnqAllowedBrn[2500]; 
	char tAccNo[20], tCustNo[15], tCustName[70];
	double transAmt;
	struct resMsgSrchEngineEnq	srchEngineResponse;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processAccSearchRequest]\n", getDateTime(), PID);

	memset(responseMsg.accSearch.msgLen, ' ', sizeof responseMsg.accSearch);
	responseMsg.accSearch.nullPad = '\0';

	sprintf(tmpStr, "%.5s", receivedMsg.accSearch.lastRecCount);
	lastRecRcvd = atoi(tmpStr);

	memset(&gldRec.liveChar, ' ', sizeof gldRec);
	if ( strncmp(receivedMsg.accSearch.custNo, "          ", 7) )  
	{ 
		searchType = SEARCH_BY_CUSTNO;
		sprintf(tmpStr, "%.7s", receivedMsg.accSearch.custNo);
		if ( checkCustNo(tmpStr) == SUCCESS )
		{
			strncpy(responseMsg.accSearch.custBranchCode, custTabRec.branchCode,4);
			strncpy(responseMsg.accSearch.custNo, custTabRec.custNo, 7);
			strncpy(responseMsg.accSearch.aShortName, custTabRec.aShortName,30);
			strncpy(responseMsg.accSearch.eShortName, custTabRec.eShortName,30);
		}
		else
		{
			responseMsg.accSearch.details[recsInThisMsg+1].accNo[0] = '\0';
			formatAccSearchResponse(INTERNALERR, "Invalid Customer Number..Please Check", "Invalid Customer Number..Please Check");
			sendResponse(responseMsg.accSearch.msgLen);
			return FAILURE;
		}
		actualToBmCust(receivedMsg.accSearch.custNo,tCustNo);
		isindexinfo(gldFile, &gldKey, 3);
		strncpy(&gldRec.accNo[5], tCustNo, 6);
		isstart(gldFile, &gldKey, 6, &gldRec.liveChar, ISGTEQ);
	}
	else if ( strncmp(receivedMsg.accSearch.accNo, "                ", 14) )
	{
		searchType = SEARCH_BY_ACCTNO;
		sprintf(tmpStr, "%.7s", &receivedMsg.accSearch.accNo[5]);
		if ( checkCustNo(tmpStr) == SUCCESS )
		{
			strncpy(responseMsg.accSearch.custBranchCode, custTabRec.branchCode,4);
			strncpy(responseMsg.accSearch.custNo, custTabRec.custNo, 7);
			strncpy(responseMsg.accSearch.aShortName, custTabRec.aShortName,30);
			strncpy(responseMsg.accSearch.eShortName, custTabRec.eShortName,30);
		}
		else
		{
			responseMsg.accSearch.details[recsInThisMsg+1].accNo[0] = '\0';
			formatAccSearchResponse(INTERNALERR, "Invalid Customer Number..Please Check", "Invalid Customer Number..Please Check");
			sendResponse(responseMsg.accSearch.msgLen);
			return FAILURE;
		}
		actualToBmAcc(receivedMsg.accSearch.accNo, tAccNo, 13);
		isindexinfo(gldFile, &gldKey, 1);
		strncpy(gldRec.accNo, tAccNo, 13);
		isstart(gldFile, &gldKey, 13, &gldRec.liveChar, ISGTEQ);
	}
	else if ( strncmp(receivedMsg.accSearch.cardNo, "                      ", 19) )
	{
		if ( openCardTabFile(ISMANULOCK+ISINOUT) < 0 ) 
		{
			responseMsg.accSearch.details[recsInThisMsg+1].accNo[0] = '\0';
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
		isindexinfo(cardTabFile, &cardTabKey, 1);
		memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);
		strncpy(cardTabRec.cardNo, receivedMsg.accSearch.cardNo,19);
		isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar, ISGTEQ);
		if ( isRead(cardTabFile, &cardTabRec.liveChar, ISEQUAL) < 0 )
		{
			sprintf(tmpStr,"Error %d while reading stcardtab.dat ",iserrno);
			fprintf(logFp,"%s|%5d|[processAccSearchRequest] : ISREAD/ISEQUAL error %d while reading stcardtab.dat for key [%.19s]\n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
			responseMsg.accSearch.details[recsInThisMsg+1].accNo[0] = '\0';
			formatAccSearchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.accSearch.msgLen);
			return FAILURE;
		}

		sprintf(tmpStr, "%.7s", &cardTabRec.bmAccNo[5]);
		if ( checkCustNo(tmpStr) == SUCCESS )
		{
			strncpy(responseMsg.accSearch.custBranchCode, custTabRec.branchCode,4);
			strncpy(responseMsg.accSearch.custNo, custTabRec.custNo, 7);
			strncpy(responseMsg.accSearch.aShortName, custTabRec.aShortName,30);
			strncpy(responseMsg.accSearch.eShortName, custTabRec.eShortName,30);
		}
		else
		{
			responseMsg.accSearch.details[recsInThisMsg+1].accNo[0] = '\0';
			formatAccSearchResponse(INTERNALERR, "Invalid Customer Number..Please Check", "Invalid Customer Number..Please Check");
			sendResponse(responseMsg.accSearch.msgLen);
			return FAILURE;
		}
		isindexinfo(gldFile, &gldKey, 1);
		strncpy(gldRec.accNo, actualToBmAcc(cardTabRec.bmAccNo,tAccNo), 13);
		isstart(gldFile, &gldKey, 13, &gldRec.liveChar, ISGTEQ);
		searchType = SEARCH_BY_ACCTNO;
	}

	/* The following if statement added after giving the source to MISYS */

	/* Read "CustTabBranchCode" in stctltab to get the restricted flag */ 
	if ( getRestrictedFlag(custTabRec.branchCode) == FAILURE )
	{
		sprintf(tmpStr, "Branch record is missing in ctlFile [%.4s]", ctlRec.branchCode);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	if ( ctlRec.updateRestricted != NULL ) /* avoid NULL characters in the response packet */
		responseMsg.accSearch.restrictedFlag = ctlRec.updateRestricted; /* This line is added after giving the source to MISYS */

	responseMsg.accSearch.foundInAList = '0'; /* Initiatialise to 0 as "not AList" */ 
	/* Read ABC List whether Customer is A List customer or not */ 

	memset(&abcRec.liveChar, ' ', sizeof abcRec); 

	strncpy(abcRec.idNo, custTabRec.idNo, 15); 
	abcRec.idType = custTabRec.idType; 

	isindexinfo(abcFile, &abcKey, 1); 

	if ( isstart(abcFile,&abcKey,16,&abcRec.liveChar,ISGTEQ) < 0 ) 
	{
		fprintf(logFp,"%s|%5d|[processAccSearchReqeust] ISSTART error %d on stabclist for %.16s ignored\n ",getDateTime(), PID, iserrno, &abcRec.idType); 
		fflush(logFp); 
	}

	while ( isRead(abcFile, &abcRec.liveChar, ISNEXT) == 0 ) 
	{
		if ( abcRec.idType != custTabRec.idType || strncmp(abcRec.idNo, custTabRec.idNo, 15) != 0 ) 
			break; 

		if ( abcRec.abcListType == 'A' && checkAList ) 
			responseMsg.accSearch.foundInAList = '1'; 
	}

	memset(&userRec.liveChar, ' ', sizeof userRec);
	strncpy(userRec.userId, receivedMsg.accSearch.userId, 10);

	isindexinfo(userFile, &userKey, 1);
	isstart(userFile, &userKey, 0, &userRec.liveChar, ISGTEQ);

	if ( isRead(userFile, &userRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processAccSearchRequest] ISREAD/ISEQUAL error %d on stuser for the user [%.10s] \n", getDateTime(), PID, iserrno, userRec.userId);
		fflush(logFp);
		sprintf(tmpStr, "UserID[%.10s] could not be read", receivedMsg.accSearch.userId);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	sprintf(tmpStr, "%.20s", userRec.authorityLevel);
	sprintf(tmpAuthLevel, "~%.2s", tmpStr);
	for (i=2; i < strlen(tmpStr); i += 2 )
		sprintf(tmpAuthLevel, "%s~%.2s", tmpAuthLevel, &tmpStr[i]);

	sprintf(tmpStr, "%.60s", userRec.authorityLevel2);
	for (i=0; i < strlen(tmpStr); i += 2 )
		sprintf(tmpAuthLevel, "%s~%.2s", tmpAuthLevel, &tmpStr[i]);

	memset(tmpEnqAllowedBrn, NULL, sizeof tmpEnqAllowedBrn);
	if ( (tmpPtr=strstr(tmpAuthLevel, "~86")) != NULL )
	{
		memset(&usrBrnRec.liveChar, ' ', sizeof usrBrnRec);
		strncpy(usrBrnRec.userId, userRec.userId, 10);
		if ( isRead(usrBrnFile, &usrBrnRec.liveChar, ISEQUAL) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processAccSearchRequest] ISREAD/ISEQUAL error %d on stusrbrn for the user [%.10s] IGNORED\n", getDateTime(), PID, iserrno, usrBrnRec.userId);
			fflush(logFp);
		}
		else
		{
			sprintf(tmpEnqAllowedBrn, "~%.4s", usrBrnRec.allowedBranch);
			for (i=1; i < 500; i++ )
			{
				if ( strncmp(usrBrnRec.allowedBranch[i], "       ", 4) == 0 )
					break;
				sprintf(tmpEnqAllowedBrn, "%s~%.4s", tmpEnqAllowedBrn, usrBrnRec.allowedBranch[i]);
			}
		}
	}

	if ( extraDebug > 5 )
	{
		fprintf(logFp, "%s|%5d|[processAccSearchRequest] Before entering into while loop, tmpAuthLevel [%s]; tmpEnqAllowedBrn [%s] \n", getDateTime(), PID, tmpAuthLevel, tmpEnqAllowedBrn);
		fflush(logFp);
	}

	if ( strncmp(custTabRec.businessType, "266", 3) == 0 || strncmp(custTabRec.branchCode, "0175",4) == 0 )
		responseMsg.accSearch.staffFlag = '1';  /* Staff */
	else
		responseMsg.accSearch.staffFlag = '0'; /* Not a staff */

	strncpy(responseMsg.accSearch.samaMainCategory, custTabRec.samaMainCategory, 2);
	strncpy(responseMsg.accSearch.samaSubCategory, custTabRec.samaSubCategory, 2);
	responseMsg.accSearch.customerLang = custTabRec.preferredLang;

	if ( searchType == SEARCH_BY_ACCTNO )
	{
		if ( isRead(gldFile, &gldRec.liveChar, ISEQUAL) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processAccSearchRequest] :Error %d while reading gld0data for key [%.13s] ignored\n", getDateTime(), PID, iserrno, gldRec.accNo);
			fflush(logFp);
			fprintf(errLogFp, "%s :processAccSearch() : Error %d while reading gld0data for key [%.13s] ignored\n", getDateTime(), iserrno, gldRec.accNo);
			fflush(errLogFp);
			sprintf(tmpStr, "%05d", recsInThisMsg);
			strncpy(responseMsg.accSearch.lastRecCount, tmpStr, 5);
			sprintf(tmpStr, "%02d", recsInThisMsg);
			strncpy(responseMsg.accSearch.noOfRecs, tmpStr, 2);
			responseMsg.accSearch.details[recsInThisMsg+1].accNo[0] = '\0';
			formatAccSearchResponse(DONE, "Successful", "Successful");
			fflush(logFp);
			sendResponse(responseMsg.accSearch.msgLen);
			return SUCCESS;
		}

		bmAccToActual(gldRec.accNo, tAccNo);

		if ( strncmp(gldRec.branchCode, "0175", 4) == 0 )
			responseMsg.accSearch.staffFlag = '1';

		strncpy(responseMsg.accSearch.details[recsInThisMsg].accNo, tAccNo, 14);
		/*
		transAmt = bmAmtToDbl(gldRec.bookBal, 14);
		sprintf(tmpStr, "%014.0f", transAmt);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].bookBal, tmpStr,14);
		transAmt = bmAmtToDbl(gldRec.clearedBal, 14);
		sprintf(tmpStr, "%014.0f", transAmt);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].clearedBal, tmpStr, 14);
		transAmt = bmAmtToDbl(gldRec.blockedAmt, 14);
		sprintf(tmpStr, "%014.0f", transAmt);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].blockedBal, tmpStr, 14);
		*/
		strncpy(responseMsg.accSearch.details[recsInThisMsg].bookBal, gldRec.bookBal,14);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].clearedBal, gldRec.clearedBal, 14);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].blockedBal, gldRec.blockedAmt, 14);
		sprintf(tmpStr,"0%c", gldRec.passwd);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].accStatus, tmpStr,2);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].creditLimit, gldRec.accLimit, 12);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].transCount, gldRec.transCount,5);
		responseMsg.accSearch.inactiveFlag[recsInThisMsg] = gldRec.anbDormantFlag;
		strncpy(responseMsg.accSearch.branchCode[recsInThisMsg], gldRec.branchCode, 4);

		responseMsg.accSearch.balEnqRestricted[recsInThisMsg] = '0'; /* Initially set as 0 */
		if ( strncmp(&tAccNo[5], "0002000", 7) > 0 )
		{
			if ( getRestrictedFlag(gldRec.branchCode) < 0 )
			{
				/* Error is IGNORED since it can cause total account enquiry failure;  */
			}

			if ( ctlRec.balEnqRestrictedFlag == '1' )
			{
				if ( (tmpPtr=strstr(tmpAuthLevel, "~86")) != NULL )
				{
					sprintf(tmpStr, "~%.4s", gldRec.branchCode);
					if ( (tmpPtr=strstr(tmpEnqAllowedBrn, tmpStr)) != NULL )
						responseMsg.accSearch.balEnqRestricted[recsInThisMsg] = '0';
					else
						responseMsg.accSearch.balEnqRestricted[recsInThisMsg] = '1';
				}
				else
					responseMsg.accSearch.balEnqRestricted[recsInThisMsg] = '1';
			}
		}
		recsInThisMsg++;
		sprintf(tmpStr, "%05d", recsInThisMsg);
		strncpy(responseMsg.accSearch.lastRecCount, tmpStr, 5);
		sprintf(tmpStr, "%02d", recsInThisMsg);
		strncpy(responseMsg.accSearch.noOfRecs, tmpStr, 2);
		formatAccSearchResponse(DONE, "Successful", "Successful");
		fflush(logFp);
		sendResponse(responseMsg.accSearch.msgLen);
		return SUCCESS;
	}

	while ( isread(gldFile, &gldRec.liveChar, ISNEXT) == 0 )
	{
		if ( recCount++ < lastRecRcvd )
			continue; /* read all records already sent */

		if ( strncmp(tCustNo, &gldRec.accNo[5], 6) )
			break;

		bmAccToActual(gldRec.accNo, tAccNo);
		if ( strncmp(gldRec.branchCode, "0175", 4) == 0 )
			responseMsg.accSearch.staffFlag = '1';

		strncpy(responseMsg.accSearch.details[recsInThisMsg].accNo, tAccNo, 14);
		/*
		transAmt = bmAmtToDbl(gldRec.bookBal, 14);
		sprintf(tmpStr, "%014.0f", transAmt);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].bookBal, tmpStr,14);
		transAmt = bmAmtToDbl(gldRec.clearedBal, 14);
		sprintf(tmpStr, "%014.0f", transAmt);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].clearedBal, tmpStr, 14);
		transAmt = bmAmtToDbl(gldRec.blockedAmt, 14);
		sprintf(tmpStr, "%014.0f", transAmt);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].blockedBal, tmpStr, 14);
		*/

		strncpy(responseMsg.accSearch.details[recsInThisMsg].bookBal, gldRec.bookBal,14);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].clearedBal, gldRec.clearedBal, 14);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].blockedBal, gldRec.blockedAmt, 14);
		sprintf(tmpStr,"0%c", gldRec.passwd);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].accStatus, tmpStr,2);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].creditLimit, gldRec.accLimit, 12);
		strncpy(responseMsg.accSearch.details[recsInThisMsg].transCount, gldRec.transCount,5);

		responseMsg.accSearch.inactiveFlag[recsInThisMsg] = gldRec.anbDormantFlag;
		strncpy(responseMsg.accSearch.branchCode[recsInThisMsg], gldRec.branchCode, 4);

		responseMsg.accSearch.balEnqRestricted[recsInThisMsg] = '0'; /* Initially set as 0 */

		if ( strncmp(&tAccNo[5], "0002000", 7) > 0 ) /* Ignore the internal accounts */
		{
			if ( getRestrictedFlag(gldRec.branchCode) < 0 )
			{
				/* Error is IGNORED here since it can cause total account enquiry failure;  */
			}

			if ( ctlRec.balEnqRestrictedFlag == '1' )
			{
				if ( (tmpPtr=strstr(tmpAuthLevel, "~86")) != NULL )
				{
					sprintf(tmpStr, "~%.4s", gldRec.branchCode);
					if ( (tmpPtr=strstr(tmpEnqAllowedBrn, tmpStr)) != NULL )
						responseMsg.accSearch.balEnqRestricted[recsInThisMsg] = '0';
					else
						responseMsg.accSearch.balEnqRestricted[recsInThisMsg] = '1';
				}
				else
					responseMsg.accSearch.balEnqRestricted[recsInThisMsg] = '1';
			}
		}

		if ( ++recsInThisMsg >=  20 )
			break;
	}
	sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
	strncpy(responseMsg.accSearch.lastRecCount, tmpStr, 5);
	sprintf(tmpStr, "%02d", recsInThisMsg);
	strncpy(responseMsg.accSearch.noOfRecs, tmpStr, 2);
	formatAccSearchResponse(DONE, "Successful", "Successful");
	fflush(logFp);
	sendResponse(responseMsg.accSearch.msgLen);
	return SUCCESS;
}

getTpinFromPhoneDb()
{
	char tmpStr[50];

	memset(tpinRequestMsg.tpinStatus.msgLen, ' ', sizeof tpinRequestMsg.tpinStatus);
	memset(tpinResponseMsg.tpinStatus.msgLen, ' ', sizeof tpinResponseMsg.tpinStatus);

	strncpy(tpinRequestMsg.tpinStatus.reqSource, "CSD               ", 10);
	strncpy(tpinRequestMsg.tpinStatus.service, "01", 2);
	/*strncpy(tpinRequestMsg.tpinStatus.custNo, &cardLogRec.coreAccNo[5], 7);*/
	strncpy(tpinRequestMsg.tpinStatus.cardNo, cardLogRec.cardNo, 19);
	tpinRequestMsg.tpinStatus.nullPad = '\0';
	sprintf(tmpStr, "%05d", strlen(tpinRequestMsg.tpinStatus.msgLen));
	strncpy(tpinRequestMsg.tpinStatus.msgLen, tmpStr, 5);

	fprintf(logFp, "%s|%5d|[getTpinFromPhoneDb] Send to TUXEDO [%s] \n", getDateTime(), PID, tpinRequestMsg.tpinStatus.msgLen);
	fflush(logFp);

	if ( dealWithTuxedo("FTPINSERVICES", tpinRequestMsg.tpinStatus.msgLen, tpinResponseMsg.tpinStatus.msgLen) == FAILURE )
		return FAILURE;

	return SUCCESS;
}

processPinRequest()
{
	char tmpStr[100], atmPin[10], tmpStr1[20];
	char tmpAtmPin[10];
	int cardFound=NO;
	int expiryYear;
	char reqType;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processPinRequest]\n", getDateTime(), PID);


	fprintf(logFp, "%s|%5d|[processPinRequest]; cardTabFile [%d] ; cardLogFile [%d] \n", getDateTime(), PID, cardTabFile, cardLogFile);
	fflush(logFp);

	memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);

	strncpy(cardLogRec.branchCode, receivedMsg.processPin.homeBranch, 4);
	strncpy(cardLogRec.userId, receivedMsg.processPin.userId, 10);
	strncpy(cardLogRec.dateTime, receivedMsg.processPin.dateTime, 14);

	isindexinfo(cardLogFile, &cardLogKey, 1);

	if ( isstart(cardLogFile, &cardLogKey, 0, &cardLogRec.liveChar, ISGTEQ) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processPinRequest]: ISSTART/ISGTEQ error %d occured on cbcardlog.dat while processing the pin select from branches for the key [%.28s]\n", getDateTime() , PID, iserrno, cardLogRec.branchCode);
		fflush(logFp);
		fprintf(errLogFp, "%s: processPinRequest : ISSTART/ISGTEQ error %d occured on cbcardlog.dat while processing the pin select from branches for the key [%.28s]\n", getDateTime() , iserrno, cardLogRec.branchCode);
		fflush(errLogFp);
	}

	cardFound = NO;
	while ( isRead(cardLogFile, &cardLogRec.liveChar, ISNEXT) == 0 )
	{
		if ( strncmp(cardLogRec.branchCode, receivedMsg.processPin.homeBranch,4) ||
			 strncmp(cardLogRec.userId, receivedMsg.processPin.userId, 10) ||
			 strncmp(cardLogRec.dateTime, receivedMsg.processPin.dateTime, 14) )
				break;

		if ( cardLogRec.primaryOrSupplementary == receivedMsg.processPin.primaryOrSupplementary )
		{
			cardFound = YES;
			break;
		}
	}

	if ( cardFound == NO )
	{
		fprintf(logFp, "%s|%5d|[processPinRequest] No %s card found in cbcardlog for the key [%.4s%.10s%.14s] \n", getDateTime(), PID, receivedMsg.processPin.primaryOrSupplementary=='P'?"Primary":"Supplementary", receivedMsg.processPin.homeBranch, receivedMsg.processPin.userId, receivedMsg.processPin.dateTime); 
		sprintf(tmpStr, "No %s card found in cbcardlog", receivedMsg.processPin.primaryOrSupplementary=='P'?"Primary":"Supplementary");
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);
	strncpy(cardTabRec.cardNo, cardLogRec.cardNo, 19);
	isindexinfo(cardTabFile, &cardTabKey, 1);
	isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar, ISGTEQ);

	if ( isRead(cardTabFile, &cardTabRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processPinRequest]: ISREAD/ISEQUAL error %d occured on cbcardtab while processing pin select from branch for the card $ [%.19s] ignored \n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
		fflush(logFp);
		fprintf(errLogFp, "%s: processPinRequest() : ISREAD/ISEQUAL error %d occured on cbcardtab while processing pin select from branch for the card $ [%.19s] ignored \n", getDateTime(), iserrno, cardTabRec.cardNo);
		fflush(errLogFp);
		strncpy(cardTabRec.expireDate, cardLogRec.expireDate, 8);
	}

	sprintf(atmPin, "%.4s", receivedMsg.processPin.atmPin);

	if ( strncmp(atmPin, "         ",4) )
	{
		if ( strncmp(receivedMsg.processPin.atmPin, "CARD", 4) == 0 )
		{
			getDateTime();
			sprintf(tmpStr, "%04d", systemDate->tm_year+1900);
			strncpy(cardTabRec.renewalDate, tmpStr, 4);
			expiryYear = (systemDate->tm_year+1900)+2;
			sprintf(tmpStr, "%04d", expiryYear);
			strncpy(cardTabRec.expireDate, tmpStr, 4); /* Copy only the year */
			strncpy(cardLogRec.expireDate, cardTabRec.expireDate, 8);
			strncpy(cardLogRec.renewalDate, cardTabRec.renewalDate, 8);
			sprintf(tmpStr, "       ");
			reqType = '2'; /* FORCE_CARD */
		}
		else
		{
			sprintf(tmpStr1, "%.4s", atmPin);
			trim(tmpStr1);
			sprintf(tmpAtmPin, "%-4.4s", (char *) Decrypt(tmpStr1));
			reqType = '0'; /* Initial or FORCE_PIN */
			if ( getTpinFromPhoneDb() == FAILURE )
			{
				sendResponse(responseMsg.customer.msgLen);
				return FAILURE;
			}
			if ( strncmp(tpinResponseMsg.tpinStatus.responseStatus, "00", 2) == 0 ) /* Success */
			{
				if ( strncmp(tpinResponseMsg.tpinStatus.tpinNo, atmPin, 4) == 0 )
				{
					formatBranchResponse(TPIN_MATCH, "This pin matches with the TPIN;Please try again", "This pin matches with the TPIN;Please try again");
					sendResponse(responseMsg.customer.msgLen);
					return FAILURE;
				}
			}
			else if ( strncmp(tpinResponseMsg.tpinStatus.responseStatus, "02", 2) == 0 ) /* Invalid Customer */
			{
				/* This empty condition is reqd since "INVALID CUSTOMER" error to be treated as SUCCESS */
			}
			else if ( strncmp(tpinResponseMsg.tpinStatus.responseStatus, "06", 2) == 0 )/* Database error */
			{
				sprintf(tmpStr, "Phone Database Error occured..Contact support");
				formatBranchResponse(DATABASE_ERROR, tmpStr, tmpStr);
				sendResponse(responseMsg.customer.msgLen);
				return FAILURE;
			}
			else
			{
				fprintf(logFp, "%s|%5d|[processPinRequest] Internal error response (%.2s) received from Tuxedo ; Please check \n", getDateTime(), PID, tpinResponseMsg.tpinStatus.responseStatus);
				fflush(logFp);
				formatBranchResponse(INTERNALERR, "Internal error ; Please call support", "Internal error ; please call support");
				return FAILURE;
			}
		}
		if ( callHsmInt(tmpAtmPin, reqType) == FAILURE )
		{
			fprintf(logFp, "%s|%5d|[processPinRequest]: Error %.2s received from HSM INT server...\n", getDateTime(), PID, hsmReplyMsg.retStatus);
			fflush(logFp);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
		else
		{
			if ( reqType == '2' ) /* Force_card */
				cardLogRec.branchCardPrdn  = 'Y';
			else /* Force_pin or initial */
			{
				cardLogRec.branchPinSelect = 'Y';
				strncpy(cardLogRec.pinOffset, hsmReplyMsg.pinOffset, 4);
			}
			strncpy(cardLogRec.pinOffset, hsmReplyMsg.pinOffset, 4);
			if ( strncmp(hsmReplyMsg.cvv, "     ", 3) )
				strncpy(cardLogRec.cvv, hsmReplyMsg.cvv, 3);
			if ( strncmp(hsmReplyMsg.pvv, "      ",4) )
				strncpy(cardLogRec.pvv, hsmReplyMsg.pvv, 4);
		}
	}
	else
	{
		cardLogRec.branchPinSelect = 'N';
		cardLogRec.branchCardPrdn  = 'N'; 
	}

	/*strncpy(cardLogRec.lastUpdateUser, custLogRec.supervisorId, 10);*/
	strncpy(cardLogRec.lastUpdateUser, authorisedUser, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardLogRec.lastUpdateDateTime, tmpStr, 14);
	strncpy(cardLogRec.processDateTime, cardTabRec.processDateTime,14);

	if ( isRewcurr(cardLogFile, &cardLogRec.liveChar) < 0 )
	{
		fprintf(logFp,"%s|%5d|[processPinRequest] : ISREWCURR error %d on cbcardlog , key is [%.28s] and the card # is [%.19s] while updating pin select from branches \n", getDateTime(), PID, iserrno, cardLogRec.branchCode, cardLogRec.cardNo );
		fflush(logFp);

		sprintf(tmpStr, "Error %d occured while updating pin/card select", iserrno);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	formatBranchResponse(DONE, "Successful..", "Successful..");
	sendResponse(responseMsg.customer.msgLen);
	return SUCCESS;
}

processCardPrint()
{
	char tmpStr[100];
	int cardLogExists = YES;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processCardPrin]\n", getDateTime(), PID);


	memset(responseMsg.printCard.msgLen, ' ', sizeof responseMsg.printCard);
	memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);
	isindexinfo(cardTabFile, &cardTabKey, 1);
	strncpy(cardTabRec.cardNo, receivedMsg.printCard.cardNo, 19);
	isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar, ISGTEQ);

	if ( readCardTabFile(ISEQUAL) < 0 )
	{
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);
	isindexinfo(cardLogFile, &cardLogKey, 1);

	strncpy(cardLogRec.branchCode, cardTabRec.requestBranch, 4);
	strncpy(cardLogRec.userId, cardTabRec.requestUserId,  10);
	strncpy(cardLogRec.dateTime, cardTabRec.requestDateTime, 14);
	strncpy(cardLogRec.cardNo, cardTabRec.cardNo, 19);
	isstart(cardLogFile, &cardLogKey, 0, &cardLogRec.liveChar, ISGTEQ);

	if ( readCardLogFile(ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardPrint]: ISREAD/ISEQUAL error %d occured on cbcardlog for the key %.28s and the card # [%.19s] while confirming th card printed successfully at branch \n", getDateTime(), PID, iserrno, cardLogRec.branchCode, cardLogRec.cardNo);
		fflush(logFp);
		fprintf(errLogFp, "%s: processCardPrint() : ISREAD/ISEQUAL error %d occured on cbcardlog for the key %.28s and the card # [%.19s] while confirming th card printed successfully at branch \n", getDateTime(), iserrno, cardLogRec.branchCode, cardLogRec.cardNo);
		fflush(errLogFp);
		cardLogExists = NO;
	}

	if ( receivedMsg.printCard.requestType == '9' ) /* Card not produced successfully ; close the card */
	{
		cardTabRec.requestStatus = '9'; /* cancelled by Branch */ 
		cardTabRec.cardStatus = '9';
		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
		strncpy(cardTabRec.processDateTime, tmpStr, 14);
		strncpy(cardTabRec.rejectedDate, tmpStr, 8);
		strncpy(cardTabRec.rejectedUserId, "BRCARDPRNT", 10);
		strncpy(cardTabRec.rejectedReason, "Brn unable to produce ", 20);

		strncpy(cardTabRec.lastUpdateUser, receivedMsg.printCard.userId, 10);
		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
		strncpy(cardTabRec.lastUpdateDateTime, tmpStr, 14);

		if ( updateCardTabFile() < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
		cardLogRec.requestStatus = cardTabRec.requestStatus; 

		strncpy(&cardLogRec.cardType, &cardTabRec.cardType, 374);
		cardLogRec.requestType =  cardTabRec.requestType;
		cardLogRec.branchCardPrdn = cardTabRec.branchCardPrdn;
		cardLogRec.branchPinSelect = cardTabRec.branchPinSelect;
		strncpy(cardLogRec.rejectedDate, cardTabRec.rejectedDate, 8);
		strncpy(cardLogRec.rejectedUserId, cardTabRec.rejectedUserId,10);
		strncpy(cardLogRec.rejectedReason, cardTabRec.rejectedReason, 20);
		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
		strncpy(cardLogRec.rejectedTime, &tmpStr[8], 6);

		strncpy(cardLogRec.lastUpdateUser, receivedMsg.printCard.userId, 10);
		strncpy(cardLogRec.processDateTime, cardTabRec.processDateTime,14);

		if ( cardLogExists == YES )
		{
			if ( updateCardLogFile() < 0 )
			{
				sendResponse(responseMsg.customer.msgLen);
				return FAILURE;
			}
		}

		if ( cardTabRec.requestType ==  '2' ) /* If the request is FORCE_CARD, then close  the card in Base 24 */
		{
			sprintf(pinOffset, "       ");

			if ( callB24Int() == FAILURE )
			{
				sendResponse(responseMsg.printCard.msgLen);
				return FAILURE;
			}

			if ( strncmp(b24ReplyMsg.retStatus, "000", 3) )
			{
				fprintf(logFp, "%s|%5d|[processCardPrint] Error %.3s received from Base 24 interface for the card # [%.19s]\n", getDateTime(), PID, b24ReplyMsg.retStatus, cardTabRec.cardNo);
				fflush(logFp);
				sprintf(tmpStr, "Error %.3s received from Base 24 server", b24ReplyMsg.retStatus);
				formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr);
				sendResponse(responseMsg.printCard.msgLen);
				return FAILURE;
			}
		}
		formatPrintCardResponse(DONE, "Successful", "Successful");
		sendResponse(responseMsg.printCard.msgLen);
		return SUCCESS;
	}

	if ( receivedMsg.printCard.requestType == '0' || receivedMsg.printCard.requestType == '3' )
		sprintf(pinOffset, "%.4s", cardTabRec.pinOffset);
	else
		sprintf(pinOffset, "       ");

	if ( callB24Int() == FAILURE )
	{
		sendResponse(responseMsg.printCard.msgLen);
		return FAILURE;
	}

	if ( strncmp(b24ReplyMsg.retStatus, "000", 3) )
	{
		fprintf(logFp, "%s|%5d|[processCardPrint] Error %.3s received from Base 24 interface for the card # [%.19s]\n", getDateTime(), PID, b24ReplyMsg.retStatus, cardTabRec.cardNo);
		fflush(logFp);
		sprintf(tmpStr, "Error %.3s received from Base 24 server", b24ReplyMsg.retStatus);
		formatPrintCardResponse(INTERNALERR, tmpStr, tmpStr);
		sendResponse(responseMsg.printCard.msgLen);
		return FAILURE;
	}
	cardTabRec.branchCardPrdn  = 'N';  /* Initialised to N to avoid old values to stay in cardtab*/
	cardTabRec.branchPinSelect = 'N'; /* Initialised to N to avoid old values to stay in cardtab*/

	strncpy(cardTabRec.b24CardType, b24RequestMsg.cardType, 2);
	if ( receivedMsg.printCard.requestType != '3' ) /* not equal to FORCE_PIN */
		cardTabRec.branchCardPrdn = 'Y'; /* card produced at branch successfully */

	if ( receivedMsg.printCard.requestType != '2' ) /* not equal to FORCE_CARD */
		cardTabRec.branchPinSelect = 'Y';
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	if ( cardTabRec.requestType == '0' ) /* Initial request */
	{
		if ( cardTabRec.branchCardPrdn == 'Y' )
		{
			cardTabRec.requestStatus = '5'; /* Issue to customer */
			strncpy(cardTabRec.cardGeneratedDate, tmpStr, 8);
			strncpy(cardLogRec.cardGeneratedTime, &tmpStr[8], 6);
			strncpy(cardTabRec.cardGeneratedUserId, "BRCARDPRNT", 10);
			/*
			strncpy(cardTabRec.cBranchReceiptDate, tmpStr, 8);
			strncpy(cardLogRec.cBranchReceiptTime, &tmpStr[8],6);
			strncpy(cardTabRec.cBranchReceiptUserId, "BRCARDPRNT", 10);
			*/
			strncpy(cardTabRec.cCustIssueDate, tmpStr, 8);
			strncpy(cardLogRec.cCustIssueTime, &tmpStr[8],6);
			strncpy(cardTabRec.cCustIssueUserId, "BRCARDPRNT", 10);
		}
		if ( cardTabRec.branchPinSelect == 'Y' )
		{
			cardTabRec.pinRequestStatus = '5'; /* Issued to Customer */
			strncpy(cardTabRec.pCustIssueDate, tmpStr, 8);
			strncpy(cardLogRec.pCustIssueTime, &tmpStr[8],6);
			strncpy(cardTabRec.pCustIssueUserId, "BRPINSELECT", 10);
		}
		if ( cardTabRec.branchPinSelect == 'Y' && cardTabRec.branchCardPrdn == 'Y' )
			strncpy(cardTabRec.processDateTime, tmpStr, 14);

		cardTabRec.cardStatus = '1'; /* Open */
	}
	else if ( cardTabRec.requestType == '2' ) /* Force_card */
	{
		if ( cardTabRec.branchCardPrdn == 'Y' )
		{
			strncpy(cardTabRec.processDateTime, tmpStr, 14);
			cardTabRec.requestStatus = '5'; /* Received by Branch */ 
			strncpy(cardTabRec.cardGeneratedDate, tmpStr, 8);
			strncpy(cardLogRec.cardGeneratedTime, &tmpStr[8], 6);
			strncpy(cardTabRec.cardGeneratedUserId, "BRCARDPRNT", 10);
			/*
			strncpy(cardTabRec.cBranchReceiptDate, tmpStr, 8);
			strncpy(cardLogRec.cBranchReceiptTime, &tmpStr[8],6);
			strncpy(cardTabRec.cBranchReceiptUserId, "BRCARDPRNT", 10);
			*/

			strncpy(cardTabRec.cCustIssueDate, tmpStr, 8);
			strncpy(cardLogRec.cCustIssueTime, &tmpStr[8],6);
			strncpy(cardTabRec.cCustIssueUserId, "BRCARDPRNT", 10);
		}
	}
	else if ( cardTabRec.requestType == '3' ) /* Force_pin */
	{
		if ( cardTabRec.branchPinSelect == 'Y' )
		{
			strncpy(cardTabRec.processDateTime, tmpStr, 14);
			cardTabRec.pinRequestStatus = '5'; /* Issued to Customer */
			strncpy(cardTabRec.pCustIssueDate, tmpStr, 8);
			strncpy(cardLogRec.pCustIssueTime, &tmpStr[8],6);
			strncpy(cardTabRec.pCustIssueUserId, "BRPINSELECT", 10);
		}
	}

	strncpy(cardTabRec.lastUpdateUser, receivedMsg.printCard.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(cardTabRec.lastUpdateDateTime, tmpStr, 14);

	if ( updateCardTabFile() < 0 )
	{
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	cardLogRec.requestStatus = cardTabRec.requestStatus; 

	strncpy(&cardLogRec.cardType, &cardTabRec.cardType, 374);
	strncpy(cardLogRec.coreAccNo, cardTabRec.coreAccNo, 16);
	strncpy(cardLogRec.coreCustNo, cardTabRec.coreCustNo, 8);
	cardLogRec.requestType =  cardTabRec.requestType;
	cardLogRec.branchCardPrdn = cardTabRec.branchCardPrdn;
	cardLogRec.branchPinSelect = cardTabRec.branchPinSelect;

	if ( cardTabRec.requestType == '3' ) /* Force_pin */
		memset(cardLogRec.cardGeneratedDate, ' ', 54);
	if ( cardTabRec.requestType == '2' ) /* Force_card */
		memset(cardLogRec.pinGeneratedDate, ' ', 54);

	strncpy(cardLogRec.lastUpdateUser, receivedMsg.printCard.userId, 10);
	strncpy(cardLogRec.processDateTime, cardTabRec.processDateTime,14);

	if ( cardLogExists == YES )
	{
		if ( updateCardLogFile() < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
	}

	formatPrintCardResponse(DONE, "Successful", "Successful");
	sendResponse(responseMsg.printCard.msgLen);
	return SUCCESS;
}

validateCustNo(char *custNo)
{
	char bmCustNo[10], tmpStr[50];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[validateCustNo] for customer number [%.8s]\n", getDateTime(), PID, custNo);

	memset(custInfoResponseMsg.msgLen, ' ', sizeof custInfoResponseMsg);
	memset(custInfoReqMsg.msgLen, ' ', sizeof custInfoReqMsg);
	strncpy(custInfoReqMsg.branchName,"CB-CMS          ",10);
	strncpy(custInfoReqMsg.source,"CM", 2);
	strncpy(custInfoReqMsg.service,"05", 2);
	strncpy(custInfoReqMsg.custNo, custNo, 8);
	strncpy(custInfoReqMsg.userId, postingUserId, 4); /* postingUserId is taken from cbcmssrv.cfg file */
	custInfoReqMsg.endOfText = 'Z';
	custInfoReqMsg.nullPad = '\0';

	sprintf(tmpStr,"%04d",strlen(custInfoReqMsg.msgLen));
	strncpy(custInfoReqMsg.msgLen, tmpStr,4);

	fprintf(logFp, "%s|%5d|[validateCustNo] Send to TUXEDO [%s] \n", getDateTime(), PID, custInfoReqMsg.msgLen);
	fflush(logFp);

	if ( dealWithTuxedo("FINONLNGWENQ", custInfoReqMsg.msgLen, custInfoResponseMsg.msgLen) == FAILURE )
		return FAILURE;

	if ( strncmp(custInfoResponseMsg.responseStatus, "00000",5) )
	{
		fprintf(logFp, "%s|%5d|[validateCustNo] Error [%.5s] received from  FINACLE online gateway ; Please check \n", getDateTime(), PID, custInfoResponseMsg.responseStatus);
		fflush(logFp);
		return FAILURE;
	}

	return SUCCESS;
}

validateAccNo(char *accNo)
{
	char bmCustNo[10], tmpStr[50];
	char officeTelNo[50], homeTelNo[50], mobileNo[30], faxNo[50], emailAddr[50];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[validateAccNo] for account number [%.16s]\n", getDateTime(), PID, accNo);

	memset(acctInfoReqMsg.msgLen, ' ', sizeof custInfoReqMsg);
	strncpy(acctInfoReqMsg.branchName,"CB-CMS          ",10);
	strncpy(acctInfoReqMsg.source,"CM", 2);
	strncpy(acctInfoReqMsg.service,"04", 2);
	strncpy(acctInfoReqMsg.accNo, accNo, 16);
	strncpy(acctInfoReqMsg.userId, postingUserId, 4); /* postingUserId is taken from cbcmssrv.cfg file */
	acctInfoReqMsg.endOfText = 'Z';
	acctInfoReqMsg.nullPad = '\0';

	sprintf(tmpStr,"%04d",strlen(acctInfoReqMsg.msgLen));
	strncpy(acctInfoReqMsg.msgLen, tmpStr,4);

	fprintf(logFp, "%s|%5d|[validateAccNo] Send to TUXEDO [%s] \n", getDateTime(), PID, acctInfoReqMsg.msgLen);
	fflush(logFp);

	if ( dealWithTuxedo("FINONLNGWENQ", acctInfoReqMsg.msgLen, acctInfoResponseMsg.msgLen) == FAILURE )
		return FAILURE;

	if ( strncmp(acctInfoResponseMsg.responseStatus, "00000",5) )
	{
		fprintf(logFp, "%s|%5d|[validateAccNo] Error [%.5s] received from  FINACLE online gateway for the account # [%.16s] ; Please check \n", getDateTime(), PID, acctInfoResponseMsg.responseStatus, accNo);
		fflush(logFp);
		return FAILURE;
	}

	return SUCCESS;
}

