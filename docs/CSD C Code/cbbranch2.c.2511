formatStopChqDetailResponse(responseCode, aRemarks, eRemarks)
char *responseCode, *aRemarks, *eRemarks;
{
	char	tmpStr[100];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[formatStopChqDetailRespoonse] formating the response\n", getDateTime(), PID);

	strncpy(responseMsg.stopChqDetail.status, responseCode, 3);
	sprintf(tmpStr, "%-50.50s", aRemarks);
	strncpy(responseMsg.stopChqDetail.aRemarks,tmpStr,50);
	sprintf(tmpStr, "%-50.50s", eRemarks);
	strncpy(responseMsg.stopChqDetail.eRemarks,tmpStr,50);
	strncpy(responseMsg.stopChqDetail.service, receivedMsg.stopChqDetail.service, 2);
	responseMsg.stopChqDetail.nullPad = '\0';
	sprintf(tmpStr, "%06d", strlen(responseMsg.stopChqDetail.msgLen));
	strncpy(responseMsg.stopChqDetail.msgLen, tmpStr, 6);
	if ( responseCode == COMMSERR )
	{
		iscleanup();
		fclose(logFp);
	}
	return SUCCESS;
}

formatStdOrdDetailResponse(responseCode, aRemarks, eRemarks)
char *responseCode, *aRemarks, *eRemarks;
{
	char	tmpStr[100];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[formatStdOrdDetailResponse] formating the response\n", getDateTime(), PID);

	strncpy(responseMsg.stdOrdDetail.status, responseCode, 3);
	sprintf(tmpStr, "%-50.50s", aRemarks);
	strncpy(responseMsg.stdOrdDetail.aRemarks,tmpStr,50);
	sprintf(tmpStr, "%-50.50s", eRemarks);
	strncpy(responseMsg.stdOrdDetail.eRemarks,tmpStr,50);
	strncpy(responseMsg.stdOrdDetail.service, receivedMsg.stdOrdDetail.service, 2);
	responseMsg.stdOrdDetail.nullPad = '\0';
	sprintf(tmpStr, "%06d", strlen(responseMsg.stdOrdDetail.msgLen));
	strncpy(responseMsg.stdOrdDetail.msgLen, tmpStr, 6);
	if ( responseCode == COMMSERR )
	{
		iscleanup();
		fclose(logFp);
	}
	return SUCCESS;
}

logStopChqSearch()
{
	if ( debug == 0 )
		return SUCCESS;

	fprintf(logFp, "%s : INCOMMING MESSAGE from %s\n", getDateTime(), authorisedUser);
	fprintf(logFp, "===================================\n");
	fprintf(logFp, "Service 		: %.2s[Stop Cheque Search]\n", receivedMsg.stdOrdSearch.service);
	fprintf(logFp, "Branch Code		: %.4s\n", receivedMsg.stdOrdSearch.homeBranch);
	fprintf(logFp, "User Id			: %.10s\n", receivedMsg.stdOrdSearch.userId);
	fprintf(logFp, "Last Rec Count	: %.5s\n", receivedMsg.stdOrdSearch.lastRecCount);
	fprintf(logFp, "Stop.Chq Acc No	: %.14s\n", receivedMsg.stdOrdSearch.accNo);
	fflush(logFp);
}

logStopChqDetail()
{
	if ( debug == 0 )
		return SUCCESS;

	fprintf(logFp, "%s : INCOMMING MESSAGE from %s\n", getDateTime(), authorisedUser);
	fprintf(logFp, "===================================\n");
	if ( strncmp(receivedMsg.stopChqDetail.requestType, "03",2) == 0 )
		fprintf(logFp, "Service         : %.2s[Cancel Stop Cheque Request]\n", receivedMsg.stopChqDetail.service);
	else
		fprintf(logFp, "Service         : %.2s[Stop Cheque Detail]\n", receivedMsg.stopChqDetail.service);
	fprintf(logFp, "Branch Code         : %.4s\n", receivedMsg.stopChqDetail.homeBranch);
	fprintf(logFp, "Request Type        : %.2s\n", receivedMsg.stopChqDetail.requestType);
	fprintf(logFp, "User Id             : %.10s\n", receivedMsg.stopChqDetail.userId);
	if ( strncmp(receivedMsg.stdOrdDetail.requestType, "01",2) == 0 )
		fprintf(logFp, "Date & Time     : %.14s\n", receivedMsg.stopChqDetail.accNo);
	else
	{
		fprintf(logFp, "Account Number  : %.14s\n", receivedMsg.stopChqDetail.accNo);
		fprintf(logFp, "Cheque  Number  : %.10s\n", receivedMsg.stopChqDetail.chequeNo);
	}
	fflush(logFp);
}

formatStopChqSearchResponse(responseCode, aRemarks, eRemarks)
char *responseCode, *aRemarks,*eRemarks;
{
	char tmpStr[120];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[formatStopChqSearchRespone] Formating the response\n", getDateTime(), PID);

	strncpy(responseMsg.stopChqSearch.status, responseCode, 3);
	sprintf(tmpStr, "%-50.50s", aRemarks);
	strncpy(responseMsg.stopChqSearch.aRemarks,tmpStr,50);
	sprintf(tmpStr, "%-50.50s", eRemarks);
	strncpy(responseMsg.stopChqSearch.eRemarks,tmpStr,50);
	strncpy(responseMsg.stopChqSearch.service, receivedMsg.stdOrdSearch.service, 2);
	responseMsg.stopChqSearch.nullPad = '\0';
	sprintf(tmpStr, "%06d", strlen(responseMsg.stopChqSearch.msgLen));
	strncpy(responseMsg.stopChqSearch.msgLen, tmpStr, 6);
	if ( responseCode == COMMSERR )
	{
		iscleanup();
		fclose(logFp);
	}
	return SUCCESS;
}

