processCardSearchRequest()
{
	int lastRecRcvd, recCount=0, recsInThisMsg = 0, searchType = 0, i, len;
	int validCust;
	char tmpStr[100]; 
	char tAccNo[20],tCustNo[15], aShortName[30], eShortName[30];
	char officeTelNo[50], homeTelNo[50], mobileNo[30], faxNo[50], emailAddr[50];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processCardSearchRequest]\n", getDateTime(), PID);

	memset(responseMsg.cardSearch.msgLen, ' ', sizeof responseMsg.cardSearch);
	responseMsg.cardSearch.nullPad = '\0';

	sprintf(tmpStr, "%.5s", receivedMsg.cardSearch.lastRecCount);
	lastRecRcvd = atoi(tmpStr);

	memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);
	if ( strncmp(receivedMsg.cardSearch.custNo, "           ", 8 ) )  
	{
		searchType = SEARCH_BY_CUSTNO;
		strncpy(tCustNo, receivedMsg.cardSearch.custNo,8);
		validCust = validateCustNo(tCustNo);
		if ( validCust == FAILURE )
		{
			if ( strncmp(custInfoResponseMsg.responseStatus, "00005", 5) == 0  )
				sprintf(tmpStr, "Invalid Customer No %.8s..Please Check", tCustNo);
			else
				sprintf(tmpStr, "Error %.5s while reading account ", custInfoResponseMsg.responseStatus);
			responseMsg.cardSearch.details[recsInThisMsg+1].cardNo[0] = '\0';
			formatCardSearchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		sprintf(tCustNo, "%.8s", receivedMsg.cardSearch.custNo);

		/*isindexinfo(cardTabFile, &cardTabKey, 4);*/
		isindexinfo(cardTabFile, &cardTabKey, 10);
		/*strncpy(&cardTabRec.coreAccNo[4], receivedMsg.cardSearch.custNo, 8);*/
		strncpy(cardTabRec.coreCustNo, receivedMsg.cardSearch.custNo, 8);
		isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar, ISGTEQ);
	}
	else if ( strncmp(receivedMsg.cardSearch.accNo, "                  ", 16) )
	{
		searchType = SEARCH_BY_ACCTNO;

		sprintf(tAccNo, "%.16s", receivedMsg.cardSearch.accNo);
		if ( validateAccNo(tAccNo) == FAILURE )
		{
			if ( strncmp(acctInfoResponseMsg.responseStatus, "00005", 5) == 0  )
				sprintf(tmpStr, "Attached Account not exist for this customer");
			else
				sprintf(tmpStr, "Error %.5s while reading account ", acctInfoResponseMsg.responseStatus);
			formatCardSearchResponse(END_OF_FILE, tmpStr, tmpStr ); 
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		sprintf(tCustNo, "%.8s", acctInfoResponseMsg.custNo); 

		if ( validateCustNo(tCustNo) == FAILURE )
		{
			if ( strncmp(custInfoResponseMsg.responseStatus, "00005", 5) == 0  )
				sprintf(tmpStr, "Invalid Customer No %.8s..Please Check", tCustNo);
			else
				sprintf(tmpStr, "Error %.5s while reading account ", custInfoResponseMsg.responseStatus);

			responseMsg.cardSearch.details[recsInThisMsg+1].cardNo[0] = '\0';
			formatCardSearchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}

		/*isindexinfo(cardTabFile, &cardTabKey, 2);*/
		isindexinfo(cardTabFile, &cardTabKey, 9);
		strncpy(cardTabRec.coreAccNo, receivedMsg.cardSearch.accNo, 16);
		isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar, ISGTEQ);
	}
	else if( strncmp(receivedMsg.cardSearch.cardNo, "                    ", 19) )
	{
		searchType = SEARCH_BY_CARDNO;
		isindexinfo(cardTabFile, &cardTabKey, 1);
		strncpy(cardTabRec.cardNo, receivedMsg.cardSearch.cardNo,19);
		isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar, ISGTEQ);
		if ( isRead(cardTabFile, &cardTabRec.liveChar, ISEQUAL) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processCardSearchRequest] ISREAD error %d on cbcardtab while searching for the card # [%.19s]\n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
			fflush(logFp);
			responseMsg.cardSearch.details[recsInThisMsg+1].cardNo[0] = '\0';
			formatCardSearchResponse(INTERNALERR,"Invalid Card Number..Please Check","Invalid Card Number..Please Check");
			sendResponse(responseMsg.cardSearch.msgLen);
			return FAILURE;
		}
		if ( strncmp(cardTabRec.cardNo, receivedMsg.cardSearch.cardNo, 19) == 0)
		{
			sprintf(tCustNo, "%.8s", cardTabRec.coreCustNo);
			if ( validateCustNo(tCustNo) == FAILURE )
			{
				if ( strncmp(custInfoResponseMsg.responseStatus, "00005", 5) == 0  )
					sprintf(tmpStr, "Invalid Customer No %.8s..Please Check", tCustNo);
				else
					sprintf(tmpStr, "Error %.5s while reading account ", custInfoResponseMsg.responseStatus);
				responseMsg.cardSearch.details[recsInThisMsg+1].cardNo[0] = '\0';
				formatCardSearchResponse(INTERNALERR, tmpStr, tmpStr);
				sendResponse(responseMsg.cardSearch.msgLen);
				return FAILURE;
			}

			strncpy(responseMsg.cardSearch.custNo, tCustNo, 8);
			strncpy(responseMsg.cardSearch.aShortName, custInfoResponseMsg.shortName, 30);
			strncpy(responseMsg.cardSearch.eShortName, custInfoResponseMsg.shortName, 30);
			/*responseMsg.cardSearch.addressType = custTabRec.addressType;*/
			responseMsg.cardSearch.addressType =  '0'; /* CHECK : to be verified with CBS team possibility of sending this field also */
			strncpy(responseMsg.cardSearch.address1, custInfoResponseMsg.address1, 30);
			strncpy(responseMsg.cardSearch.poBox, custInfoResponseMsg.poBox, 10);
			strncpy(responseMsg.cardSearch.cityName, custInfoResponseMsg.cityName, 20);
			strncpy(responseMsg.cardSearch.zipCode, custInfoResponseMsg.zipCode, 10);
			strncpy(responseMsg.cardSearch.custBranchCode, custInfoResponseMsg.branchCode,4);
			/*if ( custInfoResponseMsg.custType == '1' || custInfoResponseMsg.custType == ' ' || custInfoResponseMsg.custType == '4' )*/
			if ( custInfoResponseMsg.custType == '1' || custInfoResponseMsg.custType == '4' )
				responseMsg.cardSearch.custType = '0';
			else
				responseMsg.cardSearch.custType = '1';

			if ( (custInfoResponseMsg.custType == ' ' || custInfoResponseMsg.custType == 'R') && strncmp(custInfoResponseMsg.custNo, "06000000", 8) >= 0 ) /* for the new customers from finacle opened through quick screen, cust type is coming as SPACES.., send it as RETAIL to allow ATM card request ; As advised by Arul on 11th July 2009*/
			{
				fprintf(logFp, "%s|%5d|[processCardSearchRequest] Customer Type is coming as [%c] from FI for the customer [%.8s] (opened in Finacle) ; responding to static data as RETAIL to allow requesting ATM card \n", getDateTime(), PID, custInfoResponseMsg.custType, custInfoResponseMsg.custNo);
				fflush(logFp);
				responseMsg.cardSearch.custType = '0';
			}

			if ( custInfoResponseMsg.preferredLang == '2' ) /* 2-ARABIC */
				responseMsg.cardSearch.customerLang = '0';
			else
				responseMsg.cardSearch.customerLang = '1';  /* English */

			strncpy(responseMsg.cardSearch.remarksInfo.applnPrint.idNo, custInfoResponseMsg.idNo, 10);

			memset(officeTelNo, ' ', sizeof officeTelNo);
			memset(homeTelNo, ' ', sizeof homeTelNo);

			strncpy(responseMsg.cardSearch.remarksInfo.applnPrint.homeTelNo, custInfoResponseMsg.homeTelNo, 20);
			strncpy(responseMsg.cardSearch.remarksInfo.applnPrint.offTelNo, custInfoResponseMsg.officeTelNo, 20);

			strncpy(responseMsg.cardSearch.details[recsInThisMsg].cardNo, cardTabRec.cardNo, 19);
			strncpy(responseMsg.cardSearch.details[recsInThisMsg].nameOnTheCard, cardTabRec.nameOnTheCard, 26);
			strncpy(responseMsg.cardSearch.details[recsInThisMsg].issueDate, cardTabRec.firstIssueDate, 8);
			strncpy(responseMsg.cardSearch.details[recsInThisMsg].expiryDate, cardTabRec.expireDate, 8);
			responseMsg.cardSearch.details[recsInThisMsg].cardStatus = cardTabRec.cardStatus;
			responseMsg.cardSearch.details[recsInThisMsg].requestStatus = cardTabRec.requestStatus;
			responseMsg.cardSearch.details[recsInThisMsg].pinRequestStatus = cardTabRec.pinRequestStatus;
			strncpy(responseMsg.cardSearch.details[recsInThisMsg].coreAccNo, cardTabRec.coreAccNo, 16);
			recsInThisMsg++;
			sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
			strncpy(responseMsg.cardSearch.lastRecCount, tmpStr, 5);
			sprintf(tmpStr, "%02d", recsInThisMsg);
			strncpy(responseMsg.cardSearch.noOfRecs, tmpStr, 2);
			formatCardSearchResponse(DONE, "Successful", "Successful");
			fflush(logFp);
			sendResponse(responseMsg.cardSearch.msgLen);
			return SUCCESS;
		}
	}
	else if ( strncmp(receivedMsg.cardSearch.idNo, "                      ", 15) ) /* Search on IdNo is disabled in the front-end, so this portion should not be considered... it is kept for furture use (it may be) */
	{
		searchType = SEARCH_BY_IDNO;
		isindexinfo(cardTabFile, &cardTabKey, 4); /* CHECK - this index has been removed since card search on idno is disabled  */
		strncpy(cardTabRec.idNo, receivedMsg.cardSearch.idNo,15);
		isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar, ISGTEQ);
		if ( strncmp(cardTabRec.idNo, receivedMsg.cardSearch.idNo, 15) == 0)
		{
			strncpy(tCustNo, cardTabRec.coreCustNo,8);
			if ( validateCustNo(tCustNo) == FAILURE )
			{
				if ( strncmp(custInfoResponseMsg.responseStatus, "00005", 5) == 0  )
					sprintf(tmpStr, "Invalid Customer No %.8s..Please Check", tCustNo);
				else
					sprintf(tmpStr, "Error %.5s while reading account ", custInfoResponseMsg.responseStatus);
				formatCardSearchResponse(INTERNALERR, tmpStr, tmpStr);
				sendResponse(responseMsg.cardSearch.msgLen);
				return FAILURE;
			}
			else
			{
				strncpy(responseMsg.cardSearch.custNo, tCustNo, 7);
				/*CBS
				strncpy(responseMsg.cardSearch.aShortName, custTabRec.aShortName,30);
				strncpy(responseMsg.cardSearch.eShortName, custTabRec.eShortName,30);
				*/
			}
		}
	}

	strncpy(responseMsg.cardSearch.custNo, tCustNo, 8);
	strncpy(responseMsg.cardSearch.aShortName, custInfoResponseMsg.shortName, 30);
	strncpy(responseMsg.cardSearch.eShortName, custInfoResponseMsg.shortName, 30);
	/*responseMsg.cardSearch.addressType = custTabRec.addressType;*/
	responseMsg.cardSearch.addressType =  '0'; /* CHECK : to be verified with CBS team possibility of sending this field also */
	strncpy(responseMsg.cardSearch.address1, custInfoResponseMsg.address1, 30);
	strncpy(responseMsg.cardSearch.poBox, custInfoResponseMsg.poBox, 10);
	strncpy(responseMsg.cardSearch.cityName, custInfoResponseMsg.cityName, 20);
	strncpy(responseMsg.cardSearch.zipCode, custInfoResponseMsg.zipCode, 10);
	strncpy(responseMsg.cardSearch.custBranchCode, custInfoResponseMsg.branchCode, 4);
	if ( custInfoResponseMsg.custType == '1' || custInfoResponseMsg.custType == '4' )
		responseMsg.cardSearch.custType = '0';
	else
		responseMsg.cardSearch.custType = '1';

	if ( (custInfoResponseMsg.custType == ' ' || custInfoResponseMsg.custType == 'R') && strncmp(custInfoResponseMsg.custNo, "06000000", 8) >= 0 ) /* for the new customers from finacle opened through quick screen, cust type is coming as SPACES.., send it as RETAIL to allow ATM card request ; As advised by Arul on 11th July 2009*/
	{
		fprintf(logFp, "%s|%5d|[processCardSearchRequest] Customer Type is coming as [%c] from FI for the customer [%.8s] (opened in Finacle) ; responding to static data as RETAIL to allow requesting ATM card \n", getDateTime(), PID, custInfoResponseMsg.custType, custInfoResponseMsg.custNo);
		fflush(logFp);
		responseMsg.cardSearch.custType = '0';
	}

	if ( custInfoResponseMsg.preferredLang == '2' ) /* 2-ARABIC */
		responseMsg.cardSearch.customerLang = '0';
	else
		responseMsg.cardSearch.customerLang = '1';  /* English */

	strncpy(responseMsg.cardSearch.remarksInfo.applnPrint.idNo, custInfoResponseMsg.idNo, 10);

	/*
	if ( strncmp(custTabRec.samaMainCategory, "        ", 4) )
	{
		getCtlDesc("CC", custTabRec.samaMainCategory);
		memcpy(&categoryConfigRec.liveChar, &ctlRec.liveChar, sizeof ctlRec);
	}
	if ( responseMsg.cardSearch.custType == '1' )
	{
		if ( categoryConfigRec.atmCardAllowed == '1' )
		{
			fprintf(logFp, "%s|%5d| ATM card is set as allowed in the control table for the customer  #[%.7s]; Main & Subcategory [%.2s;%.2s]; so , customer type is set as Individual \n", getDateTime(), PID, custTabRec.custNo, custTabRec.samaMainCategory, custTabRec.samaSubCategory);
			fflush(logFp);
			responseMsg.cardSearch.custType = '0';
		}
	}
	else
	{
		if ( categoryConfigRec.atmCardAllowed != '1' && strncmp(custTabRec.samaMainCategory, "0000", 4) )
		{
			fprintf(logFp, "%s|%5d| ATM card is set as NOT allowed(%c) in the control table for the customer  #[%.7s]; Main & Subcategory [%.2s;%.2s]; so , customer type is set as \"2\" for Individual customer card rejection \n", getDateTime(), PID, categoryConfigRec.atmCardAllowed, custTabRec.custNo, custTabRec.samaMainCategory, custTabRec.samaSubCategory);
			fflush(logFp);
			responseMsg.cardSearch.custType = '2';
		}
	}
	*/

	memset(officeTelNo, ' ', sizeof officeTelNo);
	memset(homeTelNo, ' ', sizeof homeTelNo);
	strncpy(responseMsg.cardSearch.remarksInfo.applnPrint.homeTelNo, custInfoResponseMsg.homeTelNo, 20);
	strncpy(responseMsg.cardSearch.remarksInfo.applnPrint.offTelNo, custInfoResponseMsg.officeTelNo, 20);

	while ( isread(cardTabFile, &cardTabRec.liveChar, ISNEXT) == 0 )
	{
		if ( recCount++ < lastRecRcvd )
			continue; /* read all records already sent */

		if ( searchType == SEARCH_BY_CUSTNO )
		{
			/*if ( strncmp(&cardTabRec.coreAccNo[4], receivedMsg.cardSearch.custNo, 8) )*/
			if ( strncmp(cardTabRec.coreCustNo, receivedMsg.cardSearch.custNo, 8) )
				break;
		}
		if ( searchType == SEARCH_BY_CARDNO )
		{
			if ( strncmp(cardTabRec.cardNo, receivedMsg.cardSearch.cardNo,19) )
				break;
		}

		if ( searchType == SEARCH_BY_ACCTNO )
		{
			if ( strncmp(cardTabRec.coreAccNo, receivedMsg.cardSearch.accNo, 16) )
				break;
		}

		if ( searchType == SEARCH_BY_IDNO )
		{
			if ( strncmp(cardTabRec.idNo, receivedMsg.cardSearch.idNo, 15) )
				break;
		}

		len = sizeof(cardTabRec);

		for (i=0; i < len; i++)
		{
			if ( cardTabRec.processDateTime[i] == NULL )
				cardTabRec.processDateTime[i] = ' ';
		}

		strncpy(responseMsg.cardSearch.details[recsInThisMsg].cardNo, cardTabRec.cardNo, 19);
		strncpy(responseMsg.cardSearch.details[recsInThisMsg].nameOnTheCard, cardTabRec.nameOnTheCard, 26);
		strncpy(responseMsg.cardSearch.details[recsInThisMsg].issueDate, cardTabRec.firstIssueDate, 8);
		strncpy(responseMsg.cardSearch.details[recsInThisMsg].expiryDate, cardTabRec.expireDate, 8);
		responseMsg.cardSearch.details[recsInThisMsg].cardStatus = cardTabRec.cardStatus;
		responseMsg.cardSearch.details[recsInThisMsg].requestStatus = cardTabRec.requestStatus;
		responseMsg.cardSearch.details[recsInThisMsg].pinRequestStatus = cardTabRec.pinRequestStatus;
		strncpy(responseMsg.cardSearch.details[recsInThisMsg].coreAccNo, cardTabRec.coreAccNo, 16);

		if ( ++recsInThisMsg >=  20 )
			break;
	}
	sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
	strncpy(responseMsg.cardSearch.lastRecCount, tmpStr, 5);
	sprintf(tmpStr, "%02d", recsInThisMsg);
	strncpy(responseMsg.cardSearch.noOfRecs, tmpStr, 2);
	formatCardSearchResponse(DONE, "Successful", "Successful");
	fflush(logFp);
	sendResponse(responseMsg.cardSearch.msgLen);
	return SUCCESS;
}

readCardPendingList()
{
	int lastRecRcvd, recCount=0, recsInThisMsg = 0, searchType = 0, i, nameLen;
	char tmpStr[100]; 
	char tAccNo[20],tCustNo[15];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[readCardPendingList]\n", getDateTime(), PID);


	memset(responseMsg.cardPendingList.msgLen, ' ', sizeof responseMsg.cardPendingList);
	responseMsg.cardPendingList.nullPad = '\0';

	sprintf(tmpStr, "%.5s", receivedMsg.cardPendingList.lastRecCount);
	lastRecRcvd = atoi(tmpStr);

	memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);

	isindexinfo(cardLogFile, &cardLogKey, 4);
	if( receivedMsg.cardPendingList.activityFlag == SUPERVISOR_ACTION ) 
	{		
		strncpy(cardLogRec.branchCode, receivedMsg.cardPendingList.homeBranch,4);
		cardLogRec.bmUpdateStatus  = '1'; /* Pending with Supervisor */
		memset( cardLogRec.userId, ' ' ,10 );
	}
	else if( receivedMsg.cardPendingList.activityFlag == TELLER_ACTION ) 
	{
		strncpy(cardLogRec.branchCode,receivedMsg.cardPendingList.homeBranch,4);
		cardLogRec.bmUpdateStatus  = '2'; /* Pending with CSO */
		strncpy( cardLogRec.userId, receivedMsg.cardPendingList.userId ,10 ); 
	}
	else /* FINACLE_ACTION */
	{
		strncpy(cardLogRec.branchCode, receivedMsg.cardPendingList.homeBranch,4);
		cardLogRec.bmUpdateStatus  = 'C'; /* Pending request from Finacle */
		memset( cardLogRec.userId, ' ' ,10 );
	}

	if ( isstart(cardLogFile,&cardLogKey, 0, &cardLogRec.liveChar,ISGTEQ) < 0 )
	{
		if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
			formatCardPendingListResponse(END_OF_FILE,"No more Records to fetch....", "No more Records to fetch....");
		else
		{
			fprintf(logFp,"%s|%5d|[readCardPendingList] C-ISAM Error %d occured during ISSTART on cbcardlog, key [%.14s %c]\n", getDateTime(), PID, iserrno, cardLogRec.branchCode, cardLogRec.bmUpdateStatus);
			sprintf(tmpStr, "CISAM Error %d occured on cbcardlog file", iserrno);
			formatCardPendingListResponse(INTERNALERR, tmpStr, tmpStr);
		}
     	sendResponse(responseMsg.cardPendingList.msgLen);
		return FAILURE;
	}

	while ( isread(cardLogFile, &cardLogRec.liveChar, ISNEXT) == 0 )
	{
		if ( receivedMsg.cardPendingList.activityFlag == SUPERVISOR_ACTION )
		{	
		 	if (strncmp(receivedMsg.cardPendingList.homeBranch, cardLogRec.branchCode,4) != 0 || cardLogRec.bmUpdateStatus !=  '1') 
				break;
		}
		else if ( receivedMsg.cardPendingList.activityFlag == TELLER_ACTION )
		{
		 	if (strncmp(receivedMsg.cardPendingList.homeBranch,cardLogRec.branchCode,4) != 0 || strncmp(receivedMsg.cardPendingList.userId,cardLogRec.userId,10) != 0 || cardLogRec.bmUpdateStatus !=  '2') 
				break;
		}
		else /* FINACLE_ACTION */
		{
		 	if (strncmp(receivedMsg.cardPendingList.homeBranch, cardLogRec.branchCode,4) != 0 || cardLogRec.bmUpdateStatus !=  'C') 
				break;
		}

		if ( strncmp(receivedMsg.cardPendingList.custNo, "           ", 8) && receivedMsg.cardPendingList.custNo[0] != NULL && 
			 strncmp(receivedMsg.cardPendingList.custNo, "00000000", 8) )
		{
			if ( strncmp(receivedMsg.cardPendingList.custNo, cardLogRec.coreCustNo, 8) )
				continue;
		}

		if ( recCount++ < lastRecRcvd )
			continue; /* read all records already sent */
		
		strncpy(responseMsg.cardPendingList.details[recsInThisMsg].userId, cardLogRec.userId, 10);
		strncpy(responseMsg.cardPendingList.details[recsInThisMsg].dateTime, cardLogRec.dateTime, 14);
		strncpy(responseMsg.cardPendingList.details[recsInThisMsg].cardNo, cardLogRec.cardNo, 19);
		strncpy(responseMsg.cardPendingList.details[recsInThisMsg].nameOnTheCard, cardLogRec.nameOnTheCard, 26);
		responseMsg.cardPendingList.details[recsInThisMsg].cardStatus = cardLogRec.cardType;
		responseMsg.cardPendingList.details[recsInThisMsg].natureOfCard = cardLogRec.primaryOrSupplementary;
		if ( cardLogRec.newOrUpdate == 'N' ) /* New Card */
			strncpy(responseMsg.cardPendingList.details[recsInThisMsg].pendingType, "New Card  ", 10);
		else /* if cardLogRec.newOrUpdate == 'U' */
		{
			if ( cardLogRec.requestType == '2' ) /* Force Card */
				strncpy(responseMsg.cardPendingList.details[recsInThisMsg].pendingType, "Force Card",10);
			else if ( cardLogRec.requestType == '3' ) /* Force Pin */
				strncpy(responseMsg.cardPendingList.details[recsInThisMsg].pendingType, "Force Pin ",10);
			else if ( cardLogRec.requestType == '5' ) /* Activation */
				strncpy(responseMsg.cardPendingList.details[recsInThisMsg].pendingType, "Activation", 10);
			else if ( cardLogRec.requestType == '7' ) /* Restriction */
				strncpy(responseMsg.cardPendingList.details[recsInThisMsg].pendingType, "Restriction", 10);
			else if ( cardLogRec.requestType == '8' ) /* Unrestrict */
				strncpy(responseMsg.cardPendingList.details[recsInThisMsg].pendingType, "Unrestrict", 10);
		}

		if ( ++recsInThisMsg >=  20 )
			break;
	}
	sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
	strncpy(responseMsg.cardPendingList.lastRecCount, tmpStr, 5);
	sprintf(tmpStr, "%02d", recsInThisMsg);
	strncpy(responseMsg.cardPendingList.noOfRecs, tmpStr, 2);
	responseMsg.cardPendingList.details[recsInThisMsg+1].userId[0] = '\0';
	formatCardPendingListResponse(DONE, "Successful", "Successful");
	fflush(logFp);
	sendResponse(responseMsg.cardPendingList.msgLen);
	return SUCCESS;
}

processCardDetailRequest()
{
	char tmpStr[200];
	int i;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[readCardDetailRequest]\n", getDateTime(), PID);


	memset(responseMsg.cardPendingDetail.msgLen, ' ', sizeof responseMsg.cardPendingDetail);

	memset(&cardTabRec.liveChar, ' ', sizeof cardTabRec);

	strncpy(cardTabRec.cardNo, receivedMsg.cardPendingDetail.cardNo, 19);

	isindexinfo(cardTabFile, &cardTabKey, 1);
	if( isstart(cardTabFile, &cardTabKey, 0, &cardTabRec.liveChar,ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processCardDetailRequest] :ISSTART/ISEQUAL error %d occured on cbcardtab file for card # [%.19s]\n", getDateTime(), PID, iserrno, cardTabRec.cardNo);
		fflush(logFp);
		if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
		     formatCardPendingDetailResponse(END_OF_FILE, "No Record found for this card...", "No Record found for this card ..");
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on cbcardtab", iserrno);
			formatCardPendingDetailResponse(INTERNALERR, tmpStr, tmpStr);
		}
     	sendResponse(responseMsg.cardPendingDetail.msgLen);
		return FAILURE;
	}

	if ( readCardTabFile(ISEQUAL) < 0 )
	{
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE ;
	}

	strncpy(responseMsg.cardPendingDetail.cardNo, cardTabRec.cardNo, 19);
	/*strncpy(responseMsg.cardPendingDetail.custNo, &cardTabRec.coreAccNo[4], 8);*/
	strncpy(responseMsg.cardPendingDetail.custNo, cardTabRec.coreCustNo, 8);
	responseMsg.cardPendingDetail.requestStatus = cardTabRec.requestStatus;
	strncpy(responseMsg.cardPendingDetail.deliveryBranchCode, cardTabRec.deliveryBranchCode, 4);

	for (i=0; i < 374; i++ )  /* for loop added by Arul on 07/01/2003 to avoid PIN-SELECT problem in production */
	{
		if ( cardTabRec.bmAccNo[i] == NULL ) /* bmAccNo is next character array to cardType */
			cardTabRec.bmAccNo[i] = ' ';
	}
	strncpy(&responseMsg.cardPendingDetail.cardType, &cardTabRec.cardType, 374);
	/*strncpy(responseMsg.cardPendingDetail.custNo, &cardTabRec.coreAccNo[4], 8);*/
	strncpy(responseMsg.cardPendingDetail.custNo, cardTabRec.coreCustNo, 8);
	strncpy(responseMsg.cardPendingDetail.coreAccNo, cardTabRec.coreAccNo, 16);

	if ( cardTabRec.requestType == '0' ) /* Initial Card */
		responseMsg.cardPendingDetail.newOrUpdate = 'N';
	else
		responseMsg.cardPendingDetail.newOrUpdate = 'U';

	sprintf(tmpStr, "%.8s", cardTabRec.coreCustNo);

	validateCustNo(tmpStr);  /* Return status is ignored */

	if ( custInfoResponseMsg.packageCustFlag > '0' )
		responseMsg.cardPendingDetail.custCategory = 'K'; /* Package Acc Holder */
	else if ( strncmp(custInfoResponseMsg.businessType, "029",3) == 0 || strncmp(custInfoResponseMsg.businessType,"290", 3) == 0 ) /*CHECK ; how business types are handled in CBS */
		responseMsg.cardPendingDetail.custCategory = 'P'; /* Pension Customer */
	else 
		responseMsg.cardPendingDetail.custCategory = ' '; 

	if ( custInfoResponseMsg.shortName[0] != NULL )
		strncpy(responseMsg.cardPendingDetail.custName, custInfoResponseMsg.shortName, 30);

	formatCardPendingDetailResponse(DONE, "Successfully fetched..", "Successfully fetched..");
	sendResponse(responseMsg.cardPendingDetail.msgLen);
	return SUCCESS;
}

getCardHistoryDetails()
{
	int noOfCardRec, noOfPinRec;
	int lastRecRcvd, recCount=0, recsInThisMsg = 0, searchType = 0, i, nameLen;
	char tmpStr[10];
	int len, currentYear=0;
	char *pathName;
	int  tmpCardLogFile;
	struct keydesc  tmpCardLogKey;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[getCardHistoryDetails]\n", getDateTime(), PID);

	noOfCardRec=noOfPinRec=0;

	if ( receivedMsg.cardHistory.msgType == '1' ) /* Card Update history */
	{
		sprintf(tmpStr, "%.5s", receivedMsg.cardHistory.lastRecCount);
		lastRecRcvd = atoi(tmpStr);
	}

	memset(responseMsg.cardHistory.msgLen, ' ', sizeof responseMsg.cardHistory);

	getDateTime();
	currentYear = systemDate->tm_year+1900;
	for ( i=2000; i < currentYear; i++ )
	{
		sprintf(tmpStr, "cardlog%04d", i);
		pathName = getpath(tmpStr, "cards");

		if ( (tmpCardLogFile  = isopen(pathName, ISMANULOCK+ISINPUT)) < 0)
		{
			if ( extraDebug > 8 ) 
			{
				fprintf(logFp, "%s|%5d|[getCardHistoryDetails] ISOPEN error %d for %s File IGNORED\n",getDateTime(), PID, iserrno, pathName);
				fflush(logFp);
			}
			free(pathName);
			continue;
		}
		free(pathName);
		isindexinfo(tmpCardLogFile, &tmpCardLogKey, 6); /* Key on card number */
		memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);
		strncpy(cardLogRec.cardNo, receivedMsg.cardHistory.cardNo, 19);

		isstart(tmpCardLogFile, &tmpCardLogKey, 0, &cardLogRec.liveChar,ISGTEQ);
		while ( isread(tmpCardLogFile, &cardLogRec.liveChar, ISNEXT) == 0 )
		{
			/* Remove NULL char from the record */
			replNullChars();

			if ( strncmp(cardLogRec.cardNo, receivedMsg.cardHistory.cardNo, 19) )
				break;

			if ( receivedMsg.cardHistory.msgType == '1' ) /* Card Update history */
			{
				if ( recCount++ < lastRecRcvd )
					continue; /* read all records already sent */

				strncpy(responseMsg.cardUpdateHistory.details[recsInThisMsg].branchCode, cardLogRec.branchCode, 4);
				strncpy(responseMsg.cardUpdateHistory.details[recsInThisMsg].userId, cardLogRec.userId, 10);
				strncpy(responseMsg.cardUpdateHistory.details[recsInThisMsg].dateTime, cardLogRec.dateTime, 14);
				responseMsg.cardUpdateHistory.details[recsInThisMsg].pendingStatus = cardLogRec.bmUpdateStatus;
				if ( cardLogRec.bmUpdateStatus != '1' && cardLogRec.bmUpdateStatus != '2' )
				{
					strncpy(responseMsg.cardUpdateHistory.details[recsInThisMsg].supervisorId, cardLogRec.supervisorId, 10);
					strncpy(responseMsg.cardUpdateHistory.details[recsInThisMsg].lastUpdateDateTime, cardLogRec.lastUpdateDateTime, 14);
				}
				responseMsg.cardUpdateHistory.details[recsInThisMsg].requestType = cardLogRec.requestType;

				if ( ++recsInThisMsg >= 20 ) 
					break;
			}
			else
			{
				if ( cardLogRec.bmUpdateStatus == '9' ) /* Only completed records are processed */
				{
					responseMsg.cardHistory.details[noOfCardRec].requestType = cardLogRec.requestType;
					strncpy(responseMsg.cardHistory.details[noOfCardRec].requestUserId, cardLogRec.userId,10);
					if ( cardLogRec.userId[0] >= '0' && cardLogRec.userId[0] <= '9' )
						strncpy(&responseMsg.cardHistory.details[noOfCardRec].requestUserId[7], &cardLogRec.branchCode[1], 3);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].requestDateTime,cardLogRec.dateTime,14);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].cardGeneratedDate, cardLogRec.cardGeneratedDate,8);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].cardGeneratedTime, cardLogRec.cardGeneratedTime, 6);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].cardGeneratedUserId, cardLogRec.cardGeneratedUserId, 10);
					if ( cardLogRec.cardGeneratedUserId[0] >= '0' && cardLogRec.cardGeneratedUserId[0] <= '9' )
						strncpy(&responseMsg.cardHistory.details[noOfCardRec].cardGeneratedUserId[7], &cardLogRec.branchCode[1], 3);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].cBranchReceiptDate, cardLogRec.cBranchReceiptDate, 8);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].cBranchReceiptTime, cardLogRec.cBranchReceiptTime, 6);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].cBranchReceiptUserId, cardLogRec.cBranchReceiptUserId, 10);
					if ( cardLogRec.cBranchReceiptUserId[0] >= '0' && cardLogRec.cBranchReceiptUserId[0] <= '9' )
						strncpy(&responseMsg.cardHistory.details[noOfCardRec].cBranchReceiptUserId[7], &cardLogRec.branchCode[1], 3);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].cCustIssueDate, cardLogRec.cCustIssueDate, 8);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].cCustIssueTime, cardLogRec.cCustIssueTime, 6);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].cCustIssueUserId, cardLogRec.cCustIssueUserId, 10);
					if ( cardLogRec.cCustIssueUserId[0] >= '0' && cardLogRec.cCustIssueUserId[0] <= '9' )
						strncpy(&responseMsg.cardHistory.details[noOfCardRec].cCustIssueUserId[7], &cardLogRec.branchCode[1], 3);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].pinGeneratedDate, cardLogRec.pinGeneratedDate, 8);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].pinGeneratedTime, cardLogRec.pinGeneratedTime, 6);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].pinGeneratedUserId, cardLogRec.pinGeneratedUserId, 10);
					if ( cardLogRec.pinGeneratedUserId[0] >= '0' && cardLogRec.pinGeneratedUserId[0] <= '9' )
						strncpy(&responseMsg.cardHistory.details[noOfCardRec].pinGeneratedUserId[7], &cardLogRec.branchCode[1], 3);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].pBranchReceiptDate, cardLogRec.pBranchReceiptDate, 8);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].pBranchReceiptTime, cardLogRec.pBranchReceiptTime, 6);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].pBranchReceiptUserId, cardLogRec.pBranchReceiptUserId, 10);
					if ( cardLogRec.pBranchReceiptUserId[0] >= '0' && cardLogRec.pBranchReceiptUserId[0] <= '9' )
						strncpy(&responseMsg.cardHistory.details[noOfCardRec].pBranchReceiptUserId[7], &cardLogRec.branchCode[1], 3);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].pCustIssueDate, cardLogRec.pCustIssueDate, 8);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].pCustIssueTime, cardLogRec.pCustIssueTime, 6);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].pCustIssueUserId, cardLogRec.pCustIssueUserId, 10);
					if ( cardLogRec.pCustIssueUserId[0] >= '0' && cardLogRec.pCustIssueUserId[0] <= '9' )
						strncpy(&responseMsg.cardHistory.details[noOfCardRec].pCustIssueUserId[7], &cardLogRec.branchCode[1], 3);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].supervisorId, cardLogRec.supervisorId, 10);
					if ( cardLogRec.supervisorId[0] >= '0' && cardLogRec.supervisorId[0] <= '9' )
						strncpy(&responseMsg.cardHistory.details[noOfCardRec].supervisorId[7], &cardLogRec.branchCode[1], 3);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].lastUpdateDateTime,cardLogRec.lastUpdateDateTime, 14);
					/*if ( cardLogRec.branchCardPrdn != 'Y' )*/
					if ( strncmp(cardLogRec.cardGeneratedUserId, "BRCARDPRNT", 10) )   
						strncpy(responseMsg.cardHistory.details[noOfCardRec].processDateTime, cardLogRec.processDateTime, 14);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].rejectedUserId, cardLogRec.rejectedUserId, 10);
					if ( cardLogRec.rejectedUserId[0] >= '0' && cardLogRec.rejectedUserId[0] <= '9' )
						strncpy(&responseMsg.cardHistory.details[noOfCardRec].rejectedUserId[7], &cardLogRec.branchCode[1], 3);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].rejectedDate, cardLogRec.rejectedDate, 8);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].rejectedTime, cardLogRec.rejectedTime, 6);
					strncpy(responseMsg.cardHistory.details[noOfCardRec].rejectedReason, cardLogRec.rejectedReason, 20);
					noOfCardRec++;

					if ( noOfCardRec > 50 ) 
						break;
				}
			}
		}
		isclose(tmpCardLogFile);
		if ( receivedMsg.cardHistory.msgType == '1' ) /* Card update history */
		{
			if ( recsInThisMsg >= 20 )
			{
				sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
				strncpy(responseMsg.cardUpdateHistory.lastRecCount, tmpStr, 5);
				sprintf(tmpStr, "%02d", recsInThisMsg);
				strncpy(responseMsg.cardUpdateHistory.noOfRecs, tmpStr, 2);
				strncpy(responseMsg.cardUpdateHistory.cardNo, receivedMsg.cardHistory.cardNo, 19);
				responseMsg.cardUpdateHistory.details[recsInThisMsg+1].branchCode[0] = '\0';
				formatCardHistoryResponse(DONE, "Successful", "Successful");
				fflush(logFp);
				sendResponse(responseMsg.cardUpdateHistory.msgLen);
			}
		}
		else /* card/pin tracking history */
		{
			if ( noOfCardRec > 50 )
			{
				responseMsg.cardHistory.details[noOfCardRec+1].requestType = '\0';
				sprintf(tmpStr,"%02d", noOfCardRec);
				strncpy(responseMsg.cardHistory.noOfRecs, tmpStr,2);
				formatCardHistoryResponse(DONE, "Successful...", "Successful...");
				sendResponse(responseMsg.cardHistory.msgLen);
			}
		}
	}

	memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);
	strncpy(cardLogRec.cardNo, receivedMsg.cardHistory.cardNo, 19);
	isindexinfo(cardLogFile, &cardLogKey, 6);
	isstart(cardLogFile, &cardLogKey, 0, &cardLogRec.liveChar, ISGTEQ);

	while ( isread(cardLogFile, &cardLogRec.liveChar, ISNEXT) == 0 )
	{
		if ( strncmp(cardLogRec.cardNo, receivedMsg.cardHistory.cardNo, 19) )
			break;

		if ( receivedMsg.cardHistory.msgType == '1' ) /* Card Update history */
		{
			if ( recCount++ < lastRecRcvd )
				continue; /* read all records already sent */
			replNullChars();
			strncpy(responseMsg.cardUpdateHistory.details[recsInThisMsg].branchCode, cardLogRec.branchCode, 4);
			strncpy(responseMsg.cardUpdateHistory.details[recsInThisMsg].userId, cardLogRec.userId, 10);
			strncpy(responseMsg.cardUpdateHistory.details[recsInThisMsg].dateTime, cardLogRec.dateTime, 14);
			responseMsg.cardUpdateHistory.details[recsInThisMsg].pendingStatus = cardLogRec.bmUpdateStatus;
			if ( cardLogRec.bmUpdateStatus != '1' && cardLogRec.bmUpdateStatus != '2' )
			{
				strncpy(responseMsg.cardUpdateHistory.details[recsInThisMsg].supervisorId, cardLogRec.supervisorId, 10);
				strncpy(responseMsg.cardUpdateHistory.details[recsInThisMsg].lastUpdateDateTime, cardLogRec.lastUpdateDateTime, 14);
			}
			responseMsg.cardUpdateHistory.details[recsInThisMsg].requestType = cardLogRec.requestType;

			if ( ++recsInThisMsg >= 20 ) 
				break;
		}
		else
		{
			if ( cardLogRec.bmUpdateStatus == '9' ) /* Only completed records are processed */
			{
				replNullChars();
				responseMsg.cardHistory.details[noOfCardRec].requestType = cardLogRec.requestType;
				strncpy(responseMsg.cardHistory.details[noOfCardRec].requestUserId, cardLogRec.userId,10);
				if ( cardLogRec.userId[0] >= '0' && cardLogRec.userId[0] <= '9' )
					strncpy(&responseMsg.cardHistory.details[noOfCardRec].requestUserId[7], &cardLogRec.branchCode[1], 3);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].requestDateTime,cardLogRec.dateTime,14);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].cardGeneratedDate, cardLogRec.cardGeneratedDate,8);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].cardGeneratedTime, cardLogRec.cardGeneratedTime, 6);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].cardGeneratedUserId, cardLogRec.cardGeneratedUserId, 10);
				if ( cardLogRec.cardGeneratedUserId[0] >= '0' && cardLogRec.cardGeneratedUserId[0] <= '9' )
					strncpy(&responseMsg.cardHistory.details[noOfCardRec].cardGeneratedUserId[7], &cardLogRec.branchCode[1], 3);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].cBranchReceiptDate, cardLogRec.cBranchReceiptDate, 8);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].cBranchReceiptTime, cardLogRec.cBranchReceiptTime, 6);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].cBranchReceiptUserId, cardLogRec.cBranchReceiptUserId, 10);
				if ( cardLogRec.cBranchReceiptUserId[0] >= '0' && cardLogRec.cBranchReceiptUserId[0] <= '9' )
					strncpy(&responseMsg.cardHistory.details[noOfCardRec].cBranchReceiptUserId[7], &cardLogRec.branchCode[1], 3);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].cCustIssueDate, cardLogRec.cCustIssueDate, 8);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].cCustIssueTime, cardLogRec.cCustIssueTime, 6);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].cCustIssueUserId, cardLogRec.cCustIssueUserId, 10);
				if ( cardLogRec.cCustIssueUserId[0] >= '0' && cardLogRec.cCustIssueUserId[0] <= '9' )
					strncpy(&responseMsg.cardHistory.details[noOfCardRec].cCustIssueUserId[7], &cardLogRec.branchCode[1], 3);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].pinGeneratedDate, cardLogRec.pinGeneratedDate, 8);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].pinGeneratedTime, cardLogRec.pinGeneratedTime, 6);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].pinGeneratedUserId, cardLogRec.pinGeneratedUserId, 10);
				if ( cardLogRec.pinGeneratedUserId[0] >= '0' && cardLogRec.pinGeneratedUserId[0] <= '9' )
					strncpy(&responseMsg.cardHistory.details[noOfCardRec].pinGeneratedUserId[7], &cardLogRec.branchCode[1], 3);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].pBranchReceiptDate, cardLogRec.pBranchReceiptDate, 8);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].pBranchReceiptTime, cardLogRec.pBranchReceiptTime, 6);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].pBranchReceiptUserId, cardLogRec.pBranchReceiptUserId, 10);
				if ( cardLogRec.pBranchReceiptUserId[0] >= '0' && cardLogRec.pBranchReceiptUserId[0] <= '9' )
					strncpy(&responseMsg.cardHistory.details[noOfCardRec].pBranchReceiptUserId[7], &cardLogRec.branchCode[1], 3);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].pCustIssueDate, cardLogRec.pCustIssueDate, 8);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].pCustIssueTime, cardLogRec.pCustIssueTime, 6);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].pCustIssueUserId, cardLogRec.pCustIssueUserId, 10);
				if ( cardLogRec.pCustIssueUserId[0] >= '0' && cardLogRec.pCustIssueUserId[0] <= '9' )
					strncpy(&responseMsg.cardHistory.details[noOfCardRec].pCustIssueUserId[7], &cardLogRec.branchCode[1], 3);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].supervisorId, cardLogRec.supervisorId, 10);
				if ( cardLogRec.supervisorId[0] >= '0' && cardLogRec.supervisorId[0] <= '9' )
					strncpy(&responseMsg.cardHistory.details[noOfCardRec].supervisorId[7], &cardLogRec.branchCode[1], 3);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].lastUpdateDateTime,cardLogRec.lastUpdateDateTime, 14);
				/*if ( cardLogRec.branchCardPrdn != 'Y' )*/
				if ( strncmp(cardLogRec.cardGeneratedUserId, "BRCARDPRNT", 10) )   
					strncpy(responseMsg.cardHistory.details[noOfCardRec].processDateTime, cardLogRec.processDateTime, 14);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].rejectedUserId, cardLogRec.rejectedUserId, 10);
				if ( cardLogRec.rejectedUserId[0] >= '0' && cardLogRec.rejectedUserId[0] <= '9' )
					strncpy(&responseMsg.cardHistory.details[noOfCardRec].rejectedUserId[7], &cardLogRec.branchCode[1], 3);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].rejectedDate, cardLogRec.rejectedDate, 8);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].rejectedTime, cardLogRec.rejectedTime, 6);
				strncpy(responseMsg.cardHistory.details[noOfCardRec].rejectedReason, cardLogRec.rejectedReason, 20);
				noOfCardRec++;

				if ( noOfCardRec > 50 ) 
					break;
			}
		}
	}
	if ( receivedMsg.cardHistory.msgType == '1' )
	{
		sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
		strncpy(responseMsg.cardUpdateHistory.lastRecCount, tmpStr, 5);
		sprintf(tmpStr, "%02d", recsInThisMsg);
		strncpy(responseMsg.cardUpdateHistory.noOfRecs, tmpStr, 2);
		strncpy(responseMsg.cardUpdateHistory.cardNo, receivedMsg.cardHistory.cardNo, 19);
		responseMsg.cardUpdateHistory.details[recsInThisMsg+1].branchCode[0] = '\0';
		formatCardHistoryResponse(DONE, "Successful", "Successful");
		fflush(logFp);
		sendResponse(responseMsg.cardUpdateHistory.msgLen);
	}
	else
	{
		responseMsg.cardHistory.details[noOfCardRec+1].requestType = '\0';
		sprintf(tmpStr,"%02d", noOfCardRec);
		strncpy(responseMsg.cardHistory.noOfRecs, tmpStr,2);
		formatCardHistoryResponse(DONE, "Successful...", "Successful...");
		sendResponse(responseMsg.cardHistory.msgLen);
	}
	return SUCCESS;
}

replNullChars()
{
	int i=0, len;

	len = sizeof(cardLogRec);

	for (i=0; i < len; i++)
	{
		if ( cardLogRec.branchCode[i] == NULL )
			cardLogRec.branchCode[i] = ' ';
	}
}

processAccDetail()
{
	char tmpStr[100], tAccNo[20], bmAccNo[20];
	char tCustNo[15], bmCustNo[15], aDate[15];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processAccDetail]\n", getDateTime(), PID);

	memset(responseMsg.accPendingDetail.msgLen, ' ', sizeof responseMsg.accPendingDetail);

	memset(&gldRec.liveChar, ' ', sizeof gldRec);

	/* While Account Enquiry , we treat receivedMsg.accPendingDetail.dateTime  
	   									as Account Number  */
	strncpy(tAccNo, receivedMsg.accPendingDetail.dateTime, 14);

	strncpy(gldRec.accNo, actualToBmAcc(tAccNo, bmAccNo), 13);

	isindexinfo(gldFile, &gldKey, 1);
	isstart(gldFile, &gldKey, 0, &gldRec.liveChar, ISGTEQ);

	if ( isRead(gldFile, &gldRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processAccDetail] ISREAD/ISEQUAL error %d on gld0data for the key=%.13s and the account number is [%.14s]\n", getDateTime(), PID, iserrno, gldRec.accNo, tAccNo );
		fflush(logFp);
		if  ( iserrno == 111 || iserrno == 112 )
		{
			sprintf(tmpStr, "Record not found with this key ");
			formatAccPendingDetailResponse(NOT_FOUND, tmpStr, tmpStr ); 
		}
		else if ( iserrno = 110 )
		{
			sprintf(tmpStr, "Begining/End of file reached");
			formatAccPendingDetailResponse(END_OF_FILE, tmpStr,tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked on gld0data");
			formatAccPendingDetailResponse(RECORD_LOCKED,  tmpStr, tmpStr); 
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on gld0data", iserrno);
			formatAccPendingDetailResponse(INTERNALERR, tmpStr,tmpStr);
		}
		sendResponse(responseMsg.accPendingDetail.msgLen);
		return FAILURE;
	}

	strncpy(bmAccNo, gldRec.accNo, 13);
	memset(tAccNo, ' ' , 14);
	strncpy(responseMsg.accPendingDetail.accNo, bmAccToActual(bmAccNo, tAccNo),14);
	sprintf(tmpStr, "0%c", gldRec.passwd);
	strncpy(responseMsg.accPendingDetail.accStatus, tmpStr, 2);
	sprintf(tmpStr, "0%c", gldRec.samaAccStatus);
	strncpy(responseMsg.accPendingDetail.samaAccStatus, tmpStr, 2);
	if ( gldRec.statementFrequency[0] == 'D' || gldRec.statementFrequency[0] == 'A' ) /* Daily */
		strncpy(responseMsg.accPendingDetail.stmtFreq, "02",2);
	else if ( gldRec.statementFrequency[0] == 'W' || gldRec.statementFrequency[0] == 'B' ) /* Weekly */
		strncpy(responseMsg.accPendingDetail.stmtFreq, "03", 2);
	else if ( gldRec.statementFrequency[0] == 'M' || gldRec.statementFrequency[0] == 'C' ) /* Monthly */
		strncpy(responseMsg.accPendingDetail.stmtFreq, "04", 2);
	else if ( gldRec.statementFrequency[0] == 'Q' || gldRec.statementFrequency[0] == 'E' ) /* Quarterly */
		strncpy(responseMsg.accPendingDetail.stmtFreq, "05", 2);
	else if ( gldRec.statementFrequency[0] == 'H' || gldRec.statementFrequency[0] == 'F' ) /* Half yearly */
		strncpy(responseMsg.accPendingDetail.stmtFreq, "06", 2);
	else if ( gldRec.statementFrequency[0] == 'Y' || gldRec.statementFrequency[0] == 'G' ) /* Yearly */
		strncpy(responseMsg.accPendingDetail.stmtFreq, "07", 2);
	else if ( gldRec.statementFrequency[0] == 'N' || gldRec.statementFrequency[0] == 'I' ) /* Non-Auto */
		strncpy(responseMsg.accPendingDetail.stmtFreq, "01", 2);

	if ( gldRec.statementFrequency[0] == 'M' || gldRec.statementFrequency[0] == 'C' )
	{
		if ( strncmp(&gldRec.statementFrequency[1], "01", 2) ==  0 )
			responseMsg.accPendingDetail.statementDay = '0';
		else
			responseMsg.accPendingDetail.statementDay = '1';
	}
	else
		responseMsg.accPendingDetail.statementDay = '0';

	strncpy(responseMsg.accPendingDetail.branchCode, gldRec.branchCode, 4);

	/* MISYS */

	if ( getRestrictedFlag(gldRec.branchCode) == FAILURE )
	{
		sprintf(tmpStr, "Branch record is missing in ctlFile [%.4s]", ctlRec.branchCode);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	} /* MISYS */

	responseMsg.accPendingDetail.restrictedFlag = ctlRec.updateRestricted; /* MISYS */

	if ( receivedMsg.accPendingDetail.updateFlag == '1' ) /* update mode */
	{
		moveSignTabRecToSignLog();
	}

	responseMsg.accPendingDetail.intApplication = gldRec.intApplication;
	strncpy(responseMsg.accPendingDetail.crIntRate, gldRec.crIntRate, 9);
	strncpy(responseMsg.accPendingDetail.drIntRate, gldRec.drIntRate, 9);
	strncpy(responseMsg.accPendingDetail.payAccNo, bmAccToActual(gldRec.payAccNo,tmpStr), 14);
	strncpy(responseMsg.accPendingDetail.uniqueNo, gldRec.uniqueNo, 5);
	strncpy(responseMsg.accPendingDetail.uniqueSub, gldRec.uniqueSubNo1, 2);
	strncpy(responseMsg.accPendingDetail.intApplicationDay, gldRec.intApplicationDay, 2);
	strncpy(responseMsg.accPendingDetail.intApplicationFreq, gldRec.intApplicationFreq, 3);
	strncpy(responseMsg.accPendingDetail.collateral, gldRec.drawerName, 15);
	strncpy(responseMsg.accPendingDetail.memoNote1, gldRec.memorandumField1, 20);
	strncpy(responseMsg.accPendingDetail.memoNote2, gldRec.memorandumField2, 20);

	bmDateToActual(gldRec.lastAmendmentDate, aDate);
	strncpy(responseMsg.accPendingDetail.lastAmendDate, aDate, 8);
	bmDateToActual(gldRec.accOpenDate, aDate);
	strncpy(responseMsg.accPendingDetail.accOpenDate, aDate, 8);
	strncpy(responseMsg.accPendingDetail.acctDesc, gldRec.accDesc, 30);
	strncpy(responseMsg.accPendingDetail.accLimit, gldRec.accLimit, 12);
	responseMsg.accPendingDetail.dormantAcc = gldRec.inactiveAccFlag;
	strncpy(responseMsg.accPendingDetail.intLastRun, gldRec.intLastRun, 14);
	strncpy(responseMsg.accPendingDetail.lastTransDate, (char *) bmDateToActual(gldRec.lastTransDate, aDate), 8);

	strncpy(responseMsg.accPendingDetail.ibanAccNo, gldRec.iban, 24);

	/* While Account Enquiry , we treat receivedMsg.accPendingDetail.dateTime  
	   									as Account Number  */
	sprintf(tCustNo, "%.7s", &receivedMsg.accPendingDetail.dateTime[5]);
	/* Read the customer Name from stcusttab/crd0data */
	if ( getCustName(tCustNo) == SUCCESS )
	{
		if ( strncmp(custTabRec.eShortName, "                                 ", 30) == 0 )
			strncpy(responseMsg.accPendingDetail.custName, custTabRec.aShortName, 30);
		else
			strncpy(responseMsg.accPendingDetail.custName, custTabRec.eShortName, 30);
	}
	else
	{
		sprintf(tmpStr, "Invalid custNo [%.7s]   ", tCustNo);
		strncpy(responseMsg.accPendingDetail.custName,tmpStr,30);
	}

	getAccLastUpdateUserId();
	responseMsg.accPendingDetail.foundInTList = '0';
	responseMsg.accPendingDetail.details[0].englishName[0] = '\0';

	formatAccPendingDetailResponse(DONE, "Successfully fetched..", "Successfully fetched...");
	sendResponse(responseMsg.accPendingDetail.msgLen);
	return SUCCESS;
}

getAccLastUpdateUserId()
{
	char tmpStr[100], accNo[20];
	char *pathName;
	int  tmpAcctLogFile;
	struct keydesc  tmpAcctLogKey;
	char yearFileToRead[50], currentDateTime[20];
	int  acctLogRecFound = NO, i=0, currentYear;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[getAccLastUpdateUserId]\n", getDateTime(), PID);


	if ( openAcctLogFile(ISMANULOCK+ISINOUT) < 0 )
	{
		fprintf(logFp, "%s|%5d|[getAccLastUpdateUserId] ISOPEN error %d on stacclog ignored...\n", getDateTime(), PID, iserrno);
		fflush(logFp);
		fprintf(errLogFp, "%s : getAccLastUpdateUserId() :ISOPEN error %d on stacclog ignored...\n", getDateTime(), iserrno);
		fflush(errLogFp);
		return 0;
	}

	memset(&acctLogRec.liveChar, ' ', sizeof acctLogRec);

	isindexinfo(acctLogFile, &acctLogKey, 5);

	strncpy(acctLogRec.accNo, bmAccToActual(gldRec.accNo, accNo), 14);
	strncpy(acctLogRec.lastUpdateDateTime, "99999999999999", 14);

	isstart(acctLogFile, &acctLogKey, 0, &acctLogRec.liveChar, ISGREAT);

	while  ( isRead(acctLogFile, &acctLogRec.liveChar, ISPREV) == 0 )
	{
		if ( strncmp(acctLogRec.accNo, accNo, 14) )
			break;

		if ( acctLogRec.bmUpdateStatus != '9' )
			continue;

		acctLogRecFound = YES;
		strncpy(responseMsg.accPendingDetail.lastUpdateUserId, acctLogRec.userId, 10);
		strncpy(responseMsg.accPendingDetail.lastUpdateStDate, acctLogRec.dateTime, 8);
		strncpy(responseMsg.accPendingDetail.supervisorId, acctLogRec.supervisorId, 10 );
		strncpy(responseMsg.accPendingDetail.lastUpdateAppDate, acctLogRec.lastUpdateDateTime, 8);
		strncpy(responseMsg.accPendingDetail.accStatusChangeReason, acctLogRec.accStatusChangeReason, 30); /* Ver 1.2 */
		break;
	}

	if ( iserrno != 0 )
	{
		if ( iserrno != 111 && iserrno != 110 )
		{
			fprintf(logFp, "%s|%5d|[getAccLastUpdateUserId] ISREAD/ISPREV error %d on stacclog for the key %.14s  %.14s IGNORED\n", getDateTime(), PID, iserrno, acctLogRec.accNo, acctLogRec.lastUpdateDateTime);
			fflush(logFp);
			fprintf(errLogFp, "%s: getAccLastUpdateUserId(): ISREAD/ISPREV error %d on stacclog for the key %.14s  %.14s IGNORED\n", getDateTime(), iserrno, acctLogRec.accNo, acctLogRec.lastUpdateDateTime);
			fflush(errLogFp);
		}
	}

	if ( acctLogRecFound == NO )
	{
		getDateTime();
		currentYear = systemDate->tm_year+1900;
		for ( i=currentYear-1; i >= 2000; i-- ) /* YEAR 2000 is hard coded because static data first implemented on 2000 */
		{
			sprintf(tmpStr, "acclog%04d", i);
			pathName = getpath(tmpStr, "static");

			if ( (tmpAcctLogFile  = isopen(pathName, ISMANULOCK+ISINPUT)) < 0)
			{
				if ( extraDebug > 8 )
				{
					fprintf(logFp, "%s|%5d|[getAccLastUpdateUserId] ISOPEN error %d for %s File IGNORED\n",getDateTime(), PID, iserrno, pathName);
					fflush(logFp);
				}
				free(pathName);
				continue;
			}
			free(pathName);
			isindexinfo(tmpAcctLogFile, &tmpAcctLogKey, 5); /* Key on account number */
			memset(&acctLogRec.liveChar, ' ', sizeof acctLogRec);
			strncpy(acctLogRec.accNo, accNo, 14);
			strncpy(acctLogRec.lastUpdateDateTime, "99999999999999", 14);

			isstart(tmpAcctLogFile, &tmpAcctLogKey, 0, &acctLogRec.liveChar,ISGREAT);
			while ( isRead(tmpAcctLogFile, &acctLogRec.liveChar, ISPREV) == 0 )
			{
				if ( strncmp(acctLogRec.accNo, accNo, 14) )
					break;

				if ( acctLogRec.bmUpdateStatus != '9' )
					continue;

				acctLogRecFound = YES;
				strncpy(responseMsg.accPendingDetail.lastUpdateUserId, acctLogRec.userId, 10);
				strncpy(responseMsg.accPendingDetail.lastUpdateStDate, acctLogRec.dateTime, 8);
				strncpy(responseMsg.accPendingDetail.supervisorId, acctLogRec.supervisorId, 10 );
				strncpy(responseMsg.accPendingDetail.lastUpdateAppDate, acctLogRec.lastUpdateDateTime, 8);
				strncpy(responseMsg.accPendingDetail.accStatusChangeReason, acctLogRec.accStatusChangeReason, 30); /* Ver 1.2 */
				break;
			}
			isclose(tmpAcctLogFile);
			if ( acctLogRecFound == YES )
				break;
		}
	}

	return 0;
}

processAccPendingDetail()
{
	char tmpStr[100], tmpCustName[70], bmCustNo[15], tCustNo[15];
	char name1[35], name2[35], name3[20], name4[20];
	struct resMsgSrchEngineEnq	srchEngineResponse;
	char *pathName;
	int  tmpAcctLogFile;
	struct keydesc  tmpAcctLogKey;
	char yearFileToRead[50], currentDateTime[20];
	int  acctLogRecFound = NO;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processAccPendingDetail]\n", getDateTime(), PID);

	memset(responseMsg.accPendingDetail.msgLen, ' ', sizeof responseMsg.accPendingDetail);

	getDateTime();
	sprintf(currentDateTime, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);

	acctLogRecFound=NO;
	if ( strncmp(currentDateTime, receivedMsg.accPendingDetail.dateTime, 4) )
	{
		sprintf(yearFileToRead, "acclog%.4s", receivedMsg.accPendingDetail.dateTime);
		pathName = getpath(yearFileToRead, "static");
		if ( (tmpAcctLogFile  = isopen(pathName, ISMANULOCK+ISINPUT)) < 0)
		{
			if ( extraDebug > 8 )
			{
				fprintf(logFp, "%s|%5d|[processAccPendingDetail] ISOPEN error %d for %s File IGNORED\n",getDateTime(), PID, iserrno, pathName);
				fflush(logFp);
			}
			free(pathName);
		}
		else
		{
			free(pathName);
			isindexinfo(tmpAcctLogFile, &tmpAcctLogKey, 1); 
			if ( extraDebug )
			{
				fprintf(logFp, "reading information from the file [%s]......\n", yearFileToRead);
				fprintf(logFp, "branch code  : %.4s\n", receivedMsg.accPendingDetail.homeBranch);
				fprintf(logFp, "user Id      : %.10s\n", receivedMsg.accPendingDetail.userId);
				fprintf(logFp, "date Time    : %.14s\n", receivedMsg.accPendingDetail.dateTime);
			}
			memset(&acctLogRec.liveChar, ' ', sizeof acctLogRec);
			strncpy(acctLogRec.branchCode, receivedMsg.accPendingDetail.homeBranch,4);
			strncpy(acctLogRec.userId, receivedMsg.accPendingDetail.userId, 10);
			strncpy(acctLogRec.dateTime, receivedMsg.accPendingDetail.dateTime, 14);

			if ( isRead(tmpAcctLogFile, &acctLogRec.liveChar, ISEQUAL) < 0 )
			{
				fprintf(logFp, "%s|%5d|[processAccPendingDetail] : ISREAD/ISEQUAL error %d on %s for key=%.38s IGNORED and trying to read from stacclog file\n", getDateTime(), PID, iserrno, yearFileToRead, acctLogRec.branchCode);
				fflush(logFp);
			}
			else
				acctLogRecFound=YES;

			isclose(tmpAcctLogFile);
		}
	}

	if ( acctLogRecFound == NO )
	{
		isindexinfo(acctLogFile, &acctLogKey, 1);
		memset(&acctLogRec.liveChar, ' ', sizeof acctLogRec);
		strncpy(acctLogRec.branchCode, receivedMsg.accPendingDetail.homeBranch,4);
		strncpy(acctLogRec.userId, receivedMsg.accPendingDetail.userId, 10);
		strncpy(acctLogRec.dateTime, receivedMsg.accPendingDetail.dateTime, 14);

		if ( isstart(acctLogFile,&acctLogKey,0,&acctLogRec.liveChar,ISGTEQ) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processAccPendingDetail] ISSTART/ISGTEQ error %d occured on stacclog for the key [%.38s]\n", getDateTime(), PID, iserrno, acctLogRec.branchCode);
			if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
				formatAccPendingDetailResponse(END_OF_FILE,"No Account Records found....", "No Account Records found....");
			else
			{
				sprintf(tmpStr, "CISAM Error %d occured on stacclog", iserrno);
				formatAccPendingDetailResponse(INTERNALERR,tmpStr, tmpStr);
			}
			sendResponse(responseMsg.accPendingDetail.msgLen);
			return FAILURE;
		}

		if ( readAcctLogFile(ISEQUAL) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE ;
		}
	}

	responseMsg.accPendingDetail.newOrUpdate = acctLogRec.newOrUpdate;
	strncpy(responseMsg.accPendingDetail.accNo, acctLogRec.accNo,14);
	strncpy(responseMsg.accPendingDetail.accStatus, acctLogRec.accStatus, 2);
	strncpy(responseMsg.accPendingDetail.stmtFreq, acctLogRec.statementFreq, 2);
	strncpy(responseMsg.accPendingDetail.branchCode, acctLogRec.custBranchCode, 4);
	responseMsg.accPendingDetail.intApplication = acctLogRec.intApplication;
	strncpy(responseMsg.accPendingDetail.crIntRate, acctLogRec.crIntRate, 9);
	strncpy(responseMsg.accPendingDetail.drIntRate, acctLogRec.drIntRate, 9);
	strncpy(responseMsg.accPendingDetail.payAccNo, acctLogRec.payAccNo, 14);
	strncpy(responseMsg.accPendingDetail.uniqueNo, acctLogRec.uniqueNo, 5);
	strncpy(responseMsg.accPendingDetail.uniqueSub, acctLogRec.uniqueSub, 2);
	responseMsg.accPendingDetail.statementDay  = acctLogRec.statementDay;

	strncpy(responseMsg.accPendingDetail.accLimit, acctLogRec.creditLimit, 12);
	strncpy(responseMsg.accPendingDetail.intLastRun, acctLogRec.intLastRun, 14);
	strncpy(responseMsg.accPendingDetail.intApplicationFreq, acctLogRec.intFreqCode, 3);
	strncpy(responseMsg.accPendingDetail.intApplicationDay, acctLogRec.intApplDay, 2);
	responseMsg.accPendingDetail.dormantAcc = acctLogRec.inactiveAccFlag;

	memset(responseMsg.accPendingDetail.lastAmendDate, ' ', 8);
	memset(responseMsg.accPendingDetail.accOpenDate, ' ', 8);
	strncpy(responseMsg.accPendingDetail.supervisorComments, acctLogRec.supervisorComments,200);
	strncpy(responseMsg.accPendingDetail.acctDesc, acctLogRec.acctDesc, 30);
	strncpy(responseMsg.accPendingDetail.initialStatus, acctLogRec.initialStatus, 2);
	strncpy(responseMsg.accPendingDetail.initialSamaStatus, acctLogRec.initialSamaStatus, 2);
	strncpy(responseMsg.accPendingDetail.samaAccStatus, acctLogRec.samaAccStatus, 2);
	responseMsg.accPendingDetail.samaStatusChanged = acctLogRec.samaAccStatusChanged;
	strncpy(responseMsg.accPendingDetail.accStatusChangeReason, acctLogRec.accStatusChangeReason, 30);
	responseMsg.accPendingDetail.dormantActivationUpd = acctLogRec.dormantActivationUpd;

	/* Read the customer Name from crd0data */
	memset(&crdRec.liveChar, ' ', sizeof crdRec);
	sprintf(tCustNo, "%.7s", &acctLogRec.accNo[5]);
	actualToBmCust(tCustNo, bmCustNo);
	strncpy(crdRec.accNo, bmCustNo, 6);

	if ( isRead(crdFile, &crdRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processAccPendingDetail] :ISREAD/ISEQUAL error %d occured in crd0data while reading for cust # [%.7s] [%.6s] \n", getDateTime(), PID, iserrno, tCustNo, bmCustNo);
		fflush(logFp);
		strncpy(responseMsg.accPendingDetail.custName, "Could not Read from CRD0DATA   ", 30); 
	}
	else
		strncpy(responseMsg.accPendingDetail.custName, crdRec.shortName, 30);

	/* Read the customer Name from crd0data */
	memset(&custTabRec.liveChar, ' ', sizeof custTabRec);
	strncpy(custTabRec.custNo, &acctLogRec.accNo[5], 7);
	isindexinfo(custTabFile, &custTabKey, 1);
	isstart(custTabFile, &custTabKey, 0, &custTabRec.liveChar, ISGTEQ);

	if ( isread(custTabFile, &custTabRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processAccPendingDetail] :ISREAD/ISEQUAL error %d occured in stcusttab while reading for cust # [%.7s] IGNORED \n", getDateTime(), PID, iserrno, &acctLogRec.accNo[5]);
		fflush(logFp);
		memset(&custTabRec.liveChar, ' ', sizeof custTabRec);
	}

	responseMsg.accPendingDetail.foundInTList = '0';
	responseMsg.accPendingDetail.details[0].englishName[0] = '\0';

	if ( searchEngineCallReqd == YES )
	{
		if ( custTabRec.custType > '0' )
		{
			if ( custTabRec.preferredLang == '0' ) /* ARABIC */
			{
				sprintf(name1, "%.30s", custTabRec.aOrgName1);
				trim(name1);
				sprintf(name2, "%.30s", custTabRec.aOrgName2);
				trim(name2);
				sprintf(tmpCustName, "%s %s", name1, name2);
				/*sprintf(tmpStr, "%.30s%.30s", custTabRec.aOrgName1, custTabRec.aOrgName2);*/
			}
			else
			{
				sprintf(name1, "%.30s", custTabRec.eOrgName1);
				trim(name1);
				sprintf(name2, "%.30s", custTabRec.eOrgName2);
				trim(name2);
				sprintf(tmpCustName, "%s %s", name1, name2);
				/*sprintf(tmpStr, "%.30s%.30s", custTabRec.eOrgName1, custTabRec.eOrgName2);*/
			}
		}
		else
		{
			if ( custTabRec.preferredLang == '0' ) /* ARABIC */
			{
				sprintf(name1, "%.15s", custTabRec.aFirstName);
				trim(name1);
				sprintf(name2, "%.15s", custTabRec.a2ndName);
				trim(name2);
				sprintf(name3, "%.15s", custTabRec.a3rdName);
				trim(name3);
				sprintf(name4, "%.15s", custTabRec.aLastName);
				trim(name4);
				sprintf(tmpCustName, "%s %s %s %s", name1, name2, name3, name4);

				/*sprintf(tmpStr, "%.15s%.15s%.15s%.15s", custTabRec.aFirstName, custTabRec.a2ndName, custTabRec.a3rdName, custTabRec.aLastName);*/
			}
			else
			{
				sprintf(name1, "%.15s", custTabRec.eFirstName);
				trim(name1);
				sprintf(name2, "%.15s", custTabRec.e2ndName);
				trim(name2);
				sprintf(name3, "%.15s", custTabRec.e3rdName);
				trim(name3);
				sprintf(name4, "%.15s", custTabRec.eLastName);
				trim(name4);
				sprintf(tmpCustName, "%s %s %s %s", name1, name2, name3, name4);
				/*sprintf(tmpStr, "%.15s%.15s%.15s%.15s", custTabRec.eFirstName, custTabRec.e2ndName, custTabRec.e3rdName, custTabRec.eLastName);*/
			}
		}

		memset(srchEngineResponse.msgLen, ' ', sizeof srchEngineResponse);
		sprintf(tmpCustName, "%-60.60s", tmpCustName);
		callSrchEngine(tmpCustName, custTabRec.idNo, searchEngineLevel, srchEngineResponse.msgLen);

		if ( strncmp(srchEngineResponse.responseStatus, "00", 2) )
		{
			if ( strncmp(srchEngineResponse.responseStatus, "03", 2) == 0  )
				sprintf(tmpStr, "Incorrect Message");
			else if ( strncmp(srchEngineResponse.responseStatus, "18", 2) == 0  )
				sprintf(tmpStr, "No Such record exists");
			else if ( strncmp(srchEngineResponse.responseStatus, "99", 2) == 0 )
				sprintf(tmpStr, "Internal Errors");
			else
				sprintf(tmpStr, "Unknown error");
			fprintf(logFp, "%s|%5d| [processAccPendingDetail] Error [%.2s:%s] received from SRCHENGINE service IGNORED; \n", getDateTime(), PID, srchEngineResponse.responseStatus, tmpStr);
			fflush(logFp);
		}

		if ( strncmp(srchEngineResponse.recsRetrieved, "00", 2) > 0 )
			responseMsg.accPendingDetail.foundInTList = '1';
		else
			responseMsg.accPendingDetail.foundInTList = '0';

		strncpy(responseMsg.accPendingDetail.noOfRecs, srchEngineResponse.recsRetrieved, 2);
		strncpy(responseMsg.accPendingDetail.details, srchEngineResponse.details, sizeof srchEngineResponse.details);
		sprintf(tmpStr, "%.2s", srchEngineResponse.recsRetrieved);
		responseMsg.accPendingDetail.details[atoi(tmpStr)].englishName[0] = NULL;
	}

	memset(&signLogRec.liveChar, ' ', sizeof signLogRec);
	strncpy(signLogRec.branchCode, receivedMsg.accPendingDetail.homeBranch, 4);
	strncpy(signLogRec.userId, receivedMsg.accPendingDetail.userId, 10);
	strncpy(signLogRec.dateTime, receivedMsg.accPendingDetail.dateTime, 14);
	isindexinfo(signLogFile, &signLogKey, 1);
	isstart(signLogFile, &signLogKey, 0, &signLogRec.liveChar,ISGTEQ);

	responseMsg.accPendingDetail.signatoryForOthers = '0';
	while (  isread(signLogFile, &signLogRec.liveChar, ISNEXT) == 0 )
	{
		if (strncmp(receivedMsg.accPendingDetail.homeBranch, signLogRec.branchCode, 4) || strncmp(receivedMsg.accPendingDetail.userId, signLogRec.userId, 10) || strncmp(receivedMsg.accPendingDetail.dateTime, signLogRec.dateTime, 14) )
			break;

		if ( signLogRec.signatoryForOthers == '1' )
		{
			responseMsg.accPendingDetail.signatoryForOthers = '1';
			break;
		}				
	}

	formatAccPendingDetailResponse(DONE, "Successfully fetched..", "Successfully fetched...");
	sendResponse(responseMsg.accPendingDetail.msgLen);
	return SUCCESS;
}

processCardPendingDetail()
{
	char tmpStr[200];
	int i;
	char *pathName;
	int  tmpCardLogFile;
	struct keydesc  tmpCardLogKey;
	char yearFileToRead[50], currentDateTime[20];
	int  cardLogRecFound = NO;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processCardPendingDetail]\n", getDateTime(), PID);

	memset(responseMsg.cardPendingDetail.msgLen,' ',sizeof responseMsg.cardPendingDetail);

	getDateTime();
	sprintf(currentDateTime, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);

	cardLogRecFound=NO;
	if ( strncmp(currentDateTime, receivedMsg.cardPendingDetail.dateTime, 4) )
	{
		sprintf(yearFileToRead, "cardlog%.4s", receivedMsg.cardPendingDetail.dateTime);
		pathName = getpath(yearFileToRead, "cards");
		if ( (tmpCardLogFile  = isopen(pathName, ISMANULOCK+ISINPUT)) < 0)
		{
			if ( extraDebug > 8 )
			{
				fprintf(logFp, "%s|%5d|[processCardPendingDetail] ISOPEN error %d for the file %s IGNORED\n",getDateTime(), PID, iserrno, pathName);
				fflush(logFp);
			}
			free(pathName);
		}
		else
		{
			free(pathName);
			isindexinfo(tmpCardLogFile, &tmpCardLogKey, 1); 
			if ( extraDebug )
			{
				fprintf(logFp, "reading information from the file [%s]......\n", yearFileToRead);
				fprintf(logFp, "branch code  : %.4s\n", receivedMsg.cardPendingDetail.homeBranch);
				fprintf(logFp, "user Id      : %.10s\n", receivedMsg.cardPendingDetail.userId);
				fprintf(logFp, "date Time    : %.14s\n", receivedMsg.cardPendingDetail.dateTime);
				fprintf(logFp, "card number  : %.14s\n", receivedMsg.cardPendingDetail.cardNo);
			}
			memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);
			strncpy(cardLogRec.branchCode, receivedMsg.cardPendingDetail.homeBranch,4);
			strncpy(cardLogRec.userId, receivedMsg.cardPendingDetail.userId,10);
			strncpy(cardLogRec.dateTime, receivedMsg.cardPendingDetail.dateTime,14);
			strncpy(cardLogRec.cardNo, receivedMsg.cardPendingDetail.cardNo, 19);

			if ( isRead(tmpCardLogFile, &cardLogRec.liveChar, ISEQUAL) < 0 )
			{
				fprintf(logFp, "%s|%5d|[processCardPendingDetail] : ISREAD/ISEQUAL error %d on %s for key=%.28s & the cardnumber [%.19s] IGNORED and trying to read from cbcardlog file\n", getDateTime(), PID, iserrno, yearFileToRead, cardLogRec.branchCode, cardLogRec.cardNo);
				fflush(logFp);
			}
			else
				cardLogRecFound=YES;

			isclose(tmpCardLogFile);
		}
	}

	if ( cardLogRecFound == NO )
	{
		isindexinfo(cardLogFile, &cardLogKey, 1);
		memset(&cardLogRec.liveChar, ' ', sizeof cardLogRec);
		strncpy(cardLogRec.branchCode, receivedMsg.cardPendingDetail.homeBranch,4);
		strncpy(cardLogRec.userId, receivedMsg.cardPendingDetail.userId,10);
		strncpy(cardLogRec.dateTime, receivedMsg.cardPendingDetail.dateTime,14);
		strncpy(cardLogRec.cardNo, receivedMsg.cardPendingDetail.cardNo, 19);
		if( isstart(cardLogFile, &cardLogKey, 0, &cardLogRec.liveChar,ISGTEQ) < 0 )
		{
			if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
				 formatCardPendingDetailResponse(END_OF_FILE, "No more Records to fetch....", "No more Records to fetch....");
			else
			{
				sprintf(tmpStr, "CISAM Error %d occured on cbcardlog", iserrno);
				formatCardPendingDetailResponse(INTERNALERR, tmpStr, tmpStr);
			}
			sendResponse(responseMsg.cardPendingDetail.msgLen);
			return FAILURE;
		}

		if ( readCardLogFile(ISEQUAL) < 0 )
		{
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE ;
		}
	}

	strncpy( responseMsg.cardPendingDetail.supervisorId, cardLogRec.supervisorId, 10 );
	for (i=0; i < 401; i++ )  /* for loop added by Arul on 07/01/2003 to avoid PIN-SELECT problem in production */
	{
		if ( cardLogRec.cardNo[i] == NULL ) 
			cardLogRec.cardNo[i] = ' ';
	}
	strncpy(responseMsg.cardPendingDetail.cardNo, cardLogRec.cardNo, 401);
	/*strncpy(responseMsg.cardPendingDetail.custNo, &cardLogRec.coreAccNo[4], 8);*/
	strncpy(responseMsg.cardPendingDetail.custNo, cardLogRec.coreCustNo, 8);
	strncpy(responseMsg.cardPendingDetail.coreAccNo, cardLogRec.coreAccNo, 16);
	responseMsg.cardPendingDetail.newOrUpdate = cardLogRec.newOrUpdate;
	for (i=0; i < 200; i++ )  /* for loop added by Arul on 07/01/2003 to avoid PIN-SELECT problem in production */
	{
		if ( cardLogRec.supervisorComments[i] == NULL ) 
			cardLogRec.supervisorComments[i] = ' ';
	}
	strncpy(responseMsg.cardPendingDetail.supervisorComments, cardLogRec.supervisorComments, 200);

	strncpy(tmpStr, cardLogRec.coreCustNo, 8);

	if ( validateCustNo(tmpStr) == SUCCESS )
		strncpy(responseMsg.cardPendingDetail.custName, custInfoResponseMsg.shortName, 30);

	formatCardPendingDetailResponse(DONE, "Successfully fetched..", "Successfully fetched..");
	sendResponse(responseMsg.cardPendingDetail.msgLen);
	return SUCCESS;
}

processAccOpeningCard() 
{
	int i, j ;
	int len, currentYear=0;
	int accFound=NO;
	char tmpStr[100], tmpAccNo[20];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processAccOpeningCard]\n", getDateTime(), PID);

	memset(responseMsg.accOpeningCard.msgLen, ' ', sizeof responseMsg.accOpeningCard);
	responseMsg.accOpeningCard.nullPad = '\0';

	memset(&custTabRec.liveChar, ' ', sizeof custTabRec);
	strncpy(custTabRec.custNo, &receivedMsg.accOpeningCard.accNo[5], 7);

	isindexinfo(custTabFile, &custTabKey, 1);
	isstart(custTabFile, &custTabKey, 0, &custTabRec.liveChar, ISGTEQ);

	if ( isread(custTabFile, &custTabRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processAccOpeningCard] ISREAD/ISEQUAL error %d occured on stcusttab for  customer # [%.7s]\n", getDateTime(), PID, iserrno, &receivedMsg.accOpeningCard.accNo[5]);
		fflush(logFp);
		if ( iserrno == 111 || iserrno == 110 )
		{
			sprintf(tmpStr, "Invalid Customer number ..please check..");
			formatBranchResponse(NOT_FOUND, tmpStr, tmpStr);
		}
		else
		{
			sprintf(tmpStr, "CISAM error %d occured on stcusttab...please check..", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	memset(&crdRec.liveChar, ' ', sizeof crdRec);
	strncpy(crdRec.accNo, actualToBmCust(&receivedMsg.accOpeningCard.accNo[5], tmpStr), 6);

	if ( isRead(crdFile, &crdRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processAccOpeningCard]: ISREAD/ISEQUAL error %d occured while reading crd0data for customer # [%.7s] .. \n", getDateTime(), PID, iserrno, &receivedMsg.accOpeningCard.accNo[5]);
		fflush(logFp);

		if ( iserrno == 111 || iserrno == 110 )
		{
			sprintf(tmpStr, "Customer not exist in Bankmaster..please check..");
			formatBranchResponse(NOT_FOUND, tmpStr, tmpStr);
		}
		else
		{
			sprintf(tmpStr, "CISAM error %d occured on crd0data...please check..", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}

		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	memset(&gldRec.liveChar, ' ', sizeof gldRec);
	strncpy(gldRec.accNo, actualToBmAcc(receivedMsg.accOpeningCard.accNo, tmpAccNo), 13);

	isindexinfo(gldFile, &gldKey, 1);
	isstart(gldFile, &gldKey, 0, &gldRec.liveChar, ISGTEQ);

	if ( isRead(gldFile, &gldRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processAccOpeningCard]: ISREAD/ISEQUAL error %d occured while reading gld0data for account # [%.14s:%.13s] IGNORED.. \n", getDateTime(), PID, iserrno, receivedMsg.accOpeningCard.accNo, tmpAccNo);
		fflush(logFp);
		if ( iserrno == 111 || iserrno == 110 )
		{
			sprintf(tmpStr, "Account does not exist in Bankmaster..please check..");
			formatBranchResponse(NOT_FOUND, tmpStr, tmpStr);
		}
		else
		{
			sprintf(tmpStr, "CISAM error %d occured on gld0data...please check..", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}

		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}
	strncpy(responseMsg.accOpeningCard.accNo, receivedMsg.accOpeningCard.accNo, 14);
	strncpy(responseMsg.accOpeningCard.iban, gldRec.iban, 24);

	strncpy(responseMsg.accOpeningCard.custNo, custTabRec.custNo, 7);
	if ( custTabRec.custType != '0' )
	{
		strncpy(responseMsg.accOpeningCard.aShortName, custTabRec.aOrgShortName, 30);
		strncpy(responseMsg.accOpeningCard.eShortName, custTabRec.eOrgShortName, 30);
		if ( custTabRec.preferredLang == '0' ) /* ARABIC */
			strncpy(responseMsg.accOpeningCard.firstName, custTabRec.aOrgName1, 60);
		else
			strncpy(responseMsg.accOpeningCard.firstName, custTabRec.eOrgName1, 60);
	}
	else
	{
		strncpy(responseMsg.accOpeningCard.aShortName, custTabRec.aShortName, 30);
		strncpy(responseMsg.accOpeningCard.eShortName, custTabRec.eShortName, 30);
		if ( custTabRec.preferredLang == '0' ) /* ARABIC */
			strncpy(responseMsg.accOpeningCard.firstName, custTabRec.aFirstName, 60);
		else
			strncpy(responseMsg.accOpeningCard.firstName, custTabRec.eFirstName, 60);
	}

	strncpy(responseMsg.accOpeningCard.custBranchCode, custTabRec.branchCode, 4);
	responseMsg.accOpeningCard.customerLang = custTabRec.preferredLang;
	strncpy(responseMsg.accOpeningCard.custOpenDate, custTabRec.custOpenDate, 8);
	strncpy(responseMsg.accOpeningCard.accOpenDate, bmDateToActual(gldRec.accOpenDate, tmpStr), 8);

	formatAccOpeningCardResponse(DONE, "Successful", "Successful");
	fflush(logFp);
	sendResponse(responseMsg.accOpeningCard.msgLen);
	return SUCCESS;
}

processConfirmAccOpeningCard()
{
	char tmpStr[100];

	memset(&accOpenCardRec.liveChar, ' ', sizeof accOpenCardRec);
	accOpenCardRec.liveChar = '@';
	strncpy(accOpenCardRec.branchCode, receivedMsg.printAccOpeningCard.homeBranch, 4);
	strncpy(accOpenCardRec.userId, receivedMsg.printAccOpeningCard.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min, systemDate->tm_sec);
	strncpy(accOpenCardRec.dateTime, tmpStr, 14);
	strncpy(accOpenCardRec.custNo, receivedMsg.printAccOpeningCard.custNo, 7);
	accOpenCardRec.printStatus = receivedMsg.printAccOpeningCard.requestType;
	strncpy(accOpenCardRec.accNo, receivedMsg.printAccOpeningCard.accNo, 14);
	strncpy(accOpenCardRec.iban, receivedMsg.printAccOpeningCard.iban, 24);
	strncpy(accOpenCardRec.custName, receivedMsg.printAccOpeningCard.shortName, 30);
	strncpy(accOpenCardRec.custBranchCode, receivedMsg.printAccOpeningCard.custBranchCode, 4);
	accOpenCardRec.customerLang = receivedMsg.printAccOpeningCard.customerLang;
	strncpy(accOpenCardRec.custOpenDate, receivedMsg.printAccOpeningCard.custOpenDate, 8);

	strncpy(accOpenCardRec.lastUpdateUser, receivedMsg.printAccOpeningCard.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min, systemDate->tm_sec);
	strncpy(accOpenCardRec.lastUpdateDateTime, tmpStr, 14);

	if ( isWrite(accOpenCardFile, &accOpenCardRec.liveChar) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processConfirmAccOpeningCard] :ISWRITE error %d while writing into account opening card file(staccopencard) for customer # %.7s & key [%.28s]\n", getDateTime(), PID, iserrno, receivedMsg.printAccOpeningCard.custNo, accOpenCardRec.branchCode);
		fflush(logFp);
		if  ( iserrno == 100 )
		{
			sprintf(tmpStr, "Duplicate record on staccopencard [%.28s]", accOpenCardRec.branchCode);
			formatBranchResponse(DUPLICATE, tmpStr, tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked on staccopencard"); 
			formatBranchResponse(RECORD_LOCKED, tmpStr, tmpStr);
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on staccopencard", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		}
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}

	isclose(accOpenCardFile);
	accOpenCardFileOpen=NO;

	formatBranchResponse(DONE, "Successful...", "Successful...");
	sendResponse(responseMsg.customer.msgLen);
	return SUCCESS;
}

processFetchIBAN() 
{
	char tmpStr[100], tAccNo[20], bmAccNo[20];
	char tCustNo[15], bmCustNo[15], aDate[15];
	char ibanAccNo[30];
	int  retStatus;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processFetchIBAN]\n", getDateTime(), PID);

	memset(responseMsg.fetchAccDetails.msgLen, ' ', sizeof responseMsg.fetchAccDetails);

	memset(&gldRec.liveChar, ' ', sizeof gldRec);

	strncpy(gldRec.accNo, actualToBmAcc(receivedMsg.fetchAccDetails.accNo, bmAccNo), 13);

	isindexinfo(gldFile, &gldKey, 1);
	isstart(gldFile, &gldKey, 0, &gldRec.liveChar, ISGTEQ);

	if ( isRead(gldFile, &gldRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processFetchAccDetails] ISREAD/ISEQUAL error %d on gld0data for the key=%.13s and the account number is [%.14s]\n", getDateTime(), PID, iserrno, bmAccNo, receivedMsg.fetchAccDetails.accNo );
		fflush(logFp);
		if  ( iserrno == 111 || iserrno == 112 )
		{
			sprintf(tmpStr, "Record not found with this key ");
			formatFetchAccDetailResponse(NOT_FOUND, tmpStr, tmpStr ); 
		}
		else if ( iserrno = 110 )
		{
			sprintf(tmpStr, "Begining/End of file reached");
			formatFetchAccDetailResponse(END_OF_FILE, tmpStr,tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked on gld0data");
			formatFetchAccDetailResponse(RECORD_LOCKED,  tmpStr, tmpStr); 
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on gld0data", iserrno);
			formatFetchAccDetailResponse(INTERNALERR, tmpStr,tmpStr);
		}
		sendResponse(responseMsg.fetchAccDetails.msgLen);
		return FAILURE;
	}

	strncpy(responseMsg.fetchAccDetails.accNo, receivedMsg.fetchAccDetails.accNo, 14);

	if ( strncmp(gldRec.iban, "SA", 2) ) 
	{
		retStatus = convertToIban(receivedMsg.fetchAccDetails.accNo, ibanAccNo, "30"); 
		if ( retStatus < 0 )
		{
			fprintf(logFp, "%s|%5d|[processFetchAccDetails]: Error %d while converting the BM account number [%.14s] to IBAN account; IBAN moved as spaces \n", getDateTime(), PID, retStatus, receivedMsg.fetchAccDetails.accNo);
			fflush(logFp);
		}
		strncpy(gldRec.iban, ibanAccNo, 24);
	}

	strncpy(responseMsg.fetchAccDetails.iban, gldRec.iban, 24);

	formatFetchAccDetailResponse(DONE, "Successful...", "Successful...");
	sendResponse(responseMsg.fetchAccDetails.msgLen);
	return SUCCESS;
}

readCardTabFile(mode)
int mode;
{
	char tmpStr[50];

	fprintf(logFp, "%s|%5d|[readCardTabFile] for key value %.19s\n", getDateTime(), PID, cardTabRec.cardNo);
	fflush(logFp);
	if ( isRead(cardTabFile, &cardTabRec.liveChar, mode) < 0 )
	{
		fprintf(logFp, "%s|%5d|[readCardTabFile] : ISREAD/%s error %d on cbcardtab for the key=%.19s\n", getDateTime(), PID, mode==ISEQUAL ? "ISEQUAL" : mode==ISNEXT ? "ISNEXT" : mode==ISPREV ? "ISPREV" : mode == ISFIRST ? "ISFIRST" : mode == ISLAST ? "ISLAST" : mode == ISGTEQ ? "ISGTEQ" : "UNKNOWN", iserrno, cardTabRec.cardNo);
		fflush(logFp);
		if  ( iserrno == 111 || iserrno == 112 )
		{
			sprintf(tmpStr, "Record not found with this key ");
			formatBranchResponse(NOT_FOUND, tmpStr, tmpStr ); 
		}
		else if ( iserrno == 110 )
		{
			sprintf(tmpStr, "Begining/End of file reached");
			formatBranchResponse(END_OF_FILE, tmpStr,tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked on cbcardtab");
			formatBranchResponse(RECORD_LOCKED,  tmpStr, tmpStr); 
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on cbcardtab", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr,tmpStr);
		}
		/* send resonse will be taken care of calling function */
		return FAILURE;
	}

	fflush(logFp);
	return SUCCESS;
}

readCardLogFile(mode)
int mode;
{
	char tmpStr[50];

	fprintf(logFp, "%s|%5d|[readCardLogFile] for key value [%.28s] [%.19s]\n", getDateTime(), PID, cardLogRec.branchCode, cardLogRec.cardNo);
	fflush(logFp);
	if ( isRead(cardLogFile, &cardLogRec.liveChar, mode) < 0 )
	{
		fprintf(logFp, "%s|%5d|[readCardLogFile] ISREAD/%s error %d on cbcardlog for the key=%.38s and the card number is [%.19s]\n", getDateTime(), PID, mode==ISEQUAL ? "ISEQUAL" : mode==ISNEXT ? "ISNEXT" : mode==ISPREV ? "ISPREV" : mode == ISFIRST ? "ISFIRST" : mode == ISLAST ? "ISLAST" : mode == ISGTEQ ? "ISGTEQ" : "UNKNOWN", iserrno, cardLogRec.branchCode, cardLogRec.cardNo);
		fflush(logFp);
		if  ( iserrno == 111 || iserrno == 112 )
		{
			sprintf(tmpStr, "Record not found in cbcardlog with this key ");
			formatBranchResponse(NOT_FOUND, tmpStr, tmpStr ); 
		}
		else if ( iserrno == 110 )
		{
			sprintf(tmpStr, "Begining/End of file reached in cbcardlog ");
			formatBranchResponse(END_OF_FILE, tmpStr,tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked on cbcardlog");
			formatBranchResponse(RECORD_LOCKED,  tmpStr, tmpStr); 
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on cbcardlog", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr,tmpStr);
		}
		/* send resonse will be taken care of calling function */
		return FAILURE;
	}

	fflush(logFp);
	return SUCCESS;
}

updateCardLogFile()
{
	char tmpStr[120];

	if ( isRewcurr(cardLogFile, &cardLogRec.liveChar) < 0 ) 
	{
		fprintf(logFp, "%s|%5d|[updateCardLogFile] : ISREWCURR error %d on cbcardlog for key=[%.28s] [%.19s]\n", getDateTime(), PID, iserrno, cardLogRec.branchCode, cardLogRec.cardNo);
		fflush(logFp);
		if  ( iserrno == 100 )
		{
			sprintf(tmpStr, "Duplicate record [%.28s] [%.19s] on cbcardlog", cardLogRec.branchCode, cardLogRec.cardNo);
			formatCardApprovalResponse( DUPLICATE, tmpStr, tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked on cbcardlog");
			formatCardApprovalResponse(RECORD_LOCKED, tmpStr, tmpStr);
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on cbcardlog", iserrno);
			formatCardApprovalResponse(INTERNALERR, tmpStr, tmpStr);
		}
		isrelease(cardLogFile);
		return FAILURE;
	}

	isrelease(cardLogFile);
	return SUCCESS;
}

