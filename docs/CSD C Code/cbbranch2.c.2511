logStatusUpdateDetails()
{
	char tmpStr[10];
	int noOfRecs, i;

	sprintf(tmpStr,"%.2s", receivedMsg.statusUpdate.noOfRecs);
	noOfRecs = atoi(tmpStr);

	if ( debug == 0 )
		return SUCCESS;

	fprintf(logFp, "%s : INCOMMING MESSAGE from %s\n", getDateTime(), authorisedUser);
	fprintf(logFp, "===================================\n");
	fprintf(logFp, "Service 		: %.2s[Card / Pin Status Update]\n", receivedMsg.statusList.service);
	fprintf(logFp, "Branch Code		: %.4s\n", receivedMsg.statusUpdate.homeBranch);
	fprintf(logFp, "User Id			: %.10s\n", receivedMsg.statusUpdate.userId);
	fprintf(logFp, "No.of Records	: %.2s\n", receivedMsg.statusUpdate.noOfRecs);
	fprintf(logFp, "Card / Pin Flag   : %c\n", receivedMsg.statusUpdate.cardOrPin);
	fprintf(logFp, "Request Status    : %c\n", receivedMsg.statusUpdate.requestStatus);

	for(i=0; i < noOfRecs; i++)
	{
		fprintf(logFp, "Card No [%d]   : %.19s\n", i+1, receivedMsg.statusUpdate.cardNo[i]);
	}
	fflush(logFp);
}

