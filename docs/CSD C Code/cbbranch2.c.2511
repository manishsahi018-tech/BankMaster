logCardSearchDetails()
{
	if ( debug == 0  )
		return SUCCESS;
	fprintf(logFp, "%s : INCOMMING MESSAGE from %s\n", getDateTime(), authorisedUser);
	fprintf(logFp, "===================================\n");
	fprintf(logFp, "Service         : %.2s[Card Enquiry]\n", receivedMsg.cardSearch.service);
	fprintf(logFp, "Last Record     : %.5s\n", receivedMsg.cardSearch.lastRecCount);
	fprintf(logFp, "Cust Number     : %.8s\n", receivedMsg.cardSearch.custNo);
	fprintf(logFp, "Account Number  : %.16s\n", receivedMsg.cardSearch.accNo);
	fprintf(logFp, "Card Number     : %.19s\n", receivedMsg.cardSearch.cardNo);
	fprintf(logFp, "Id Number       : %.15s\n", receivedMsg.cardSearch.idNo);
	fflush(logFp);
}

logCardDetails()
{
	if ( debug == 0  )
		return SUCCESS;

	fprintf(logFp, "%s : INCOMMING MESSAGE from %s\n", getDateTime(), authorisedUser);
	fprintf(logFp, "===================================\n");
	fprintf(logFp, "Service         : %.2s[New/Update Card Request]\n", receivedMsg.cardInfo.service);
	fprintf(logFp, "Branch Code     : %.4s\n", receivedMsg.cardInfo.homeBranch);
	fprintf(logFp, "User Id         : %.10s\n", receivedMsg.cardInfo.userId);
	fprintf(logFp, "Date & Time     : %.14s\n", receivedMsg.cardInfo.dateTime);
	fprintf(logFp, "New Or Update   : %c\n", receivedMsg.cardInfo.newOrUpdate);
	fprintf(logFp, "Creation/Update : %c\n", receivedMsg.cardInfo.creationOrUpdate);
	fprintf(logFp, "Customer No     : %.8s\n", receivedMsg.cardInfo.custNo);
	fprintf(logFp, "Customer Br.Code: %.4s\n", receivedMsg.cardInfo.customerBranch);
	fprintf(logFp, "Card Type       : %c\n", receivedMsg.cardInfo.cardType);
	fprintf(logFp, "Primary/Supp    : %c\n", receivedMsg.cardInfo.primaryOrSupplementary);
	fprintf(logFp, "New/Replacement : %c\n", receivedMsg.cardInfo.newOrReplacement);
	fprintf(logFp, "Name on the card: %.26s\n", receivedMsg.cardInfo.nameOnTheCard);
	fprintf(logFp, "Delivery to Branch/PO Box : %c\n", receivedMsg.cardInfo.deliveryToBranchOrPO);

	fflush(logFp);
}

