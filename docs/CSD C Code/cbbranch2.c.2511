	responseMsg.cardSearch.nullPad = '\0';
	sprintf(tmpStr, "%06d", strlen(responseMsg.cardSearch.msgLen));
	strncpy(responseMsg.cardSearch.msgLen, tmpStr, 6);
	if ( responseCode == COMMSERR )
