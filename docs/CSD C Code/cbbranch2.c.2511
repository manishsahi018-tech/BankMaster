openCbCtlFile(int mode)
{
	char tmpStr[100];
	if ( cbCtlTabFileOpen == YES )
		return SUCCESS;

	if ( (cbCtlTabFile  = isopen(cbCtlTabFilePath, mode )) < 0)
	{
		fprintf(logFp, "%s|%5d|[openCbCtlFile] ISOPEN error %d for %s File\n", getDateTime(), PID, iserrno, cbCtlTabFilePath);
		sprintf(tmpStr,"Error  %d occured while opening cbctltab.dat", iserrno);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}
	isindexinfo(cbCtlTabFile, &cbCtlTabKey, 1);
	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| cbctltab file (%d) successfully opened...\n", getDateTime(), PID, cbCtlTabFile);
		fflush(logFp);
	}

	cbCtlTabFileOpen = YES;
	return SUCCESS;
}

