		return SUCCESS;

	fprintf(logFp, "%s : INCOMMING MESSAGE from %s\n", getDateTime(), authorisedUser);
	fprintf(logFp, "===================================\n");
	fprintf(logFp, "Service         : %.2s[Change Address]\n", receivedMsg.changeAddress.service);
	fprintf(logFp, "Branch Code     : %.4s\n", receivedMsg.changeAddress.homeBranch);
	fprintf(logFp, "User Id         : %.10s\n", receivedMsg.changeAddress.userId);
	fprintf(logFp, "Card  Number    : %.19s\n", receivedMsg.changeAddress.cardNo);
	fprintf(logFp, "Delivery to Branch Or PO  : %c\n", receivedMsg.changeAddress.deliveryToBranchOrPO);
	fprintf(logFp, "Address 1       : %.30s\n", receivedMsg.changeAddress.address1);
	fprintf(logFp, "Address 2       : %.30s\n", receivedMsg.changeAddress.address2);
	fprintf(logFp, "Po Box          : %.10s\n", receivedMsg.changeAddress.poBox);
	fprintf(logFp, "City  Name      : %.20s\n", receivedMsg.changeAddress.cityName);
	fprintf(logFp, "Zip  Code       : %.10s\n", receivedMsg.changeAddress.zipCode);
	fflush(logFp);
}

