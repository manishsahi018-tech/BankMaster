moveSignTabRecToSignLog()
{
	char keyDateTime[20], tmpStr[100];

	if ( openIdLogFile(ISINOUT+ISMANULOCK) < 0 )
	{
		sendResponse(responseMsg.pendingDetail.msgLen);
		return FAILURE;
	}

	if ( openIdTabFile(ISINOUT+ISMANULOCK) < 0 )
	{
		sendResponse(responseMsg.pendingDetail.msgLen);
		return FAILURE;
	}

	if ( openSignLogFile(ISINOUT+ISMANULOCK) < 0 )
	{
		sendResponse(responseMsg.pendingDetail.msgLen);
		return FAILURE;
	}

	if ( openSignTabFile(ISINOUT+ISMANULOCK) < 0 )
	{
		sendResponse(responseMsg.pendingDetail.msgLen);
		return FAILURE;
	}

	getDateTime();
	sprintf(keyDateTime, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);

	memset(&signTabRec.liveChar, ' ', sizeof signTabRec);
	/* While Account Enquiry , we treat receivedMsg.accPendingDetail.dateTime  
	   									as Account Number  */
	strncpy(signTabRec.accNo, receivedMsg.accPendingDetail.dateTime, 14);
	isindexinfo(signTabFile, &signTabKey, 1);
	isstart(signTabFile, &signTabKey, 14, &signTabRec.liveChar, ISGTEQ);

	while ( isRead(signTabFile, &signTabRec.liveChar, ISNEXT) == 0 )
	{
		if ( strncmp(signTabRec.accNo, receivedMsg.accPendingDetail.dateTime, 14) )
			break;

		memset(&signLogRec.liveChar, ' ', sizeof signLogRec);
		signLogRec.liveChar = '@';
		strncpy(signLogRec.branchCode, receivedMsg.accPendingDetail.homeBranch, 4);
		strncpy(signLogRec.userId, authorisedUser, 10);
		strncpy(signLogRec.dateTime, keyDateTime, 14);

		signLogRec.newOrUpdate = 'U';
		strncpy(signLogRec.accNo, signTabRec.accNo, 14);
		strncpy(signLogRec.signatoryNo, signTabRec.signatoryNo, 4);
		strncpy(signLogRec.custBranchCode, signTabRec.branchCode, 4);
		signLogRec.idType = signTabRec.idType;
		strncpy(signLogRec.idNo, signTabRec.idNo, 244);
		strncpy(signLogRec.lastUpdateBmDate, bankingDate, 8);
		signLogRec.recordChanged = 'N';

		strncpy(signLogRec.lastUpdateUser, authorisedUser, 10);
		getDateTime();
		sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
		strncpy(signLogRec.lastUpdateDateTime, tmpStr, 14);

		if ( extraDebug > 4 )
		{
			fprintf(logFp, "%s|%5d| [moveSignTabRecToSignLog] Before writing to signLogFile (%d) ..\n", getDateTime(), PID, signLogFile);
			fflush(logFp);
		}
		if ( isWrite(signLogFile, &signLogRec.liveChar) < 0 )
		{
			fprintf(logFp, "%s|%5d|[moveSignTabRecToSignLog] ISWRITE error %d on stsignlog for account No [%.14s] ; signatory No [%.2s] ; and the key is [%.28s] IGNORED \n", getDateTime(), PID, iserrno, signLogRec.accNo, signLogRec.signatoryNo, signLogRec.branchCode);
			fflush(logFp);
		}

		memset(&idTabRec.liveChar, ' ', sizeof idTabRec);

		strncpy(idTabRec.custNo, &signTabRec.accNo[5], 7);
		idTabRec.idType = signTabRec.idType;
		strncpy(idTabRec.idNo, signTabRec.idNo, 15);
		idTabRec.idCategory = 'S';
		isindexinfo(idTabFile, &idTabKey, 1);
		isstart(idTabFile, &idTabKey, 0, &idTabRec.liveChar, ISGTEQ);

		if ( isRead(idTabFile, &idTabRec.liveChar, ISEQUAL) == 0 )
		{
			memset(&idLogRec.liveChar, ' ', sizeof idLogRec);

			idLogRec.liveChar = '@';
			strncpy(idLogRec.branchCode, receivedMsg.accPendingDetail.homeBranch, 4);
			strncpy(idLogRec.userId, authorisedUser, 10);
			strncpy(idLogRec.dateTime, keyDateTime, 14);

			idLogRec.newOrUpdate = 'U';
			strncpy(idLogRec.custNo, idTabRec.custNo, 7);
			idLogRec.idType = idTabRec.idType;
			strncpy(idLogRec.idNo, idTabRec.idNo, 96); /* From idNo to grace2ActionDate */
			strncpy(idLogRec.idRefNo, idTabRec.idRefNo, 4);
			strncpy(idLogRec.lastUpdateBmDate, bankingDate, 8);
			idLogRec.recordChanged = 'N';  /* Not changed */

			strncpy(idLogRec.lastUpdateUser, authorisedUser, 10);
			getDateTime();
			sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
			strncpy(idLogRec.lastUpdateDateTime, tmpStr, 14);

			if ( extraDebug > 4 )
			{
				fprintf(logFp, "%s|%5d| [moveSignTabRecToSignLog] Before writing to idLogFile (%d) ..\n", getDateTime(), PID, idLogFile);
				fflush(logFp);
			}
			if ( isWrite(idLogFile, &idLogRec.liveChar) < 0 )
			{
				fprintf(logFp, "%s|%5d|[moveSignTabRecToSignLog] ISWRITE error %d on stidlog for customer No [%.7s] ; id type & id No [%c ; %.15s] ; id Ref No [%.4s] ; id category [%c] and the key is [%.28s] IGNORED \n", getDateTime(), PID, iserrno, idLogRec.custNo, idLogRec.idType , idLogRec.idNo,idLogRec.idRefNo,  idLogRec.idCategory, idLogRec.branchCode);
				fflush(logFp);
			}
		}
		else
		{
			fprintf(logFp, "%s|%5d|[moveSignTabRecToSignLog] ISREAD/IEQUAL error %d on stidtab for customer No [%.7s] ; id type & id No [%c ; %.15s] ; id category [%c] IGNORED \n", getDateTime(), PID, iserrno, idTabRec.custNo, idTabRec.idType , idTabRec.idNo,idTabRec.idCategory);
			fflush(logFp);
		}
	}

	strncpy(responseMsg.accPendingDetail.keyDateTime, keyDateTime, 14);
	return SUCCESS;
}

