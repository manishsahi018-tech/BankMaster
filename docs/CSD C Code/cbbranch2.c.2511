openCtlFile(int mode )
{
	char tmpStr[80];

	if ( ctlFileOpen == YES )
		return SUCCESS;

	/* Open static control table */
	if ( (ctlFile  = isopen(ctlFilePath, mode )) < 0)
	{
		fprintf(logFp, "%s|%5d|[openCtlFile] ISOPEN error %d for %s File\n", getDateTime(), PID, iserrno, ctlFilePath);
		sprintf(tmpStr,"Error  %d occured while opening stctltab.dat", iserrno);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr );
		return FAILURE;
	}
	isindexinfo(ctlFile, &ctlKey, 1);
	ctlFileOpen = YES;

	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| Ctl file (%d) successfully opened....\n", getDateTime(), PID, ctlFile);
		fflush(logFp);
	}
	
	return SUCCESS;
}

getCtlDesc(char *recType, char *code)
{
	char retStr[100];

    memset(&ctlRec.liveChar, ' ', sizeof ctlRec);

	strncpy(ctlRec.recType, recType, 2);
	strncpy(ctlRec.branchCode, code, 4);
	isindexinfo(ctlFile, &ctlKey, 1);
	isstart(ctlFile, &ctlKey, 0, &ctlRec.liveChar, ISGTEQ);

	if ( isRead(ctlFile, &ctlRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s : ISREAD/ISEQUAL error %d occured while reading Control File for Code No [%.6s]\n", getDateTime(), iserrno,ctlRec.recType);
		fflush(logFp);
		sprintf(ctlRec.englishName, " [%.6s]  Not found in ctlTab  ", ctlRec.recType);
		return -1;
	}
	return 0;
}

getHijriDate(char *gregDate)
{
	memset(&calendarRec.liveChar, ' ', sizeof calendarRec);

	if ( strncmp(gregDate, "             ", 8) == 0 )
		return SUCCESS;

	isindexinfo(calendarFile, &calendarKey, 1);

	strncpy(calendarRec.gregDate, gregDate, 8);

	isstart(calendarFile, &calendarKey, 0, &calendarRec.liveChar, ISGTEQ);

	if ( isRead(calendarFile, &calendarRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d| [getHijiriDate] ISREAD/ISEQUAL error %d occured on stcaltab while reading greg-to-Hijri date correponds to [%.8s]\n", getDateTime(), PID, iserrno, gregDate);
		fflush(logFp);
		return FAILURE;
	}

	return SUCCESS;
}

getGregDate(char *hijriDate)
{
	memset(&calendarRec.liveChar, ' ', sizeof calendarRec);

	if ( strncmp(hijriDate, "           ", 8) == 0 )
		return SUCCESS;

	isindexinfo(calendarFile, &calendarKey, 2);

	strncpy(calendarRec.hijriDate, hijriDate, 8);

	isstart(calendarFile, &calendarKey, 0, &calendarRec.liveChar, ISGTEQ);

	if ( isRead(calendarFile, &calendarRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d| [getGregDate] ISREAD/ISEQUAL error %d occured on stcaltab while reading hijri-to-greg date correponds to [%.8s]\n", getDateTime(), PID, iserrno, hijriDate);
		fflush(logFp);
		return FAILURE;
	}

	return SUCCESS;
}

