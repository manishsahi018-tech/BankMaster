logChequeBookHistoryDetails()
{
	if ( debug == 0 )
		return SUCCESS;

	fprintf(logFp, "%s : INCOMMING MESSAGE from %s\n", getDateTime(), authorisedUser);
	fprintf(logFp, "===================================\n");
	fprintf(logFp, "Service         : %.2s[Cheque Book History Details]\n", receivedMsg.chequeBookHistory.service);
	fprintf(logFp, "Branch Code     : %.4s\n", receivedMsg.chequeBookHistory.homeBranch);
	fprintf(logFp, "Account Number  : %.14s\n", receivedMsg.chequeBookHistory.accNo);
	fprintf(logFp, "Request Date    : %.8s\n", receivedMsg.chequeBookHistory.reqDate);
	fflush(logFp);
}

logAcctStatusChangeHistoryDetails()
{
	if ( debug == 0 )
		return SUCCESS;

	fprintf(logFp, "%s : INCOMMING MESSAGE from %s\n", getDateTime(), authorisedUser);
	fprintf(logFp, "===================================\n");
	fprintf(logFp, "Service         : %.2s[Account Status_Change/Update History Details]\n", receivedMsg.acctStatusHistory.service);
	fprintf(logFp, "Branch Code     : %.4s\n", receivedMsg.acctStatusHistory.homeBranch);
	fprintf(logFp, "Account Number  : %.14s\n", receivedMsg.acctStatusHistory.accNo);
	fprintf(logFp, "Request Type    : %c\n", receivedMsg.acctStatusHistory.requestType);
	fprintf(logFp, "                  0-A/c status change;1-Sama a/c status change; 2-A/c update; History \n");
	fprintf(logFp, "Last Rec count  : %.5s\n", receivedMsg.acctStatusHistory.lastRecCount);
	fflush(logFp);
}

openChqTabFile(int mode)
{
	char tmpStr[100];
	if ( chqTabFileOpen == YES )
		return SUCCESS;

	if ( (chqTabFile  = isopen(chqTabFilePath, mode)) < 0)
	{
		fprintf(logFp, "%s|%5d|[openChqTabFile] ISOPEN error %d for %s File\n", getDateTime(), PID, iserrno, chqTabFilePath);
		sprintf(tmpStr,"Error  %d occured while opening stchqtab.dat", iserrno);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}
	isindexinfo(chqTabFile, &chqTabKey, 1);

	chqTabFileOpen = YES;
	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| stchqtab file (%d) successfully opened...\n", getDateTime(), PID, chqTabFile);
		fflush(logFp);
	}
	return SUCCESS;
}

openAccOpenCardFile(int mode)
{
	char tmpStr[100];
	if ( accOpenCardFileOpen == YES )
		return SUCCESS;

	if ( (accOpenCardFile = isopen(accOpenCardFilePath, mode)) < 0)
	{
		fprintf(logFp, "%s|%5d|[openAccOpenCardFile] ISOPEN error %d for %s File\n", getDateTime(), PID, iserrno, accOpenCardFilePath);
		fflush(logFp);
		sprintf(tmpStr,"Error  %d occured while opening staccopencard.dat", iserrno);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}
	isindexinfo(accOpenCardFile, &accOpenCardKey, 1);

	accOpenCardFileOpen = YES;
	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| staccopencard file (%d) successfully opened...\n", getDateTime(), PID, accOpenCardFile);
		fflush(logFp);
	}
	return SUCCESS;
}

formatAccOpeningCardResponse(responseCode, aRemarks, eRemarks)
char *responseCode, *aRemarks,*eRemarks;
{
	char tmpStr[120];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[formatAccOpeningCardResponse] Formating the response\n", getDateTime(), PID);

	strncpy(responseMsg.accOpeningCard.status, responseCode, 3);
	sprintf(tmpStr, "%-50.50s", aRemarks);
	strncpy(responseMsg.accOpeningCard.aRemarks,tmpStr,50);
	sprintf(tmpStr, "%-50.50s", eRemarks);
	strncpy(responseMsg.accOpeningCard.eRemarks,tmpStr,50);
	strncpy(responseMsg.accOpeningCard.service, receivedMsg.accOpeningCard.service, 2);
	responseMsg.accOpeningCard.nullPad = '\0';
	sprintf(tmpStr, "%06d", strlen(responseMsg.accOpeningCard.msgLen));
	strncpy(responseMsg.accOpeningCard.msgLen, tmpStr, 6);
	if ( responseCode == COMMSERR )
	{
		iscleanup();
		fclose(logFp);
	}
	return SUCCESS;
}

