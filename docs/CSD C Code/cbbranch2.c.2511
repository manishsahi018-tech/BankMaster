readAcctLogFile(mode)
int mode;
{
	char tmpStr[50];

	fprintf(logFp, "%s|%5d|[readAcctLogFile] for key value %.38s \n", getDateTime(), PID, acctLogRec.branchCode );
	fflush(logFp);
	if ( isRead(acctLogFile, &acctLogRec.liveChar, mode) < 0 )
	{
		fprintf(logFp, "%s|%5d|[readAcctLogFile] ISREAD/%s error %d on stacclog for the key=%.38s and the acct number is [%.14s]\n", getDateTime(), PID, mode==ISEQUAL ? "ISEQUAL" : mode==ISNEXT ? "ISNEXT" : mode==ISPREV ? "ISPREV" : mode == ISFIRST ? "ISFIRST" : mode == ISLAST ? "ISLAST" : mode == ISGTEQ ? "ISGTEQ" : "UNKNOWN", iserrno, acctLogRec.branchCode, acctLogRec.accNo);
		fflush(logFp);
		if  ( iserrno == 111 || iserrno == 112 )
		{
			sprintf(tmpStr, "Record not found in stacclog with this key ");
			formatBranchResponse(NOT_FOUND, tmpStr, tmpStr ); 
		}
		else if ( iserrno == 110 )
		{
			sprintf(tmpStr, "Begining/End of file reached");
			formatBranchResponse(END_OF_FILE, tmpStr,tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked on stacclog");
			formatBranchResponse(RECORD_LOCKED,  tmpStr, tmpStr); 
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on stacclog", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr,tmpStr);
		}
		/* send resonse will be taken care of calling function */
		return FAILURE; 
	}
	fflush(logFp);
	return SUCCESS;
}

logAccPendingDetails()
{
	if ( debug == 0  )
		return SUCCESS;

	fprintf(logFp, "%s : INCOMMING MESSAGE from %s\n", getDateTime(), authorisedUser);
	fprintf(logFp, "===================================\n");
	if ( strncmp(receivedMsg.accPendingDetail.requestType, "01", 2) == 0 )
		fprintf(logFp, "Service             : %.2s[Account Pending Detail]\n", receivedMsg.accPendingDetail.service);
	else if ( strncmp(receivedMsg.accPendingDetail.requestType, "02", 2) == 0 )
		fprintf(logFp, "Service             : %.2s[Account Detail]\n", receivedMsg.accPendingDetail.service);
	else if ( strncmp(receivedMsg.accPendingDetail.requestType, "03", 2) == 0 )
		fprintf(logFp, "Service             : %.2s[Dormant Account Activation]\n", receivedMsg.accPendingDetail.service);
	else
		fprintf(logFp, "Service             : %.2s[Unknown Request Type]\n", receivedMsg.accPendingDetail.service);

	fprintf(logFp, "Branch Code         : %.4s\n", receivedMsg.accPendingDetail.homeBranch);
	fprintf(logFp, "Request Type        : %.2s\n", receivedMsg.accPendingDetail.requestType);
	fprintf(logFp, "User Id             : %.10s\n", receivedMsg.accPendingDetail.userId);
	fprintf(logFp, "Date & Time/Account Number  : %.14s\n", receivedMsg.accPendingDetail.dateTime);
	fflush(logFp);
}

formatAccSearchResponse(responseCode, aRemarks, eRemarks)
char *responseCode, *aRemarks,*eRemarks;
{
	char tmpStr[120];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[formatAccSearchRespone] Formating the response\n", getDateTime(), PID);

	strncpy(responseMsg.accSearch.status, responseCode, 3);
	sprintf(tmpStr, "%-50.50s", aRemarks);
	strncpy(responseMsg.accSearch.aRemarks,tmpStr,50);
	sprintf(tmpStr, "%-50.50s", eRemarks);
	strncpy(responseMsg.accSearch.eRemarks,tmpStr,50);
	strncpy(responseMsg.accSearch.service, receivedMsg.accSearch.service, 2);
	responseMsg.accSearch.nullPad = '\0';
	sprintf(tmpStr, "%06d", strlen(responseMsg.accSearch.msgLen));
	strncpy(responseMsg.accSearch.msgLen, tmpStr, 6);
	if ( responseCode == COMMSERR )
	{
		iscleanup();
		fclose(logFp);
	}
	return SUCCESS;
}

formatAccPendingDetailResponse(responseCode, aRemarks, eRemarks)
char *responseCode, *aRemarks, *eRemarks;
{
	char	tmpStr[100];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[formatAccPendingDetailResponse] formating the response\n", getDateTime(), PID);

	strncpy(responseMsg.accPendingDetail.status, responseCode, 3);
	sprintf(tmpStr, "%-50.50s", aRemarks);
	strncpy(responseMsg.accPendingDetail.aRemarks,tmpStr,50);
	sprintf(tmpStr, "%-50.50s", eRemarks);
	strncpy(responseMsg.accPendingDetail.eRemarks,tmpStr,50);
	strncpy(responseMsg.accPendingDetail.service, receivedMsg.accPendingDetail.service, 2);
	responseMsg.accPendingDetail.nullPad = '\0';
	sprintf(tmpStr, "%06d", strlen(responseMsg.accPendingDetail.msgLen));
	strncpy(responseMsg.accPendingDetail.msgLen, tmpStr, 6);
	if ( responseCode == COMMSERR )
	{
		iscleanup();
		fclose(logFp);
	}
	return SUCCESS;
}

