openGldFile(int mode)
{
	char tmpStr[100];
	if ( gldFileOpen == YES )
		return SUCCESS;

	if ( (gldFile  = isopen(gldFilePath, mode )) < 0)
	{
		fprintf(logFp, "%s|%5d|[openGldFile] : ISOPEN error %d for %s File\n", getDateTime(), PID, iserrno, gldFilePath);
		sprintf(tmpStr,"Error  %d occured while opening gld0data.dat", iserrno);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}
	isindexinfo(gldFile, &gldKey, 1);

	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d|[openGldFile] : gld0data file [%d] successfully opened...\n", getDateTime(), PID, gldFile);
		fflush(logFp);
	}

	gldFileOpen = YES;
	return SUCCESS;
}

openCardTabFile(int mode)
{
	char tmpStr[80];

	if ( cardTabFileOpen == YES )
		return SUCCESS;

	/* Open card table */
	if ( (cardTabFile  = isopen(cardTabFilePath, mode )) < 0)
	{
		fprintf(logFp, "%s|%5d|[openCardTabFile] ISOPEN error %d for %s File\n", getDateTime(), PID, iserrno, cardTabFilePath);
		sprintf(tmpStr,"Error  %d occured while opening cbcardtab.dat", iserrno);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr );
		return FAILURE;
	}
	isindexinfo(cardTabFile, &cardTabKey, 1);

	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| cbcardTab file (%d) successfully opened...\n", getDateTime(), PID, cardTabFile);
		fflush(logFp);
	}

	cardTabFileOpen = YES;
	return SUCCESS;
}

openCardLogFile(int mode)
{
	char tmpStr[100];

	if ( cardLogFileOpen == YES )
		return SUCCESS;

	/*  Open Card Log table */
	if ( (cardLogFile = isopen(cardLogFilePath,mode)) < 0)
	{
		fprintf(logFp, "%s|%5d|[openCardLogFile] ISOPEN error %d for %s File\n", getDateTime(), PID, iserrno, cardLogFilePath);
		sprintf(tmpStr,"Error  %d occured while opening cbcardlog.dat", iserrno);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}
	isindexinfo(cardLogFile, &cardLogKey, 1);
	cardLogFileOpen = YES;

	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| cbcardlog file (%d) successfully opened...\n", getDateTime(), PID, cardLogFile);
		fflush(logFp);
	}

	return SUCCESS;
}

openUserFiles(int mode)
{
	char tmpStr[100];

	if ( userFileOpen == YES )
	{
		if ( userLogFileOpen == YES )
			return SUCCESS;

		/* Open user profile table */
		if ( (userLogFile  = isopen(userLogFilePath, mode)) < 0)
		{
			fprintf(logFp, "%s|%5d|[openUserFiles] ISOPEN error %d for %s File\n", getDateTime(), PID, iserrno, userLogFilePath);
			fflush(logFp);
			sprintf(tmpStr, "Error %d occured while opening stuserlog.dat ", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
		isindexinfo(userLogFile, &userLogKey, 1);
		userLogFileOpen = YES;
		if ( extraDebug > 4 )
		{
			fprintf(logFp, "%s|%5d| stuserlog file (%d) successfully opened...\n", getDateTime(), PID, userLogFile);
			fflush(logFp);
		}
		return SUCCESS;
	}


	if( (userFile = isopen(userFilePath, mode)) < 0 )
	{
		fprintf(logFp, "%s|%5d|[openUserFiles] ISOPEN error %d for %s file\n", getDateTime(), PID, iserrno, userFilePath);
		fflush(logFp);
		sprintf(tmpStr, "Error %d occured while opening stuser.dat \n", iserrno, userFilePath);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		return FAILURE;
	}

	isindexinfo(userFile, &userKey, 1);
	userFileOpen = YES;
	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| stuse file (%d) successfully opened...\n", getDateTime(), PID, userFile);
		fflush(logFp);
	}

	if ( userLogFileOpen == YES )
		return SUCCESS;

	/* Open user profile table */
	if ( (userLogFile  = isopen(userLogFilePath, mode)) < 0)
	{
		fprintf(logFp, "%s|%5d|[openUserFiles] ISOPEN error %d for %s File\n", getDateTime(), PID, iserrno, userLogFilePath);
		fflush(logFp);
		sprintf(tmpStr, "Error %d occured while opening stuserlog.dat ", iserrno);
		formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE;
	}
	isindexinfo(userLogFile, &userLogKey, 1);
	userLogFileOpen = YES;
	if ( extraDebug > 4 )
	{
		fprintf(logFp, "%s|%5d| stuserlog file (%d) successfully opened...\n", getDateTime(), PID, userLogFile);
		fflush(logFp);
	}

	return SUCCESS;
}

formatBranchResponse( responseCode, aRemarks, eRemarks)
char  *responseCode, *aRemarks,*eRemarks;
{
	char tmpStr[120];
	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[formatBranchResponse] formatting the response\n", getDateTime(), PID);
	strncpy(responseMsg.customer.status, responseCode, 3);
	sprintf(tmpStr, "%-50.50s", aRemarks);
	strncpy(responseMsg.customer.aRemarks,tmpStr,50);
	sprintf(tmpStr, "%-50.50s", eRemarks);
	strncpy(responseMsg.customer.eRemarks,tmpStr,50);
	strncpy(responseMsg.customer.service, receivedMsg.customer.service, 2);
	responseMsg.customer.nullPad = '\0';
	sprintf(tmpStr, "%06d", strlen(responseMsg.customer.msgLen));
	strncpy(responseMsg.customer.msgLen, tmpStr, 6);
	if ( responseCode == COMMSERR )
	{
		iscleanup();
		fclose(logFp);
	}
	return SUCCESS;
}

