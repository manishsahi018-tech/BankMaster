processStopChqSearch()
{
	int lastRecRcvd, recCount=0, recsInThisMsg = 0, i, len ;
	char tmpStr[100],tAccNo[20], tBmAccNo[25]; 

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processStopChqSearch]\n", getDateTime(), PID);


	memset(responseMsg.stopChqSearch.msgLen, ' ', sizeof responseMsg.stopChqSearch);
	responseMsg.stopChqSearch.nullPad = '\0';

	/* Same StdOrd search Request is used for stopChqSearch also */
	sprintf(tmpStr, "%.5s", receivedMsg.stdOrdSearch.lastRecCount);
	lastRecRcvd = atoi(tmpStr);

	memset(&pydRec.liveChar, ' ', sizeof pydRec);

	isindexinfo(pydFile, &pydKey, 1);

	strncpy(tAccNo, receivedMsg.stdOrdSearch.accNo, 14);
	strncpy(pydRec.recType, "CH", 2);
	strncpy(pydRec.accNo, actualToBmAcc(tAccNo, tBmAccNo), 13);
	isstart(pydFile, &pydKey, 15, &pydRec.liveChar, ISGTEQ);

	while ( isRead(pydFile, &pydRec.liveChar, ISNEXT) == 0 )
	{
		if ( recCount++ < lastRecRcvd )
			continue; /* read all records already sent */

		if ( strncmp(tBmAccNo, pydRec.accNo, 13) )
			break;

		len = sizeof(pydRec);

		for (i=0; i < len; i++)
		{
			if ( pydRec.recType[i] == NULL )
				pydRec.recType[i] = ' ';
		}

		if ( receivedMsg.stdOrdSearch.destroyChequeFlag == '1' )
		{
			if ( pydRec.destroyFlag != '1' )
				continue;
		}
		/*
		else
		{
			if ( pydRec.destroyFlag == '1' )
				continue;
		}
		*/

		strncpy(responseMsg.stopChqSearch.details[recsInThisMsg].chequeNo, pydRec.chequeNo, 10);
		strncpy(responseMsg.stopChqSearch.details[recsInThisMsg].amount, pydRec.amount, 14);
		strncpy(responseMsg.stopChqSearch.details[recsInThisMsg].stopDate, (char *) bmDateToActual(pydRec.dateStop,tmpStr), 8);
		strncpy(responseMsg.stopChqSearch.details[recsInThisMsg].details, pydRec.payeeName,25);
		strncpy(responseMsg.stopChqSearch.fromChequeNo[recsInThisMsg], pydRec.chequeFrom, 8);

		if ( ++recsInThisMsg >=  20 )
			break;
	}
	sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
	strncpy(responseMsg.stopChqSearch.lastRecCount, tmpStr, 5);
	sprintf(tmpStr, "%02d", recsInThisMsg);
	strncpy(responseMsg.stopChqSearch.noOfRecs, tmpStr, 2);

	formatStopChqSearchResponse(DONE, "Successful", "Successful");
	sendResponse(responseMsg.stopChqSearch.msgLen);
	return SUCCESS;
}

processStopChqDetail()
{
	char tmpStr[100], tAccNo[20], tBmAccNo[20];
	double transAmt;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processStopChqDetail]\n", getDateTime(), PID);


	memset(responseMsg.stopChqDetail.msgLen, ' ', sizeof responseMsg.stopChqDetail);
	memset(&pydRec.liveChar, ' ', sizeof pydRec);

	sprintf(tAccNo, "%.14s", receivedMsg.stopChqDetail.accNo);
	strncpy(pydRec.recType, "CH", 2);
	strncpy(pydRec.accNo, actualToBmAcc(tAccNo, tBmAccNo),13);
	strncpy(pydRec.chequeNo, receivedMsg.stopChqDetail.chequeNo, 10);

	isindexinfo(pydFile, &pydKey, 1);
	if( isstart(pydFile, &pydKey, 0, &pydRec.liveChar,ISGTEQ) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processStopChqDetail] :ISSTART/ISGTEQ error %d occured on pyd0data for key [%.26s]\n", getDateTime(), PID, iserrno, pydRec.recType);
		fflush(logFp);
		if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
		     formatStopChqDetailResponse(END_OF_FILE, "No Stop Cheque Record found for this Acct...", "No Stop Cheque Record found for this Acct ..");
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on pyd0data", iserrno);
			formatStopChqDetailResponse(INTERNALERR, tmpStr, tmpStr);
		}
     	sendResponse(responseMsg.pensionDetail.msgLen);
		return FAILURE;
	}

	if ( readPydFile(ISEQUAL) < 0 )
	{
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE ;
	}

	strncpy(responseMsg.stopChqDetail.accNo, tAccNo,14);
	strncpy(responseMsg.stopChqDetail.filler1, pydRec.filler1, 7);
	strncpy(responseMsg.stopChqDetail.chequeNo, pydRec.chequeNo, 10);
	transAmt = bmAmtToDbl(pydRec.amount,14);
	sprintf(tmpStr, "%014.0f", transAmt);
	/*strncpy(responseMsg.stopChqDetail.amount, pydRec.amount, 14);*/
	strncpy(responseMsg.stopChqDetail.amount, tmpStr, 14);
	strncpy(responseMsg.stopChqDetail.dateStop, (char *) bmDateToActual(pydRec.dateStop,tmpStr), 8);
	strncpy(responseMsg.stopChqDetail.payeeName, pydRec.payeeName, 25);
	strncpy(responseMsg.stopChqDetail.chequeFrom, pydRec.chequeFrom, 8);

	getStopChqUserId();

	formatStopChqDetailResponse(DONE, "Successful","Successful");
	sendResponse(responseMsg.stopChqDetail.msgLen);
	return SUCCESS;
}

getStopChqUserId()
{
	char tmpStr[50], accNo[15];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[getStopChqUserId]\n", getDateTime(), PID);


	if ( openStopChqLogFile(ISMANULOCK+ISINOUT) < 0 )
	{
		fprintf(logFp, "%s|%d|[getStopChqUserId] ISOPEN error %d on ststchqlog ignored...\n", getDateTime(), PID, iserrno);
		fflush(logFp);
		fprintf(errLogFp, "%s : getStopChqUserId() : ISOPEN error %d on ststchqlog ignored...\n", getDateTime(), iserrno);
		fflush(errLogFp);
		return 0;
	}

	memset(&stopChqLogRec.liveChar, ' ', sizeof stopChqLogRec);

	isindexinfo(stopChqLogFile, &stopChqLogKey, 5);

	strncpy(stopChqLogRec.recType, "CH",2);
	strncpy(stopChqLogRec.accNo, pydRec.accNo , 13);
	strncpy(stopChqLogRec.chequeNo, pydRec.chequeNo, 10);
	strncpy(stopChqLogRec.lastUpdateBmDate, "99999999", 8); 
	isstart(stopChqLogFile, &stopChqLogKey, 0, &stopChqLogRec.liveChar, ISGREAT);

	if ( isRead(stopChqLogFile, &stopChqLogRec.liveChar, ISPREV) < 0 )
	{
		fprintf(logFp, "%s|%5d|[getStopChqUserId] ISREAD/ISPREV error %d on ststchqlog for the key %.32s %.14s\n", getDateTime(), PID, iserrno, stopChqLogRec.recType, stopChqLogRec.lastUpdateDateTime);
		fflush(logFp);
	}

	if ( strncmp(stopChqLogRec.accNo, pydRec.accNo, 13) == 0  && strncmp(stopChqLogRec.chequeNo, pydRec.chequeNo, 8) == 0 )
	{
		strncpy(responseMsg.stopChqDetail.stopChqUserId, stopChqLogRec.userId, 10);
	}
	else
	{
		fprintf(logFp, "%s|%5d|[getStopChqUserId]  account numbers are different.. %.13s  %.13s   ;  %.10s  %.10s  \n", getDateTime(), PID, stopChqLogRec.accNo, pydRec.accNo, stopChqLogRec.chequeNo, pydRec.chequeNo);  
		fflush(logFp);
	}

	return 0;
}

processStopChqPendingDetail()
{
	char tmpStr[100], tAccNo[20], tBmAccNo[20];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processStopChqPendingDetail]\n", getDateTime(), PID);


	memset(responseMsg.stopChqDetail.msgLen, ' ', sizeof responseMsg.stopChqDetail);
	memset(&stopChqLogRec.liveChar, ' ', sizeof stopChqLogRec);

	strncpy(stopChqLogRec.branchCode, receivedMsg.stopChqDetail.homeBranch, 4);
	strncpy(stopChqLogRec.userId, receivedMsg.stopChqDetail.userId, 10);
	/* For Pending Detail, accNo in request message is used as date&time */
	strncpy(stopChqLogRec.dateTime, receivedMsg.stopChqDetail.accNo, 14);

	isindexinfo(stopChqLogFile, &stopChqLogKey, 1);
	if( isstart(stopChqLogFile, &stopChqLogKey, 0, &stopChqLogRec.liveChar,ISGTEQ) < 0 )
	{
		fprintf(logFp, "%s|%5d|[readStopChqPendingDetail] ISSTART/ISGTEQ error %d occured on ststchqlog for key [%.28s]\n", getDateTime(), PID, iserrno, stopChqLogRec.recType);
		fflush(logFp);
		if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
		     formatStopChqDetailResponse(END_OF_FILE, "No Stop Cheque Record found for this Acct...", "No Stop Cheque Record found for this Acct ..");
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on ststchqlog", iserrno);
			formatStopChqDetailResponse(INTERNALERR, tmpStr, tmpStr);
		}
     	sendResponse(responseMsg.pensionDetail.msgLen);
		return FAILURE;
	}

	if ( readStopChqLogFile(ISEQUAL) < 0 )
	{
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE ;
	}

	strncpy(responseMsg.stopChqDetail.accNo, bmAccToActual(stopChqLogRec.accNo, tAccNo), 14);
	strncpy(responseMsg.stopChqDetail.filler1, stopChqLogRec.filler1, 7);
	strncpy(responseMsg.stopChqDetail.chequeNo, stopChqLogRec.chequeNo, 10);
	strncpy(responseMsg.stopChqDetail.amount, stopChqLogRec.amount, 14);
	strncpy(responseMsg.stopChqDetail.dateStop, (char *) bmDateToActual(stopChqLogRec.dateStop,tmpStr), 8);
	strncpy(responseMsg.stopChqDetail.payeeName, stopChqLogRec.payeeName, 25);
	strncpy(responseMsg.stopChqDetail.chequeFrom, stopChqLogRec.chequeFrom, 8);
	responseMsg.stopChqDetail.newOrUpdate = stopChqLogRec.newOrUpdate;
	strncpy(responseMsg.stopChqDetail.supervisorComments, stopChqLogRec.supervisorComments,200);

	formatStopChqDetailResponse(DONE, "Successful","Successful");
	sendResponse(responseMsg.stopChqDetail.msgLen);
	return SUCCESS;
}

processStopChqRequest() 
{
	char tmpStr[100], tBmAccNo[15], tmpStr1[50];
	double transAmt;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processStopChqRequest]\n", getDateTime(), PID);

	readBankingDate();

	memset(&stopChqLogRec.liveChar, ' ', sizeof stopChqLogRec);
	stopChqLogRec.liveChar = '@';

	strncpy(stopChqLogRec.branchCode, receivedMsg.stopChqInfo.homeBranch, 4);
	strncpy(stopChqLogRec.userId, receivedMsg.stopChqInfo.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(stopChqLogRec.dateTime, tmpStr, 14);
	if ( receivedMsg.stopChqInfo.creationOrUpdate == 'U' )
	{
		strncpy(stopChqLogRec.dateTime, receivedMsg.stopChqInfo.dateTime, 14);
		if ( isRead(stopChqLogFile, &stopChqLogRec.liveChar, ISEQUAL) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processStopChqRequest] :ISREAD/ISEQUAL error %d while reading ststopchqlog for  the key # [%.28s] and account No [%.14s] [%.13s]\n", getDateTime(), PID, iserrno, stopChqLogRec.branchCode, receivedMsg.stopChqInfo.accNo, stopChqLogRec.accNo );
			fflush(logFp);
			if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
				 formatBranchResponse(END_OF_FILE,"No stop chq Record(s) found for this key ....", "No stop chq Record(s) found for this key ....");
			else
			{
				sprintf(tmpStr, "CISAM Error %d occured on ststchqlog file", iserrno);
				formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			}
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
	}

	strncpy(stopChqLogRec.userId, receivedMsg.stopChqInfo.userId, 10);
	if ( receivedMsg.stopChqInfo.destroyFlag == '1' )
	{
		stopChqLogRec.bmUpdateStatus = '9' ; 
		stopChqLogRec.destroyFlag = '1' ; 
	}
	else
	{
		stopChqLogRec.bmUpdateStatus = '1' ; /* 1 is for Pending with Supervisor */
		stopChqLogRec.destroyFlag = '0' ; 
	}
	actualToBmAcc(receivedMsg.stopChqInfo.accNo, tBmAccNo);
	strncpy(stopChqLogRec.accNo, tBmAccNo, 13);
	stopChqLogRec.newOrUpdate = receivedMsg.stopChqInfo.newOrUpdate;
	strncpy(stopChqLogRec.recType, "CH", 2);
	sprintf(tmpStr, "%.10s", receivedMsg.stopChqInfo.chequeNo);
	sprintf(tmpStr1, "%08ld", atol(tmpStr));
	strncpy(stopChqLogRec.chequeNo, tmpStr1, 8);
	strncpy(stopChqLogRec.amount, receivedMsg.stopChqInfo.amount, 14);
	strncpy(stopChqLogRec.dateStop, actualToBmDate(receivedMsg.stopChqInfo.dateStop, tmpStr), 6);
	strncpy(stopChqLogRec.payeeName, receivedMsg.stopChqInfo.payeeName, 25);
	sprintf(tmpStr, "%.8s", receivedMsg.stopChqInfo.chequeFrom);
	sprintf(tmpStr1, "%08ld", atol(tmpStr));
	strncpy(stopChqLogRec.chequeFrom, tmpStr1, 8);
	strncpy(stopChqLogRec.lastUpdateBmDate, bankingDate, 8);
	strncpy(stopChqLogRec.lastUpdateUser, receivedMsg.stopChqInfo.userId, 10);
	getDateTime();
	sprintf(tmpStr, "%04d%02d%02d%02d%02d%02d", systemDate->tm_year+1900, systemDate->tm_mon+1, systemDate->tm_mday, systemDate->tm_hour, systemDate->tm_min,systemDate->tm_sec);
	strncpy(stopChqLogRec.lastUpdateDateTime, tmpStr, 14);

	if ( receivedMsg.stopChqInfo.creationOrUpdate == 'C' )
	{
		if ( extraDebug > 4 )
		{
			fprintf(logFp, "%s|%5d| [processStopChqRequest] Before writing to stopChqLogFile (%d) ..\n", getDateTime(), PID, stopChqLogFile);
			fflush(logFp);
		}
		if ( isWrite(stopChqLogFile, &stopChqLogRec.liveChar) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processStopChqRequest] ISWRITE error %d on ststchqlog while creating a new stop cheque Info for the account # [%.14s] [%.13s], cheque # [%.10s], key is [%.28s] \n", getDateTime(), PID, iserrno, receivedMsg.stopChqInfo.accNo, stopChqLogRec.accNo, stopChqLogRec.chequeNo, stopChqLogRec.branchCode);
			fflush(logFp);
			if  ( iserrno == 100 || iserrno == 108 )
			{
				sprintf(tmpStr, "Duplicate record [%.28s]", stopChqLogRec.branchCode);
				formatBranchResponse(DUPLICATE, tmpStr, tmpStr);
			}
			else if ( iserrno == 107 || iserrno == 113 )
			{
				sprintf(tmpStr, "Record/File locked on ststchqlog");
				formatBranchResponse( RECORD_LOCKED, tmpStr, tmpStr);
			}
			else
			{
				sprintf(tmpStr, "CISAM Error %d occured on ststchqlog", iserrno);
				formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			}
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
	}
	else
	{
		if ( isRewcurr(stopChqLogFile, &stopChqLogRec.liveChar) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processStopChqRequest] ISREWCURR error %d on ststchqlog while creating a new stop cheque Info for the account # [%.14s] [%.13s], cheque # [%.10s], key is [%.28s] \n", getDateTime(), PID, iserrno, receivedMsg.stopChqInfo.accNo, stopChqLogRec.accNo, stopChqLogRec.chequeNo, stopChqLogRec.branchCode);
			fflush(logFp);
			if  ( iserrno == 100 || iserrno == 108 )
			{
				sprintf(tmpStr, "Duplicate record [%.28s]", stopChqLogRec.branchCode);
				formatBranchResponse(DUPLICATE, tmpStr, tmpStr);
			}
			else if ( iserrno == 107 || iserrno == 113 )
			{
				sprintf(tmpStr, "Record/File locked on ststchqlog");
				formatBranchResponse( RECORD_LOCKED, tmpStr, tmpStr);
			}
			else
			{
				sprintf(tmpStr, "CISAM Error %d occured on ststchqlog", iserrno);
				formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			}
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
	}

	if ( receivedMsg.stopChqInfo.destroyFlag == '1' )
	{
		memset(&pydRec.liveChar, ' ', sizeof pydRec);

		pydRec.liveChar = '@';
		strncpy(pydRec.recType,"CH", 2);
		strncpy(pydRec.accNo, stopChqLogRec.accNo, 13);
		strncpy(pydRec.chequeNo, stopChqLogRec.chequeNo, 10);

		sprintf(tmpStr, "%.14s", stopChqLogRec.amount);
		transAmt = atof(tmpStr);
		sprintf(tmpStr, dblToBmAmt(transAmt,14));
		/*strncpy(pydRec.amount, stopChqLogRec.amount, 14);*/
		strncpy(pydRec.amount, tmpStr, 14);
		strncpy(pydRec.dateStop, stopChqLogRec.dateStop, 6);
		strncpy(pydRec.payeeName, stopChqLogRec.payeeName, 25);
		strncpy(pydRec.chequeFrom, stopChqLogRec.chequeFrom, 8);
		pydRec.destroyFlag = '1';

		if ( extraDebug > 4 )
		{
			fprintf(logFp, "%s|%5d| [processStopChqRequest] Before writing to pyd0data (%d) ..\n", getDateTime(), PID, pydFile);
			fflush(logFp);
		}
		if ( isWrite(pydFile, &pydRec.liveChar) < 0 )
		{
			fprintf(logFp, "%s|%5d|[processStopChqRequest] ISWRITE error %d occured on pyd0data for the account # [%.13s]  and cheque No [%.10s]\n", getDateTime(), PID, iserrno, pydRec.accNo, pydRec.chequeNo);
			fflush(logFp);
			sprintf(tmpStr, "Error %d occurred while writing pyd0data", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
	}
	closeAllFiles();

	formatBranchResponse(DONE,"Successfully Added...", "Successfully Added...");
    sendResponse(responseMsg.customer.msgLen);
	return SUCCESS;
}

processChequeBookSearch()
{
	int lastRecRcvd, recCount=0, recsInThisMsg = 0, i ;
	char tmpStr[100],tAccNo[20], tBmAccNo[15]; 

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processChequeBookSearch]\n", getDateTime(), PID);


	memset(responseMsg.chequeBookSearch.msgLen, ' ', sizeof responseMsg.chequeBookSearch);
	responseMsg.chequeBookSearch.nullPad = '\0';

	/* Same StdOrd search Request Structure is used for chequeBookSearch also */
	sprintf(tmpStr, "%.5s", receivedMsg.stdOrdSearch.lastRecCount);
	lastRecRcvd = atoi(tmpStr);


	memset(&crdRec.liveChar, ' ', sizeof crdRec);
	strncpy(crdRec.accNo, (char *)actualToBmCust(&receivedMsg.stdOrdSearch.accNo[5], tmpStr), 6);

	if ( isRead(crdFile, &crdRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processChequeBookSearch] :ISREAD/ISEQUAL error %d occured while reading crd0data for the customer # [%.7s] [%.6s] while getting the alternative branch code for the cheque book request \n", getDateTime(), PID, iserrno, &receivedMsg.stdOrdSearch.accNo[5], crdRec.accNo);
		fflush(logFp);
		sprintf(tmpStr,"Error %d occured while reading crd0data", iserrno);
		formatPrintCardResponse(NOT_FOUND, tmpStr, tmpStr);
		return FAILURE;
	}
	strncpy(responseMsg.chequeBookSearch.alternativeBranchCode, crdRec.alternativeBranchCode, 4);

	memset(&chqTabRec.liveChar, ' ', sizeof chqTabRec);

	isindexinfo(chqTabFile, &chqTabKey, 1);

	strncpy(chqTabRec.accNo,receivedMsg.stdOrdSearch.accNo , 14);
	isstart(chqTabFile, &chqTabKey, 0, &chqTabRec.liveChar, ISGTEQ);

	strncpy(responseMsg.chequeBookSearch.accNo, receivedMsg.stdOrdSearch.accNo, 14);

	while ( isRead(chqTabFile, &chqTabRec.liveChar, ISNEXT) == 0 )
	{
		if ( recCount++ < lastRecRcvd )
			continue; /* read all records already sent */

		if ( strncmp(receivedMsg.stdOrdSearch.accNo, chqTabRec.accNo, 14) )
			break;

		/*strncpy(responseMsg.chequeBookSearch.details[recsInThisMsg].branchCode, chqTabRec.custBranchCode, 4);*/
		if ( strncmp(chqTabRec.deliveryBranchCode, "      ", 4) == 0 || strncmp(chqTabRec.deliveryBranchCode, "0000", 4) == 0)
			strncpy(responseMsg.chequeBookSearch.details[recsInThisMsg].deliveryBranchCode, chqTabRec.custBranchCode, 4);
		else
			strncpy(responseMsg.chequeBookSearch.details[recsInThisMsg].deliveryBranchCode, chqTabRec.deliveryBranchCode, 4);
		responseMsg.chequeBookSearch.details[recsInThisMsg].chequeType = chqTabRec.chequeType;
		strncpy(responseMsg.chequeBookSearch.details[recsInThisMsg].booksRequested, chqTabRec.booksRequested, 2);
		strncpy(responseMsg.chequeBookSearch.details[recsInThisMsg].requestDate, chqTabRec.requestDateTime, 8);
		responseMsg.chequeBookSearch.details[recsInThisMsg].requestStatus = chqTabRec.requestStatus;
		strncpy(responseMsg.chequeBookSearch.details[recsInThisMsg].chequeNoFrom, chqTabRec.chequeNoFrom, 8);
		strncpy(responseMsg.chequeBookSearch.details[recsInThisMsg].chequeNoTo, chqTabRec.chequeNoTo, 8);
		/* request user id is added at the end of response message layout - Rajesh - 26/09/2006 */
		strncpy(responseMsg.chequeBookSearch.requestUserId[recsInThisMsg], chqTabRec.requestUserId, 10);
		if ( chqTabRec.requestUserId[0] >= '0' && chqTabRec.requestUserId[0] <= '9' )
			strncpy(&responseMsg.chequeBookSearch.requestUserId[recsInThisMsg][7], &chqTabRec.branchCode[1], 3);

		if ( ++recsInThisMsg >=  20 )
			break;
	}
	sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
	strncpy(responseMsg.chequeBookSearch.lastRecCount, tmpStr, 5);
	sprintf(tmpStr, "%02d", recsInThisMsg);
	strncpy(responseMsg.chequeBookSearch.noOfRecs, tmpStr, 2);
	formatAccSearchResponse(DONE, "Successful", "Successful");/* to be changed */
	fflush(logFp);
	sendResponse(responseMsg.chequeBookSearch.msgLen);
	return SUCCESS;
}

getChequeBookHistoryDetails()
{
	int noOfRec ;
	char tmpStr[10];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[getChequeBookHistoryDetails]\n", getDateTime(), PID);


	noOfRec=0;

	memset(responseMsg.chequeBookHistory.msgLen, ' ', sizeof responseMsg.chequeBookHistory);

	memset(&chqTabRec.liveChar, ' ', sizeof chqTabRec);

	strncpy(chqTabRec.accNo, receivedMsg.chequeBookHistory.accNo, 14);
	strncpy(chqTabRec.requestDateTime, receivedMsg.chequeBookHistory.reqDate, 8);

	isindexinfo(chqTabFile, &chqTabKey, 1);
	isstart(chqTabFile, &chqTabKey, 0, &chqTabRec.liveChar, ISGTEQ);

	if ( isRead(chqTabFile, &chqTabRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d| ISREAD/ISEQUAL error %d occure on stchqtab for the account number [%.14s] & request date [%.8s] \n", getDateTime(), PID, iserrno, chqTabRec.accNo, chqTabRec.requestDateTime);
		fflush(logFp);
		if ( iserrno == 111 || iserrno == 110 )
		{
			sprintf(tmpStr, "ChequeBk record not found on stchqtab.Please check");
			formatBranchResponse(NOT_FOUND, tmpStr, tmpStr);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
		else
		{
			sprintf(tmpStr, "Error %d occurred while reading stchqtab", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			sendResponse(responseMsg.customer.msgLen);
			return FAILURE;
		}
	}

	if ( receivedMsg.chequeBookHistory.historyOrDetail != 'D' ) 
	{
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].requestUserId, chqTabRec.requestUserId,10);
		if ( chqTabRec.requestUserId[0] >= '0' && chqTabRec.requestUserId[0] <= '9' )
			strncpy(&responseMsg.chequeBookHistory.details[noOfRec].requestUserId[7], &chqTabRec.branchCode[1], 3);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].requestDate,chqTabRec.requestDateTime,8); 
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].producedDate, chqTabRec.producedDate,8);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].producedUserId, chqTabRec.producedUserId, 10);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].recdByBranchDate, chqTabRec.recdByBranchDate, 8);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].recdByBranchUserId, chqTabRec.recdByBranchUserId, 10);
		if ( chqTabRec.recdByBranchUserId[0] >= '0' && chqTabRec.recdByBranchUserId[0] <= '9' )
			strncpy(&responseMsg.chequeBookHistory.details[noOfRec].recdByBranchUserId[7], &chqTabRec.branchCode[1], 3);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].issuedToCustDate, chqTabRec.issuedToCustDate, 8);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].issuedToCustUserId, chqTabRec.issuedToCustUserId, 10);
		if ( chqTabRec.issuedToCustUserId[0] >= '0' && chqTabRec.issuedToCustUserId[0] <= '9' )
			strncpy(&responseMsg.chequeBookHistory.details[noOfRec].issuedToCustUserId[7], &chqTabRec.branchCode[1], 3);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].rejectedDate, chqTabRec.rejectedDate, 8);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].rejectedUserId, chqTabRec.rejectedUserId, 10);
		if ( chqTabRec.rejectedUserId[0] >= '0' && chqTabRec.rejectedUserId[0] <= '9' )
			strncpy(&responseMsg.chequeBookHistory.details[noOfRec].rejectedUserId[7], &chqTabRec.rejectedUserId[1], 3);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].rejectedReason, chqTabRec.rejectedReason, 20);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].requestTime, &chqTabRec.requestDateTime[8],6);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].producedTime, chqTabRec.producedTime, 6);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].recdByBranchTime, chqTabRec.recdByBranchTime, 6);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].issuedToCustTime, chqTabRec.issuedToCustTime, 6);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].rejectedTime, chqTabRec.rejectedTime, 6);
		noOfRec++;
		sprintf(tmpStr,"%02d", noOfRec);
		strncpy(responseMsg.chequeBookHistory.noOfRecs, tmpStr,2);
		responseMsg.chequeBookHistory.details[noOfRec+1].requestUserId[0] = '\0';
		formatCardHistoryResponse(DONE, "Successful...", "Successful...");
		sendResponse(responseMsg.chequeBookHistory.msgLen);
		return SUCCESS;
	}
	else
	{
		strncpy(responseMsg.chequeBookDetail.accNo, chqTabRec.accNo, 14);
		strncpy(responseMsg.chequeBookDetail.requestDateTime, chqTabRec.requestDateTime, 14);
		strncpy(responseMsg.chequeBookDetail.booksRequested, chqTabRec.booksRequested, 2);
		responseMsg.chequeBookDetail.chequeType = chqTabRec.chequeType;
		responseMsg.chequeBookDetail.requestStatus = chqTabRec.requestStatus;
		strncpy(responseMsg.chequeBookDetail.custBranchCode, chqTabRec.custBranchCode, 4);
		strncpy(responseMsg.chequeBookDetail.deliveryBranchCode, chqTabRec.deliveryBranchCode, 4);
		strncpy(responseMsg.chequeBookDetail.chequeNoFrom, chqTabRec.chequeNoFrom, 8);
		strncpy(responseMsg.chequeBookDetail.chequeNoTo, chqTabRec.chequeNoTo, 8);
		formatCardHistoryResponse(DONE, "Successful...", "Successful...");
		sendResponse(responseMsg.chequeBookDetail.msgLen);
		return SUCCESS;
	}

	/* commented since index number 1 is primary key and it is ISNODUPS 
	while ( isRead(chqTabFile, &chqTabRec.liveChar, ISNEXT) == 0 )
	{
		if ( strncmp(chqTabRec.accNo, receivedMsg.chequeBookHistory.accNo, 14) || 
			 strncmp(chqTabRec.requestDateTime, receivedMsg.chequeBookHistory.reqDate,8) )
			break;

		strncpy(responseMsg.chequeBookHistory.details[noOfRec].requestUserId, chqTabRec.requestUserId,10);
		if ( chqTabRec.requestUserId[0] >= '0' && chqTabRec.requestUserId[0] <= '9' )
			strncpy(&responseMsg.chequeBookHistory.details[noOfRec].requestUserId[7], &chqTabRec.branchCode[1], 3);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].requestDate,chqTabRec.requestDateTime,8); 
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].producedDate, chqTabRec.producedDate,8);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].producedUserId, chqTabRec.producedUserId, 10);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].recdByBranchDate, chqTabRec.recdByBranchDate, 8);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].recdByBranchUserId, chqTabRec.recdByBranchUserId, 10);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].issuedToCustDate, chqTabRec.issuedToCustDate, 8);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].issuedToCustUserId, chqTabRec.issuedToCustUserId, 10);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].rejectedDate, chqTabRec.rejectedDate, 8);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].rejectedUserId, chqTabRec.rejectedUserId, 10);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].rejectedReason, chqTabRec.rejectedReason, 20);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].requestTime, &chqTabRec.requestDateTime[8],6);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].producedTime, chqTabRec.producedTime, 6);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].recdByBranchTime, chqTabRec.recdByBranchTime, 6);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].issuedToCustTime, chqTabRec.issuedToCustTime, 6);
		strncpy(responseMsg.chequeBookHistory.details[noOfRec].rejectedTime, chqTabRec.rejectedTime, 6);
		noOfRec++;

		if ( noOfRec > 50 )
			break;
	}
	*/
}

processStdOrdSearch()
{
	int lastRecRcvd, recCount=0, recsInThisMsg = 0, i, len ;
	char tmpStr[100],tAccNo[20], tBmAccNo[15]; 

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processStdOrdSearch]\n", getDateTime(), PID);


	memset(responseMsg.stdOrdSearch.msgLen, ' ', sizeof responseMsg.stdOrdSearch);
	responseMsg.stdOrdSearch.nullPad = '\0';

	sprintf(tmpStr, "%.5s", receivedMsg.stdOrdSearch.lastRecCount);
	lastRecRcvd = atoi(tmpStr);

	memset(&sodRec.liveChar, ' ', sizeof sodRec);

	isindexinfo(sodFile, &sodKey, 1);

	strncpy(tAccNo, receivedMsg.stdOrdSearch.accNo, 14);
	strncpy(sodRec.accNo, actualToBmAcc(tAccNo, tBmAccNo), 13);
	isstart(sodFile, &sodKey, 13, &sodRec.liveChar, ISGTEQ);

	while ( isRead(sodFile, &sodRec.liveChar, ISNEXT) == 0 )
	{
		if ( recCount++ < lastRecRcvd )
			continue; /* read all records already sent */

		if ( strncmp(tBmAccNo, sodRec.accNo,13) )
			break;

		len = sizeof(sodRec);

		for (i=0; i < len; i++)
		{
			if ( sodRec.accNo[i] == NULL )
				sodRec.accNo[i] = ' ';
		}

		strncpy(responseMsg.stdOrdSearch.details[recsInThisMsg].sodNo, sodRec.sodNo, 6);
		responseMsg.stdOrdSearch.details[recsInThisMsg].paymentType = sodRec.paymentType;
		strncpy(responseMsg.stdOrdSearch.details[recsInThisMsg].paymentAmt, sodRec.paymentAmt,14);
		strncpy(responseMsg.stdOrdSearch.details[recsInThisMsg].payAccNo, bmAccToActual(sodRec.payAccNo,tmpStr), 14);
		responseMsg.stdOrdSearch.details[recsInThisMsg].orderType = sodRec.orderType;
		responseMsg.stdOrdSearch.details[recsInThisMsg].paymentFrequency = sodRec.paymentFrequency;
		strncpy(responseMsg.stdOrdSearch.details[recsInThisMsg].branchCode, sodRec.branchCode,4);

		if ( ++recsInThisMsg >=  20 )
			break;
	}
	sprintf(tmpStr, "%05d", lastRecRcvd+recsInThisMsg);
	strncpy(responseMsg.stdOrdSearch.lastRecCount, tmpStr, 5);
	sprintf(tmpStr, "%02d", recsInThisMsg);
	strncpy(responseMsg.stdOrdSearch.noOfRecs, tmpStr, 2);
	responseMsg.stdOrdSearch.details[recsInThisMsg+1].sodNo[0] = '\0';
	formatAccSearchResponse(DONE, "Successful", "Successful");
	fflush(logFp);
	sendResponse(responseMsg.stdOrdSearch.msgLen);
	return SUCCESS;
}

processStdOrdPendingDetail()
{
	char tmpStr[100], tAccNo[20], tBmAccNo[20];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processStdOrdPendingDetail]\n", getDateTime(), PID);


	memset(responseMsg.stdOrdDetail.msgLen, ' ', sizeof responseMsg.stdOrdDetail);
	memset(&sodLogRec.liveChar, ' ', sizeof sodLogRec);

	strncpy(sodLogRec.userId, receivedMsg.stdOrdDetail.userId, 10);
	strncpy(sodLogRec.branchCode, receivedMsg.stdOrdDetail.homeBranch, 4);
							/* For pending detail, accno is used as dateTime */
	strncpy(sodLogRec.dateTime, receivedMsg.stdOrdDetail.accNo,14);

	isindexinfo(sodLogFile, &sodLogKey, 1);
	if( isstart(sodLogFile, &sodLogKey, 0, &sodLogRec.liveChar,ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processStdOrdPendingDetail] ISSTART/ISEQUAL error %d occured on stsodLog for key [%.28s]\n", getDateTime(), PID, iserrno, sodLogRec.branchCode);
		fflush(logFp);
		if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
		     formatStdOrdDetailResponse(END_OF_FILE, "No Std Order Record found for this Acct...", "No Std Order Record found for this Acct ..");
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on stsodLog", iserrno);
			formatStdOrdDetailResponse(INTERNALERR, tmpStr, tmpStr);
		}
     	sendResponse(responseMsg.stdOrdDetail.msgLen);
		return FAILURE;
	}

	if ( readSodLogFile(ISEQUAL) < 0 )
	{
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE ;
	}

	strncpy(responseMsg.stdOrdDetail.accNo, bmAccToActual(sodLogRec.accNo, tAccNo), 14);
	responseMsg.stdOrdDetail.newOrUpdate = sodLogRec.newOrUpdate;
	strncpy(responseMsg.stdOrdDetail.sodNo, sodLogRec.sodNo, 6);
	responseMsg.stdOrdDetail.orderType = sodLogRec.orderType;
	responseMsg.stdOrdDetail.paymentType = sodLogRec.paymentType;
	responseMsg.stdOrdDetail.paymentMode = sodLogRec.paymentMode;
	responseMsg.stdOrdDetail.paymentFrequency = sodLogRec.paymentFrequency;
	strncpy(responseMsg.stdOrdDetail.firstPaymentDate, (char *) bmDateToActual(sodLogRec.firstPaymentDate, tmpStr), 8);
	strncpy(responseMsg.stdOrdDetail.nextPaymentDate, (char *) bmDateToActual(sodLogRec.nextPaymentDate, tmpStr), 8);
	strncpy(responseMsg.stdOrdDetail.finalPaymentDate, (char *) bmDateToActual(sodLogRec.finalPaymentDate, tmpStr), 8);
	strncpy(responseMsg.stdOrdDetail.lastProcessedDate, (char *) bmDateToActual(sodLogRec.lastProcessedDate, tmpStr), 8);
	strncpy(responseMsg.stdOrdDetail.paymentsToBeMade, sodLogRec.paymentsToBeMade, 3);
	strncpy(responseMsg.stdOrdDetail.paymentsMade, sodLogRec.paymentsMade, 3);
	responseMsg.stdOrdDetail.limitInExcessFlag = sodLogRec.limitInExcessFlag;
	responseMsg.stdOrdDetail.commissionFlag = sodLogRec.commissionFlag;
	responseMsg.stdOrdDetail.processNextDayFlag = sodLogRec.processNextDayFlag;
	strncpy(responseMsg.stdOrdDetail.thresholdAmt, sodLogRec.thresholdAmt,10);
	strncpy(responseMsg.stdOrdDetail.paymentAmt, sodLogRec.paymentAmt, 14);
	strncpy(responseMsg.stdOrdDetail.totalPaidToDate, sodLogRec.totalPaidToDate, 14);
	strncpy(responseMsg.stdOrdDetail.totalToPay, sodLogRec.totalToPay, 14);
	strncpy(responseMsg.stdOrdDetail.payAccNo, (char *) bmAccToActual(sodLogRec.payAccNo, tAccNo), 14);
	sprintf(tmpStr, "%.7s", &responseMsg.stdOrdDetail.payAccNo[5]);
	if ( getCustName(tmpStr) == SUCCESS )
	{
		if ( strncmp(custTabRec.aShortName, "                                 ", 30) == 0 )
			strncpy(responseMsg.stdOrdDetail.payeeCustName, custTabRec.eShortName, 30);
		else
			strncpy(responseMsg.stdOrdDetail.payeeCustName, custTabRec.aShortName, 30);
	}
	else
	{
		sprintf(tmpStr,"Invalid Customer [%.7s]", &responseMsg.stdOrdDetail.payAccNo[5]);
		strncpy(responseMsg.stdOrdDetail.payeeCustName, tmpStr,30);  
	}
	sprintf(tmpStr, "%.7s", &responseMsg.stdOrdDetail.accNo[5]);
	if ( getCustName(tmpStr) == SUCCESS )
	{
		if ( strncmp(custTabRec.aShortName, "                                 ", 30) == 0 )
			strncpy(responseMsg.stdOrdDetail.custName, custTabRec.eShortName, 30);
		else
			strncpy(responseMsg.stdOrdDetail.custName, custTabRec.aShortName, 30);
	}
	else
	{
		sprintf(tmpStr,"Invalid Customer [%.7s]", &responseMsg.stdOrdDetail.accNo[5]);
		strncpy(responseMsg.stdOrdDetail.custName, tmpStr,30);  
	}
	strncpy(responseMsg.stdOrdDetail.drNarrative1, sodLogRec.drNarrative1, 20);
	strncpy(responseMsg.stdOrdDetail.drNarrative2, sodLogRec.drNarrative2, 20);
	strncpy(responseMsg.stdOrdDetail.crNarrative1, sodLogRec.crNarrative1, 20);
	strncpy(responseMsg.stdOrdDetail.crNarrative2, sodLogRec.crNarrative2, 20);
	responseMsg.stdOrdDetail.transactionDateFlag = sodLogRec.transactionDateFlag;
	strncpy(responseMsg.stdOrdDetail.branchCode, sodLogRec.branchCode,4);
	strncpy(responseMsg.stdOrdDetail.supervisorComments, sodLogRec.supervisorComments,200);
	strncpy(responseMsg.stdOrdDetail.remarks, sodLogRec.remarks, 25);

	memset(&gldRec.liveChar, ' ', sizeof gldRec);
	strncpy(gldRec.accNo, sodLogRec.accNo, 13);
	isindexinfo(gldFile, &gldKey, 1);
	isstart(gldFile, &gldKey, 13, &gldRec.liveChar, ISGTEQ);

	if ( isRead(gldFile, &gldRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processStdOrdPendingDetail] :ISREAD/ISEQUAL error %d occured while reading gld0data for the account no [%.13s] IGNORED \n", getDateTime(), PID, iserrno, sodLogRec.accNo );
		fflush(logFp);
	}
	strncpy(responseMsg.stdOrdDetail.custBranchCode, gldRec.branchCode, 4);

	formatStdOrdDetailResponse(DONE, "Successful","Successful");
	sendResponse(responseMsg.stdOrdDetail.msgLen);
	return SUCCESS;
}

processStdOrdDetail()
{
	char tmpStr[100], tAccNo[20], tBmAccNo[20];
	double transAmt;

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[processStdOrdDetail]\n", getDateTime(), PID);


	memset(responseMsg.stdOrdDetail.msgLen, ' ', sizeof responseMsg.stdOrdDetail);
	memset(&sodRec.liveChar, ' ', sizeof sodRec);

	sprintf(tAccNo, "%.14s", receivedMsg.stdOrdDetail.accNo);
	strncpy(sodRec.accNo, actualToBmAcc(tAccNo, tBmAccNo),13);
	strncpy(sodRec.sodNo, receivedMsg.stdOrdDetail.sodNo, 6);

	isindexinfo(sodFile, &sodKey, 1);
	if( isstart(sodFile, &sodKey, 0, &sodRec.liveChar,ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processStdOrdDetail] :ISSTART/ISEQUAL error %d occured on sod0data for key [%.26s]\n", getDateTime(), PID, iserrno, sodRec.accNo);
		fflush(logFp);
		if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
		     formatStdOrdDetailResponse(END_OF_FILE, "No Std Order Record found for this Acct...", "No Std Order Record found for this Acct ..");
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on sod0data", iserrno);
			formatStdOrdDetailResponse(INTERNALERR, tmpStr, tmpStr);
		}
     	sendResponse(responseMsg.pensionDetail.msgLen);
		return FAILURE;
	}

	if ( readSodFile(ISEQUAL) < 0 )
	{
		sendResponse(responseMsg.customer.msgLen);
		return FAILURE ;
	}

	strncpy(responseMsg.stdOrdDetail.accNo, tAccNo, 14);
	strncpy(responseMsg.stdOrdDetail.sodNo, sodRec.sodNo, 6);
	responseMsg.stdOrdDetail.orderType = sodRec.orderType;
	responseMsg.stdOrdDetail.paymentType = sodRec.paymentType;
	responseMsg.stdOrdDetail.paymentMode = sodRec.paymentMode;
	responseMsg.stdOrdDetail.paymentFrequency = sodRec.paymentFrequency;
	strncpy(responseMsg.stdOrdDetail.firstPaymentDate, (char *) bmDateToActual(sodRec.firstPaymentDate, tmpStr), 8);
	strncpy(responseMsg.stdOrdDetail.nextPaymentDate, (char *) bmDateToActual(sodRec.nextPaymentDate, tmpStr), 8);
	strncpy(responseMsg.stdOrdDetail.finalPaymentDate, (char *) bmDateToActual(sodRec.finalPaymentDate, tmpStr), 8);
	strncpy(responseMsg.stdOrdDetail.lastProcessedDate, (char *) bmDateToActual(sodRec.lastProcessedDate, tmpStr), 8);
	strncpy(responseMsg.stdOrdDetail.paymentsToBeMade, sodRec.paymentsToBeMade, 3);
	strncpy(responseMsg.stdOrdDetail.paymentsMade, sodRec.paymentsMade, 3);
	responseMsg.stdOrdDetail.limitInExcessFlag = sodRec.limitInExcessFlag;
	responseMsg.stdOrdDetail.commissionFlag = sodRec.commissionFlag;
	responseMsg.stdOrdDetail.processNextDayFlag = sodRec.processNextDayFlag;
	transAmt = bmAmtToDbl(sodRec.thresholdAmt,10);
	sprintf(tmpStr, "%010.0f", transAmt);
	/*strncpy(responseMsg.stdOrdDetail.thresholdAmt, sodRec.thresholdAmt,10);*/
	strncpy(responseMsg.stdOrdDetail.thresholdAmt, tmpStr, 10);
	transAmt = bmAmtToDbl(sodRec.paymentAmt,14);
	sprintf(tmpStr, "%014.0f", transAmt);
	/*strncpy(responseMsg.stdOrdDetail.paymentAmt, sodRec.paymentAmt, 14);*/
	strncpy(responseMsg.stdOrdDetail.paymentAmt, tmpStr, 14);
	transAmt = bmAmtToDbl(sodRec.totalPaidToDate, 14);
	sprintf(tmpStr, "%014.0f", transAmt);
	/*strncpy(responseMsg.stdOrdDetail.totalPaidToDate, sodRec.totalPaidToDate, 14);*/
	strncpy(responseMsg.stdOrdDetail.totalPaidToDate, tmpStr, 14);
	transAmt = bmAmtToDbl(sodRec.totalToPay, 14);
	sprintf(tmpStr, "%014.0f", transAmt);
	/*strncpy(responseMsg.stdOrdDetail.totalToPay, sodRec.totalToPay, 14);*/
	strncpy(responseMsg.stdOrdDetail.totalToPay, tmpStr, 14);
	strncpy(responseMsg.stdOrdDetail.payAccNo, (char *) bmAccToActual(sodRec.payAccNo, tAccNo), 14);
	sprintf(tmpStr, "%.7s", &responseMsg.stdOrdDetail.payAccNo[5]);
	if ( getCustName(tmpStr) == SUCCESS )
	{
		if ( strncmp(custTabRec.aShortName, "                                 ", 30) == 0 )
			strncpy(responseMsg.stdOrdDetail.payeeCustName, custTabRec.eShortName, 30);
		else
			strncpy(responseMsg.stdOrdDetail.payeeCustName, custTabRec.aShortName, 30);
	}
	else
	{
		sprintf(tmpStr,"Invalid Customer [%.7s]", &responseMsg.stdOrdDetail.payAccNo[5]);
		strncpy(responseMsg.stdOrdDetail.payeeCustName, tmpStr,30);  
	}
	strncpy(responseMsg.stdOrdDetail.drNarrative1, sodRec.drNarrative1, 20);
	strncpy(responseMsg.stdOrdDetail.drNarrative2, sodRec.drNarrative2, 20);
	strncpy(responseMsg.stdOrdDetail.crNarrative1, sodRec.crNarrative1, 20);
	strncpy(responseMsg.stdOrdDetail.crNarrative2, sodRec.crNarrative2, 20);
	responseMsg.stdOrdDetail.transactionDateFlag = sodRec.transactionDateFlag;
	strncpy(responseMsg.stdOrdDetail.branchCode, sodRec.branchCode,4);
	strncpy(responseMsg.stdOrdDetail.remarks, sodRec.remarks, 25);

	memset(&gldRec.liveChar, ' ', sizeof gldRec);
	strncpy(gldRec.accNo, sodRec.accNo, 13);
	isindexinfo(gldFile, &gldKey, 1);
	isstart(gldFile, &gldKey, 13, &gldRec.liveChar, ISGTEQ);

	if ( isRead(gldFile, &gldRec.liveChar, ISEQUAL) < 0 )
	{
		fprintf(logFp, "%s|%5d|[processStdOrdDetail] :ISREAD/ISEQUAL error %d occured while reading gld0data for the account no [%.13s] IGNORED \n", getDateTime(), PID, iserrno, sodRec.accNo );
		fflush(logFp);
	}
	strncpy(responseMsg.stdOrdDetail.custBranchCode, gldRec.branchCode, 4);

	getStdOrdLastUpdateUser();

	formatStdOrdDetailResponse(DONE, "Successful","Successful");
	sendResponse(responseMsg.stdOrdDetail.msgLen);
	return SUCCESS;
}

getStdOrdLastUpdateUser()
{
	char tmpStr[50], accNo[15];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[getStdOrdLastUpdateUser]\n", getDateTime(), PID);


	if ( openSodLogFile(ISMANULOCK+ISINOUT) < 0 )
	{
		fprintf(logFp, "%s|%5d|[getStdOrdLastUpdateUser] ISOPEN error %d on stsodlog ignored...\n", getDateTime(), PID, iserrno);
		fflush(logFp);
		fprintf(errLogFp, "%s : getStdOrdLastUpdateUser(): ISOPEN error %d on stsodlog ignored...\n", getDateTime(), iserrno);
		fflush(errLogFp);
		return SUCCESS;
	}

	memset(&sodLogRec.liveChar, ' ', sizeof sodLogRec);

	isindexinfo(sodLogFile, &sodLogKey, 5);

	strncpy(sodLogRec.accNo, sodRec.accNo, 13);
	strncpy(sodLogRec.sodNo, sodRec.sodNo, 6);
	strncpy(sodLogRec.lastUpdateDateTime, "99999999999999", 8);

	fprintf(logFp, "%s|%5d|[getStdOrdLastUpdateUser] readSodLogFile for the key  %.13s  %.6s %.8s \n", getDateTime(), PID, sodLogRec.accNo, sodLogRec.sodNo, sodLogRec.lastUpdateDateTime);
	fflush(logFp);

	isstart(sodLogFile, &sodLogKey, 0, &sodLogRec.liveChar, ISGTEQ);

	if ( isRead(sodLogFile, &sodLogRec.liveChar, ISPREV) < 0 )
	{
		fprintf(logFp, "%s|%d|[getStdOrdLastUpdateUser] : ISREAD/ISPREV error %d on stsodlog for the key %.13s %.6s  %.8s\n", getDateTime(), PID, iserrno, sodLogRec.accNo, sodLogRec.sodNo, sodLogRec.lastUpdateDateTime);
		fflush(logFp);
	}

	if ( strncmp(sodLogRec.accNo, sodRec.accNo, 13) == 0 && strncmp(sodLogRec.sodNo, sodRec.sodNo,6) == 0 )
	{
		strncpy(responseMsg.stdOrdDetail.lastUpdateUserId, sodLogRec.userId, 10);
		strncpy(responseMsg.stdOrdDetail.lastUpdateDate, sodLogRec.lastUpdateDateTime, 8 );
	}
	else
	{
		fprintf(logFp, "account numbers are not matching...\n");
		fprintf(logFp, "Acc Nos   : %.13s  %.13s  ; Sod Nos  : %.6s  %.6s \n", sodRec.accNo, sodLogRec.accNo, sodRec.accNo, sodLogRec.sodNo);
		fflush(logFp);
	}

	return SUCCESS;
}

checkStdOrdPendingStatus()
{
	char tmpStr[100], bmAccNo[15];

	if ( extraDebug )
		fprintf(logFp, "%s|%5d|[checkStdOrdPendingStatus]\n", getDateTime(), PID);

	
	isindexinfo(sodLogFile,&sodLogKey,2);

	memset(&sodLogRec.liveChar, ' ', sizeof sodLogRec);

	strncpy(sodLogRec.accNo, actualToBmAcc(receivedMsg.stdOrdDetail.accNo, bmAccNo),13);
	strncpy(sodLogRec.sodNo, receivedMsg.stdOrdDetail.sodNo, 6);

	if ( isstart(sodLogFile,&sodLogKey, 0, &sodLogRec.liveChar,ISGTEQ) < 0 )
	{
		if ( iserrno == 110 || iserrno == 112 || iserrno == 111 )
			return FAILURE;
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on stsodlog", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr, tmpStr);
			return FAILURE;
		}
	}
	while ( isRead(sodLogFile, &sodLogRec.liveChar, ISNEXT) == 0 )
	{
		if ( strncmp(sodLogRec.accNo, bmAccNo, 13) || strncmp(sodLogRec.sodNo, receivedMsg.stdOrdDetail.sodNo, 6) )
			break;

		if ( sodLogRec.bmUpdateStatus == '1' || sodLogRec.bmUpdateStatus == '2' )
		   return SUCCESS;
	}
	return FAILURE;
}

readStopChqLogFile(mode)
int mode;
{
	char tmpStr[55];

	fprintf(logFp, "%s|%5d|[readStopChqLogFile] for key value %.28s\n", getDateTime(), PID, stopChqLogRec.branchCode);
	fflush(logFp);
	if ( isRead(stopChqLogFile, &stopChqLogRec.liveChar, mode) < 0 )
	{
		fprintf(logFp, "%s|%5d|[readStopChqLogFile] : ISREAD/%s error %d on ststchqlog for the key=%.28s\n", getDateTime(), PID, mode==ISEQUAL ? "ISEQUAL" : mode==ISNEXT ? "ISNEXT" : mode==ISPREV ? "ISPREV" : mode == ISFIRST ? "ISFIRST" : mode == ISLAST ? "ISLAST" : mode == ISGTEQ ? "ISGTEQ" : "UNKNOWN", iserrno, stopChqLogRec.branchCode);
		fflush(logFp);
		if  ( iserrno == 111 || iserrno == 112 )
		{
			sprintf(tmpStr, "Record not found with this key ");
			formatBranchResponse(NOT_FOUND, tmpStr, tmpStr ); 
		}
		else if ( iserrno == 110 )
		{
			sprintf(tmpStr, "Begining/End of file reached");
			formatBranchResponse(END_OF_FILE, tmpStr,tmpStr);
		}
		else if ( iserrno == 107 || iserrno == 113 )
		{
			sprintf(tmpStr, "Record/File locked on ststchqlog file");
			formatBranchResponse(RECORD_LOCKED,  tmpStr, tmpStr); 
		}
		else
		{
			sprintf(tmpStr, "CISAM Error %d occured on ststchqlog file", iserrno);
			formatBranchResponse(INTERNALERR, tmpStr,tmpStr);
		}
		/* send resonse will be taken care of calling function */
		return FAILURE;
	}

	fflush(logFp);
	return SUCCESS;
}

